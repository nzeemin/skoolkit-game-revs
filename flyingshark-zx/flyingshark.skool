 $C313 LD A,(IY+$1A)   ;
 $C316 LD (IY+$06),A   ;
 $C319 RET             ;

; Movement handler $31: advance object down-screen; on flag, score and mark
; progress
;
; .
;
; IY object struct base (Y at IY+$0D/$0E, action flag IY+$14 bit 7)
;
; Handler for index $31 of the #R$A000 jump table (see #R$B7F6).
c$C31A LD A,(IY+$0D)  ;
 $C31D ADD A,$20      ;
 $C31F LD (IY+$0D),A  ;
 $C322 JR NC,$C327    ;
 $C324 INC (IY+$0E)   ;
*$C327 BIT 7,(IY+$14) ;
 $C32B JR Z,$C347     ;
 $C32D LD IX,($9C77)  ;
 $C331 LD A,(IX+$09)  ;
 $C334 CP $07         ;
 $C336 JR NC,$C34D    ;
 $C338 INC (IX+$09)   ;
 $C33B LD HL,$9C27    ;
 $C33E SET 2,(HL)     ;
 $C340 LD A,$05       ;
 $C342 CALL $66B5     ; Add BCD score value to current player's score
 $C345 JR $C34D       ;
*$C347 LD A,(IY+$0E)  ;
 $C34A CP $1B         ;
 $C34C RET C          ;
*$C34D LD HL,$9C3F    ;
 $C350 DEC (HL)       ;
 $C351 LD HL,$9D18    ;
 $C354 INC (HL)       ;
 $C355 CALL $B79F     ; Mark formation slot done, trigger completion effect
                      ; when group empties
 $C358 RET            ;

