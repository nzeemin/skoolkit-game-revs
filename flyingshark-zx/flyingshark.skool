 $BC16 LD A,(HL)     ;
 $BC17 OR E          ;
 $BC18 LD (HL),A     ;
 $BC19 INC L         ;
 $BC1A LD A,(HL)     ;
 $BC1B OR E          ;
 $BC1C LD (HL),A     ;
 $BC1D INC L         ;
 $BC1E LD A,(HL)     ;
 $BC1F OR E          ;
