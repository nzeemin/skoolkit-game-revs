 $CA71 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ;
 $CA79 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ;
 $CA81 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ; }
