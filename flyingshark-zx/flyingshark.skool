 $B179 LD A,(DE)     ;
 $B17A OR C          ;
 $B17B LD (DE),A     ;
 $B17C INC E         ;
 $B17D LD A,(DE)     ;
 $B17E OR B          ;
 $B17F LD (DE),A     ;
