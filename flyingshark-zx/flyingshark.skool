 $C886 LDI           ;
 $C888 LDI           ;
 $C88A LDI           ;
 $C88C LDI           ;
 $C88E LDI           ;
 $C890 LDI           ;
 $C892 LDI           ;
 $C894 LDI           ;
 $C896 LDI           ;
 $C898 LDI           ;
 $C89A LDI           ;
 $C89C LDI           ;
 $C89E LDI           ;
 $C8A0 LDI           ;
 $C8A2 LDI           ;
 $C8A4 LDI           ;
 $C8A6 LDI           ;
 $C8A8 LDI           ;
 $C8AA LDI           ;
 $C8AC DJNZ $C862    ;
*$C8AE LD HL,$FA79   ; {Wrap: continue remaining bytes from buffer start $FA79
 $C8B1 LD B,A        ;
 $C8B2 AND A         ;
 $C8B3 LD A,$00      ;
 $C8B5 JR NZ,$C862   ; }
 $C8B7 RET           ;

; Routine at C8B8
;
; Used by the routines at #R$A0C4 and #R$A4E7.
c$C8B8 LD HL,$9C00   ;
 $C8BB LD A,(HL)     ;
 $C8BC INC A         ;
 $C8BD CP $08        ; Test for 8th frame (mod-8 wrap)
 $C8BF RES 3,A       ;
 $C8C1 LD (HL),A     ;
 $C8C2 RRCA          ;
 $C8C3 RRCA          ;
 $C8C4 RRCA          ;
 $C8C5 INC HL        ;
 $C8C6 LD (HL),A     ;
 $C8C7 AND A         ; {Only continue every 8th call
 $C8C8 RET NZ        ; }
 $C8C9 LD HL,$9C27   ;
 $C8CC SET 3,(HL)    ; Mark deferred event bit 3 pending
 $C8CE LD HL,$9BAE   ;
 $C8D1 LD A,(HL)     ;
 $C8D2 XOR $01       ; Toggle ping-pong buffer selector
 $C8D4 LD (HL),A     ;
 $C8D5 LD HL,$9BB0   ;
 $C8D8 LD IY,$9BC2   ;
 $C8DC JR Z,$C8E5    ; Select this pass's ping-pong buffer
 $C8DE LD HL,$9BC2   ;
 $C8E1 LD IY,$9BB0   ;
*$C8E5 LD DE,$9BD4   ;
 $C8E8 LD BC,$0012   ;
 $C8EB LDIR          ; Copy 18-byte row into staging buffer $9BD4
 $C8ED CALL Z,$C941  ; Decode next column's tile data into ping-pong buffer
 $C8F0 LD HL,$9BD4   ;
 $C8F3 LD DE,($9BF9) ;
 $C8F7 LD B,$12      ;
 $C8F9 LD C,(HL)     ;
 $C8FA INC HL        ;
 $C8FB LD A,(IY+$00) ;
 $C8FE JR $C907      ;
*$C900 LD C,(HL)     ;
 $C901 INC HL        ;
 $C902 LD A,(IY+$00) ;
 $C905 INC IY        ;
*$C907 CP $0C        ;
 $C909 JR C,$C916    ;
 $C90B CP $60        ;
 $C90D JR NC,$C916   ;
 $C90F LD A,C        ;
 $C910 CP $60        ;
 $C912 JR C,$C917    ;
 $C914 LD C,$62      ;
*$C916 LD A,C        ;
*$C917 RLCA          ;
 $C918 RLCA          ;
 $C919 RLCA          ;
 $C91A LD C,A        ;
 $C91B AND $F8       ;
 $C91D LD (DE),A     ;
 $C91E INC DE        ;
 $C91F XOR C         ;
 $C920 ADD A,$80     ;
 $C922 LD (DE),A     ;
 $C923 INC DE        ;
 $C924 DJNZ $C900    ;
 $C926 LD HL,($9BF9) ;
 $C929 LD DE,$FFDC   ;
