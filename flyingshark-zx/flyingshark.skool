 $648B LD HL,$4000   ;
 $648E LD DE,$4001   ;
 $6491 LD BC,$17FF   ;
 $6494 LD (HL),L     ;
 $6495 LDIR          ;
 $6497 RET           ;

; Init menu screen: wipe, draw player boxes, labels, fill buffer
;
; Used by the routines at #R$A5C0, #R$A6BB, #R$A6E5 and #R$A894.
;
; A colour/type for the wipe transition ($9C59)
;
; Sets the wipe colour, runs the $C6A6 wipe effect, draws the player-panel box
; graphics ($6AD4, which uses $6B09), prints the "PLAYER ONE"/"PLAYER TWO"
; label, draws two box variants via $66DE, then fast-fills a buffer at $FA79
; downward with the word $3D00 (261 words) using a PUSH-based stack trick, and
; finally calls $C772.
c$6498 LD ($9C59),A  ; set active colour/type for the wipe effect
 $649B CALL $C6A6    ; Screen wipe transition effect
 $649E CALL $6AD4    ; Draw both players' panel borders
 $64A1 LD A,$03      ; "PLAYER ONE"/"PLAYER TWO"
 $64A3 CALL $6648    ; Print message N from table $627A
 $64A6 LD A,$01      ; select box variant 1
 $64A8 CALL $66DE    ; Print a player's score at its HUD position
 $64AB INC A         ; {draw box variant 2
 $64AC CALL $66DE    ; }
 $64AF DI            ; {disable interrupts, save SP, point SP at fill target
 $64B0 LD ($64C8),SP ; $FA79
 $64B4 LD SP,$FA79   ; }
 $64B7 LD HL,$3D00   ; {HL=fill value $3D00, BC=261 (word count)
 $64BA LD BC,$0105   ; }
*$64BD PUSH HL       ; {fill loop: push HL twice per iteration (fast memory
 $64BE PUSH HL       ; fill via stack)
 $64BF DEC BC        ;
 $64C0 LD A,C        ;
 $64C1 OR B          ;
 $64C2 JR NZ,$64BD   ; }
 $64C4 CALL $C772    ; run $C772
 $64C7 LD SP,$0000   ; reset SP (restored by caller)
 $64CA EI            ; {re-enable interrupts, return
 $64CB RET           ; }

; Print character to screen using ROM font (pixel-shifted blit)
;
; Used by the routines at #R$6626, #R$6663, #R$67F1, #R$6989 and #R$A6E5.
;
; A ASCII character code to print
;
; Draws an ASCII character (ROM font table at $3D00+) at a pixel-precise screen
; position from cursor $9CC7/$9CC9, merging glyph rows into the destination via
; OR (HL) rather than overwriting. Live-traced: HL=$3D06 (char code 32/space,
; row 6) confirms ROM font table use. If the skip-print flag ($9CCB) is set
; instead of a real character, control transfers to $6594, a separate small
; dispatcher for control codes 0-8 via a jump table at $65B3.
c$64CC PUSH AF       ;
 $64CD PUSH HL       ;
 $64CE PUSH DE       ;
 $64CF PUSH BC       ;
 $64D0 LD C,A        ; C=char code
 $64D1 LD A,($9CCB)  ;
 $64D4 CP $20        ;
 $64D6 JP C,$6594    ; jump to control-code path if printing suppressed
 $64D9 LD A,C        ;
 $64DA CP $20        ;
 $64DC JP C,$658C    ; jump to blank-glyph exit if char<$20
 $64DF CP $FE        ;
 $64E1 JP Z,$658C    ; jump to blank-glyph exit if char=$FE
 $64E4 LD HL,($9CC7) ; {load cursor position
 $64E7 LD DE,($9CC9) ; }
 $64EB LD BC,$0020   ;
 $64EE LD (HL),E     ;
 $64EF ADD HL,BC     ;
 $64F0 LD (HL),D     ;
 $64F1 SBC HL,BC     ;
 $64F3 INC HL        ;
 $64F4 LD ($9CC7),HL ; store advanced cursor column
 $64F7 DEC HL        ;
 $64F8 RLCA          ;
 $64F9 RLCA          ;
 $64FA RLCA          ;
 $64FB LD D,A        ;
 $64FC AND $F8       ;
 $64FE LD E,A        ;
 $64FF XOR D         ;
 $6500 ADD A,$3C     ;
 $6502 LD D,A        ;
 $6503 LD A,H        ;
 $6504 RLCA          ;
 $6505 RLCA          ;
 $6506 RLCA          ;
 $6507 XOR $82       ;
 $6509 LD H,A        ;
 $650A EX DE,HL      ;
 $650B XOR A         ;
 $650C LD (DE),A     ;
 $650D INC D         ;
 $650E LD (DE),A     ;
 $650F INC D         ;
 $6510 LD (DE),A     ;
 $6511 INC D         ;
 $6512 INC L         ;
 $6513 LD A,(HL)     ; start of unrolled pixel-shift blit (glyph rows 0-7)
 $6514 RRCA          ;
 $6515 AND $F8       ;
 $6517 LD B,A        ;
 $6518 LD A,(HL)     ;
 $6519 ADD A,A       ;
 $651A OR B          ;
 $651B OR (HL)       ;
 $651C LD C,A        ;
 $651D SRL A         ;
 $651F AND $F8       ;
 $6521 LD B,A        ;
 $6522 LD A,C        ;
 $6523 ADD A,A       ;
 $6524 AND $0F       ;
 $6526 OR B          ;
 $6527 AND C         ;
 $6528 LD (DE),A     ;
 $6529 INC L         ;
 $652A INC D         ;
 $652B LD A,C        ;
 $652C LD (DE),A     ;
 $652D INC D         ;
 $652E LD A,(HL)     ;
 $652F RRCA          ;
 $6530 AND $F8       ;
 $6532 LD B,A        ;
 $6533 LD A,(HL)     ;
 $6534 ADD A,A       ;
 $6535 OR B          ;
 $6536 OR (HL)       ;
 $6537 LD (DE),A     ;
 $6538 INC L         ;
 $6539 INC D         ;
 $653A LD (DE),A     ;
 $653B INC D         ;
 $653C LD A,(HL)     ;
 $653D RRCA          ;
 $653E AND $F8       ;
 $6540 LD B,A        ;
 $6541 LD A,(HL)     ;
 $6542 ADD A,A       ;
 $6543 OR B          ;
 $6544 OR (HL)       ;
 $6545 LD (DE),A     ;
 $6546 INC L         ;
 $6547 INC D         ;
 $6548 DEC D         ;
 $6549 LD A,E        ; {advance destination to next screen third (row wrap)
 $654A ADD A,$20     ; }
 $654C LD E,A        ;
 $654D LD A,D        ;
 $654E ADC A,$00     ;
 $6550 AND $F8       ;
 $6552 LD D,A        ;
 $6553 LD A,(HL)     ;
 $6554 RRCA          ;
 $6555 AND $F8       ;
 $6557 LD B,A        ;
 $6558 LD A,(HL)     ;
 $6559 ADD A,A       ;
 $655A OR B          ;
 $655B OR (HL)       ;
 $655C LD (DE),A     ;
 $655D INC L         ;
 $655E INC D         ;
 $655F LD A,(HL)     ;
 $6560 RRCA          ;
 $6561 AND $F8       ;
 $6563 LD B,A        ;
 $6564 LD A,(HL)     ;
 $6565 ADD A,A       ;
 $6566 OR B          ;
 $6567 OR (HL)       ;
 $6568 LD (DE),A     ;
 $6569 INC L         ;
 $656A INC D         ;
 $656B LD (DE),A     ;
 $656C INC D         ;
 $656D LD A,(HL)     ;
 $656E RRCA          ;
 $656F AND $F8       ;
 $6571 LD B,A        ;
 $6572 LD A,(HL)     ;
 $6573 ADD A,A       ;
 $6574 OR B          ;
 $6575 OR (HL)       ;
 $6576 LD (DE),A     ;
 $6577 INC D         ;
 $6578 LD C,A        ;
 $6579 SRL A         ;
 $657B AND $F8       ;
 $657D LD B,A        ;
 $657E LD A,C        ;
 $657F ADD A,A       ;
 $6580 AND $1F       ;
 $6582 OR B          ;
 $6583 AND C         ;
 $6584 LD (DE),A     ;
 $6585 INC D         ;
 $6586 XOR A         ;
 $6587 LD (DE),A     ;
 $6588 INC D         ;
 $6589 LD (DE),A     ;
 $658A INC D         ;
 $658B LD (DE),A     ;
*$658C POP BC        ; restore registers and return
 $658D POP DE        ;
 $658E POP HL        ;
 $658F POP AF        ;
 $6590 LD ($9CCB),A  ; store last-printed char as new skip-print flag
 $6593 RET           ;
*$6594 CP $09        ; control-code path: codes >=9 treated as space
 $6596 JR NC,$65A9   ;
 $6598 ADD A,A       ;
 $6599 LD E,A        ;
 $659A LD D,$00      ;
 $659C LD HL,$65B3   ; dispatch via jump table $65B3
 $659F ADD HL,DE     ;
 $65A0 LD E,(HL)     ;
 $65A1 INC HL        ;
 $65A2 LD D,(HL)     ;
 $65A3 LD HL,$65A9   ;
 $65A6 PUSH HL       ;
 $65A7 EX DE,HL      ;
 $65A8 JP (HL)       ;
*$65A9 LD A,$20      ;
; This entry point is used by the routines at #R$65C5 and #R$65EA.
*$65AB LD ($9CCB),A  ;
 $65AE POP BC        ;
 $65AF POP DE        ;
 $65B0 POP HL        ;
 $65B1 POP AF        ;
 $65B2 RET           ;

; Control-code dispatch table (9 entries, codes 0-8, used by $6594)
w$65B3 DEFW $65C5
 $65B5 DEFW $65D3
 $65B7 DEFW $65DC
 $65B9 DEFW $65F2
 $65BB DEFW $65FB
 $65BD DEFW $6612
 $65BF DEFW $6619
 $65C1 DEFW $65CE
 $65C3 DEFW $65EA

; Control code $00: reset $9CC9 row, skip-count 7
;
; .
;
; .
;
; C still holds the control code value (0, since dispatch index = code). Zeroes
; the low byte of $9CC9 (part of the cursor position pair), sets a skip-count
; of 7 into A, then jumps into $65AB (the tail of the space-handling path) to
; store that count as the new skip-print flag ($9CCB) and return. Reads like a
; "reset row / pad N characters" control character; not fully confirmed against
; live behaviour.
c$65C5 LD HL,$9CC9   ; {zero the low byte of $9CC9 (cursor row reset)
 $65C8 LD (HL),C     ; }
 $65C9 LD A,$07      ; skip-count = 7
 $65CB POP HL        ; {discard pushed return address, jump into skip-flag
 $65CC JR $65AB      ; setter}

; Control code $07: set $9CCA to code value
;
; .
;
; .
;
; Simplest handler: just LD ($9CCA),C then return. $9CCA's purpose is not
; otherwise confirmed.
c$65CE LD HL,$9CCA   ;
 $65D1 LD (HL),C     ;
 $65D2 RET           ;

; Control code $01: set $9CC9 bits 0-2
c$65D3 LD HL,$9CC9   ;
 $65D6 LD A,(HL)     ;
 $65D7 AND $F8       ;
 $65D9 OR C          ; OR in code value (1) to low 3 bits of $9CC9
 $65DA LD (HL),A     ;
 $65DB RET           ;

; Control code $02: set $9CC9 bits 3-5
c$65DC LD HL,$9CC9   ;
 $65DF LD A,C        ;
 $65E0 ADD A,A       ;
 $65E1 ADD A,A       ;
 $65E2 ADD A,A       ;
 $65E3 LD C,A        ;
 $65E4 LD A,(HL)     ;
 $65E5 AND $C7       ;
 $65E7 OR C          ; OR in code value<<3 to bits 3-5 of $9CC9
 $65E8 LD (HL),A     ;
 $65E9 RET           ;

; Control code $08: set $9CC7 bits 0-4 (via code $03), skip-count 4
c$65EA CALL $65F2    ; Control code $03
 $65ED LD A,$04      ; skip-count = 4
 $65EF POP HL        ;
 $65F0 JR $65AB      ;

; Control code $03: set $9CC7 bits 0-4
;
; Used by the routine at #R$65EA.
;
; .
;
; Shared: also called by control code $08 with C=8 instead of 3.
c$65F2 LD HL,$9CC7   ;
 $65F5 LD A,(HL)     ;
 $65F6 AND $E0       ;
 $65F8 OR C          ; OR C into bits 0-4 of $9CC7
 $65F9 LD (HL),A     ;
 $65FA RET           ;

; Control code $04: convert $9CC7 to screen pixel address
;
; Used by the routine at #R$6619.
;
; .
;
; Shared: also reached from control code $06 with a different C value. Converts
; the cursor field $9CC7 into a screen pixel address (same bit-twiddle as
; $64CC's blit), folding in C.
c$65FB LD HL,($9CC7) ;
 $65FE LD A,C        ;
 $65FF RRCA          ;
 $6600 RRCA          ;
 $6601 RRCA          ;
 $6602 LD C,A        ;
 $6603 AND $03       ;
 $6605 OR $58        ;
 $6607 LD H,A        ;
 $6608 LD A,C        ;
 $6609 XOR L         ;
 $660A AND $E0       ;
 $660C XOR L         ;
 $660D LD L,A        ;
 $660E LD ($9CC7),HL ; store converted pixel address back into $9CC7
 $6611 RET           ;

; Control code $05: add code value to $9CC7 low byte
c$6612 LD HL,$9CC7   ;
 $6615 LD A,(HL)     ;
 $6616 ADD A,C       ; add code value (5) to low byte of $9CC7
 $6617 LD (HL),A     ;
 $6618 RET           ;

; Control code $06: compute C, reuse code $04's conversion
c$6619 LD HL,($9CC7) ;
 $661C ADD HL,HL     ;
 $661D ADD HL,HL     ;
 $661E ADD HL,HL     ;
 $661F LD A,H        ;
 $6620 AND $1F       ; {mask to 5 bits, add code value (6)
 $6622 ADD A,C       ; }
 $6623 LD C,A        ;
 $6624 JR $65FB      ; reuse control code $04's conversion with this C

; Print string (control codes + ROM-font text) from HL
;
; Used by the routines at #R$6648 and #R$A6E5.
;
; HL pointer to $FF-terminated string
c$6626 PUSH AF       ; {save AF/HL
 $6627 PUSH HL       ; }
*$6628 LD A,($9CCB)  ; check skip-print flag at $9CCB
 $662B CP $20        ;
 $662D LD A,(HL)     ; {read next byte, advance HL; branch if control code
 $662E INC HL        ; (<$20)
 $662F JR C,$6639    ; }
 $6631 CP $FF        ; check string terminator $FF
 $6633 JR Z,$6645    ; exit if string terminated
 $6635 CP $1B        ; {check position/attribute control code $1B
 $6637 JR Z,$663E    ; }
*$6639 CALL $64CC    ; Print character to screen using ROM font
 $663C JR $6628      ; loop for next character
*$663E LD A,(HL)     ; {read control parameter byte, apply via $6648
 $663F INC HL        ;
 $6640 CALL $6648    ; }
 $6643 JR $6628      ; loop back
*$6645 POP HL        ; {restore AF/HL and return
 $6646 POP AF        ;
 $6647 RET           ; }

; Print message N from table $627A
;
; Used by the routines at #R$6498, #R$6626, #R$67C7, #R$67F1, #R$6989, #R$6A6D,
; #R$6A88, #R$A6BB, #R$A6E5, #R$A783 and #R$A802.
;
; A message number (0-based) to print
@label=print_message
c$6648 PUSH AF       ; {save AF/HL/DE/BC
 $6649 PUSH HL       ;
 $664A PUSH DE       ;
 $664B PUSH BC       ; }
 $664C LD HL,$627A   ; point HL at string index table $627A
 $664F LD E,A        ; {init search count E=A+1, set terminator byte $FF
 $6650 INC E         ;
 $6651 LD A,$FF      ; }
 $6653 LD B,A        ; {search table for the (A+1)th $FF-terminated string
*$6654 CPIR          ; using CPIR}
 $6656 DEC E         ; {loop until count exhausted
 $6657 JR NZ,$6654   ; }
 $6659 CALL $6626    ; Print string (control codes + ROM-font text) from HL
 $665C POP BC        ; {restore AF/HL/DE/BC
 $665D POP DE        ;
 $665E POP HL        ;
 $665F POP AF        ; }
 $6660 RET           ; return

; Unused
s$6661 DEFB $3E,$20

; Print packed-BCD number with leading-zero suppression
;
; Used by the routines at #R$66DE and #R$A6E5.
;
; HL pointer to 3-byte packed-BCD value
; A fill character for suppressed leading zeros ($FE = pad remainder with
; . spaces instead)
;
; Copies the BCD value to scratch ($9C2B), then unpacks its 6 nibbles via RLD
; (one per digit), printing each through $64CC; nibbles that are still zero
; before the first nonzero digit print the fill character A instead of "0". If
; A was $FE on entry, once all 6 digits are printed it pads the unused width
; with spaces (count = original 6 minus digits actually printed, tracked in D).
c$6663 PUSH AF       ;
 $6664 LD DE,$9C2B   ; copy source BCD value to scratch $9C2B
 $6667 LD BC,$0003   ;
 $666A LDIR          ;
 $666C LD C,A        ; C = fill character (from entry A)
 $666D PUSH HL       ;
 $666E LD HL,$9C2B   ;
 $6671 LD D,$00      ;
 $6673 LD B,$05      ;
 $6675 LD A,$0F      ;
*$6677 RLD           ; unpack next BCD digit (RLD)
 $6679 CP $0F        ;
 $667B JR NZ,$6680   ;
 $667D INC HL        ;
 $667E RLD           ;
*$6680 LD E,A        ;
 $6681 AND A         ;
 $6682 JR Z,$6687    ;
 $6684 INC B         ;
 $6685 JR $669A      ;
*$6687 LD A,C        ; leading zero: print fill character instead of digit
 $6688 CALL $64CC    ; Print character to screen using ROM font
 $668B INC D         ;
 $668C LD A,E        ;
 $668D DJNZ $6677    ;
 $668F INC B         ;
*$6690 RLD           ;
 $6692 CP $0F        ;
 $6694 JR NZ,$6699   ;
 $6696 INC HL        ;
 $6697 RLD           ;
*$6699 LD E,A        ;
*$669A ADD A,$30     ;
 $669C CALL $64CC    ; Print character to screen using ROM font
 $669F LD A,E        ;
 $66A0 DJNZ $6690    ;
 $66A2 RLD           ;
 $66A4 POP HL        ;
 $66A5 POP AF        ;
 $66A6 CP $FE        ; check for space-padding mode (A=$FE)
 $66A8 RET NZ        ;
 $66A9 LD A,D        ;
 $66AA AND A         ;
 $66AB RET Z         ;
 $66AC LD B,A        ; B = remaining width to pad
 $66AD LD A,$20      ;
*$66AF CALL $64CC    ; Print character to screen using ROM font
 $66B2 DJNZ $66AF    ;
 $66B4 RET           ;

; Add BCD score value to current player's score
;
; Used by the routines at #R$A802, #R$C075, #R$C11C, #R$C199, #R$C217, #R$C298,
; #R$C31A, #R$C388, #R$C3C7 and #R$C5D2.
;
; A table index into $A094 (0=use HL directly)
; HL score value to add, when A=0
;
; Adds a 3-byte packed-BCD value to the active player's score field ($9C7B for
; player 1, $9C87 for player 2, selected via $9C76), then sets bit 1 of $9C27
; (likely a "score changed, redraw HUD" flag). If A=0 the value is added
; directly from HL; otherwise A indexes a table of preset score values at $A094
; (3 bytes per entry).
c$66B5 AND A         ; {if A=0 use HL as score value directly; else point HL at
 $66B6 LD HL,$A094   ; score-value table $A094
 $66B9 JR Z,$66C2    ; }
 $66BB LD B,A        ; {index into table: HL += 3*A
 $66BC LD DE,$0003   ;
*$66BF ADD HL,DE     ;
 $66C0 DJNZ $66BF    ; }
*$66C2 LD DE,$9C7B   ; {point DE at player 1 score field; check active player
 $66C5 LD A,($9C76)  ;
 $66C8 DEC A         ;
 $66C9 JR Z,$66CE    ; }
 $66CB LD DE,$9C87   ; player 2: point DE at player 2 score field instead
*$66CE LD B,$03      ; 3-byte BCD add loop count
*$66D0 LD A,(DE)     ; {add BCD byte with carry, store back, advance pointers,
 $66D1 ADC A,(HL)    ; repeat for 3 bytes
 $66D2 DAA           ;
 $66D3 LD (DE),A     ;
 $66D4 DEC HL        ;
 $66D5 DEC DE        ;
 $66D6 DJNZ $66D0    ; }
 $66D8 LD HL,$9C27   ; {set score-changed/redraw flag at $9C27
 $66DB SET 1,(HL)    ; }
 $66DD RET           ; return

; Print a player's score at its HUD position
;
; Used by the routines at #R$6498, #R$6771, #R$A178 and #R$A802.
;
; A player number (1 or 2)
;
; Selects the score cursor coordinates ($9C1D/$9C1F, active vs. other player
; via $9C76) and the score data pointer (player 1: $9C79/fill=$FE space-pad;
; player 2: $9C85/fill=$20 plain space), sets the print cursor ($9CC7/$9CC9),
; then calls $6663 to print the BCD score.
c$66DE PUSH AF       ;
 $66DF LD HL,$9C76   ; compare entry player number to active player ($9C76)
 $66E2 CP (HL)       ;
 $66E3 LD BC,($9C1D) ;
 $66E7 JR Z,$66ED    ;
 $66E9 LD BC,($9C1F) ; other player: use $9C1F cursor coordinate
*$66ED CP $01        ; is this player 1?
 $66EF LD HL,$9C79   ;
 $66F2 LD DE,($9C21) ;
 $66F6 LD A,$FE      ; player 1: fill character = $FE (space-pad)
 $66F8 JR Z,$6703    ;
 $66FA LD HL,$9C85   ;
 $66FD LD DE,($9C23) ;
 $6701 LD A,$20      ; player 2: fill character = $20 (plain space)
*$6703 LD ($9CC7),DE ; set print cursor column ($9CC7)
 $6707 LD ($9CC9),BC ; set print cursor row ($9CC9)
 $670B PUSH HL       ; {IX = score data pointer
 $670C POP IX        ; }
 $670E LD DE,$0000   ;
 $6711 ADD HL,DE     ;
 $6712 CALL $6663    ; Print packed-BCD number with leading-zero suppression
 $6715 POP AF        ;
 $6716 RET           ;

; Compare 3 bytes at (DE) vs (HL); NC if all equal
;
; Used by the routine at #R$6989.
;
;   DE,HL pointers to the two 3-byte sequences
; O:Cy set if any byte differs, clear if all 3 match
c$6717 PUSH HL       ;
 $6718 PUSH DE       ;
 $6719 PUSH BC       ;
 $671A LD B,$03      ;
*$671C LD A,(DE)     ;
 $671D CP (HL)       ;
 $671E JR Z,$6722    ;
 $6720 JR $6727      ;
*$6722 INC DE        ;
 $6723 INC HL        ;
 $6724 DJNZ $671C    ;
 $6726 SCF           ;
*$6727 CCF           ;
 $6728 POP BC        ;
 $6729 POP DE        ;
 $672A POP HL        ;
 $672B RET           ;

; Draw lives/bombs icon rows for a player
;
; Used by the routines at #R$6771 and #R$A189.
;
; A player number (1 or 2)
; IX player struct base
;
; Draws two icon rows via $6751: lives (from IX+3, colour $46) and bombs (from
; IX+9, colour $42), at attribute base $59A0 (player 1) or $59BA (player 2).
c$672C PUSH AF       ;
 $672D CP $01        ;
 $672F LD E,(IX+$09) ;
 $6732 LD IY,$59A0   ;
 $6736 JR Z,$673C    ;
 $6738 LD IY,$59BA   ;
*$673C LD A,(IX+$03) ;
 $673F LD C,$46      ;
 $6741 CALL $6751    ; Draw icon row
 $6744 LD A,E        ;
 $6745 LD DE,$005A   ;
 $6748 ADD IY,DE     ;
 $674A LD C,$42      ;
 $674C CALL $6751    ; Draw icon row
 $674F POP AF        ;
 $6750 RET           ;

; Draw icon row: up to 6 filled cells (colour C), rest blank
;
; Used by the routine at #R$672C.
;
; A icon count x2
; C fill colour
; IY attribute row base
c$6751 ADD A,A       ;
 $6752 LD B,A        ;
 $6753 CP $08        ;
 $6755 JR C,$6759    ;
 $6757 LD B,$06      ;
*$6759 AND A         ;
 $675A LD A,$06      ;
 $675C JR Z,$6769    ;
 $675E SUB B         ;
*$675F LD (IY+$00),C ;
 $6762 LD (IY+$20),C ;
 $6765 INC IY        ;
 $6767 DJNZ $675F    ;
*$6769 LD B,A        ;
 $676A LD C,$00      ;
 $676C AND A         ;
 $676D LD A,C        ;
 $676E JR NZ,$675F   ;
 $6770 RET           ;

; Update player's HUD panel (score + lives/bombs icons)
;
; Used by the routines at #R$6A88, #R$A15F and #R$A773.
;
; A player number (1 or 2)
c$6771 CALL $66DE    ; Print a player's score at its HUD position
 $6774 CALL $672C    ; Draw lives/bombs icon rows for a player
 $6777 RET           ;

; Paint attribute colour-wipe column (menu highlight effect)
;
; Used by the routines at #R$6989, #R$6A6D, #R$A6E5 and #R$A783.
;
; A row/column count (used as both position and loop count B)
; C flags (bit 7: special mode, unconfirmed)
; E screen column
;
; Paints a 2-row-tall column of screen attributes at (row A, col E) with bytes
; from a repeating $FF-terminated sequence at $9CCC, B columns wide, synced to
; HALT and interruptible by fire. Looks like a colour-wipe/highlight-bar effect
; (e.g. for menu selection); exact meaning of the high/low bits of C is
; unconfirmed.
c$6778 LD B,A        ; {B=column count; compute row pixel offset from A
 $6779 SRL A         ;
 $677B NEG           ;
 $677D ADD A,$10     ; }
 $677F LD L,A        ; {start attribute address calc from column E
 $6780 LD A,E        ;
 $6781 RRCA          ;
 $6782 RRCA          ;
 $6783 RRCA          ; }
 $6784 LD H,A        ; {combine row/column bits into attribute address
 $6785 AND $E0       ;
 $6787 OR L          ;
 $6788 LD L,A        ;
 $6789 LD A,H        ;
 $678A AND $1F       ; }
 $678C ADD A,$58     ; {add attribute-memory base, store into IX
 $678E LD H,A        ; }
 $678F PUSH HL       ; {load computed attribute address into IX
 $6790 POP IX        ; }
 $6792 LD DE,$9CCC   ; {DE=pointer into repeating colour sequence;
 $6795 LD HL,$9CDE   ; HL=fire-debounce flag}
*$6798 HALT          ; sync to frame
 $6799 BIT 7,C       ; check special-mode flag in C
 $679B JR NZ,$67A5   ; skip input poll if special mode
 $679D CALL $68B1    ; Read input
 $67A0 LD A,($9CDC)  ; {check fire pressed
 $67A3 OR (HL)       ; }
 $67A4 RET NZ        ; return if fire pressed
*$67A5 HALT          ; sync to frame
 $67A6 LD A,(DE)     ; {read next colour byte, check sequence terminator $FF
 $67A7 INC DE        ;
 $67A8 CP $FF        ; }
 $67AA JR NZ,$67B0   ; skip wrap if not terminated
 $67AC LD DE,$9CCC   ; wrap sequence pointer to start
 $67AF LD A,(DE)     ; reload first colour byte after wrap
*$67B0 PUSH BC       ; {save loop state
 $67B1 PUSH IX       ; }
*$67B3 LD (IX+$00),A ; {paint attribute cell and the cell 4 rows below (32-byte
 $67B6 LD (IX+$20),A ; stride)}
 $67B9 INC IX        ; advance to next column
 $67BB DJNZ $67B3    ; repeat for B columns
 $67BD POP IX        ; {restore loop state
 $67BF POP BC        ; }
 $67C0 LD A,C        ; {mask special-mode flag off C
 $67C1 AND $7F       ; }
 $67C3 RET Z         ;
 $67C4 DEC C         ;
 $67C5 JR $6798      ;

; Redefine keys: prompt for and store each direction/fire key
;
; Used by the routine at #R$6A4A.
;
; .
;
; Loops 5 times (E=$0A..$0E), printing the "FIRE"/"UP"/"DOWN"/"LEFT"/"RIGHT"
; labels via $6648, waiting for a keypress via $6829/$686A (keyboard scan with
; animated highlight), then storing the chosen key's row/mask (B,C) into the
; redefinable-key table at $9CE0 - the same table $68B1 reads when decoding
; keyboard input.
c$67C7 PUSH AF       ;
 $67C8 LD A,$09      ;
 $67CA LD B,$05      ;
 $67CC LD E,A        ;
 $67CD LD HL,$9CE0   ;
*$67D0 PUSH BC       ;
 $67D1 INC E         ;
 $67D2 LD A,E        ;
 $67D3 CALL $6648    ; Print message N from table $627A
 $67D6 LD C,(HL)     ;
 $67D7 INC HL        ;
 $67D8 LD B,(HL)     ;
 $67D9 CALL $67F1    ; Print a redefined key's name
 $67DC CALL $6829    ; Scan keyboard for a keypress
 $67DF CALL $67F1    ; Print a redefined key's name
*$67E2 CALL $686A    ; Copy 16 bytes from wrapping sequence ($9C25) into screen
                     ; at $5A68
 $67E5 JR NC,$67E2   ;
 $67E7 LD (HL),B     ;
 $67E8 DEC HL        ;
 $67E9 LD (HL),C     ;
 $67EA INC HL        ;
 $67EB INC HL        ;
 $67EC POP BC        ;
 $67ED DJNZ $67D0    ;
 $67EF POP AF        ;
 $67F0 RET           ;

; Print a redefined key's name (character or CS/SS/SP/EN)
;
; Used by the routine at #R$67C7.
c$67F1 PUSH AF       ;
 $67F2 PUSH HL       ;
 $67F3 PUSH BC       ;
 $67F4 LD A,$FB      ;
*$67F6 ADD A,$05     ;
 $67F8 RR C          ;
 $67FA JR C,$67F6    ;
 $67FC DEC A         ;
*$67FD INC A         ;
 $67FE RR B          ;
 $6800 JR NC,$67FD   ;
 $6802 LD C,A        ;
 $6803 LD B,$00      ;
 $6805 LD HL,$9CF0   ;
 $6808 ADD HL,BC     ;
 $6809 LD A,(HL)     ;
 $680A LD BC,($9CC7) ;
 $680E CP $04        ;
 $6810 JR NC,$6819   ;
 $6812 ADD A,$06     ; map key-code 0-3 to message $06-$09 (CS/SS/SP/EN)
 $6814 CALL $6648    ; Print message N from table $627A
 $6817 JR $681C      ;
*$6819 CALL $64CC    ; Print character to screen using ROM font
*$681C LD A,$20      ;
 $681E CALL $64CC    ; Print character to screen using ROM font
 $6821 LD ($9CC7),BC ;
 $6825 POP BC        ;
 $6826 POP HL        ;
 $6827 POP AF        ;
 $6828 RET           ;

; Scan keyboard for a keypress (animated wait, debounced)
;
; Used by the routine at #R$67C7.
;
; O:B,C row/mask of the key pressed
c$6829 PUSH AF       ;
 $682A PUSH HL       ;
 $682B PUSH DE       ;
 $682C CALL $6861    ; Reset animated-sequence pointer
*$682F CALL $686A    ; Copy 16 bytes from wrapping sequence ($9C25) into screen
                     ; at $5A68
 $6832 LD HL,$9CEA   ;
 $6835 LD B,$06      ;
*$6837 LD A,(HL)     ;
 $6838 IN A,($FE)    ;
 $683A CPL           ;
 $683B AND $1F       ;
 $683D JR Z,$6846    ;
 $683F LD C,A        ;
*$6840 SRL A         ;
 $6842 JR NC,$6840   ;
 $6844 JR Z,$684B    ;
*$6846 INC HL        ;
 $6847 DJNZ $6837    ;
 $6849 JR $682F      ;
*$684B LD B,C        ;
 $684C LD C,(HL)     ;
*$684D CALL $686A    ; Copy 16 bytes from wrapping sequence ($9C25) into screen
                     ; at $5A68
 $6850 XOR A         ;
 $6851 IN A,($FE)    ;
 $6853 CPL           ;
 $6854 AND $1F       ;
 $6856 JR NZ,$684D   ;
*$6858 CALL $686A    ; Copy 16 bytes from wrapping sequence ($9C25) into screen
                     ; at $5A68
 $685B JR NC,$6858   ;
 $685D POP DE        ;
 $685E POP HL        ;
 $685F POP AF        ;
 $6860 RET           ;

; Reset animated-sequence pointer ($9C25 = $9CCC)
;
; Used by the routine at #R$6829.
c$6861 PUSH HL       ;
 $6862 LD HL,$9CCC   ;
 $6865 LD ($9C25),HL ;
 $6868 POP HL        ;
 $6869 RET           ;

; Copy 16 bytes from wrapping sequence ($9C25) into screen at $5A68
;
; Used by the routines at #R$67C7 and #R$6829.
;
; .
;
; Waits 2 frames, then copies B=16 bytes from the repeating $FF-terminated
; sequence at $9CCC (tracked via pointer $9C25, same source used by $6778's
; colour-wipe effect), wrapping back to the start on the terminator, into a
; fixed screen destination at $5A68.
c$686A HALT          ; {Wait 2 frames
 $686B HALT          ; }
 $686C PUSH BC       ;
 $686D PUSH DE       ;
 $686E PUSH IX       ;
 $6870 LD IX,$5A68   ;
 $6874 LD DE,($9C25) ; DE = sequence cursor ($9C25)
 $6878 LD B,$10      ; Copy 16 bytes
 $687A LD A,(DE)     ;
 $687B INC DE        ;
 $687C CP $FF        ; On $FF terminator, wrap to sequence start
 $687E CCF           ;
 $687F JR NZ,$6885   ;
 $6881 LD DE,$9CCC   ; {Reload cursor to $9CCC
 $6884 LD A,(DE)     ; }
*$6885 LD (IX+$00),A ; {Write byte to two rows ($5A68 and +$20)
 $6888 LD (IX+$20),A ; }
 $688B INC IX        ;
 $688D DJNZ $6885    ;
 $688F LD ($9C25),DE ; Save advanced cursor back to $9C25
 $6893 POP IX        ;
 $6895 POP DE        ;
 $6896 POP BC        ;
 $6897 RET           ;

; Wait N frames
;
; Used by the routine at #R$6989.
;
; A number of frames to wait
c$6898 PUSH BC       ;
 $6899 LD B,A        ; B = frame count
*$689A HALT          ;
 $689B DJNZ $689A    ;
 $689D POP BC        ;
 $689E RET           ;

; Wait up to N frames, exit early on fire
;
; .
;
; A number of frames to wait
c$689F PUSH BC       ;
 $68A0 LD B,A        ;
*$68A1 HALT          ;
 $68A2 CALL $68B1    ; Read input
 $68A5 LD A,($9CDC)  ; {check fire pressed
 $68A8 CP $01        ; }
 $68AA CCF           ;
 $68AB JR C,$68AF    ; exit early if fire pressed
 $68AD DJNZ $68A1    ;
*$68AF POP BC        ;
 $68B0 RET           ;

; Read input (Kempston or keyboard)
;
; Used by the routines at #R$6778, #R$689F, #R$6971, #R$6989 and #R$BE03.
@label=read_input
c$68B1 PUSH AF       ;
 $68B2 PUSH HL       ;
 $68B3 PUSH DE       ;
 $68B4 PUSH BC       ;
 $68B5 LD C,$00      ; {init direction accumulator C=0, loop counter B=5
 $68B7 LD B,$05      ; }
 $68B9 LD HL,$9CE0   ;
; Reads Kempston joystick (port $1F) and keyboard (port $FE) into shift
; register at $9CE0-$9CE1.
*$68BC LD A,(HL)     ;
 $68BD INC HL        ;
 $68BE IN A,($FE)    ;
 $68C0 AND (HL)      ;
 $68C1 CP $01        ; {shift key state bit into C
 $68C3 RL C          ; }
 $68C5 INC HL        ;
 $68C6 DJNZ $68BC    ;
 $68C8 LD HL,$9CDF   ; check Kempston-enabled flag at $9CDF
 $68CB BIT 0,(HL)    ;
 $68CD JR Z,$68D7    ;
 $68CF IN A,($1F)    ; read Kempston joystick
 $68D1 AND $1F       ;
 $68D3 SET 0,(HL)    ; mark Kempston active
 $68D5 JR $691E      ;
*$68D7 LD A,$EF      ; {read CAPS SHIFT+direction keys (port $FE row $EF)
 $68D9 IN A,($FE)    ; }
 $68DB CPL           ;
 $68DC AND $1F       ;
 $68DE LD E,A        ;
 $68DF LD A,$F7      ; read SPACE+redefine keys (port $FE row $F7)
 $68E1 IN A,($FE)    ;
 $68E3 BIT 1,E       ; {skip redefine-toggle if not held
 $68E5 JR NZ,$690B   ; }
 $68E7 BIT 1,(HL)    ;
 $68E9 JR NZ,$690B   ;
*$68EB RES 1,(HL)    ; clear redefine-toggle debounce flag
 $68ED BIT 4,A       ; {fire button from row $EF bit 4
 $68EF JR NZ,$68F3   ; }
 $68F1 SET 1,B       ;
*$68F3 LD A,E        ; {decode direction bits from E into B
 $68F4 RRCA          ;
 $68F5 JR NC,$68F9   ;
 $68F7 SET 4,B       ; }
*$68F9 RRCA          ;
 $68FA RRCA          ;
 $68FB JR NC,$68FE   ;
 $68FD INC B         ;
*$68FE RRCA          ;
 $68FF JR NC,$6903   ;
 $6901 SET 3,B       ;
*$6903 RRCA          ;
 $6904 JR NC,$6908   ;
 $6906 SET 2,B       ;
*$6908 LD A,B        ; {return combined direction+fire byte
 $6909 JR $691E      ; }
*$690B BIT 4,A       ; check fire+redefine combo held
 $690D JR Z,$68EB    ;
 $690F SET 1,(HL)    ; set redefine-toggle debounce flag
 $6911 XOR A         ; {encode redefined-key row into direction bits
 $6912 SRL E         ;
 $6914 RLA           ;
 $6915 SRL E         ;
 $6917 RLA           ;
 $6918 SRL E         ;
 $691A RLA           ;
 $691B RLCA          ;
 $691C RLCA          ;
 $691D OR E          ; }
*$691E OR C          ; {combine keyboard bits with accumulator
 $691F LD C,A        ; }
 $6920 LD HL,$9CDC   ;
 $6923 LD A,(HL)     ;
 $6924 LD E,A        ;
 $6925 INC A         ;
 $6926 BIT 4,C       ;
 $6928 JR NZ,$692B   ;
 $692A XOR A         ;
*$692B LD (HL),A     ;
 $692C RES 4,C       ;
 $692E LD D,A        ;
 $692F XOR A         ;
 $6930 CP D          ;
 $6931 SBC A,A       ;
 $6932 LD D,A        ;
 $6933 XOR A         ;
 $6934 CP E          ;
 $6935 SBC A,A       ;
 $6936 XOR D         ;
 $6937 LD ($9CDD),A  ;
 $693A LD HL,$9CDE   ;
 $693D LD (HL),C     ;
 $693E POP BC        ;
 $693F POP DE        ;
 $6940 POP HL        ;
 $6941 POP AF        ;
 $6942 RET           ;

; Read fire button (Kempston/keyboard) with debounce
;
; Used by the routines at #R$A6BB, #R$A6E5, #R$A8A7 and #R$A94C.
;
; O:Cy fire button pressed
;
; Reads Kempston joystick fire button (port $1F, bit 4) combined with keyboard
; debounce (port $FE); returns pressed state in carry flag.
@label=read_fire
c$6943 PUSH HL       ;
 $6944 PUSH BC       ;
 $6945 LD HL,$9CDF   ; {save and set debounce flag at $9CDF
 $6948 LD C,(HL)     ;
 $6949 SET 0,(HL)    ; }
 $694B IN A,($1F)    ; read Kempston joystick fire
 $694D AND $1F       ;
 $694F CP $10        ;
 $6951 JR Z,$696E    ; skip if Kempston fire not pressed
 $6953 RES 0,(HL)    ; {clear debounce flag, point to keyboard debounce mask
 $6955 LD HL,$9CE0   ; }
 $6958 LD A,(HL)     ;
 $6959 INC HL        ;
 $695A IN A,($FE)    ; read keyboard, compare against debounce mask
 $695C AND (HL)      ;
 $695D JR Z,$696E    ; skip if key not held
 $695F LD A,$EF      ; {read keyboard row $EF (SPACE bar)
 $6961 IN A,($FE)    ; }
 $6963 RRA           ;
 $6964 JR NC,$696E   ;
 $6966 LD HL,$9CDF   ; restore debounce flag if fire release confirmed
 $6969 LD (HL),C     ;
 $696A AND A         ;
*$696B POP BC        ;
 $696C POP HL        ;
 $696D RET           ;
*$696E SCF           ;
 $696F JR $696B      ;

; Wait for input (debounced, up to 3 frames)
;
; Used by the routines at #R$6989, #R$A773 and #R$A8C0.
c$6971 PUSH AF       ;
 $6972 PUSH HL       ;
 $6973 PUSH BC       ;
 $6974 LD HL,$9CDE   ;
*$6977 LD B,$03      ;
*$6979 HALT          ;
 $697A CALL $68B1    ; Read input
 $697D LD A,($9CDC)  ;
 $6980 OR (HL)       ;
 $6981 JR NZ,$6977   ;
 $6983 DJNZ $6979    ;
 $6985 POP BC        ;
 $6986 POP HL        ;
 $6987 POP AF        ;
 $6988 RET           ;

; Check for new high score, congratulate and reset defaults if so
;
; Used by the routine at #R$A783.
;
; .
;
; Waits for input, then compares the score's initials (via IX/$9C77) against
; each entry of the high-score name table ($6240) using $6717. On the first
; mismatch it prints the "CONGRATULATIONS!" message ($05) and copies fresh
; default name/score data back over the table (from $6272). If every entry
; matches, it just returns. Exact match/mismatch semantics not fully verified
; against live play.
c$6989 CALL $6971    ; Wait for input
 $698C LD HL,($9C77) ;
 $698F PUSH HL       ;
 $6990 POP IX        ;
 $6992 LD DE,$0000   ;
 $6995 ADD HL,DE     ;
 $6996 EX DE,HL      ;
 $6997 LD HL,$6240   ;
 $699A LD B,$06      ;
*$699C CALL $6717    ; Compare 3 bytes at (DE) vs
 $699F JR C,$69AA    ;
 $69A1 PUSH BC       ;
 $69A2 LD BC,$000B   ;
 $69A5 ADD HL,BC     ;
 $69A6 POP BC        ;
 $69A7 DJNZ $699C    ;
 $69A9 RET           ;
*$69AA PUSH HL       ;
 $69AB PUSH DE       ;
 $69AC LD A,$05      ; "CONGRATULATIONS!...A GREAT SCORE...???"
 $69AE CALL $6648    ; Print message N from table $627A
 $69B1 LD DE,$0000   ;
 $69B4 LD HL,$6272   ;
*$69B7 PUSH HL       ;
 $69B8 PUSH BC       ;
 $69B9 LD BC,$0008   ;
 $69BC LDIR          ;
 $69BE POP BC        ;
 $69BF POP DE        ;
 $69C0 LD HL,$FFF5   ;
 $69C3 ADD HL,DE     ;
 $69C4 DJNZ $69B7    ;
 $69C6 POP HL        ;
 $69C7 POP DE        ;
 $69C8 LD BC,$0003   ;
 $69CB LDIR          ;
 $69CD LD HL,$FFF8   ;
 $69D0 ADD HL,DE     ;
 $69D1 LD IX,$59CE   ;
 $69D5 LD IY,$9CC4   ;
 $69D9 LD B,$03      ;
*$69DB PUSH BC       ;
 $69DC LD C,(IY+$00) ;
 $69DF EX AF,AF'     ;
 $69E0 LD A,$64      ;
 $69E2 EX AF,AF'     ;
*$69E3 LD ($9CC7),IX ;
 $69E7 LD A,C        ;
 $69E8 CALL $64CC    ; Print character to screen using ROM font
 $69EB CALL $68B1    ; Read input
 $69EE LD A,($9CDC)  ;
 $69F1 AND A         ;
 $69F2 JR NZ,$6A2C   ;
 $69F4 LD A,$05      ;
 $69F6 CALL $6898    ; Wait N frames
 $69F9 EX AF,AF'     ;
 $69FA DEC A         ;
 $69FB JR Z,$6A2C    ;
 $69FD EX AF,AF'     ;
 $69FE LD A,($9CDE)  ;
 $6A01 LD E,A        ;
 $6A02 AND $0C       ;
 $6A04 JR Z,$6A08    ;
 $6A06 XOR $0C       ;
*$6A08 RRCA          ;
 $6A09 RRCA          ;
 $6A0A OR E          ;
 $6A0B AND $03       ;
 $6A0D JR Z,$6A13    ;
 $6A0F EX AF,AF'     ;
 $6A10 LD A,$64      ;
 $6A12 EX AF,AF'     ;
*$6A13 LD E,A        ;
 $6A14 LD A,C        ;
 $6A15 RR E          ;
 $6A17 ADC A,$00     ;
 $6A19 RR E          ;
 $6A1B SBC A,$00     ;
 $6A1D CP $5B        ;
 $6A1F LD C,$41      ;
 $6A21 JR Z,$6A2A    ;
 $6A23 CP $40        ;
 $6A25 LD C,$5A      ;
 $6A27 JR Z,$6A2A    ;
 $6A29 LD C,A        ;
*$6A2A JR $69E3      ;
*$6A2C LD (HL),C     ;
 $6A2D LD (IY+$00),C ;
 $6A30 INC IY        ;
 $6A32 INC HL        ;
 $6A33 CALL $6971    ; Wait for input
 $6A36 INC IX        ;
 $6A38 POP BC        ;
 $6A39 DJNZ $69DB    ;
 $6A3B LD A,$02      ;
 $6A3D CALL $A927    ; Start playing music track A
 $6A40 LD A,$04      ;
 $6A42 LD E,$0E      ;
 $6A44 LD C,$10      ;
 $6A46 CALL $6778    ; Paint attribute colour-wipe column
 $6A49 RET           ;

; Main menu key dispatcher (1P/2P select, redefine keys)
;
; Used by the routine at #R$A94C.
;
; .
;
; Guarded by re-entrancy flag $9C29 (set by $A927). Reads keyboard row $F7
; (SPACE/SYM SHIFT/M/N/B) and dispatches by bit: bit 0 -> $6A6D (select player
; 1), bit 1 -> $6A72 (select player 2), bit 2 -> $67C7 (redefine keys menu).
c$6A4A LD A,($9C29)  ;
 $6A4D AND A         ;
 $6A4E RET NZ        ;
 $6A4F EI            ;
 $6A50 PUSH HL       ;
 $6A51 PUSH DE       ;
 $6A52 PUSH BC       ;
 $6A53 LD A,$F7      ; {read keyboard row $F7
 $6A55 IN A,($FE)    ; }
 $6A57 CPL           ;
 $6A58 RRA           ;
 $6A59 CALL C,$6A6D  ; Print "PLAYER 1"/"PLAYER 2" turn indicator
 $6A5C JR C,$6A68    ;
 $6A5E RRA           ;
 $6A5F CALL C,$6A72  ;
 $6A62 JR C,$6A68    ;
 $6A64 RRA           ;
 $6A65 CALL C,$67C7  ; Redefine keys
*$6A68 POP BC        ;
 $6A69 POP DE        ;
 $6A6A POP HL        ;
 $6A6B DI            ;
 $6A6C RET           ;

; Print "PLAYER 1"/"PLAYER 2" turn indicator
;
; Used by the routine at #R$6A4A.
c$6A6D PUSH AF       ; {entry: set player number to 1
 $6A6E LD A,$01      ;
 $6A70 JR $6A75      ; }
; This entry point is used by the routine at #R$6A4A.
*$6A72 PUSH AF       ; {entry: set player number to 2
 $6A73 LD A,$02      ; }
*$6A75 LD ($9C75),A  ; store player number at $9C75
 $6A78 ADD A,$0E     ; map player number to message $0F/$10 ("1 PLAYER"/"2
                     ; PLAYERS")
 $6A7A CALL $6648    ; Print message N from table $627A
 $6A7D LD A,$0A      ;
 $6A7F LD C,$40      ;
 $6A81 LD E,$13      ;
 $6A83 CALL $6778    ; Paint attribute colour-wipe column
 $6A86 POP AF        ;
 $6A87 RET           ;

; Show credits screen: highlight active player, update HUD, wipe out
;
; Used by the routine at #R$A612.
;
; .
;
; Inits state, prints "PLAYER ONE"/"PLAYER TWO" and draws the credits box
; ($6AD4), colours the active player's border white (C=$07, chosen via $9C76),
; updates both players' HUD panels via $6771, then transitions out with the
; $C6A6 wipe.
c$6A88 LD A,$FF      ;
 $6A8A LD ($9C5D),A  ;
 $6A8D LD HL,$9C67   ;
 $6A90 LD ($9C5B),HL ;
 $6A93 DI            ;
 $6A94 CALL $C84C    ; Build wrapped scroll-window row into $F6D1 buffer
 $6A97 CALL $AC8D    ;
 $6A9A CALL $C772    ;
 $6A9D EI            ;
 $6A9E HALT          ;
 $6A9F LD A,$03      ; "PLAYER ONE"/"PLAYER TWO" (credits screen)
 $6AA1 CALL $6648    ; Print message N from table $627A
 $6AA4 CALL $6AD4    ; Draw both players' panel borders
 $6AA7 LD A,($9C76)  ;
 $6AAA LD HL,$58C4   ;
 $6AAD LD DE,$58DA   ;
 $6AB0 DEC A         ;
 $6AB1 JR Z,$6AB4    ;
 $6AB3 EX DE,HL      ;
*$6AB4 LD C,$07      ;
*$6AB6 LD (HL),C     ;
 $6AB7 INC L         ;
 $6AB8 LD (HL),C     ;
 $6AB9 LD A,L        ;
 $6ABA ADD A,$1F     ;
 $6ABC LD L,A        ;
 $6ABD LD (HL),C     ;
 $6ABE INC L         ;
 $6ABF LD (HL),C     ;
 $6AC0 EX DE,HL      ;
 $6AC1 LD A,C        ;
 $6AC2 LD C,$00      ;
 $6AC4 AND A         ;
 $6AC5 JR NZ,$6AB6   ;
 $6AC7 LD A,$01      ;
 $6AC9 CALL $6771    ; Update player's HUD panel
 $6ACC INC A         ;
 $6ACD CALL $6771    ; Update player's HUD panel
 $6AD0 CALL $C6A6    ; Screen wipe transition effect
 $6AD3 RET           ;

; Draw both players' panel borders
;
; Used by the routines at #R$6498 and #R$6A88.
;
; .
;
; Draws a 3-cell border segment for player 1 (bitmap $6CD1 at $59A0, via
; $6AF4), two single corner-cap boxes ($58C4/$58DA), then a 3-cell border
; segment for player 2 (bitmap $6CF1 at $5A00).
c$6AD4 LD DE,$6CD1   ;
 $6AD7 LD HL,$59A0   ;
 $6ADA CALL $6AF4    ; Draw a 3-cell border segment
 $6ADD XOR A         ;
 $6ADE LD HL,$58C4   ;
 $6AE1 CALL $6B09    ; Draw bordered box graphic (colour + bitmap) at HL
 $6AE4 XOR A         ;
 $6AE5 LD L,$DA      ;
 $6AE7 CALL $6B09    ; Draw bordered box graphic (colour + bitmap) at HL
 $6AEA LD DE,$6CF1   ;
 $6AED LD HL,$5A00   ;
 $6AF0 CALL $6AF4    ; Draw a 3-cell border segment
 $6AF3 RET           ;

; Draw a 3-cell border segment
;
; Used by the routine at #R$6AD4.
;
; DE bitmap data pointer
; HL attribute base
c$6AF4 LD B,$03      ;
*$6AF6 XOR A         ;
 $6AF7 CALL $6B09    ; Draw bordered box graphic (colour + bitmap) at HL
 $6AFA DJNZ $6AF6    ;
 $6AFC LD A,L        ;
 $6AFD ADD A,$14     ;
 $6AFF LD L,A        ;
 $6B00 LD B,$03      ;
*$6B02 XOR A         ;
 $6B03 CALL $6B09    ; Draw bordered box graphic (colour + bitmap) at HL
 $6B06 DJNZ $6B02    ;
 $6B08 RET           ;

; Draw bordered box graphic (colour + bitmap) at HL
;
; Used by the routines at #R$6AD4, #R$6AF4 and #R$A802.
;
; A attribute colour
; HL attribute-memory address (top-left of the box)
; DE pointer to 32-byte bitmap data (4 columns x 8 rows)
;
; Fills a 2x2 attribute cell block with colour A, converts that attribute
; address to the corresponding pixel address, then copies an 8-byte-tall bitmap
; column from DE into it. Repeats for 4 character columns, alternating between
; the top and bottom row of the block (BIT 0,C) and stepping to the next
; attribute row pair every 2 columns (+$22 to L). Used to draw small bordered
; graphics/tiles (e.g. UI boxes) at a fixed screen position.
c$6B09 PUSH BC       ; {save registers
 $6B0A PUSH DE       ;
 $6B0B PUSH HL       ; }
 $6B0C LD (HL),A     ; {fill attribute pair (top row)
 $6B0D INC L         ;
 $6B0E LD (HL),A     ; }
 $6B0F LD BC,$001F   ; {move down one attribute row, fill pair (bottom row)
 $6B12 ADD HL,BC     ;
 $6B13 LD (HL),A     ;
 $6B14 INC L         ;
 $6B15 LD (HL),A     ; }
 $6B16 POP HL        ; {restore original HL, keep a copy
 $6B17 PUSH HL       ; }
 $6B18 LD A,H        ; {convert attribute row to pixel-address row; advance
 $6B19 ADD A,A       ; column
 $6B1A ADD A,A       ;
 $6B1B ADD A,A       ;
 $6B1C AND $7F       ;
 $6B1E LD H,A        ;
 $6B1F INC L         ; }
 $6B20 LD C,$04      ; 4 columns to draw
*$6B22 PUSH HL       ; {save column pointer; 8 pixel rows
 $6B23 LD B,$08      ; }
*$6B25 LD A,(DE)     ; {copy 8 bitmap bytes from DE into this pixel column
 $6B26 INC DE        ;
 $6B27 LD (HL),A     ;
 $6B28 INC H         ;
 $6B29 DJNZ $6B25    ; }
 $6B2B POP HL        ; {restore column pointer, move to previous attribute
 $6B2C DEC L         ; column; exit if done
 $6B2D DEC C         ;
 $6B2E JR Z,$6B3A    ; }
 $6B30 BIT 0,C       ; {continue same character row if column count odd
 $6B32 JR NZ,$6B22   ; }
 $6B34 LD A,L        ; {move to next character row pair, loop
 $6B35 ADD A,$22     ;
 $6B37 LD L,A        ;
 $6B38 JR $6B22      ; }
*$6B3A POP HL        ; {restore registers, advance HL past the box
 $6B3B POP DE        ;
 $6B3C POP BC        ;
 $6B3D INC L         ;
 $6B3E INC L         ; }
 $6B3F RET           ; return

