; Used by the routine at #R$FDFD.
;
; .
;
; Live-traced: this is the active per-frame handler right after pressing "1" to
; start. Which game phase uses this vs $A0C4 is not yet confirmed.
c$A0B0 PUSH AF       ;
 $A0B1 PUSH HL       ;
 $A0B2 LD HL,$9BA2   ;
 $A0B5 SET 7,(HL)    ;
 $A0B7 LD HL,$9BA0   ;
 $A0BA INC (HL)      ;
 $A0BB LD HL,$A1BB   ;
 $A0BE LD (HL),$7F   ;
 $A0C0 POP HL        ;
 $A0C1 POP AF        ;
 $A0C2 EI            ;
 $A0C3 RET           ;

; Interrupt handler (heavy): saves shadow regs, dispatches
; enemy/player/collision/sprite updates
c$A0C4 PUSH AF       ;
 $A0C5 PUSH HL       ;
 $A0C6 PUSH DE       ;
 $A0C7 PUSH BC       ;
 $A0C8 EX AF,AF'     ;
 $A0C9 EXX           ;
 $A0CA PUSH AF       ;
 $A0CB PUSH HL       ;
 $A0CC PUSH DE       ;
 $A0CD PUSH BC       ;
 $A0CE PUSH IX       ;
 $A0D0 PUSH IY       ;
 $A0D2 LD HL,$9BA2   ;
 $A0D5 SET 7,(HL)    ;
 $A0D7 LD HL,$9BA0   ;
 $A0DA INC (HL)      ;
 $A0DB INC HL        ;
 $A0DC RLC (HL)      ;
 $A0DE LD HL,$A1BB   ;
 $A0E1 LD (HL),$7F   ;
 $A0E3 LD HL,($9C35) ;
 $A0E6 ADD HL,HL     ;
 $A0E7 LD ($9C35),HL ;
 $A0EA SBC A,A       ;
 $A0EB LD ($9C34),A  ;
 $A0EE LD HL,($9C39) ;
 $A0F1 ADD HL,HL     ;
 $A0F2 LD ($9C39),HL ;
 $A0F5 SBC A,A       ;
 $A0F6 LD ($9C38),A  ;
 $A0F9 LD A,$08      ;
*$A0FB LD B,$0F      ;
*$A0FD DJNZ $A0FD    ;
 $A0FF AND $FF       ;
 $A101 INC HL        ;
 $A102 DEC A         ;
 $A103 JP NZ,$A0FB   ;
 $A106 CALL $C72A    ; Animate active player's indicator box colour
 $A109 CALL $BBE5    ; Mark active objects into the attribute-buffer collision
                     ; mask
 $A10C CALL $BCE9    ; Draw active objects' collision masks into attribute
                     ; buffer
 $A10F CALL $BBC2    ; Clear buffers at $7F00-$7FFF and $8000-$80FF
 $A112 CALL $C772    ;
 $A115 CALL $C680    ; Scroll background
 $A118 CALL $C8B8    ;
 $A11B CALL $C84C    ; Build wrapped scroll-window row into $F6D1 buffer
 $A11E CALL $C9AF    ; Advance enemy timeline
 $A121 CALL $BD99    ; Update randomized countdown, then enter player update
 $A124 CALL $AC8D    ;
 $A127 CALL $A561    ; Player respawn/continue state check
 $A12A POP IY        ;
 $A12C POP IX        ;
 $A12E POP BC        ;
 $A12F POP DE        ;
 $A130 POP HL        ;
 $A131 POP AF        ;
 $A132 EXX           ;
 $A133 EX AF,AF'     ;
 $A134 POP BC        ;
 $A135 POP DE        ;
 $A136 POP HL        ;
 $A137 POP AF        ;
 $A138 EI            ;
 $A139 RET           ;

; Dispatch highest-priority pending deferred event
;
; Used by the routines at #R$A255 and #R$A8C0.
;
; .
;
; Reads a pending-events bitmask ($9C27) masked by an enable/priority mask
; ($9C28); if any bit survives, finds the lowest-numbered set bit (highest
; priority), clears it from $9C27, and dispatches the corresponding handler via
; the $A042 sub-range of the shared $A000 jump table. $9C27's bits are set from
; several places for different deferred actions - bit 1 is "score changed,
; redraw HUD" (set by $66B5), bit 0 by $A1EA, bit 2 by $A8CF/$BF57/$C33B/$C373,
; bit 3 by $C8C9 - so this is a general deferred-event dispatcher, not
; sound-specific (despite looping through $A222's tone generator via $A255).
c$A13A LD HL,$9C28   ;
 $A13D LD A,($9C27)  ;
 $A140 AND (HL)      ;
 $A141 RET Z         ;
 $A142 LD B,(HL)     ;
 $A143 PUSH BC       ;
 $A144 LD B,$FF      ;
 $A146 LD C,A        ;
 $A147 LD A,B        ;
*$A148 INC B         ;
 $A149 RRA           ;
 $A14A CP C          ;
 $A14B JR NC,$A148   ;
 $A14D AND C         ;
 $A14E LD ($9C27),A  ;
 $A151 LD A,B        ;
 $A152 LD HL,$A042   ;
 $A155 CALL $B7F6    ; Jump-table dispatcher
 $A158 POP AF        ;
 $A159 LD ($9C28),A  ;
 $A15C SCF           ;
 $A15D RET           ;

; Routine at A15E
;
; .
;
; .
;
; Handler for indices $21, $22, $23, $24 of the $A000 jump table (see $B7F6).
c$A15E RET           ;

; Routine at A15F
;
; .
;
; .
;
; Handler for index $26 of the $A000 jump table (see $B7F6).
c$A15F LD HL,$9C28   ;
 $A162 LD A,$80      ;
 $A164 AND (HL)      ;
 $A165 LD (HL),A     ;
 $A166 LD A,($9C76)  ;
 $A169 CALL $6771    ; Update player's HUD panel
 $A16C RET           ;

; Routine at A16D
;
; .
;
; .
;
; Handler for index $28 of the $A000 jump table (see $B7F6).
c$A16D LD HL,$9C28   ;
 $A170 LD A,$FE      ;
 $A172 AND (HL)      ;
 $A173 LD (HL),A     ;
 $A174 CALL $A1F2    ; Load parameters for the pending sound effect
 $A177 RET           ;

; Routine at A178
;
; .
;
; .
;
; Handler for index $27 of the $A000 jump table (see $B7F6).
c$A178 LD HL,$9C28   ;
 $A17B LD A,$80      ;
 $A17D AND (HL)      ;
 $A17E LD (HL),A     ;
 $A17F LD A,($9C76)  ;
 $A182 CALL $66DE    ; Print a player's score at its HUD position
 $A185 CALL $A189    ; Award bonus life when score threshold reached
 $A188 RET           ;

; Award bonus life when score threshold reached
;
; Used by the routines at #R$A178 and #R$A802.
;
; .
;
; Compares a progress value (IX+0) against a threshold table at $9CB8 (indexed
; by IX+4); if not yet crossed, returns. Otherwise advances the threshold index
; (IX+4) and, unless lives are already at the cap of 10 (IX+3), grants an extra
; life and redraws the lives/bombs icon row via $672C.
c$A189 LD IX,($9C77) ;
 $A18D LD E,(IX+$04) ;
 $A190 LD D,$00      ;
 $A192 LD HL,$9CB8   ;
 $A195 ADD HL,DE     ;
 $A196 LD A,(IX+$00) ;
 $A199 CP (HL)       ;
 $A19A RET C         ;
 $A19B INC (IX+$04)  ;
 $A19E LD A,(IX+$03) ;
 $A1A1 CP $0A        ;
 $A1A3 RET Z         ;
 $A1A4 INC A         ;
 $A1A5 LD (IX+$03),A ;
 $A1A8 LD A,($9C76)  ;
 $A1AB CALL $672C    ; Draw lives/bombs icon rows for a player
 $A1AE RET           ;

; Restrict event mask to bit 7, run scenery script
;
; .
;
; .
;
; Handler for index $25 of the $A000 jump table (see $B7F6).
; .
; Masks the deferred-event enable mask ($9C28) down to just bit 7 (only the
; highest-priority event class stays enabled), then runs the scenery/event
; script interpreter ($A3A0). Likely used during a state where only critical
; events (e.g. game-over) may interrupt while background scenery keeps
; animating.
c$A1AF LD HL,$9C28   ;
 $A1B2 LD A,$80      ;
 $A1B4 AND (HL)      ;
 $A1B5 LD (HL),A     ;
 $A1B6 CALL $A3A0    ; Scenery/event script interpreter
 $A1B9 RET           ;

; Data block at A1BA
b$A1BA DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $A1C2 DEFB $00,$00,$00,$00,$00,$00

; Clear pending sound-effect priority
;
; Used by the routine at #R$A8C0.
c$A1C8 LD HL,$A1BA   ;
 $A1CB LD (HL),$00   ;
 $A1CD RET           ;

; Request sound effect at maximum priority
;
; Used by the routines at #R$A589 and #R$A8A7.
c$A1CE LD A,$F0      ;
 $A1D0 CALL $A1D4    ; Request sound effect if higher priority than current
 $A1D3 RET           ;

; Request sound effect if higher priority than current
;
; Used by the routines at #R$A1CE and #R$BF42.
;
; A effect priority (high nibble)
;
; Compares the high nibble of A against the currently pending effect's priority
; (stored at ($A1BA)); if A's priority is >= the current one, updates it, marks
; ($A1BB)=$80, and sets bit 0 of $9C27 to request dispatch via $A13A/$A222.
c$A1D4 PUSH HL       ;
 $A1D5 PUSH BC       ;
 $A1D6 LD HL,$A1BA   ;
 $A1D9 LD C,A        ;
 $A1DA LD A,(HL)     ;
 $A1DB AND $F0       ; {Mask current pending priority (high nibble)
 $A1DD LD B,A        ; }
 $A1DE LD A,C        ;
 $A1DF AND $F0       ; Mask new request's priority (high nibble)
 $A1E1 CP B          ;
 $A1E2 JR C,$A1EF    ; Skip if new priority is lower
 $A1E4 LD (HL),C     ; Store new priority as pending
 $A1E5 LD A,$80      ; {Mark ready flag $A1BB=$80
 $A1E7 LD ($A1BB),A  ; }
 $A1EA LD HL,$9C27   ; {Request dispatch via $9C27 bit 0
 $A1ED SET 0,(HL)    ; }
*$A1EF POP BC        ;
 $A1F0 POP HL        ;
 $A1F1 RET           ;

; Load parameters for the pending sound effect
;
; Used by the routines at #R$A16D and #R$A255.
;
; .
;
; Reads the pending sound-effect priority (low nibble of $A1BA, set by $A1D4);
; if zero, jumps to the idle path ($A324). Otherwise indexes an 8-byte-stride
; parameter table at $A329 by (priority-1), copies 7 bytes into a working
; buffer at $A1BC, and unpacks further fields from it via nibble/bit
; extraction. Continues the sound-effect pipeline started by $A1CE/$A1D4/$A13A.
c$A1F2 LD A,($A1BA)  ;
 $A1F5 AND $0F       ; {Check priority nibble; jump to idle if zero
 $A1F7 JP Z,$A324    ; }
 $A1FA DEC A         ; {(priority-1)*8 -> byte offset into $A329 table
 $A1FB RLCA          ;
 $A1FC RLCA          ;
 $A1FD RLCA          ; }
 $A1FE LD E,A        ;
 $A1FF LD D,$00      ;
 $A201 LD HL,$A329   ; {Point HL at this priority's 8-byte parameter entry
 $A204 ADD HL,DE     ; }
 $A205 LD DE,$A1BC   ;
 $A208 LD BC,$0007   ; {Copy first 7 bytes into working buffer $A1BC
 $A20B LDIR          ; }
 $A20D LD A,(HL)     ; {Low nibble of 8th byte -> extra field
 $A20E AND $0F       ;
 $A210 LD (DE),A     ; }
 $A211 INC DE        ;
 $A212 XOR (HL)      ; {Combine+rotate for second extra field (high nibble)
 $A213 RRCA          ;
 $A214 RRCA          ;
 $A215 RRCA          ;
 $A216 RRCA          ;
 $A217 LD (DE),A     ; }
 $A218 LD HL,$A1C2   ; {C = last copied parameter byte
 $A21B LD C,(HL)     ; }
 $A21C LD HL,$A1C5   ; {HL -> tone-length source; A = first parameter byte
 $A21F LD A,($A1BC)  ; }

; Play sound effect (timed speaker-bit toggle)
;
; .
;
; .
;
; Alternates the value written to port $FE between $18 and $00 (toggling bit 4,
; the speaker/EAR bit, along with border colour bits) inside a precisely
; NOP-counted delay loop - a square-wave tone generator, same technique as the
; $AA0F/$AA34 music engine but used here for a sound effect rather than music.
; Exact trigger context not confirmed.
c$A222 LD (HL),A     ;
 $A223 INC HL        ;
 $A224 LD A,($A1BE)  ;
 $A227 LD (HL),A     ;
 $A228 LD A,($A1C3)  ; {Copy $A1C3 into $A1C7 (setup source pointer)
 $A22B LD ($A1C7),A  ; }
 $A22E BIT 7,C       ; Select tone-length source via C bit 7
 $A230 EXX           ;
 $A231 LD HL,$A1C5   ;
 $A234 LD E,L        ;
 $A235 LD D,H        ;
 $A236 JR Z,$A23B    ; Pick $A1C5 vs $A1C6 pointer variant
 $A238 LD DE,$A1C6   ;
*$A23B EXX           ;
 $A23C LD B,$01      ;
; This entry point is used by the routines at #R$A255 and #R$A31D.
*$A23E EXX           ;
 $A23F LD C,$02      ;
 $A241 LD A,$18      ; A=$18: toggle-on value (border+speaker bit)
*$A243 LD B,(HL)     ;
 $A244 OUT ($FE),A   ; Write toggle value to port $FE
*$A246 NOP           ;
 $A247 NOP           ;
 $A248 NOP           ;
 $A249 DJNZ $A246    ; Hold half-cycle for B ticks (NOP-counted delay)
 $A24B EX DE,HL      ; Swap duration-source pointer for next half-cycle
 $A24C LD A,$00      ;
 $A24E DEC C         ; {Loop 2 half-cycles (one full square-wave period)
 $A24F JR NZ,$A243   ; }
 $A251 EXX           ;
 $A252 LD A,($A1BB)  ;

; Between-segment handler for the sound-effect player
;
; .
;
; .
;
; Called between tone segments of $A222's player when $A1BB (segment-remaining
; counter) is nonzero. Dispatches other pending deferred events via $A13A (same
; "poll between beats" pattern as the music engine's $A94C), then checks a
; completion marker: if it equals $80, reloads a new pending sound effect via
; $A1F2; otherwise continues the current effect's tone loop.
c$A255 AND A         ;
 $A256 JR Z,$A23E    ; If no segments remain, resume tone loop ($A23E)
 $A258 PUSH BC       ;
 $A259 EXX           ;
 $A25A PUSH HL       ;
 $A25B PUSH DE       ;
 $A25C CALL $A13A    ; Dispatch highest-priority pending deferred event
 $A25F POP DE        ;
 $A260 POP HL        ;
 $A261 EXX           ;
 $A262 POP BC        ;
 $A263 LD HL,$A1BB   ; {Read and clear completion marker $A1BB
 $A266 LD A,(HL)     ;
 $A267 LD (HL),$00   ; }
 $A269 CP $80        ; {Marker $80: effect done, load next effect ($A1F2)
 $A26B JR Z,$A1F2    ; }
 $A26D BIT 7,C       ; Mode bit (C bit 7) selects which delta pair to apply
 $A26F JR Z,$A281    ;
 $A271 LD HL,$A1C5   ;
 $A274 LD A,($A1BD)  ;
 $A277 ADD A,(HL)    ;
 $A278 LD (HL),A     ;
 $A279 INC HL        ;
 $A27A LD A,($A1BF)  ;
 $A27D ADD A,(HL)    ;
 $A27E LD (HL),A     ;
 $A27F JR $A293      ;
*$A281 LD HL,$A1C5   ;
 $A284 LD A,($A1BD)  ;
 $A287 BIT 0,B       ;
 $A289 JR NZ,$A291   ;
 $A28B LD HL,$A1C6   ;
 $A28E LD A,($A1BF)  ;
*$A291 ADD A,(HL)    ;
 $A292 LD (HL),A     ;
*$A293 LD HL,$A1C7   ; {Decrement segment counter; resume tone loop if more
 $A296 DEC (HL)      ; remain
 $A297 JR NZ,$A23E   ; }
 $A299 LD HL,$A1C1   ;
 $A29C DEC (HL)      ; {Decrement repeat count; idle ($A324) when it hits zero
 $A29D JP Z,$A324    ; }
 $A2A0 LD HL,$A1C0   ;
 $A2A3 LD E,(HL)     ;
 $A2A4 LD HL,$A1BD   ;
 $A2A7 LD A,(HL)     ;
 $A2A8 ADD A,E       ;
 $A2A9 LD (HL),A     ;
 $A2AA LD HL,$A1BF   ;
 $A2AD LD A,(HL)     ;
 $A2AE ADD A,E       ;
 $A2AF LD (HL),A     ;
 $A2B0 BIT 5,C       ; C bit 5: toggle the $A1C3 sub-counter
 $A2B2 JR Z,$A2BC    ;
 $A2B4 LD HL,$A1C3   ;
 $A2B7 DEC (HL)      ;
 $A2B8 JR NZ,$A2BC   ;
 $A2BA LD (HL),$01   ;
*$A2BC BIT 3,C       ; C bit 3: negate pitch delta ($A1BD) - sweep reversal
 $A2BE JR Z,$A2CF    ;
 $A2C0 BIT 7,C       ;
 $A2C2 JR NZ,$A2C8   ;
 $A2C4 BIT 0,B       ;
 $A2C6 JR Z,$A2CF    ;
*$A2C8 LD HL,$A1BD   ;
 $A2CB LD A,(HL)     ;
 $A2CC NEG           ;
 $A2CE LD (HL),A     ;
*$A2CF BIT 4,C       ; C bit 4: negate duration delta ($A1BF) - sweep reversal
 $A2D1 JR Z,$A2E2    ;
 $A2D3 BIT 7,C       ;
 $A2D5 JR NZ,$A2DB   ;
 $A2D7 BIT 0,B       ;
 $A2D9 JR NZ,$A2E2   ;
*$A2DB LD HL,$A1BF   ;
 $A2DE LD A,(HL)     ;
 $A2DF NEG           ;
 $A2E1 LD (HL),A     ;
*$A2E2 BIT 6,C       ; C bit 6: reload base pitch/duration from $A1BC/$A1BE
 $A2E4 JR Z,$A2F2    ;
 $A2E6 LD HL,$A1C5   ;
 $A2E9 LD A,($A1BC)  ;
 $A2EC LD (HL),A     ;
 $A2ED INC HL        ;
 $A2EE LD A,($A1BE)  ;
 $A2F1 LD (HL),A     ;
*$A2F2 EXX           ;
 $A2F3 LD HL,$A1C5   ;
 $A2F6 LD DE,$A1C6   ;
 $A2F9 LD A,($A1C3)  ;
 $A2FC EXX           ;
 $A2FD BIT 7,C       ;
 $A2FF JR NZ,$A31E   ;
 $A301 LD A,($A1C1)  ;
 $A304 LD B,C        ;
 $A305 SRL A         ;
 $A307 JR NC,$A30F   ;
 $A309 JR NZ,$A30D   ;
 $A30B RR B          ;
*$A30D RR B          ;
*$A30F BIT 0,B       ;
 $A311 EXX           ;
 $A312 LD A,($A1C3)  ;
 $A315 JR NZ,$A31B   ;
 $A317 EX DE,HL      ;
 $A318 LD A,($A1C4)  ;
*$A31B LD E,L        ;
 $A31C LD D,H        ;

; Sound-effect helper entry points, ending in priority-clear idle path
;
; .
;
; .
;
; Entry $A31E stores A into $A1C7 then jumps back into $A222's border loop
; ($A23E). Entry $A324 (used by both $A1F2 and $A255) clears the pending
; sound-effect priority ($A1BA) and returns - the "no sound active" idle state.
; The bytes right after ($A329 onward) are the 8-byte-stride parameter table
; indexed by $A1F2.
c$A31D EXX           ;
; This entry point is used by the routine at #R$A255.
*$A31E LD ($A1C7),A  ;
 $A321 JP $A23E      ;
; This entry point is used by the routines at #R$A1F2 and #R$A255.
*$A324 XOR A         ;
 $A325 LD ($A1BA),A  ;
 $A328 RET           ;

; Sound-effect parameter table (9 entries, 8 bytes each)
b$A329 DEFB $70,$FE,$F1,$01,$00,$03,$04,$23
 $A331 DEFB $10,$06,$20,$00,$00,$08,$07,$04
 $A339 DEFB $20,$06,$20,$00,$00,$08,$07,$04
 $A341 DEFB $30,$06,$20,$00,$00,$08,$07,$04
 $A349 DEFB $40,$06,$20,$00,$00,$08,$07,$04
 $A351 DEFB $B0,$00,$00,$FC,$FF,$07,$88,$55
 $A359 DEFB $A0,$F8,$70,$FE,$FC,$0D,$45,$44
 $A361 DEFB $70,$08,$50,$FA,$00,$05,$14,$13
 $A369 DEFB $70,$08,$50,$FA,$00,$08,$15,$13

; Reset various state pointers/counters to defaults
;
; Used by the routine at #R$A4E7.
;
; .
;
; Resets $9BAD=$1C, $9BA9/$9BAB=$7D00 (the system-init routine, used here as a
; sentinel/default value rather than being called), $9BAE/$9C00/$9BF8=0,
; $9BF9=$FA79 (the menu fill-buffer target from $6498), $9BAF=0, $9BFF=$FF,
; $9BFB=$6D71. Looks like a general "clear pointers to defaults" step run when
; (re)starting a level, called from $A4E7.
c$A371 LD A,$1C      ;
 $A373 LD ($9BAD),A  ;
 $A376 LD HL,$7D00   ;
 $A379 LD ($9BA9),HL ;
 $A37C LD ($9BAB),HL ;
 $A37F LD A,$00      ;
 $A381 LD ($9BAE),A  ;
 $A384 LD ($9C00),A  ;
 $A387 LD ($9BF8),A  ;
 $A38A LD HL,$FA79   ;
 $A38D LD ($9BF9),HL ;
 $A390 XOR A         ;
 $A391 LD ($9BAF),A  ;
 $A394 LD A,$FF      ;
 $A396 LD ($9BFF),A  ;
 $A399 LD HL,$6D71   ;
 $A39C LD ($9BFB),HL ;
 $A39F RET           ;

; Scenery/event script interpreter (wait or dispatch event)
;
; Used by the routines at #R$A1AF, #R$A4E7 and #R$A8C0.
;
; .
;
; Reads bytes from a script pointer ($9BFD, defaulting to $6D71 via $A371). If
; the script-active flag ($9BFF) isn't $FF, returns immediately (see $A3E2
; continuation). Otherwise: a byte with the top bit set dispatches a scene
; event via an offset-chain table at $6E06 (summing B DE-strides to find the
; target, stored into $9C0C); $FF rewinds the script pointer back to the
; default ($9BFB) and loops; anything else is a "wait" delay (masked to a
; nibble, stored at $9BAF) and the script pointer advances. Distinct from the
; enemy-formation ($AFB8) and object-movement ($B8F9) script systems - likely
; drives background/scenery timing.
c$A3A0 LD A,($9BFF)  ;
 $A3A3 CP $FF        ;
 $A3A5 JR NZ,$A3E2   ;
*$A3A7 LD HL,($9BFD) ;
 $A3AA LD A,(HL)     ;
 $A3AB AND A         ;
 $A3AC JP P,$A3C6    ;
 $A3AF CP $FF        ;
 $A3B1 JR Z,$A3BE    ;
 $A3B3 AND $0F       ;
 $A3B5 LD ($9BAF),A  ;
 $A3B8 INC HL        ;
 $A3B9 LD ($9BFD),HL ;
 $A3BC JR $A3A7      ;
*$A3BE LD HL,($9BFB) ;
 $A3C1 LD ($9BFD),HL ;
 $A3C4 JR $A3A7      ;
*$A3C6 LD HL,$6E06   ;
 $A3C9 AND A         ;
 $A3CA JR Z,$A3D3    ;
 $A3CC LD B,A        ;
 $A3CD LD D,$00      ;
*$A3CF LD E,(HL)     ;
 $A3D0 ADD HL,DE     ;
 $A3D1 DJNZ $A3CF    ;
*$A3D3 INC HL        ;
 $A3D4 LD ($9C0C),HL ;
 $A3D7 LD A,$F0      ;
 $A3D9 LD ($9C0E),A  ;
 $A3DC CALL $A4C4    ; Extract next 4-bit parameter from scenery-event data
 $A3DF LD ($9BFF),A  ;
*$A3E2 LD HL,$9BAD   ;
 $A3E5 NEG           ;
 $A3E7 ADD A,(HL)    ;
 $A3E8 RET NC        ;
 $A3E9 LD (HL),A     ;
 $A3EA XOR A         ;
 $A3EB LD ($9C0A),A  ;
 $A3EE CALL $A4C4    ; Extract next 4-bit parameter from scenery-event data
 $A3F1 LD HL,$A02A   ;
 $A3F4 CALL $B7F6    ; Jump-table dispatcher
 $A3F7 CALL $A40B    ; Render sub-pixel scrolled graphic
 $A3FA LD HL,($9BFD) ;
 $A3FD INC HL        ;
 $A3FE LD ($9BFD),HL ;
 $A401 XOR A         ;
 $A402 LD ($9BAF),A  ;
 $A405 LD A,$FF      ;
 $A407 LD ($9BFF),A  ;
 $A40A RET           ;

; Render sub-pixel scrolled graphic (shift amount from scenery script)
;
; Used by the routine at #R$A3A0.
;
; .
;
; If the scenery-script wait value ($9BAF) is zero, skips ahead ($A441).
; Otherwise uses it as a pixel-shift amount (self-modifies an operand at $A436
; with NEG+8), then copies 9 bytes from the scenery data pointer ($9BAB) into a
; double buffer at $9BE6 (both IX+0 and IX+9), continuing into shift-based blit
; logic. Looks like a smoothly-scrolling scenery/marquee graphic renderer,
; reusing $A3A0's wait-timer as the sub-pixel offset.
c$A40B LD A,($9BAF)  ;
 $A40E AND A         ;
 $A40F JR Z,$A441    ; Skip render if wait value is zero
 $A411 NEG           ;
 $A413 ADD A,$08     ; Displacement = 8 - wait value
 $A415 LD ($A436),A  ; Self-modify the shifted-read operand at $A436
 $A418 LD A,($9BFF)  ;
 $A41B LD C,A        ;
 $A41C LD HL,($9BAB) ;
 $A41F LD IX,$9BE6   ;
*$A423 LD B,$09      ; Outer: 9-byte copy loop setup
*$A425 LD A,(HL)     ;
 $A426 INC L         ;
 $A427 LD (IX+$00),A ; {Duplicate byte into both halves of the double buffer
 $A42A LD (IX+$09),A ; (wrap-safe shift)
 $A42D INC IX        ; }
 $A42F DJNZ $A425    ;
 $A431 LD E,L        ;
 $A432 LD B,$09      ;
*$A434 LD A,(IX+$00) ; Read back from the self-modified shifted offset
 $A437 DEC IX        ;
 $A439 DEC L         ;
 $A43A LD (HL),A     ; Write shifted byte, walking backward
 $A43B DJNZ $A434    ;
 $A43D LD L,E        ;
 $A43E DEC C         ;
 $A43F JR NZ,$A423   ; Repeat for C passes
*$A441 LD ($9BAB),HL ;
 $A444 RET           ;

; Draw scrolling scenery column using tile generator
;
; .
;
; .
;
; Handler for index $15 of the $A000 jump table (see $B7F6).
c$A445 LD HL,($9BAB) ;
 $A448 LD A,($9BFF)  ;
 $A44B LD C,A        ;
*$A44C LD B,$09      ;
*$A44E CALL $A499    ; Generate next scenery/terrain cell value
 $A451 LD (HL),A     ;
 $A452 INC L         ;
 $A453 DJNZ $A44E    ;
 $A455 DEC C         ;
 $A456 JR Z,$A46B    ;
 $A458 LD A,L        ;
 $A459 ADD A,$08     ;
 $A45B LD L,A        ;
 $A45C PUSH HL       ;
 $A45D LD B,$09      ;
*$A45F CALL $A499    ; Generate next scenery/terrain cell value
 $A462 LD (HL),A     ;
 $A463 DEC L         ;
 $A464 DJNZ $A45F    ;
 $A466 POP HL        ;
 $A467 INC L         ;
 $A468 DEC C         ;
 $A469 JR NZ,$A44C   ;
*$A46B RET           ;

; Draw scrolling scenery column (variant, using tile generator)
;
; .
;
; .
;
; Handler for index $16 of the $A000 jump table (see $B7F6).
; .
; Structurally similar to $A445 (same $A499 tile-generator calls building a
; column into HL) but with a +9 row stride and 5-row outer loop instead of
; $A445's layout - likely a different scenery band/type sharing the same
; generator.
c$A46C LD HL,($9BAB) ;
 $A46F LD A,($9BFF)  ;
 $A472 LD C,A        ;
 $A473 LD E,$05      ;
*$A475 LD B,C        ;
 $A476 LD A,L        ;
*$A477 CALL $A499    ; Generate next scenery/terrain cell value
 $A47A LD (HL),A     ;
 $A47B LD A,L        ;
 $A47C ADD A,$09     ;
 $A47E LD L,A        ;
 $A47F DJNZ $A477    ;
 $A481 SUB $08       ;
 $A483 LD L,A        ;
 $A484 DEC E         ;
 $A485 JR Z,$A498    ;
 $A487 LD B,C        ;
 $A488 LD A,L        ;
*$A489 CALL $A499    ; Generate next scenery/terrain cell value
 $A48C LD (HL),A     ;
 $A48D LD A,L        ;
 $A48E SUB $09       ;
 $A490 LD L,A        ;
 $A491 DJNZ $A489    ;
 $A493 ADD A,$0A     ;
 $A495 LD L,A        ;
 $A496 JR $A475      ;
*$A498 RET           ;

; Generate next scenery/terrain cell value
;
; Used by the routines at #R$A445 and #R$A46C.
;
; O:A generated cell value (base $9C0B + next script nibble)
;   HL preserved
;
; Every $9C0A calls, refreshes a base value ($9C0B) by reading a fresh byte
; from the scenery-event data via $A4B5; otherwise decrements the counter. Adds
; the next scenery-script nibble parameter ($A4C4) to that base value to
; produce the returned cell value - so the base periodically re-reads from the
; script data, not from randomness.
c$A499 PUSH HL       ;
 $A49A LD HL,$9C0A   ;
 $A49D LD A,(HL)     ;
 $A49E AND A         ;
 $A49F JR NZ,$A4AB   ;
 $A4A1 CALL $A4B5    ; Read next byte (2 nibbles) from scenery-event data
 $A4A4 LD ($9C0B),A  ;
 $A4A7 CALL $A4B5    ; Read next byte (2 nibbles) from scenery-event data
 $A4AA LD (HL),A     ;
*$A4AB DEC (HL)      ;
 $A4AC CALL $A4C4    ; Extract next 4-bit parameter from scenery-event data
 $A4AF LD HL,$9C0B   ;
 $A4B2 ADD A,(HL)    ;
 $A4B3 POP HL        ;
 $A4B4 RET           ;

; Read next byte (2 nibbles) from scenery-event data
;
; Used by the routine at #R$A499.
;
; .
;
; Combines two calls to $A4C4 (high nibble then low nibble) into a full byte.
; Corrects an earlier guess at $A499 - this is just a byte reader, not a PRNG
; source.
c$A4B5 PUSH BC       ;
 $A4B6 CALL $A4C4    ; Extract next 4-bit parameter from scenery-event data
 $A4B9 ADD A,A       ;
 $A4BA ADD A,A       ;
 $A4BB ADD A,A       ;
 $A4BC ADD A,A       ;
 $A4BD LD C,A        ;
 $A4BE CALL $A4C4    ; Extract next 4-bit parameter from scenery-event data
 $A4C1 OR C          ;
 $A4C2 POP BC        ;
 $A4C3 RET           ;

; Extract next 4-bit parameter from scenery-event data
;
; Used by the routines at #R$A3A0, #R$A499 and #R$A4B5.
;
; O:A the extracted nibble (0-15)
;
; Reads a byte from the event-data pointer $9C0C and, alternating via the flag
; $9C0E (which flips $0F/$F0 each call), returns first its high nibble then its
; low nibble; the pointer only advances after both nibbles of a byte have been
; consumed. Used by $A3A0's scenery/event script system to unpack 2 packed
; 4-bit parameters per data byte.
c$A4C4 PUSH HL       ;
 $A4C5 PUSH BC       ;
 $A4C6 LD HL,($9C0C) ; HL = current byte pointer ($9C0C)
 $A4C9 LD A,($9C0E)  ;
 $A4CC AND (HL)      ; {Mask out the selected nibble
 $A4CD LD C,A        ; }
 $A4CE LD A,($9C0E)  ;
 $A4D1 CPL           ; {Flip nibble-select mask ($9C0E); test which nibble just
 $A4D2 LD ($9C0E),A  ; finished
 $A4D5 CP $F0        ; }
 $A4D7 LD A,C        ;
 $A4D8 JR NZ,$A4E0   ; Skip shift if this was the low-nibble read
 $A4DA INC HL        ; {Advance byte pointer (low nibble just consumed) and
 $A4DB LD ($9C0C),HL ; return
 $A4DE JR $A4E4      ; }
*$A4E0 RRCA          ; {Shift high nibble down to low bits
 $A4E1 RRCA          ;
 $A4E2 RRCA          ;
 $A4E3 RRCA          ; }
*$A4E4 POP BC        ;
 $A4E5 POP HL        ;
 $A4E6 RET           ;

; Find level index from formation tag, reset state, select colour scheme
;
; Used by the routine at #R$A612.
;
; .
;
; Searches an 8-entry table (from ($9BA7)) for the first entry >= the current
; object's wave/formation tag (IX+7), storing the found level index into $9BA4.
; Calls $A371 to reset various state pointers. Then scans a second,
; 3-byte-stride table (cursor persisted at $9BA5) while $9BA4 >= the table's
; threshold byte, and once found, reads the level's colour/type value into
; $9C59 and $9C5A - the value used throughout the game for wipe-effect colour,
; screen fills etc (see $C6A6, $66B5). So the active colour scheme is
; level-dependent, selected here.
c$A4E7 LD IX,($9C77) ;
 $A4EB LD HL,$9BA2   ;
 $A4EE SET 5,(HL)    ;
 $A4F0 PUSH HL       ;
 $A4F1 LD HL,($9BA7) ;
 $A4F4 LD A,(IX+$07) ;
 $A4F7 LD B,$08      ;
*$A4F9 CP (HL)       ;
 $A4FA JR Z,$A502    ;
 $A4FC JR C,$A501    ;
 $A4FE INC HL        ;
 $A4FF DJNZ $A4F9    ;
*$A501 DEC HL        ;
*$A502 LD A,(HL)     ;
 $A503 LD ($9BA4),A  ;
 $A506 CALL $A371    ; Reset various state pointers/counters to defaults
 $A509 LD A,($9BA4)  ;
 $A50C LD L,A        ;
 $A50D LD H,$00      ;
 $A50F ADD HL,HL     ;
 $A510 ADD HL,HL     ;
 $A511 ADD HL,HL     ;
 $A512 ADD HL,HL     ;
 $A513 LD DE,$00D0   ;
 $A516 ADD HL,DE     ;
*$A517 PUSH HL       ;
 $A518 CALL $A3A0    ; Scenery/event script interpreter
 $A51B CALL $C8B8    ;
 $A51E POP HL        ;
 $A51F DEC HL        ;
 $A520 LD A,L        ;
 $A521 OR H          ;
 $A522 JR NZ,$A517   ;
 $A524 LD HL,($9BA5) ;
 $A527 LD A,($9BA4)  ;
 $A52A LD DE,$0003   ;
 $A52D AND A         ;
 $A52E SBC HL,DE     ;
*$A530 ADD HL,DE     ;
 $A531 CP (HL)       ;
 $A532 JR NC,$A530   ;
 $A534 LD ($9BA5),HL ;
 $A537 LD A,$07      ;
 $A539 LD ($9BA3),A  ;
 $A53C LD HL,$9C47   ;
 $A53F LD ($9C45),HL ;
 $A542 LD A,$02      ;
 $A544 LD ($9C44),A  ;
 $A547 LD HL,($9C57) ;
 $A54A LD A,($9BA4)  ;
*$A54D CP (HL)       ;
 $A54E INC HL        ;
 $A54F INC HL        ;
 $A550 JR C,$A54D    ;
 $A552 LD ($9C57),HL ;
 $A555 DEC HL        ;
 $A556 LD A,(HL)     ;
 $A557 LD ($9C59),A  ;
 $A55A LD ($9C5A),A  ;
 $A55D POP HL        ;
 $A55E RES 5,(HL)    ;
 $A560 RET           ;

; Player respawn/continue state check
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every frame from $A0C4. If the death/recovery timer ($9C3C, armed by
; $BF22) is active, counts it down and signals A=4 on expiry; if disabled
; ($FF), instead polls the ENTER key (row $F7 bit 3) for a manual continue (A=0
; if held, else A=2). Either way calls $A599 then dispatches the player's next
; state via the $A038 sub-range of the shared $A000 table (the same range used
; by $BE03's index $2B handler).
c$A561 LD HL,$9C3C   ;
 $A564 LD A,(HL)     ;
 $A565 CP $FF        ;
 $A567 JR Z,$A570    ;
 $A569 DEC (HL)      ;
 $A56A JR NZ,$A570   ;
 $A56C LD A,$04      ;
 $A56E JR $A57C      ;
*$A570 LD A,$F7      ;
 $A572 IN A,($FE)    ;
 $A574 BIT 3,A       ;
 $A576 LD A,$00      ;
 $A578 JR NZ,$A57C   ;
 $A57A LD A,$02      ;
*$A57C CALL $A599    ; Ratchet player state forward
 $A57F LD A,($9C3D)  ;
 $A582 LD HL,$A038   ;
 $A585 CALL $B7F6    ; Jump-table dispatcher

; No-op state (index $1C)
;
; .
;
; .
;
; Handler for index $1C of the $A000 jump table (see $B7F6).
c$A588 RET           ;

; Exit gameplay: mirror state, play alert sound, switch to light ISR
;
; .
;
; .
;
; Handler for indices $1F, $20 of the $A000 jump table (see $B7F6).
; .
; Copies $9C3D into $9C3E (a mirrored/confirmed-state value), requests the
; maximum-priority sound effect via $A1CE (likely a game-over/death jingle),
; then repoints the ISR ($FDFE) back to the light handler $A0B0 - taking the
; game out of active gameplay. Handler for indices $1F/$20 of the shared table.
c$A589 LD A,($9C3D)  ;
 $A58C LD ($9C3E),A  ;
 $A58F CALL $A1CE    ; Request sound effect at maximum priority
 $A592 LD HL,$A0B0   ; point to per-frame handler $A0B0 (light ISR)
 $A595 LD ($FDFE),HL ; set ISR handler address
 $A598 RET           ;

; Ratchet player state forward (only increase, never decrease)
;
; Used by the routines at #R$A561 and #R$BE4A.
;
; A candidate new state value
;
; Updates $9C3D (the state $A561/$A57F reads for its dispatch) only if A is >=
; the current value; otherwise leaves it unchanged. Ensures the
; respawn/continue state only ever advances.
c$A599 LD HL,$9C3D   ;
 $A59C CP (HL)       ;
 $A59D RET C         ;
 $A59E LD (HL),A     ;
 $A59F RET           ;

; Start music track 0
;
; Used by the routine at #R$A6BB.
c$A5A0 XOR A         ;
 $A5A1 CALL $A927    ; Start playing music track A
 $A5A4 RET           ;

; Show title screen once, then (re)initialize interrupts
;
; Used by the routine at #R$A8C0.
;
; .
;
; Used by $A902's menu loop. Checks a "shown once" flag at $9B9F; if not yet
; set, sets it and calls $7D1F to clear the screen and draw the title artwork.
; Either way falls through into $A5B2: CALL $7D98 (build the shift-copy
; tables), CALL $7D00 (re-init IM 2 vectors), then point the ISR trampoline at
; $A0B0 and EI/RET.
c$A5A5 DI            ;
 $A5A6 LD HL,$9B9F   ;
 $A5A9 LD A,$FF      ;
 $A5AB CP (HL)       ;
 $A5AC LD (HL),A     ;
 $A5AD JR Z,$A5B8    ;
 $A5AF CALL $7D1F    ; Clear screen and draw title screen graphics
 $A5B2 CALL $7D98    ; Decode 9 graphic blocks, then substitute every other
                     ; byte via table $9A00
 $A5B5 CALL $7D00    ; Initialize IM 2 interrupt vector table and set light ISR
*$A5B8 LD HL,$A0B0   ;
 $A5BB LD ($FDFE),HL ;
 $A5BE EI            ;
 $A5BF RET           ;

; Initialize both players' game state (lives, bombs, HUD)
;
; Used by the routine at #R$A8C0.
;
; .
;
; Used by $A8C0 when starting a new game. Zeroes each player's 11-byte state
; block ($9C79/$9C85), then sets starting lives ($9C88/$9C7C, POKE 42464),
; starting bombs ($9C82/$9C8E, POKE 42490), and other per-player defaults
; (active-player flag $9C76, HUD pointer $9C77, misc fields).
c$A5C0 LD A,$00      ;
 $A5C2 CALL $6498    ; Init menu screen
 $A5C5 LD HL,$9C79   ;
 $A5C8 LD DE,$9C7A   ;
 $A5CB LD BC,$000B   ;
 $A5CE LD (HL),$00   ;
 $A5D0 LDIR          ;
 $A5D2 LD HL,$9C85   ;
 $A5D5 LD DE,$9C86   ;
 $A5D8 LD BC,$000B   ;
 $A5DB LD (HL),$00   ;
 $A5DD LDIR          ;
 $A5DF LD A,$03      ; POKE 42464,N sets starting lives count
 $A5E1 LD ($9C88),A  ;
 $A5E4 DEC A         ;
 $A5E5 LD ($9C7C),A  ;
 $A5E8 LD A,$01      ;
 $A5EA LD ($9C76),A  ;
 $A5ED LD HL,$9C79   ;
 $A5F0 LD ($9C77),HL ;
 $A5F3 LD ($9C81),A  ;
 $A5F6 LD ($9C8D),A  ;
 $A5F9 LD A,$03      ; POKE 42490,N sets starting bomb count
 $A5FB LD ($9C82),A  ;
 $A5FE LD ($9C8E),A  ;
 $A601 LD A,$02      ;
 $A603 LD ($9C84),A  ;
 $A606 LD ($9C90),A  ;
 $A609 LD A,$00      ;
 $A60B LD ($9C7F),A  ;
 $A60E LD ($9C8B),A  ;
 $A611 RET           ;

; Initialize wave-group counters and load group data tables
;
; Used by the routine at #R$A8C0.
;
; .
;
; Loads the current wave's config from $9C84 (explosion data, 13-byte stride)
; and $61D4 (per-level pointers: colour scheme/level index/scenery script,
; 20-byte stride, $61D4 is the per-level config table), derives fire-timer
; reload values, then falls through at $A696 into $B730/$A4E7/$6A88 (wave init,
; level select, credits screen).
c$A612 LD IX,($9C77)  ;
 $A616 LD A,(IX+$08)  ;
 $A619 LD ($9C68),A   ; Save wave-group id ($9C68)
 $A61C LD ($9C72),A   ;
 $A61F LD HL,$9C84    ;
 $A622 LD DE,$000D    ;
 $A625 LD B,A         ;
*$A626 ADD HL,DE      ; {Index 13-byte table at $9C84 for explosion data
 $A627 DJNZ $A626     ; }
 $A629 LD ($9C73),HL  ;
 $A62C LD A,$06       ;
 $A62E LD ($9C6F),A   ;
 $A631 LD A,(IX+$06)  ;
 $A634 LD HL,$61D4    ;
 $A637 LD DE,$0014    ;
 $A63A LD B,A         ;
 $A63B INC B          ;
*$A63C ADD HL,DE      ; {Index 20-byte per-level table at $61D4
 $A63D DJNZ $A63C     ; }
 $A63F XOR A          ;
 $A640 LD ($9C69),A   ;
 $A643 LD ($9C3F),A   ;
 $A646 LD ($9C6A),A   ;
 $A649 DI             ;
 $A64A LD ($A69B),SP  ;
 $A64E LD SP,HL       ; {SP-trick: pop level-config pointers (colour
 $A64F POP HL         ; scheme/level index/scenery script)
 $A650 LD ($9C57),HL  ;
 $A653 POP HL         ;
 $A654 LD ($9BA5),HL  ;
 $A657 POP HL         ;
 $A658 LD ($9BFD),HL  ;
 $A65B POP HL         ; }
 $A65C LD A,($9C72)   ;
 $A65F CP $03         ; {Adjust cursor if wave-type is 3
 $A661 JR NZ,$A667    ; }
 $A663 LD A,L         ;
 $A664 ADD A,$04      ;
 $A666 LD L,A         ;
*$A667 LD A,(IX+$0A)  ;
 $A66A ADD A,A        ;
 $A66B ADD A,A        ;
 $A66C ADD A,A        ;
 $A66D ADD A,L        ;
 $A66E JR NC,$A672    ; Clamp fire-timer high byte on overflow
 $A670 LD A,$FF       ;
*$A672 LD ($9C41),A   ;
 $A675 LD A,H         ;
 $A676 ADD A,(IX+$0A) ;
 $A679 LD ($9C40),A   ;
 $A67C POP HL         ;
 $A67D LD A,L         ;
 $A67E LD ($9C43),A   ;
 $A681 LD ($9C42),A   ;
 $A684 LD A,H         ;
 $A685 LD ($9C71),A   ;
 $A688 POP HL         ;
 $A689 LD A,L         ;
 $A68A LD ($5B56),A   ;
 $A68D SRL A          ;
 $A68F LD ($C2E1),A   ;
 $A692 LD A,H         ;
 $A693 LD ($5B7A),A   ;
 $A696 LD ($9BA7),SP  ;
 $A69A LD SP,$0000    ; Restore SP
 $A69D EI             ;
 $A69E LD HL,$9C40    ;
 $A6A1 LD A,(IX+$09)  ;
 $A6A4 CP $04         ;
 $A6A6 JR C,$A6A9     ; Bump bonus counter past difficulty threshold
 $A6A8 INC (HL)       ;
*$A6A9 LD A,(IX+$03)  ;
 $A6AC CP $03         ;
 $A6AE JR C,$A6B1     ; Bump bonus counter past second threshold
 $A6B0 INC (HL)       ;
*$A6B1 CALL $B730     ; Initialize wave
 $A6B4 CALL $A4E7     ; Find level index from formation tag, reset state,
                      ; select colour scheme
 $A6B7 CALL $6A88     ; Show credits screen
 $A6BA RET            ;

; Routine at A6BB
;
; Used by the routine at #R$A8C0.
c$A6BB LD A,$00      ;
 $A6BD CALL $6498    ; Init menu screen
 $A6C0 LD A,$01      ; "FIREBIRD...FLYING SHARK...GRAFTGOLD LTD...COPYRIGHT
                     ; 1987"
 $A6C2 CALL $6648    ; Print message N from table $627A
 $A6C5 CALL $A5A0    ; Start music track 0
 $A6C8 RET C         ;
; This entry point is used by the routine at #R$A8C0.
*$A6C9 LD A,$09      ;
 $A6CB CALL $6498    ; Init menu screen
 $A6CE LD A,$02      ; credits: "SOFTWARE DESIGN AND PROGRAMMING BY DOMINIC
                     ; ROBINSON, GRAPHICS BY JOHN CUMMING, MUSIC BY STEVE
                     ; TURNER"
 $A6D0 CALL $6648    ; Print message N from table $627A
 $A6D3 LD A,$47      ;
 $A6D5 LD ($9C59),A  ;
 $A6D8 CALL $C6A6    ; Screen wipe transition effect
 $A6DB LD B,$C8      ;
*$A6DD HALT          ;
 $A6DE CALL $6943    ; Read fire button (Kempston/keyboard) with debounce
 $A6E1 RET C         ;
 $A6E2 DJNZ $A6DD    ;
 $A6E4 RET           ;

; Print high-score table
;
; Used by the routine at #R$A8C0.
c$A6E5 LD A,$09      ;
 $A6E7 CALL $6498    ; Init menu screen
 $A6EA LD HL,$0909   ; {set cursor position, point HL at high-score name table
 $A6ED LD ($9CC9),HL ; $6238}
 $A6F0 LD HL,$6238   ;
 $A6F3 LD B,$06      ; {loop 6 rows
*$A6F5 PUSH BC       ; }
 $A6F6 CALL $6626    ; Print string (control codes + ROM-font text) from HL
 $A6F9 LD DE,$0008   ;
 $A6FC ADD HL,DE     ;
 $A6FD LD A,$20      ;
 $A6FF CALL $64CC    ; Print character to screen using ROM font
 $A702 LD A,$FE      ;
 $A704 PUSH HL       ;
 $A705 CALL $6663    ; Print packed-BCD number with leading-zero suppression
 $A708 LD A,($9CC7)  ;
 $A70B AND $E0       ;
 $A70D ADD A,$07     ;
 $A70F LD ($9CC7),A  ;
 $A712 LD A,$20      ;
 $A714 POP HL        ;
 $A715 CALL $6663    ; Print packed-BCD number with leading-zero suppression
 $A718 POP BC        ;
 $A719 DJNZ $A6F5    ;
 $A71B LD A,$00      ;
 $A71D LD ($9C59),A  ;
 $A720 CALL $C6A6    ; Screen wipe transition effect
 $A723 LD B,$06      ;
 $A725 LD E,$02      ;
 $A727 LD C,$87      ;
*$A729 LD A,$12      ;
 $A72B PUSH BC       ;
 $A72C PUSH DE       ;
 $A72D CALL $6778    ; Paint attribute colour-wipe column
 $A730 POP DE        ;
 $A731 POP BC        ;
 $A732 INC E         ;
 $A733 INC E         ;
 $A734 INC E         ;
 $A735 CALL $6943    ; Read fire button (Kempston/keyboard) with debounce
 $A738 JR C,$A76A    ;
 $A73A DJNZ $A729    ;
 $A73C LD A,$04      ;
 $A73E CALL $6648    ; Print message N from table $627A
 $A741 LD DE,$9CCC   ;
 $A744 LD C,$00      ;
*$A746 HALT          ;
 $A747 HALT          ;
 $A748 LD A,(DE)     ;
 $A749 INC DE        ;
 $A74A CP $FF        ;
 $A74C JR NZ,$A752   ;
 $A74E LD DE,$9CCC   ;
 $A751 LD A,(DE)     ;
*$A752 LD B,$0E      ;
 $A754 LD IX,$5AA9   ;
*$A758 LD (IX+$00),A ;
 $A75B LD (IX+$20),A ;
 $A75E INC IX        ;
 $A760 DJNZ $A758    ;
 $A762 CALL $6943    ; Read fire button (Kempston/keyboard) with debounce
 $A765 JR C,$A76A    ;
 $A767 DEC C         ;
 $A768 JR NZ,$A746   ;
*$A76A PUSH AF       ;
 $A76B LD A,$09      ;
 $A76D CALL $6498    ; Init menu screen
 $A770 POP AF        ;
 $A771 RET           ;
; This entry point is used by the routine at #R$A8C0.
*$A772 RET           ;

; Handle player death (respawn, or Game Over if out of lives)
;
; Used by the routine at #R$A8C0.
c$A773 CALL $6771    ; Update player's HUD panel
 $A776 CALL $6971    ; Wait for input
 $A779 LD A,($9C3E)  ; {wait for frame-done flag $9C3E, run state table at
 $A77C LD HL,$A02E   ; $A02E
 $A77F CALL $B7F6    ;
 $A782 RET           ; }

; Player death-check entry (mid-point of $A773, skips input/frame update)
;
; .
;
; .
;
; Handler for index $1B of the $A000 jump table (see $B7F6).
c$A783 LD IX,($9C77)   ; load player object pointer into IX
 $A787 INC (IX+$05)    ; increment death/state counter at IX+5
 $A78A LD (IX+$08),$01 ; {init respawn state fields IX+8=1, IX+9=3
 $A78E LD (IX+$09),$03 ; }
 $A792 LD A,(IX+$03)   ; {check lives-remaining field at IX+3; skip Game Over
 $A795 AND A           ; if lives left
 $A796 JR NZ,$A7C9     ; }
; Out of lives, Game Over.
 $A798 PUSH IX         ; save IX
 $A79A LD A,$11        ; "GAME OVER"
 $A79C CALL $6648      ; Print message N from table $627A
 $A79F LD A,$0A        ; {position first Game Over text line (row $0A, col
 $A7A1 LD C,$90        ; $90/8)
 $A7A3 LD E,$08        ; }
 $A7A5 CALL $6778      ; Paint attribute colour-wipe column
 $A7A8 LD A,$0A        ; {position second Game Over text line (row $0A, col
 $A7AA LD C,$40        ; $40/8)
 $A7AC LD E,$08        ; }
 $A7AE CALL $6778      ; Paint attribute colour-wipe column
 $A7B1 CALL $6989      ; Check for new high score, congratulate and reset
                       ; defaults if so
 $A7B4 POP IX          ; {restore IX, re-init player state
 $A7B6 CALL $A7D7      ; }
 $A7B9 LD A,$09        ; {set active-object type $9C59=9
 $A7BB LD ($9C59),A    ; }
 $A7BE CALL $C6A6      ; Screen wipe transition effect
 $A7C1 LD A,(IX+$03)   ; {check IX+3 sign, branch if negative
 $A7C4 AND A           ;
 $A7C5 JP M,$A7D5      ; }
 $A7C8 RET             ; return
*$A7C9 XOR A           ;
 $A7CA LD ($9C59),A    ;
 $A7CD CALL $C6A6      ; Screen wipe transition effect
 $A7D0 CALL $A7D7      ; Decrement current player's lives
 $A7D3 AND A           ;
 $A7D4 RET             ;
*$A7D5 SCF             ;
 $A7D6 RET             ;

; Decrement current player's lives; switch turn to other player if any remain
;
; Used by the routine at #R$A783.
;
; IX current player's state block base (lives at IX+$03)
;
; Called on death/wave-loss (from $A7B6/$A7D0). If only one player ($9C75==1),
; just decrements the current player's lives (IX+$03) and returns. In 2-player
; mode, checks the *other* player's lives (IY, selected as the block that isn't
; the active one at $9C76); if they still have lives, switches control to them
; (updates the current-player pointer $9C77, toggles the active-player flag at
; $9C76). Either way, finishes by decrementing the now-current player's lives.
c$A7D7 LD A,($9C75)  ;
 $A7DA DEC A         ;
 $A7DB JR Z,$A7FE    ; Single-player: skip switch, just decrement lives
 $A7DD LD HL,$9C76   ;
 $A7E0 LD A,(HL)     ;
 $A7E1 LD IY,$9C79   ; Default: select the other player's state block
 $A7E5 DEC A         ;
 $A7E6 JR NZ,$A7EC   ; Active player was 2: keep player-1 block selected
                     ; instead
 $A7E8 LD IY,$9C85   ;
*$A7EC LD A,(IY+$03) ;
 $A7EF AND A         ;
 $A7F0 JR Z,$A7FE    ; Other player is out of lives: don't switch turns
 $A7F2 PUSH IY       ;
 $A7F4 POP IX        ;
 $A7F6 LD ($9C77),IX ; Switch current-player pointer to the other player
 $A7FA LD A,(HL)     ;
 $A7FB XOR $03       ; Toggle active-player flag
 $A7FD LD (HL),A     ;
*$A7FE DEC (IX+$03)  ; Decrement the (now-current) player's lives
 $A801 RET           ;

; Show bonus-points award screen, transition onward
;
; .
;
; .
;
; Prints "3000 POINTS" (message $12), draws a box graphic ($6B09), then
; (further in, at $A862/$A866) prints another message, starts music track 1,
; resets the colour scheme, and runs the $C6A6 wipe transition. Also plays a
; tone effect ($A84D-$A85B, same timed border/speaker-toggle technique as
; $A222) partway through. Handler for index $1A of the shared table.
c$A802 LD IX,($9C77)   ;
 $A806 LD A,($9C72)    ;
 $A809 LD (IX+$08),A   ;
 $A80C LD A,$12        ; "3000 POINTS"
 $A80E CALL $6648      ; Print message N from table $627A
 $A811 LD DE,$6CF1     ;
 $A814 LD HL,$58C9     ;
 $A817 LD A,$56        ;
 $A819 CALL $6B09      ; Draw bordered box graphic (colour + bitmap) at HL
 $A81C LD A,(IX+$09)   ;
 $A81F LD B,A          ;
 $A820 AND A           ;
 $A821 LD A,$13        ; "BONUS-"
 $A823 JR Z,$A862      ;
 $A825 CALL $6648      ; Print message N from table $627A
 $A828 LD A,$90        ;
 $A82A SUB B           ;
 $A82B EXX             ;
 $A82C LD DE,$6CF1     ;
 $A82F LD L,A          ;
 $A830 LD H,$59        ;
 $A832 EXX             ;
*$A833 PUSH BC         ;
 $A834 LD A,$56        ;
 $A836 EXX             ;
 $A837 CALL $6B09      ; Draw bordered box graphic (colour + bitmap) at HL
 $A83A EXX             ;
 $A83B LD A,$06        ;
 $A83D CALL $66B5      ; Add BCD score value to current player's score
 $A840 LD A,($9C76)    ;
 $A843 CALL $66DE      ; Print a player's score at its HUD position
 $A846 CALL $A189      ; Award bonus life when score threshold reached
 $A849 LD A,$18        ;
 $A84B LD C,$DC        ;
*$A84D LD B,C          ;
*$A84E NOP             ;
 $A84F DJNZ $A84E      ;
 $A851 OUT ($FE),A     ;
 $A853 XOR $18         ;
 $A855 DEC C           ;
 $A856 JR NZ,$A84D     ;
 $A858 LD B,$03        ;
*$A85A HALT            ;
 $A85B DJNZ $A85A      ;
 $A85D POP BC          ;
 $A85E DJNZ $A833      ;
 $A860 JR $A866        ;
*$A862 INC A           ;
 $A863 CALL $6648      ; Print message N from table $627A
*$A866 LD A,$01        ;
 $A868 CALL $A927      ; Start playing music track A
 $A86B LD A,$00        ;
 $A86D LD ($9C59),A    ;
 $A870 CALL $C6A6      ; Screen wipe transition effect
 $A873 LD IX,($9C77)   ;
 $A877 LD A,(IX+$06)   ;
 $A87A INC A           ;
 $A87B CP $04          ;
 $A87D JR C,$A887      ;
 $A87F INC (IX+$0A)    ;
 $A882 LD A,(IX+$0A)   ;
 $A885 AND $03         ;
*$A887 LD (IX+$06),A   ;
 $A88A LD (IX+$05),$00 ;
 $A88E LD (IX+$07),$00 ;
 $A892 AND A           ;
 $A893 RET             ;

; Start game: switch ISR to $A0B0, enter main loop
;
; .
;
; .
;
; Handler for indices $17, $18, $19, $1D of the $A000 jump table (see $B7F6).
c$A894 LD HL,$A0B0   ; point to per-frame handler $A0B0 (light ISR)
 $A897 LD ($FDFE),HL ; set ISR handler address
 $A89A LD SP,$0000   ;
 $A89D EI            ;
 $A89E LD A,$09      ;
 $A8A0 CALL $6498    ; Init menu screen
 $A8A3 AND A         ;
 $A8A4 JP $A909      ;

; Routine at A8A7
;
; .
;
; .
;
; Handler for index $1E of the $A000 jump table (see $B7F6).
c$A8A7 CALL $A1CE    ; Request sound effect at maximum priority
 $A8AA LD HL,$9C3D   ;
*$A8AD LD A,$FB      ;
 $A8AF IN A,($FE)    ;
 $A8B1 BIT 0,A       ;
 $A8B3 JR Z,$A8BD    ;
 $A8B5 CALL $6943    ; Read fire button (Kempston/keyboard) with debounce
 $A8B8 LD (HL),$00   ;
 $A8BA JR NC,$A8AD   ;
 $A8BC RET           ;
*$A8BD LD (HL),$01   ;
 $A8BF RET           ;

; Start new game: reset game state
;
; .
;
; .
;
; Waits for input, then resets core per-game state: deferred-event mask $9C27
; (via $A1C8/$FF00), player state $9C3D/$9C3E, immobilise flag $9C3B,
; redefine-key debounce $9CDC, and disables the death/recovery timer
; ($9C3C=$FF, the sentinel $A561 checks). Called at the start of a new game
; (from the game-start sequence via $A6BB/$A6C9).
c$A8C0 CALL $6971    ; Wait for input
 $A8C3 CALL $A1C8    ; Clear pending sound-effect priority
 $A8C6 LD HL,$FF00   ;
 $A8C9 LD ($9C27),HL ;
 $A8CC LD HL,$9C27   ;
 $A8CF SET 2,(HL)    ;
 $A8D1 LD A,$00      ;
 $A8D3 LD ($9C3D),A  ;
 $A8D6 LD ($9C3E),A  ;
 $A8D9 XOR A         ;
 $A8DA LD ($9C3B),A  ;
 $A8DD LD ($9CDC),A  ;
 $A8E0 DEC A         ;
 $A8E1 LD ($9C3C),A  ;
 $A8E4 DI            ;
 $A8E5 CALL $BBC2    ; Clear buffers at $7F00-$7FFF and $8000-$80FF
 $A8E8 CALL $BCE9    ; Draw active objects' collision masks into attribute
                     ; buffer
 $A8EB EI            ;
 $A8EC CALL $A3A0    ; Scenery/event script interpreter
 $A8EF LD HL,$A0C4   ; point to per-frame handler $A0C4 (heavy ISR)
 $A8F2 LD ($FDFE),HL ; set ISR handler address
*$A8F5 CALL $A13A    ; Dispatch highest-priority pending deferred event
 $A8F8 LD A,($9C3E)  ;
 $A8FB AND A         ;
 $A8FC JR Z,$A8F5    ;
 $A8FE LD A,($9C3D)  ;
 $A901 RET           ;
 $A902 LD SP,$0000   ;
 $A905 CALL $A5A5    ; Show title screen once, then (re)initialize interrupts
 $A908 AND A         ;
; This entry point is used by the routine at #R$A894.
*$A909 CALL NC,$A6BB ;
*$A90C CALL NC,$A6E5 ; Print high-score table
 $A90F CALL NC,$A772 ;
 $A912 JR NC,$A909   ;
 $A914 CALL $A5C0    ; Initialize both players' game state
*$A917 CALL $A612    ; Initialize wave-group counters and load group data
                     ; tables
 $A91A CALL $A8C0    ; Start new game
 $A91D CALL $A773    ; Handle player death
 $A920 JR NC,$A917   ;
 $A922 CALL $A6C9    ;
 $A925 JR $A90C      ;

; Start playing music track A
;
; Used by the routines at #R$6989, #R$A5A0 and #R$A802.
;
; A music track number
;
; Sets $9C29 = A (also used by $6A4A as a "menu busy" guard - only one
; track/menu action active at a time), then looks up a pointer from the track
; table at $AB03 (indexed by A*2) and stores it into $AA8E, the note pointer
; consumed by the $AA0F/$AA34 music engine.
c$A927 LD ($9C29),A  ;
 $A92A DI            ;
 $A92B ADD A,A       ;
 $A92C LD E,A        ;
 $A92D LD D,$00      ;
 $A92F LD HL,$AB03   ;
 $A932 ADD HL,DE     ;
 $A933 LD A,(HL)     ;
 $A934 INC HL        ;
 $A935 LD H,(HL)     ;
 $A936 LD L,A        ;

; Point score reader at next event, check for end
;
; Used by the routine at #R$A94C.
c$A937 LD ($AA8E),HL ;
 $A93A LD A,(HL)     ;
 $A93B CP $FF        ;
 $A93D JP Z,$AA32    ;
 $A940 LD E,A        ;
 $A941 LD D,$00      ;
 $A943 LD HL,$AACB   ;
 $A946 ADD HL,DE     ;
 $A947 ADD HL,DE     ;
 $A948 LD E,(HL)     ;
 $A949 INC HL        ;
 $A94A LD D,(HL)     ;
 $A94B EX DE,HL      ;

; Parse next music score byte (note/duration/rest)
;
; .
;
; .
;
; Reads score bytes and classifies by value range: >=$D0 sets an
; instrument/octave value ($AA98), $60-$6F indexes a note-pitch table at $AA9B
; (3 bytes/entry) to play a note, other ranges set duration ($AA92) or rest.
; Also polls the menu dispatcher ($6A4A) and fire button each event, so music
; playback and menu input share this loop while on the title screen.
c$A94C LD ($AA90),HL ;
 $A94F CALL $6A4A    ; Main menu key dispatcher
 $A952 CALL $6943    ; Read fire button (Kempston/keyboard) with debounce
 $A955 JP C,$AA32    ;
 $A958 LD HL,($AA90) ;
 $A95B LD A,(HL)     ;
 $A95C CP $FF        ;
 $A95E JP Z,$AA2B    ;
 $A961 CP $60        ;
 $A963 JP C,$A98A    ;
 $A966 JP Z,$A97A    ;
 $A969 CP $70        ;
 $A96B JP C,$A972    ;
 $A96E CP $D0        ;
 $A970 JR C,$A981    ;
*$A972 AND $0F       ;
 $A974 LD ($AA98),A  ;
 $A977 INC HL        ;
 $A978 JR $A94C      ;
*$A97A XOR A         ;
 $A97B LD ($AA98),A  ;
 $A97E INC HL        ;
 $A97F JR $A94C      ;
*$A981 AND $0F       ;
 $A983 INC A         ;
 $A984 LD ($AA92),A  ;
 $A987 INC HL        ;
 $A988 JR $A94C      ;
*$A98A AND $0F       ;
 $A98C EX DE,HL      ;
 $A98D LD B,$00      ;
 $A98F LD C,A        ;
 $A990 LD HL,$AA9B   ;
 $A993 ADD HL,BC     ;
 $A994 ADD HL,BC     ;
 $A995 ADD HL,BC     ;
 $A996 LD A,(HL)     ;
 $A997 LD ($AA8D),A  ;
 $A99A INC HL        ;
 $A99B LD A,(HL)     ;
 $A99C INC HL        ;
 $A99D LD H,(HL)     ;
 $A99E LD L,A        ;
 $A99F LD A,(DE)     ;
 $A9A0 RRA           ;
 $A9A1 RRA           ;
 $A9A2 RRA           ;
 $A9A3 RRA           ;
 $A9A4 AND $0F       ;
 $A9A6 LD ($AA93),A  ;
 $A9A9 LD B,A        ;
 $A9AA JR Z,$A9B2    ;
*$A9AC SRA H         ;
 $A9AE RR L          ;
 $A9B0 DJNZ $A9AC    ;
*$A9B2 LD BC,$FFF4   ;
 $A9B5 ADD HL,BC     ;
 $A9B6 LD ($AA96),HL ;
 $A9B9 LD A,($AA93)  ;
 $A9BC NEG           ;
 $A9BE ADD A,$05     ;
 $A9C0 LD L,A        ;
 $A9C1 LD A,($AA8D)  ;
 $A9C4 LD C,A        ;
 $A9C5 LD A,($AA92)  ;
*$A9C8 RRA           ;
 $A9C9 DEC L         ;
 $A9CA JR C,$A9CE    ;
 $A9CC JR NZ,$A9C8   ;
*$A9CE RLA           ;
 $A9CF AND $0F       ;
 $A9D1 LD H,A        ;
 $A9D2 LD A,L        ;
 $A9D3 AND A         ;
 $A9D4 LD B,A        ;
 $A9D5 JR Z,$A9DB    ;
*$A9D7 SRL C         ;
 $A9D9 DJNZ $A9D7    ;
*$A9DB LD A,H        ;
 $A9DC LD HL,$0000   ;
*$A9DF ADD HL,BC     ;
 $A9E0 DEC A         ;
 $A9E1 JR NZ,$A9DF   ;
 $A9E3 LD A,H        ;
 $A9E4 SRL A         ;
 $A9E6 LD B,A        ;
 $A9E7 LD A,L        ;
 $A9E8 RRA           ;
 $A9E9 LD C,A        ;
 $A9EA ADD HL,BC     ;
 $A9EB LD ($AA99),HL ;
 $A9EE LD A,($AA98)  ;
; Look up note pitch period and apply octave shift
; .
; Called from $A94C for a $60-$6F score byte. Low nibble of the byte indexes
; the pitch-period table at $AA9B (3 bytes/entry, note within octave); high
; nibble is the octave number - if nonzero, $AA0F halves the pitch period that
; many times (one halving per octave) before the note is played via $AA34.
 $A9F1 AND A         ;
 $A9F2 JR NZ,$A9F6   ;
 $A9F4 INC DE        ;
 $A9F5 LD A,(DE)     ;
*$A9F6 AND $0F       ; Note index (low nibble)
 $A9F8 LD B,$00      ;
 $A9FA LD C,A        ;
 $A9FB LD HL,$AA9B   ;
 $A9FE ADD HL,BC     ;
 $A9FF ADD HL,BC     ;
 $AA00 ADD HL,BC     ;
 $AA01 INC HL        ;
 $AA02 LD A,(HL)     ;
 $AA03 INC HL        ;
 $AA04 LD H,(HL)     ;
 $AA05 LD L,A        ;
 $AA06 LD A,(DE)     ; {Octave number (high nibble); skip halving if zero
 $AA07 RRA           ;
 $AA08 RRA           ;
 $AA09 RRA           ;
 $AA0A RRA           ; }
 $AA0B AND $0F       ;
 $AA0D JR Z,$AA16    ;
; Halve note period HL by octave count in A
*$AA0F SRA H         ;
 $AA11 RR L          ;
 $AA13 DEC A         ;
 $AA14 JR NZ,$AA0F   ;
*$AA16 EX DE,HL      ;
 $AA17 INC HL        ;
 $AA18 LD ($AA90),HL ;
 $AA1B LD HL,($AA96) ;
 $AA1E LD BC,($AA99) ;
 $AA22 CALL $AA34    ; Play beeper music note
 $AA25 LD HL,($AA90) ;
 $AA28 JP $A94C      ; => Parse next music score byte
*$AA2B LD HL,($AA8E) ;
 $AA2E INC HL        ;
 $AA2F JP $A937      ; => Point score reader at next event, check for end
; This entry point is used by the routine at #R$A937.
*$AA32 EI            ;
 $AA33 RET           ;

; Play beeper music note (square-wave tone generator)
;
; Used by the routine at #R$A94C.
c$AA34 DI            ;
 $AA35 LD ($AA94),DE ; Save note period parameters ($AA94)
 $AA39 LD DE,$0020   ; Initial 32-step attack/click burst
*$AA3C LD A,(DE)     ;
 $AA3D AND $10       ;
 $AA3F OUT ($FE),A   ; Toggle border/speaker bit during attack
 $AA41 LD A,$20      ;
*$AA43 DEC A         ;
 $AA44 JR NZ,$AA43   ;
 $AA46 DEC E         ;
 $AA47 JR NZ,$AA3C   ;
 $AA49 XOR A         ;
 $AA4A EX AF,AF'     ;
 $AA4B LD D,H        ;
 $AA4C LD E,L        ;
 $AA4D SRL D         ;
 $AA4F RR E          ;
*$AA51 XOR A         ;
 $AA52 SBC HL,DE     ; Phase accumulator step (HL -= period)
 $AA54 DEC BC        ; {Decrement duration (BC); finish when zero
 $AA55 LD A,C        ;
 $AA56 OR B          ;
 $AA57 JP Z,$AA88    ; }
*$AA5A LD A,L        ; {delay loop: hold current tone half-cycle for HL ticks
 $AA5B OR H          ;
 $AA5C DEC HL        ;
 $AA5D JP NZ,$AA5A   ; }
 $AA60 EX AF,AF'     ;
 $AA61 XOR $10       ; {Toggle speaker bit, output to port $FE
 $AA63 OUT ($FE),A   ; }
 $AA65 EX AF,AF'     ;
 $AA66 LD H,D        ;
 $AA67 LD L,E        ;
*$AA68 LD A,E        ; {Hold second half-cycle for DE ticks
 $AA69 OR D          ;
 $AA6A DEC DE        ;
 $AA6B JP NZ,$AA68   ; }
 $AA6E EX AF,AF'     ;
 $AA6F XOR $10       ; {Toggle speaker bit again (full square-wave period)
 $AA71 OUT ($FE),A   ; }
 $AA73 EX AF,AF'     ;
 $AA74 XOR A         ; {Recompute period via Bresenham blend ($AA94/$AA96)
 $AA75 LD DE,($AA94) ;
 $AA79 SBC HL,DE     ;
 $AA7B LD DE,($AA96) ; }
 $AA7F JR NC,$AA84   ;
*$AA81 ADD HL,DE     ;
 $AA82 JR NC,$AA81   ;
*$AA84 EX DE,HL      ;
 $AA85 JP $AA51      ; Loop back for next cycle
*$AA88 LD B,$00      ; {Silence pad and return
*$AA8A DJNZ $AA8A    ;
 $AA8C RET           ; }

