; IM2 interrupt trampoline and vector table
;
; .
;
; .
;
; The IM2 vector register I=$FE, so every interrupt reads the word at
; #R$FDFD/$FDFE. #R$FDFD holds a JP opcode ($C3, planted by #R$7D00), so the
; CPU executes JP #R$A0B0 (the ISR). #R$FE00 onward is the vector table itself,
; filled with $FD by #R$7D00 so every table entry points back here to #R$FDFD;
; it continues past this block's end ($FE7B) up to $FFFF.
@label=im2_trampoline
c$FDFD JP $A0B0      ; => Interrupt handler

; Data block at FE00
b$FE00 DEFW $FDFD,$FDFD,$FDFD,$FDFD ; {Interrupt vector table: all vectors
 $FE08 DEFW $FDFD,$FDFD,$FDFD,$FDFD ; resolve to $FDFD
 $FE10 DEFW $FDFD,$FDFD,$FDFD,$FDFD ;
