c$C298 LD A,(IY+$0D)   ;
 $C29B ADD A,$20       ;
 $C29D LD (IY+$0D),A   ;
 $C2A0 JR NC,$C2A5     ;
 $C2A2 INC (IY+$0E)    ;
*$C2A5 LD A,(IY+$14)   ;
 $C2A8 LD C,A          ;
 $C2A9 AND $7F         ;
 $C2AB JR Z,$C301      ;
 $C2AD BIT 6,A         ;
 $C2AF LD E,$00        ;
 $C2B1 JR Z,$C2B5      ;
 $C2B3 LD E,$02        ;
*$C2B5 AND $3F         ;
 $C2B7 LD ($9C6C),A    ;
 $C2BA LD L,A          ;
 $C2BB LD A,E          ;
 $C2BC JR Z,$C2D3      ;
 $C2BE LD D,$00        ;
 $C2C0 RR L            ;
 $C2C2 ADC A,D         ;
 $C2C3 RR L            ;
 $C2C5 ADC A,D         ;
 $C2C6 RR L            ;
 $C2C8 ADC A,D         ;
 $C2C9 RR L            ;
 $C2CB ADC A,D         ;
 $C2CC RR L            ;
 $C2CE ADC A,D         ;
 $C2CF RR L            ;
 $C2D1 ADC A,D         ;
 $C2D2 LD E,A          ;
*$C2D3 LD HL,$9C6B     ;
 $C2D6 LD A,C          ;
 $C2D7 OR (HL)         ;
 $C2D8 LD (HL),A       ;
 $C2D9 LD A,(IY+$12)   ;
 $C2DC SUB E           ;
 $C2DD LD (IY+$12),A   ;
 $C2E0 CP $03          ;
 $C2E2 JR NC,$C2EC     ;
 $C2E4 LD (IY+$02),$E1 ;
 $C2E8 LD (IY+$03),$6B ;
*$C2EC AND A           ;
 $C2ED JP P,$C2FC      ;
