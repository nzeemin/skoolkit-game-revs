; Decode next column's tile data into ping-pong buffer
;
; Used by the routine at #R$C8B8.
;
; .
;
; Called from $C8B8 every 8th frame. If the column-ready flag ($9BA2 bit 5) is
; clear, first calls $C981 to scan/spawn enemies from the previous column. Then
; decodes 9 map cells from the column-source pointer ($9BA9) into the ping-pong
; buffer at $9BB0: each cell byte indexes the four 2x2 tile-block tables at
; $7900-$7CFF (see $7900), and the four resulting character codes are stored as
; top pair ($7900/$7A00 -> IX+0/IX+1, row A) and bottom pair ($7B00/$7C00 ->
; IX+$12/IX+$13, row B). So the 9 cells expand to two 18-char column rows.
; Advances the source pointer ($9BA9) and bumps a level-progress counter
; ($9BAD) clamped at $1C.
c$C941 LD HL,$9BA2   ;
 $C944 BIT 5,(HL)    ; Check "column ready" flag before advancing
 $C946 CALL Z,$C981  ; Scan incoming column for spawn markers and allocate
                     ; enemy objects
 $C949 LD HL,($9BA9) ;
 $C94C LD IX,$9BB0   ;
 $C950 LD C,$79      ;
 $C952 LD B,$09      ;
*$C954 LD E,(HL)     ; Start of 9-entry decode loop
 $C955 LD D,C        ;
 $C956 LD A,(DE)     ;
 $C957 INC D         ;
 $C958 LD (IX+$00),A ;
 $C95B LD A,(DE)     ;
 $C95C INC D         ;
 $C95D LD (IX+$01),A ;
 $C960 LD A,(DE)     ;
 $C961 INC D         ;
 $C962 LD (IX+$12),A ;
 $C965 LD A,(DE)     ;
 $C966 LD (IX+$13),A ;
 $C969 INC IX        ; {Advance to next buffer entry (IX+=2)
 $C96B INC IX        ; }
 $C96D INC L         ;
 $C96E EX AF,AF'     ;
 $C96F ADD A,$10     ;
 $C971 EX AF,AF'     ;
 $C972 DJNZ $C954    ; Loop 9 times
 $C974 LD ($9BA9),HL ;
 $C977 LD HL,$9BAD   ;
 $C97A LD A,(HL)     ;
 $C97B CP $1C        ; Clamp progress counter at $1C
 $C97D RET NC        ; Stop if counter already at max
 $C97E INC A         ;
 $C97F LD (HL),A     ;
 $C980 RET           ;

; Scan incoming column for spawn markers and allocate enemy objects
;
; Used by the routine at #R$C941.
;
; .
;
; Called from $C941 when the "column ready" flag ($9BA2 bit 5) is clear. Scans
; 9 entries of the newly-decoded column buffer ($9BA9, stride $10) for spawn
; markers $05/$55; for each match, calls $BA5F to allocate an object slot (D =
; entry offset, used there as the enemy's row/type), and marks the column byte
; $33 ("spawned") once allocated - or leaves the marker in place if $BA5F found
; no free slot (carry set).
c$C981 LD HL,$9BA2   ;
 $C984 BIT 5,(HL)    ; Skip if column-ready flag already set
 $C986 RET NZ        ;
 $C987 LD HL,($9BA9) ;
 $C98A LD B,$09      ;
 $C98C LD C,$10      ;
*$C98E LD A,(HL)     ;
 $C98F CP $05        ; Check for spawn marker $05
 $C991 JR Z,$C997    ;
 $C993 CP $55        ; {Check for spawn marker $55; skip entry if neither
 $C995 JR NZ,$C9A7   ; }
*$C997 PUSH HL       ;
 $C998 PUSH BC       ;
 $C999 LD D,C        ;
 $C99A LD C,$00      ;
 $C99C LD A,$09      ;
 $C99E CALL $BA5F    ; Call $BA5F to allocate an object slot (D = row/type)
 $C9A1 POP BC        ;
 $C9A2 POP HL        ;
 $C9A3 JR C,$C9A7    ; Skip if no free slot was found (carry set)
 $C9A5 LD (HL),$33   ; Mark column byte as already spawned ($33)
*$C9A7 INC L         ;
 $C9A8 LD A,C        ;
 $C9A9 ADD A,$10     ;
 $C9AB LD C,A        ;
 $C9AC DJNZ $C98E    ; Loop 9 entries
 $C9AE RET           ;

; Advance enemy timeline: fire due entries and dispatch their commands
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every frame from $A0C4. Every 16th tick, advances the level-progress
; counter ($9BA4) and processes all timeline entries whose trigger byte matches
; it: each 3-byte entry [trigger, param D, command] either dispatches a special
; command ($FB-$FE) or, for any other value, treats it as a formation tag and
; spawns via $C9E4/$BA5F. Ends the frame's processing at the first non-matching
; or $FF entry. See docs/Level-Format.md.
c$C9AF LD HL,$9BA3   ; POKE 51631,201 patches entry to RET, disabling this
                     ; routine (No Enemies)
 $C9B2 LD A,(HL)     ;
 $C9B3 INC A         ; {Advance tick counter mod 16; act only every 16th tick
 $C9B4 AND $0F       ;
 $C9B6 LD (HL),A     ; }
 $C9B7 RET NZ        ;
 $C9B8 LD HL,$9BA4   ;
 $C9BB INC (HL)      ; Advance level-progress counter ($9BA4)
 $C9BC LD A,(HL)     ;
*$C9BD LD HL,($9BA5) ; Point at current timeline entry ($9BA5)
 $C9C0 LD A,(HL)     ;
 $C9C1 CP $FF        ; {End of table when trigger byte is $FF
 $C9C3 JR Z,$C9EB    ; }
 $C9C5 LD A,($9BA4)  ;
 $C9C8 CP (HL)       ; {Fire only when progress counter matches the trigger
 $C9C9 JR NZ,$C9EB   ; byte}
 $C9CB INC HL        ; {Read param D and command byte; advance past 3-byte
 $C9CC LD D,(HL)     ; entry
 $C9CD INC HL        ;
 $C9CE LD A,(HL)     ;
 $C9CF INC HL        ;
 $C9D0 LD ($9BA5),HL ; }
 $C9D3 CP $FC        ; {Command $FC: reset $9D1B
 $C9D5 JR Z,$C9F8    ; }
 $C9D7 CP $FE        ; {Command $FE: set $9C3B=$FF
 $C9D9 JR Z,$C9EC    ; }
 $C9DB CP $FD        ; {Command $FD: bump counter $9C69
 $C9DD JR Z,$C9F2    ; }
 $C9DF CP $FB        ; {Command $FB: screen/timing poke ($5B56/$C2E1)
 $C9E1 JR Z,$C9FE    ; }
 $C9E3 LD C,A        ; Else: command byte is a formation tag (falls into $C9E4)
 $C9E4 LD A,$01      ;
 $C9E6 CALL $BA5F    ;
 $C9E9 JR $C9BD      ;
*$C9EB RET           ;
*$C9EC LD A,$FF      ;
 $C9EE LD ($9C3B),A  ;
 $C9F1 RET           ;
*$C9F2 LD HL,$9C69   ;
 $C9F5 INC (HL)      ;
 $C9F6 JR $C9BD      ;
*$C9F8 XOR A         ;
 $C9F9 LD ($9D1B),A  ;
 $C9FC JR $C9BD      ;
*$C9FE LD A,D        ;
 $C9FF LD ($5B56),A  ;
 $CA02 SRL A         ;
 $CA04 LD ($C2E1),A  ;
 $CA07 JR $C9BD      ;

