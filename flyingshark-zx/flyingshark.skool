 $C2FB RET             ;
*$C2FC LD A,$00        ;
 $C2FE CALL $66B5      ; Add BCD score value to current player's score
*$C301 LD A,(IY+$0E)   ;
 $C304 CP $1B          ;
 $C306 JR C,$C310      ;
 $C308 LD HL,$9D18     ;
 $C30B INC (HL)        ;
 $C30C CALL $B79F      ; Mark formation slot done, trigger completion effect
                       ; when group empties
 $C30F RET             ;
