 $BCA9 LD (HL),A     ;
 $BCAA LD H,$7F      ; Switch to second attribute page ($7Fxx)
 $BCAC LD A,(IY+$0B) ; Row offset from object Y (IY+$0B/$0C)
 $BCAF AND $E0       ;
 $BCB1 OR (IY+$0C)   ;
 $BCB4 RLCA          ;
 $BCB5 RLCA          ;
 $BCB6 RLCA          ;
 $BCB7 ADD A,$04     ;
 $BCB9 LD L,A        ;
 $BCBA LD A,(HL)     ;
 $BCBB OR C          ;
 $BCBC LD (HL),A     ;
 $BCBD INC L         ;
 $BCBE LD A,(HL)     ;
 $BCBF OR C          ;
 $BCC0 LD (HL),A     ;
 $BCC1 INC L         ;
 $BCC2 LD A,(HL)     ;
 $BCC3 OR C          ;
 $BCC4 LD (HL),A     ;
 $BCC5 INC L         ;
 $BCC6 LD A,(HL)     ;
 $BCC7 OR C          ;
 $BCC8 LD (HL),A     ;
 $BCC9 INC L         ;
 $BCCA LD A,(HL)     ;
 $BCCB OR C          ;
 $BCCC LD (HL),A     ;
 $BCCD INC L         ;
 $BCCE LD A,(HL)     ;
 $BCCF OR C          ;
 $BCD0 LD (HL),A     ;
 $BCD1 INC L         ;
 $BCD2 LD A,(HL)     ;
 $BCD3 OR C          ;
 $BCD4 LD (HL),A     ;
 $BCD5 INC L         ;
 $BCD6 LD A,(HL)     ;
 $BCD7 OR C          ;
 $BCD8 LD (HL),A     ;
 $BCD9 LD SP,$0000   ; Restore SP
 $BCDC LD A,($9D19)  ;
 $BCDF AND A         ;
 $BCE0 RET Z         ; Exit if no objects to process ($9D19 counter is zero)
*$BCE1 LD B,$33      ;
*$BCE3 DJNZ $BCE3    ;
 $BCE5 DEC A         ;
 $BCE6 JR NZ,$BCE1   ;
 $BCE8 RET           ;

; Draw active objects' collision masks into attribute buffer
;
; Used by the routines at #R$A0C4 and #R$A8C0.
;
; .
;
; Called every interrupt from $A0C4 and $A8E8. Iterates the object linked list
; (via $9D18/EXX, same list style as $BC7D/$BBE5), and for each object with the
; right IY+$04 status bits, computes an attribute row from its Y position
; (IY+$0D/$0E and IY+$0B/$0C) and ORs a variable-height mask (row count from
; IX-$01/IX-$02) into the $7Exx/$7Fxx attribute buffers - building the
; per-object hit/collision mask consumed elsewhere.
c$BCE9 LD ($BD80),SP  ; Save SP (restored at $BD7F)
 $BCED LD HL,$9C70    ;
 $BCF0 LD A,(HL)      ;
 $BCF1 AND A          ;
 $BCF2 JR Z,$BD04     ; Skip row/page setup if flag at $9C70 is zero
 $BCF4 DEC (HL)       ;
 $BCF5 LD IY,($9C6D)  ;
 $BCF9 LD A,(IY+$0D)  ;
 $BCFC AND $E0        ;
 $BCFE OR (IY+$0E)    ;
 $BD01 RLCA           ;
 $BD02 RLCA           ;
 $BD03 RLCA           ;
*$BD04 LD ($BD46),A   ;
 $BD07 LD IY,($9D1E)  ;
 $BD0B LD HL,$9D18    ;
 $BD0E LD A,$08       ;
 $BD10 SUB (HL)       ;
 $BD11 LD HL,$9D1A    ;
 $BD14 ADD A,$04      ;
 $BD16 SUB (HL)       ;
 $BD17 JR Z,$BD78     ; No objects to draw: skip to cleanup
 $BD19 LD DE,$0008    ;
 $BD1C EXX            ;
 $BD1D LD B,A         ;
*$BD1E BIT 3,(IY+$04) ;
 $BD22 JR NZ,$BD92    ; Skip normal draw path if IY+$04 bit 3 is set
 $BD24 EXX            ;
 $BD25 XOR A          ;
 $BD26 BIT 0,(IY+$04) ;
 $BD2A JR NZ,$BD6E    ; Skip mask draw if IY+$04 bit 0 is set
 $BD2C BIT 5,(IY+$04) ;
 $BD30 JR Z,$BD6E     ; Skip mask draw unless IY+$04 bit 5 is set
 $BD32 LD SP,IY       ;
 $BD34 POP HL         ;
 $BD35 POP IX         ;
 $BD37 LD H,$7E       ;
 $BD39 LD A,(IY+$0D)  ;
 $BD3C AND $E0        ;
 $BD3E OR (IY+$0E)    ;
 $BD41 RLCA           ;
 $BD42 RLCA           ;
 $BD43 RLCA           ;
 $BD44 LD L,A         ;
 $BD45 CP $00         ;
 $BD47 LD A,$40       ;
 $BD49 JR C,$BD4C     ; Clamp row start if carry
 $BD4B XOR A          ;
*$BD4C LD B,(IX-$01)  ;
*$BD4F OR (HL)        ;
 $BD50 ADD HL,DE      ;
 $BD51 DJNZ $BD4F     ;
 $BD53 OR (HL)        ;
 $BD54 LD C,A         ;
 $BD55 LD H,$7F       ;
 $BD57 LD A,(IY+$0B)  ;
 $BD5A AND $E0        ;
 $BD5C OR (IY+$0C)    ;
 $BD5F RLCA           ;
 $BD60 RLCA           ;
 $BD61 RLCA           ;
 $BD62 LD L,A         ;
 $BD63 LD A,$40       ;
 $BD65 LD B,(IX-$02)  ;
*$BD68 OR (HL)        ;
 $BD69 ADD HL,DE      ;
 $BD6A DJNZ $BD68     ;
 $BD6C OR (HL)        ;
 $BD6D AND C          ;
*$BD6E LD (IY+$14),A  ;
 $BD71 LD SP,IY       ;
 $BD73 POP IY         ;
 $BD75 EXX            ;
 $BD76 DJNZ $BD1E     ; Next object
*$BD78 XOR A          ;
 $BD79 LD ($9C6B),A   ;
 $BD7C LD ($9C6C),A   ;
 $BD7F LD SP,$0000    ; Restore SP
 $BD82 LD HL,$9D1A    ;
 $BD85 LD A,($9D18)   ;
 $BD88 ADD A,(HL)     ;
 $BD89 RET Z          ;
*$BD8A LD B,$28       ;
*$BD8C DJNZ $BD8C     ;
 $BD8E DEC A          ;
 $BD8F JR NZ,$BD8A    ;
 $BD91 RET            ;
*$BD92 LD SP,IY       ;
 $BD94 POP IY         ;
 $BD96 JP $BD1E       ;

; Update randomized countdown, then enter player update ($BDAE)
;
; Used by the routine at #R$A0C4.
c$BD99 CALL $B7FE     ; Pseudo-random number generator
 $BD9C AND $01        ;
 $BD9E JR NZ,$BDAA    ;
 $BDA0 LD HL,$9C42    ;
 $BDA3 DEC (HL)       ;
 $BDA4 JR NZ,$BDAA    ;
 $BDA6 LD A,($9C43)   ;
 $BDA9 LD (HL),A      ;
*$BDAA LD IY,$9D1E    ;
*$BDAE LD HL,$9C33    ; {flip and mask border colour bits at $9C33/$9C34,
 $BDB1 LD A,(HL)      ; output to port $FE
 $BDB2 XOR $18        ;
 $BDB4 LD (HL),A      ; }
 $BDB5 INC HL         ;
 $BDB6 AND (HL)       ;
 $BDB7 OUT ($FE),A    ;
 $BDB9 LD L,(IY+$00)  ; {load player object pointer into IY, save previous IY
 $BDBC LD H,(IY+$01)  ;
 $BDBF LD ($B7E4),IY  ; }
 $BDC3 PUSH HL        ;
 $BDC4 POP IY         ;
 $BDC6 BIT 2,(IY+$04) ; branch on object state flag bit 2
 $BDCA JR Z,$BDD7     ;
*$BDCC LD A,(IY+$05)  ; {self-loop: advance frame counter, run per-frame update
 $BDCF LD HL,$A052    ; at $A052
 $BDD2 CALL $B7F6     ; }
 $BDD5 JR $BDAE       ;
*$BDD7 BIT 7,(IY+$0F) ; branch on respawn/blink flag bit 7
 $BDDB JR Z,$BDF6     ;
 $BDDD DEC (IY+$0F)   ; {count down respawn blink timer
 $BDE0 LD A,(IY+$0F)  ;
 $BDE3 CP $80         ;
 $BDE5 JR Z,$BDFB     ; }
 $BDE7 LD A,(IY+$0D)  ; {advance blink phase, loop
 $BDEA ADD A,$20      ;
 $BDEC LD (IY+$0D),A  ;
 $BDEF JR NC,$BDF4    ; }
 $BDF1 INC (IY+$0E)   ;
*$BDF4 JR $BDAE       ;
*$BDF6 DEC (IY+$0F)   ; count down remaining blink cycles
 $BDF9 JR NZ,$BDAE    ;
*$BDFB SET 2,(IY+$04) ; {clear blink state, resume normal update
 $BDFF JR $BDCC       ; }

; Player frozen: unwind an extra call level, then no-op
;
; .
;
; .
;
; Handler for index $2A of the $A000 jump table (see $B7F6).
c$BE01 POP HL        ;

; Player idle: no-op
;
; .
;
; .
;
; Handler for index $29 of the $A000 jump table (see $B7F6).
c$BE02 RET           ;

; Player: skip movement if immobilised, else read input and move
;
; .
;
; .
;
; Handler for index $2B of the $A000 jump table (see $B7F6).
c$BE03 LD A,($9C3B)  ; {skip movement if immobilised flag at $9C3B set
 $BE06 AND A         ;
 $BE07 JP NZ,$BED4   ; }
 $BE0A LD A,(IY+$18) ; {count down invulnerability timer, refresh sprite frame
 $BE0D CP $FF        ; when it expires
 $BE0F JR Z,$BE20    ;
 $BE11 AND $07       ;
 $BE13 LD (IY+$06),A ;
 $BE16 DEC (IY+$18)  ; }
 $BE19 LD DE,$0000   ;
 $BE1C CALL Z,$C5AF  ; Start object explosion sequence
 $BE1F RET           ;
*$BE20 LD A,($9C6B)  ; {check immunity flag at $9C6B
 $BE23 AND $80       ; }
 $BE25 JR Z,$BE2B    ; POKE 48677,24 forces unconditional JR, disabling damage
                     ; call (Immunity alt)
 $BE27 CALL $BF22    ; Handle player hit
 $BE2A RET           ;
*$BE2B CALL $68B1    ; Read input
 $BE2E LD A,($9CDE)  ; {decode horizontal direction bits from input (Kempston
 $BE31 LD C,A        ; layout: bit 0=Right, bit 1=Left)
 $BE32 AND $03       ;
 $BE34 LD B,$01      ; }
 $BE36 JR Z,$BE65    ; no horizontal input: skip straight to vertical/banking
                     ; step
 $BE38 LD L,(IY+$0B) ; {load X position, DE=step distance $0060
 $BE3B LD H,(IY+$0C) ;
 $BE3E LD DE,$0060   ; }
 $BE41 RRA           ; {shift Right bit into carry; assume bank-right target
 $BE42 LD B,$02      ; (B=2)}
 $BE44 JR C,$BE4C    ; if Right held, branch to add step ($BE4C)
 $BE46 LD B,$00      ; {Left held: bank-left target (B=0), subtract step
 $BE48 SBC HL,DE     ; }

; Clamp player position to screen bounds, update bank animation
;
; .
;
; .
;
; Clamps the player object's X position ($IY+0B/0C) between $0700 and $18E0,
; then its Y position (IY+0D/0E) between $0300 and $18E0, then steps a "bank
; angle" frame (IY+16, target IY+17) toward its target by 1 per call (with a
; short delay after a direction change) and looks up the resulting sprite frame
; from a table at $9B4C. Entered from $BE2E/$BE4C with B already set to the
; bank-frame target: 2 if Right is held (X increasing), 0 if Left is held (X
; decreasing), 1 if neither (level flight, no X movement) - this is the actual
; Left/Right-to-plane-tilt conversion.
c$BE4A JR $BE4D        ; entry: X delta already applied, skip add
; This entry point is used by the routine at #R$BE03.
*$BE4C ADD HL,DE       ; entry: add X delta (HL+=DE)
*$BE4D LD A,H          ; {check X within left bound
 $BE4E SUB $07         ;
 $BE50 JP P,$BE58      ; }
 $BE53 LD HL,$0700     ; {clamp X to left edge ($0700)
 $BE56 JR $BE5F        ; }
*$BE58 CP $12          ; {check X within right bound
 $BE5A JR C,$BE5F      ; }
 $BE5C LD HL,$18E0     ; clamp X to right edge ($18E0)
*$BE5F LD (IY+$0B),L   ; {store clamped X position
 $BE62 LD (IY+$0C),H   ; }
; This entry point is used by the routine at #R$BE03.
*$BE65 LD (IY+$17),B   ; {save frame-select param; decode vertical direction
 $BE68 LD A,C          ; bits
 $BE69 AND $0C         ;
 $BE6B RRA             ;
 $BE6C RRA             ; }
 $BE6D JR Z,$BE98      ; skip vertical move if no direction bit set
 $BE6F LD L,(IY+$0D)   ; {load Y position, DE=step size
 $BE72 LD H,(IY+$0E)   ;
 $BE75 LD DE,$0060     ; }
 $BE78 RRA             ; {check vertical direction bit
 $BE79 JR C,$BE7F      ; }
 $BE7B SBC HL,DE       ; {move up
 $BE7D JR $BE80        ; }
*$BE7F ADD HL,DE       ; move down
*$BE80 LD A,H          ; {check Y within top bound
 $BE81 SUB $03         ;
 $BE83 JP P,$BE8B      ; }
 $BE86 LD HL,$0300     ; {clamp Y to top edge ($0300)
 $BE89 JR $BE92        ; }
*$BE8B CP $16          ; {check Y within bottom bound
 $BE8D JR C,$BE92      ; }
 $BE8F LD HL,$18E0     ; clamp Y to bottom edge ($18E0)
*$BE92 LD (IY+$0D),L   ; {store clamped Y position
 $BE95 LD (IY+$0E),H   ; }
*$BE98 LD A,(IY+$16)   ; {read current bank frame; check banking-in-progress
 $BE9B BIT 4,(IY+$04)  ; flag}
 $BE9F JR NZ,$BEAE     ; skip if already banking
 $BEA1 CP (IY+$17)     ; {no bank change needed if already at target
 $BEA4 JR Z,$BEC7      ; }
 $BEA6 SET 4,(IY+$04)  ; {start banking, set delay timer=5
 $BEAA LD (IY+$15),$05 ; }
*$BEAE DEC (IY+$15)    ; {count down bank-delay timer
 $BEB1 JR NZ,$BEC7     ; }
 $BEB3 RES 4,(IY+$04)  ; {clear banking flag; compare target vs current bank
 $BEB7 LD A,(IY+$17)   ;
 $BEBA LD C,(IY+$16)   ; }
 $BEBD CP C            ;
 $BEBE JR Z,$BEC7      ;
 $BEC0 SBC A,A         ; {step current bank frame toward target by 1
 $BEC1 OR $01          ;
 $BEC3 ADD A,C         ;
 $BEC4 LD (IY+$16),A   ; }
*$BEC7 LD H,$9B        ; {index sprite-frame table by bank value
 $BEC9 ADD A,$4C       ;
 $BECB LD L,A          ;
 $BECC LD A,(HL)       ; }
 $BECD LD (IY+$06),A   ; store new sprite frame
 $BED0 CALL $BF42      ; Use bomb
 $BED3 RET             ;
; This entry point is used by the routine at #R$BE03.
*$BED4 LD HL,$9C3B     ;
 $BED7 AND A           ;
 $BED8 JP P,$BF1A      ;
 $BEDB LD A,(IY+$0E)   ;
 $BEDE CP $11          ;
 $BEE0 JR NZ,$BEF2     ;
 $BEE2 LD A,(IY+$0C)   ;
 $BEE5 CP $0E          ;
 $BEE7 JR NZ,$BEF2     ;
 $BEE9 LD (IY+$06),$06 ;
 $BEED LD A,$38        ;
 $BEEF ADD A,(HL)      ;
 $BEF0 LD (HL),A       ;
 $BEF1 RET             ;
*$BEF2 DEC (HL)        ;
 $BEF3 LD IX,$9CB5     ;
 $BEF7 CALL $B845      ; Compute angle from object IX to target IY
 $BEFA LD B,$03        ;
 $BEFC CALL $B8A2      ; Compute velocity vector (dx,dy) from angle and speed
 $BEFF CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $BF02 LD A,(IY+$0C)   ;
 $BF05 CP $0E          ;
 $BF07 LD (IY+$06),$06 ;
 $BF0B RET Z           ;
 $BF0C BIT 7,(IY+$07)  ;
 $BF10 LD (IY+$06),$04 ;
 $BF14 RET Z           ;
 $BF15 LD (IY+$06),$00 ;
 $BF19 RET             ;
*$BF1A DEC (HL)        ;
 $BF1B RET NZ          ;
 $BF1C LD A,$03        ;
 $BF1E CALL $A599      ; Ratchet player state forward
 $BF21 RET             ;

; Handle player hit: switch to hit/explosion animation, arm recovery timer
;
; Used by the routine at #R$BE03.
;
; IY player object base (inherited from $BDAE's caller)
;
; Called from $BDAE right after the immunity flag check fails (both immunity
; POKEs disable that call). Tags the object at $9C77 (the thing that hit the
; player) with the current wave/formation id from $9BA4, then repoints the
; player's per-frame update-routine pointer (IY+2/+3, little-endian) to $6B86 -
; the hit/explosion animation handler, same pointer-swap trick used by $C5AF
; for enemies - and arms a 38-frame ($26) timer at $9C3C, presumably the
; death/respawn delay.
c$BF22 LD IX,($9C77)   ; IX = object that hit the player
 $BF26 LD A,($9BA4)    ; {tag it with current wave/formation id
 $BF29 LD (IX+$07),A   ; }
 $BF2C LD (IY+$18),$0E ; {arm hit-reaction timer; point player's per-frame
 $BF30 LD (IY+$02),$86 ; handler at $6B86...}
 $BF34 LD (IY+$03),$6B ; {...(hit/explosion animation); set visual state
 $BF38 LD (IY+$06),$06 ; }
 $BF3C LD A,$26        ; {arm 38-frame recovery/death timer at $9C3C
 $BF3E LD ($9C3C),A    ; }
 $BF41 RET             ; return

; Use bomb: consume inventory, trigger flash effect
;
; Used by the routine at #R$BE4A.
;
; .
;
; Triggered when the input state at $9CDC equals $09. Decrements the player's
; bomb count (IX+9, confirmed via $66DE), sets bit 2 of the deferred-event mask
; $9C27, adds to a bonus accumulator ($9C70), and points the screen-flash
; sequence pointer $9C5B at $9C5E - the same mechanism $6A88 and $C72A use for
; the corner-box/screen flash. Once the input state reaches exactly 1 (key
; released), it also allocates a new object from the free-list pool ($9D1C,
; same trick as $C559), copies initial fields from a spawn-parameter data table
; at $6BB9 (BC points there; NOT a code handler), and positions it at the
; player's location (from IY+0D/0E) - spawning the actual bomb-explosion
; object.
c$BF42 LD DE,$9CDC     ;
 $BF45 LD A,(DE)       ;
 $BF46 CP $09          ; {Trigger only when input state ($9CDC) is $09
 $BF48 JR NZ,$BF6A     ; }
 $BF4A LD IX,($9C77)   ;
 $BF4E LD A,(IX+$09)   ;
 $BF51 AND A           ;
 $BF52 JR Z,$BF6A      ;
 $BF54 DEC (IX+$09)    ; Consume one bomb (IX+$09)
 $BF57 LD HL,$9C27     ;
 $BF5A SET 2,(HL)      ; Request the screen-flash deferred event ($9C27 bit 2)
 $BF5C LD HL,$9C70     ;
 $BF5F LD A,($9C6F)    ;
 $BF62 ADD A,(HL)      ;
 $BF63 LD (HL),A       ;
 $BF64 LD HL,$9C5E     ;
 $BF67 LD ($9C5B),HL   ;
*$BF6A LD A,(DE)       ;
 $BF6B DEC A           ; {Spawn only once input state reaches 1 (key released)
 $BF6C RET NZ          ; }
 $BF6D LD ($BFE3),SP   ;
 $BF71 LD BC,$6BB9     ; BC = spawn-parameter table $6BB9
 $BF74 EXX             ;
 $BF75 LD DE,($9C73)   ; {DE = per-type spawn data ($9C73); B = object count
 $BF79 LD A,(DE)       ;
 $BF7A INC DE          ;
 $BF7B LD B,A          ; }
 $BF7C LD HL,$9D19     ;
*$BF7F LD A,($9C72)    ; {Skip spawn if the object pool is full (difficulty
 $BF82 ADD A,A         ; $9C72 vs $9D19)
 $BF83 NEG             ;
 $BF85 ADD A,$06       ;
 $BF87 CP (HL)         ;
 $BF88 JR NC,$BFE2     ; }
 $BF8A DEC (HL)        ;
 $BF8B EXX             ;
 $BF8C LD IX,($9D1C)   ; {Pop a free object slot ($9D1C)
 $BF90 LD SP,IX        ;
 $BF92 POP HL          ;
 $BF93 LD ($9D1C),HL   ;
 $BF96 POP HL          ;
 $BF97 PUSH BC         ; }
 $BF98 LD HL,($9D30)   ;
 $BF9B PUSH HL         ;
 $BF9C LD ($9D30),SP   ;
 $BFA0 EXX             ;
 $BFA1 SET 2,(IX+$04)  ;
 $BFA5 LD (IX+$05),$03 ;
 $BFA9 LD (IX+$06),$06 ;
 $BFAD LD (IX+$13),$FF ;
 $BFB1 LD (IX+$09),$00 ;
 $BFB5 LD (IX+$0A),$FE ;
 $BFB9 LD A,(IY+$0D)   ; {Position new object at the player (IY+$0D/$0E)
 $BFBC LD (IX+$0D),A   ;
 $BFBF LD A,(IY+$0E)   ;
 $BFC2 DEC A           ;
 $BFC3 LD (IX+$0E),A   ; }
 $BFC6 LD A,(DE)       ; {Copy velocity/offset fields from spawn data
 $BFC7 INC DE          ;
 $BFC8 ADD A,(IY+$0B)  ;
 $BFCB LD (IX+$0B),A   ;
 $BFCE LD A,(DE)       ;
 $BFCF INC DE          ;
 $BFD0 ADC A,(IY+$0C)  ;
 $BFD3 LD (IX+$0C),A   ;
 $BFD6 LD A,(DE)       ; }
 $BFD7 LD (IX+$07),A   ;
 $BFDA INC DE          ;
 $BFDB LD A,(DE)       ;
 $BFDC LD (IX+$08),A   ;
 $BFDF INC DE          ;
 $BFE0 DJNZ $BF7F      ; Next object
*$BFE2 LD SP,$0000     ; Restore SP
 $BFE5 LD A,$01        ;
 $BFE7 CALL $A1D4      ; Request sound effect if higher priority than current
 $BFEA RET             ;

; Check for bullet hit, start explosion
;
; .
;
; .
;
; Handler for index $2C of the $A000 jump table (see $B7F6).
c$BFEB LD A,($9C6B)  ;
 $BFEE AND (IY+$14)  ;
 $BFF1 JR Z,$C002    ;
 $BFF3 LD HL,$9C6C   ;
 $BFF6 AND (HL)      ;
 $BFF7 JR Z,$C00D    ;
 $BFF9 LD (HL),$00   ;
 $BFFB LD DE,$9D19   ;
 $BFFE CALL $C5AF    ; Start object explosion sequence
 $C001 RET           ;
*$C002 CALL $BA0A    ; Apply object velocity (dx,dy) to position
 $C005 LD A,(IY+$0E) ;
 $C008 CP $02        ;
 $C00A JR C,$C00D    ;
 $C00C RET           ;
*$C00D LD HL,$9D19   ;
 $C010 INC (HL)      ;
 $C011 CALL $B79F    ; Mark formation slot done, trigger completion effect when
                     ; group empties
 $C014 RET           ;

; Launch and move projectile; explode on hit
;
; .
;
; .
;
; Handler for index $36 of the $A000 jump table (see $B7F6).
; .
; On first call (IY+10 != $FF) computes a launch velocity via $B8A2 from angle
; IY+10/speed IY+11, then marks IY+10=$FF so it only fires once. Every call
; then moves the object via $BA0A. If flag bit 5 of IY+4 is set and IY+14
; indicates a hit (bit 7 set, not bit 6), sets the global hit flag at $9C6B and
; starts an explosion via $C5AF; otherwise, once flag bit 5 is clear, retires
; the object and signals formation completion via $B79F.
c$C015 LD A,(IY+$10)   ;
 $C018 CP $FF          ;
 $C01A JP Z,$C02A      ;
 $C01D LD B,(IY+$11)   ;
 $C020 CALL $B8A2      ; Compute velocity vector (dx,dy) from angle and speed
 $C023 CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $C026 LD (IY+$10),$FF ;
*$C02A CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $C02D BIT 5,(IY+$04)  ;
 $C031 JR Z,$C049      ;
 $C033 LD A,(IY+$14)   ;
 $C036 BIT 6,A         ;
 $C038 JR NZ,$C049     ;
 $C03A AND $80         ;
 $C03C RET Z           ;
 $C03D LD HL,$9C6B     ;
 $C040 SET 7,(HL)      ;
 $C042 LD DE,$9D1A     ;
 $C045 CALL $C5AF      ; Start object explosion sequence
 $C048 RET             ;
*$C049 LD HL,$9D1A     ;
 $C04C INC (HL)        ;
 $C04D CALL $B79F      ; Mark formation slot done, trigger completion effect
                       ; when group empties
 $C050 RET             ;

; Move straight down at fixed speed; advance animation frame
;
; .
;
; .
;
; Handler for index $2D of the $A000 jump table (see $B7F6).
c$C051 LD A,(IY+$0D) ; {add fixed step $20 to Y position low byte
 $C054 ADD A,$20     ;
 $C056 LD (IY+$0D),A ; }
 $C059 JR NC,$C05E   ; {carry into Y position high byte
 $C05B INC (IY+$0E)  ; }
*$C05E LD A,(IY+$06) ; {advance animation frame, check wrap at 16
 $C061 INC A         ;
 $C062 CP $10        ; }
 $C064 JR Z,$C06A    ; branch when frame wraps
