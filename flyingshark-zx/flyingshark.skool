; Initialize IM 2 interrupt vector table and set light ISR
;
; Used by the routine at #R$A5A5.
;
; .
;
; Standard IM 2 setup: I=$FE (vector table at $FE00), fills $FE00-$FFFF with
; $FD so every vector reads the byte at $FDFD, which is set to $C3 (JP opcode)
; - making $FDFD/$FDFE act as a self-modifying "JP (isr-handler)" trampoline
; used by $A0C4/$A0B0 elsewhere. Points that trampoline at $A0B0 (the
; light/per-frame ISR) before returning.
c$7D00 DI            ;
 $7D01 LD A,$FE      ;
 $7D03 LD I,A        ;
 $7D05 IM 2          ;
 $7D07 LD HL,$FE00   ;
 $7D0A LD A,$FD      ;
*$7D0C LD (HL),A     ;
