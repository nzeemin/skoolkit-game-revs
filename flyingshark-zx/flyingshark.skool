; Copy 8-wide screen strips (SP-trick, screen-third aware)
;
; .
;
; .
;
; Handler for index $11 of the #R$A000 jump table (see #R$B7F6). Copies
; vertical 8-byte-wide strips of screen memory using an SP/EX (SP),HL trick to
; alternate source and destination pointers: each row LDIs 8 bytes then
; advances by $0024. Column source at $9C0F is range-checked against $C8 to
; pick which of three copy loops runs (#R$B577 plain, #R$B599 with INC H,
; #R$B5CE with DEC H) so the copy steps correctly across the ZX screen's
; non-linear thirds. Continues into the formation script (#R$AFB8).
c$B55E LD HL,($9C11) ;
 $B561 LD BC,($9C19) ; {Row count from $9C19 (+1)
 $B565 INC C         ; }
 $B566 EXX           ;
 $B567 LD HL,($9C0F) ;
 $B56A LD A,L        ;
 $B56B EXX           ;
 $B56C CP $C8        ; {Pick copy variant by column vs $C8 (screen-third
 $B56E JR C,$B571    ; boundary)}
 $B570 DEC C         ;
*$B571 LD DE,$0024   ;
 $B574 DJNZ $B596    ;
 $B576 LD B,C        ;
*$B577 LD SP,HL      ; Point SP at strip for the pointer-swap trick
 $B578 EXX           ;
 $B579 LD L,A        ;
 $B57A EX (SP),HL    ; {Swap source/dest pointers via EX (SP),HL
 $B57B POP DE        ; }
 $B57C LDI           ; {Copy 8 bytes of this strip row
 $B57E LDI           ;
 $B580 LDI           ;
 $B582 LDI           ;
 $B584 LDI           ;
 $B586 LDI           ;
 $B588 LDI           ;
 $B58A LDI           ; }
 $B58C EX DE,HL      ;
 $B58D EXX           ;
 $B58E ADD A,$08     ; {Advance column (+8) and dest row (+$24)
 $B590 ADD HL,DE     ; }
 $B591 DJNZ $B577    ; Loop rows
 $B593 JP $AFB8      ; => Formation script
*$B596 DJNZ $B5CE    ;
 $B598 LD B,C        ;
*$B599 LD SP,HL      ;
 $B59A EXX           ;
 $B59B LD L,A        ;
 $B59C EX (SP),HL    ;
 $B59D POP DE        ;
 $B59E LDI           ;
 $B5A0 LDI           ;
 $B5A2 LDI           ;
 $B5A4 LDI           ;
 $B5A6 LDI           ;
 $B5A8 LDI           ;
 $B5AA LDI           ;
 $B5AC LDI           ;
 $B5AE EX DE,HL      ;
 $B5AF INC H         ;
 $B5B0 LD L,A        ;
 $B5B1 EX (SP),HL    ;
 $B5B2 POP DE        ;
 $B5B3 LDI           ;
 $B5B5 LDI           ;
 $B5B7 LDI           ;
 $B5B9 LDI           ;
 $B5BB LDI           ;
 $B5BD LDI           ;
 $B5BF LDI           ;
 $B5C1 LDI           ;
 $B5C3 EX DE,HL      ;
 $B5C4 DEC H         ;
 $B5C5 EXX           ;
 $B5C6 ADD A,$08     ;
 $B5C8 ADD HL,DE     ;
 $B5C9 DJNZ $B599    ;
 $B5CB JP $AFB8      ; => Formation script
*$B5CE LD B,C        ;
*$B5CF LD SP,HL      ;
 $B5D0 EXX           ;
 $B5D1 LD L,A        ;
 $B5D2 EX (SP),HL    ;
 $B5D3 POP DE        ;
 $B5D4 LDI           ;
 $B5D6 LDI           ;
 $B5D8 LDI           ;
 $B5DA LDI           ;
 $B5DC LDI           ;
 $B5DE LDI           ;
 $B5E0 LDI           ;
 $B5E2 LDI           ;
 $B5E4 EX DE,HL      ;
 $B5E5 INC H         ;
 $B5E6 LD L,A        ;
 $B5E7 EX (SP),HL    ;
 $B5E8 POP DE        ;
 $B5E9 LDI           ;
 $B5EB LDI           ;
 $B5ED LDI           ;
 $B5EF LDI           ;
 $B5F1 LDI           ;
 $B5F3 LDI           ;
 $B5F5 LDI           ;
 $B5F7 LDI           ;
 $B5F9 EX DE,HL      ;
 $B5FA INC H         ;
 $B5FB LD L,A        ;
 $B5FC EX (SP),HL    ;
 $B5FD POP DE        ;
 $B5FE LDI           ;
 $B600 LDI           ;
 $B602 LDI           ;
 $B604 LDI           ;
 $B606 LDI           ;
 $B608 LDI           ;
 $B60A LDI           ;
 $B60C LDI           ;
 $B60E EX DE,HL      ;
 $B60F DEC H         ;
 $B610 DEC H         ;
 $B611 EXX           ;
 $B612 ADD A,$08     ;
 $B614 ADD HL,DE     ;
 $B615 DJNZ $B5CF    ;
 $B617 JP $AFB8      ; => Formation script

; Copy 8-wide screen strips with transparency skip (screen-third aware)
;
; .
;
; .
;
; Handler for index $12 of the #R$A000 jump table (see #R$B7F6). Like #R$B55E,
; copies vertical 8-byte-wide screen strips via the SP/EX trick with three
; screen-third variants, but tests each strip's high byte (AND $7E) and skips
; the copy when zero - a transparent-strip blit. Continues into the formation
; script (#R$AFB8).
c$B61A LD HL,($9C11)  ;
 $B61D LD BC,($9C19)  ; {Row count from $9C19 (+1)
 $B621 INC C          ; }
 $B622 EXX            ;
 $B623 LD DE,($9C0F)  ;
 $B627 LD A,E         ;
 $B628 LD B,E         ;
 $B629 LD C,$FF       ;
 $B62B EXX            ;
 $B62C CP $C8         ; {Pick copy variant by column vs $C8 (screen-third
 $B62E JR C,$B631     ; boundary)}
 $B630 DEC C          ;
*$B631 LD DE,$0024    ;
 $B634 DJNZ $B66B     ;
 $B636 LD B,C         ;
*$B637 LD SP,HL       ; Point SP at this strip
 $B638 EXX            ;
 $B639 LD E,B         ;
 $B63A POP HL         ; Read the strip's first word
 $B63B LD A,H         ; {Skip strip if high byte masks to zero (transparent)
 $B63C AND $7E        ;
 $B63E JR Z,$B652     ; }
 $B640 PUSH DE        ;
 $B641 POP DE         ;
 $B642 LDI            ; {Copy 8 bytes of this strip
 $B644 LDI            ;
 $B646 LDI            ;
 $B648 LDI            ;
 $B64A LDI            ;
 $B64C LDI            ;
 $B64E LDI            ;
 $B650 LDI            ; }
*$B652 LD A,B         ;
 $B653 ADD A,$08      ; {Advance column (+8)
 $B655 LD B,A         ; }
 $B656 EXX            ;
 $B657 ADD HL,DE      ; Advance dest row (+$24)
 $B658 DJNZ $B637     ; Loop rows
 $B65A LD A,C         ;
 $B65B ADD A,A        ;
 $B65C ADD A,A        ;
 $B65D ADD A,A        ;
 $B65E EXX            ;
 $B65F ADD A,C        ;
 $B660 INC A          ;
 $B661 JP Z,$AFB8     ; => Formation script
 $B664 SET 0,(IY+$04) ; Set redraw flag (IY+$04 bit 0)
 $B668 JP $AFB8       ; => Formation script
*$B66B DJNZ $B6BE     ;
 $B66D LD B,C         ;
*$B66E LD SP,HL       ;
 $B66F EXX            ;
 $B670 LD E,B         ;
 $B671 POP HL         ;
 $B672 LD A,H         ;
 $B673 AND $7E        ;
 $B675 JR Z,$B689     ;
 $B677 PUSH DE        ;
 $B678 POP DE         ;
 $B679 LDI            ;
 $B67B LDI            ;
 $B67D LDI            ;
 $B67F LDI            ;
 $B681 LDI            ;
 $B683 LDI            ;
 $B685 LDI            ;
 $B687 LDI            ;
*$B689 INC D          ;
 $B68A LD E,B         ;
 $B68B POP HL         ;
 $B68C LD A,H         ;
 $B68D AND $7E        ;
 $B68F JR Z,$B6A3     ;
 $B691 PUSH DE        ;
 $B692 POP DE         ;
 $B693 LDI            ;
 $B695 LDI            ;
 $B697 LDI            ;
 $B699 LDI            ;
 $B69B LDI            ;
 $B69D LDI            ;
 $B69F LDI            ;
 $B6A1 LDI            ;
*$B6A3 DEC D          ;
 $B6A4 LD A,B         ;
 $B6A5 ADD A,$08      ;
 $B6A7 LD B,A         ;
 $B6A8 EXX            ;
 $B6A9 ADD HL,DE      ;
 $B6AA DJNZ $B66E     ;
 $B6AC LD A,C         ;
 $B6AD ADD A,A        ;
 $B6AE ADD A,A        ;
 $B6AF ADD A,A        ;
 $B6B0 ADD A,A        ;
 $B6B1 EXX            ;
 $B6B2 ADD A,C        ;
 $B6B3 INC A          ;
 $B6B4 JP Z,$AFB8     ; => Formation script
 $B6B7 SET 0,(IY+$04) ;
 $B6BB JP $AFB8       ; => Formation script
*$B6BE LD B,C         ;
*$B6BF LD SP,HL       ;
 $B6C0 EXX            ;
 $B6C1 LD E,B         ;
 $B6C2 POP HL         ;
 $B6C3 LD A,H         ;
 $B6C4 AND $7E        ;
 $B6C6 JR Z,$B6DA     ;
 $B6C8 PUSH DE        ;
 $B6C9 POP DE         ;
 $B6CA LDI            ;
 $B6CC LDI            ;
 $B6CE LDI            ;
 $B6D0 LDI            ;
 $B6D2 LDI            ;
 $B6D4 LDI            ;
 $B6D6 LDI            ;
 $B6D8 LDI            ;
*$B6DA INC D          ;
 $B6DB LD E,B         ;
 $B6DC POP HL         ;
 $B6DD LD A,H         ;
 $B6DE AND $7E        ;
 $B6E0 JR Z,$B6F4     ;
 $B6E2 PUSH DE        ;
 $B6E3 POP DE         ;
 $B6E4 LDI            ;
 $B6E6 LDI            ;
 $B6E8 LDI            ;
 $B6EA LDI            ;
 $B6EC LDI            ;
 $B6EE LDI            ;
 $B6F0 LDI            ;
 $B6F2 LDI            ;
*$B6F4 INC D          ;
 $B6F5 LD E,B         ;
 $B6F6 POP HL         ;
 $B6F7 LD A,H         ;
 $B6F8 AND $7E        ;
 $B6FA JR Z,$B70E     ;
 $B6FC PUSH DE        ;
 $B6FD POP DE         ;
 $B6FE LDI            ;
 $B700 LDI            ;
 $B702 LDI            ;
 $B704 LDI            ;
 $B706 LDI            ;
 $B708 LDI            ;
 $B70A LDI            ;
 $B70C LDI            ;
*$B70E DEC D          ;
 $B70F DEC D          ;
 $B710 LD A,B         ;
 $B711 ADD A,$08      ;
 $B713 LD B,A         ;
 $B714 EXX            ;
 $B715 ADD HL,DE      ;
 $B716 DJNZ $B6BF     ;
 $B718 LD A,C         ;
 $B719 ADD A,A        ;
 $B71A ADD A,C        ;
 $B71B ADD A,A        ;
 $B71C ADD A,A        ;
 $B71D ADD A,A        ;
 $B71E EXX            ;
 $B71F ADD A,C        ;
 $B720 INC A          ;
 $B721 CP $19         ;
 $B723 JP C,$AFB8     ; => Formation script
 $B726 SET 0,(IY+$04) ;
 $B72A JP $AFB8       ; => Formation script

; => Formation script
;
; .
;
; .
;
; Handler for index $13 of the #R$A000 jump table (see #R$B7F6).
@label=jp_formation_dispatch
c$B72D JP $AFB8      ; => Formation script

; Initialize wave: build object pool, reset counts, spawn first object
;
; Used by the routine at #R$A612.
;
; .
;
; Builds the 19-slot object free-list at $9D40 (linked via IY+0/+1, head at
; $9D1C), inits 4 fixed slots at $9D1E (stride 6, "active"+"alive" flags set),
; clears the 15-byte formation-slot bitmap at $9B4F, sets four per-group enemy
; counts ($9D19=6/$9D18=8/$9D1A=4/$9D1B=1, totalling 19 = pool size), then
; allocates the first object via #R$C559. Called by $A696.
c$B730 LD HL,$9D40     ;
 $B733 LD ($9D1C),HL   ; Free-list head ($9D1C) = first pool slot
 $B736 LD IY,$9D40     ;
 $B73A LD HL,$9D5D     ;
 $B73D LD DE,$001D     ;
 $B740 LD B,$13        ;
*$B742 LD (IY+$00),L   ; {Link each slot to the next (IY+0/+1), clear IY+$14
 $B745 LD (IY+$01),H   ;
 $B748 LD (IY+$14),$00 ; }
 $B74C ADD IY,DE       ;
 $B74E ADD HL,DE       ;
 $B74F DJNZ $B742      ; Loop 19 pool slots
 $B751 LD IY,$9D1E     ;
 $B755 LD HL,$9D24     ;
 $B758 LD DE,$0006     ;
 $B75B LD B,$04        ;
 $B75D SET 3,(IY+$04)  ; {Init 4 fixed slots: set active+alive flags
 $B761 SET 2,(IY+$04)  ; }
*$B765 LD (IY+$00),L   ; {Store next-pointer, advance to next fixed slot
 $B768 LD (IY+$01),H   ;
 $B76B ADD IY,DE       ; }
 $B76D SET 3,(IY+$04)  ;
 $B771 SET 2,(IY+$04)  ;
 $B775 ADD HL,DE       ;
 $B776 DJNZ $B765      ;
 $B778 LD HL,$9B4F     ;
 $B77B LD DE,$9B50     ;
 $B77E LD BC,$000F     ;
 $B781 LD (HL),$00     ; {Clear the 15-byte formation-slot bitmap ($9B4F)
 $B783 LDIR            ; }
 $B785 LD A,$06        ; {Set the four per-group enemy counts
 $B787 LD ($9D19),A    ;
 $B78A LD A,$08        ;
 $B78C LD ($9D18),A    ;
 $B78F LD A,$04        ;
 $B791 LD ($9D1A),A    ;
 $B794 LD A,$01        ;
 $B796 LD ($9D1B),A    ; }
 $B799 DI              ;
 $B79A CALL $C559      ; Allocate object from free-list pool and initialize
 $B79D EI              ;
 $B79E RET             ;

; Mark formation slot done, trigger completion effect when group empties
;
; Used by the routines at #R$BFEB, #R$C015, #R$C075, #R$C11C, #R$C199, #R$C298,
; #R$C31A, #R$C359, #R$C388 and #R$C3C7.
;
; IY object struct base
;
; Clears/masks a bit in a table at $9B50 (indexed by IY+13, a formation-slot
; id) then decrements an adjacent per-formation counter; when that counter
; reaches zero, marks the slot done (IY+13=$FF) and either calls #R$C648 or
; #R$C5D2 (start explosion) depending on the $9C3F flag, then decrements a
; group counter at $9D18. Entry at #R$B79F uses C=0 (set bit), entry at #R$B7A3
; uses C=$FF (clear bit) - exact meaning of the $9B50 bitmap not yet confirmed.
; The tail from #R$B7DC onward (an SP=IY stack trick) is not yet analyzed.
c$B79F LD C,$00        ; {entry: normal call, C=0
 $B7A1 JR $B7A6        ; }
; This entry point is used by the routine at #R$C051.
*$B7A3 LD C,$FF        ; {entry: alternate call, C=$FF
 $B7A5 NOP             ; }
*$B7A6 LD (IY+$14),$00 ; {clear flag at IY+14; read formation-slot index from
 $B7AA LD A,(IY+$13)   ; IY+13}
 $B7AD CP $FF          ; {skip if slot unused ($FF)
 $B7AF JR Z,$B7DC      ; }
 $B7B1 ADD A,A         ; {index into bitmap table $9B50, mask bit via C
 $B7B2 ADD A,$50       ;
 $B7B4 LD L,A          ;
 $B7B5 LD H,$9B        ;
 $B7B7 LD A,(HL)       ;
 $B7B8 AND C           ; }
 $B7B9 LD (HL),A       ; write back masked bitmap byte
 $B7BA DEC L           ; {decrement adjacent slot counter; skip if still
 $B7BB DEC (HL)        ; nonzero
 $B7BC JR NZ,$B7DC     ; }
 $B7BE AND A           ; {skip if counter was already zero
 $B7BF JR Z,$B7DC      ; }
 $B7C1 LD (IY+$13),$FF ; {mark slot done; check completion mode
 $B7C5 CP $01          ; }
 $B7C7 JR Z,$B7CE      ; branch to alternate completion path
 $B7C9 CALL $C648      ; {Decrement wave-group counter
 $B7CC JR $B7D7        ; }
*$B7CE LD A,($9C3F)    ; {check game mode flag at $9C3F
 $B7D1 AND A           ;
 $B7D2 JR NZ,$B7DC     ; }
 $B7D4 CALL $C5D2      ; Convert object to explosion
*$B7D7 LD HL,$9D18     ; {decrement group counter at $9D18, return
 $B7DA DEC (HL)        ;
 $B7DB RET             ; }
*$B7DC LD ($B7EF),SP   ;
 $B7E0 LD SP,IY        ;
 $B7E2 POP HL          ;
 $B7E3 LD ($0000),HL   ;
 $B7E6 LD HL,($9D1C)   ;
 $B7E9 PUSH HL         ;
 $B7EA LD ($9D1C),SP   ;
 $B7EE LD SP,$0000     ;
 $B7F1 LD IY,($B7E4)   ;
 $B7F5 RET             ;

; Jump-table dispatcher: JP to word-sized table entry A
;
; Used by the routines at #R$A13A, #R$A3A0, #R$A561, #R$A773, #R$B8F9, #R$B941
; and #R$BD99.
;
; A word index into the jump table
; HL jump table base address
@label=jump_table_dispatch
c$B7F6 ADD A,A       ;
 $B7F7 ADD A,L       ;
 $B7F8 LD L,A        ;
 $B7F9 LD A,(HL)     ;
 $B7FA INC HL        ;
 $B7FB LD H,(HL)     ;
 $B7FC LD L,A        ;
 $B7FD JP (HL)       ;

; Pseudo-random number generator (advances LFSR state at $9C2B-$9C32)
;
; Used by the routines at #R$B920, #R$BA43, #R$BA4F, #R$BD99, #R$C075, #R$C43C
; and #R$C5D2.
;
; O:A pseudo-random byte
;   BC,DE,HL preserved (saved into self-modified operands at entry, restored
; .          before RET)
@label=random
c$B7FE LD ($B842),HL ; Self-modify: save caller's HL (restored at $B841)
 $B801 LD ($B83F),DE ; Self-modify: save caller's DE (restored at $B83E)
 $B805 LD ($B83C),BC ; Self-modify: save caller's BC (restored at $B83B)
 $B809 LD HL,$9C32   ; Point HL at LFSR state top byte
 $B80C RR (HL)       ; Rotate top byte through carry
 $B80E DEC HL        ;
 $B80F LD A,(HL)     ;
 $B810 LD E,A        ;
 $B811 RRA           ;
 $B812 LD D,A        ;
 $B813 DEC HL        ;
 $B814 LD A,(HL)     ;
 $B815 LD C,A        ;
 $B816 ADD A,A       ;
 $B817 ADD A,A       ;
 $B818 ADD A,A       ;
 $B819 ADD A,A       ;
 $B81A LD B,A        ;
 $B81B DEC HL        ;
 $B81C LD A,(HL)     ;
 $B81D INC HL        ;
 $B81E LD (HL),A     ;
 $B81F SRL A         ;
 $B821 SRL A         ;
 $B823 SRL A         ;
 $B825 SRL A         ;
 $B827 OR B          ; {Mix rotated nibbles into new state byte
 $B828 XOR D         ; }
 $B829 LD B,A        ;
 $B82A LD A,C        ;
 $B82B INC HL        ;
 $B82C LD (HL),A     ;
 $B82D LD A,($9C2E)  ;
 $B830 LD ($9C2F),A  ;
 $B833 LD A,B        ;
 $B834 LD ($9C2E),A  ;
 $B837 LD A,E        ;
 $B838 INC HL        ;
 $B839 LD (HL),A     ;
 $B83A LD A,B        ;
 $B83B LD BC,$0000   ; Restore caller's BC
 $B83E LD DE,$0000   ; Restore caller's DE
 $B841 LD HL,$0000   ; Restore caller's HL
 $B844 RET           ;

; Compute angle from object IX to target IY
;
; Used by the routines at #R$BA2B, #R$BE4A and #R$C43C.
;
; IX object position (shooter)
; IY target position (e.g. player)
;
; Rounds IX's fixed-point X/Y position (lo/hi at IX+$0B/$0C and IX+$0D/$0E) to
; the nearest integer (RLA into the low byte's top bit, then ADC A,$00 on the
; high byte), subtracts IY's integer column/row (IY+$0C/$0E) to get delta X (C)
; and delta Y (B), takes their absolute values while recording quadrant bits in
; D, then refines to an octant and runs a linear-search division
; ($B889-#R$B89C) to approximate the angle - a coarse atan2 feeding
; aiming/movement code such as #R$C43C.
@label=calc_angle
c$B845 LD A,(IX+$0B) ;
 $B848 RLA           ;
 $B849 LD A,(IX+$0C) ;
 $B84C ADC A,$00     ;
 $B84E SUB (IY+$0C)  ; Delta X = rounded IX position minus IY column
 $B851 LD C,A        ;
 $B852 LD A,(IX+$0D) ;
 $B855 RLA           ;
 $B856 LD A,(IX+$0E) ;
 $B859 ADC A,$00     ;
 $B85B SUB (IY+$0E)  ; Delta Y = rounded IX position minus IY row
 $B85E LD B,A        ;
 $B85F LD D,$00      ;
 $B861 LD A,B        ;
 $B862 AND A         ;
 $B863 JP P,$B86B    ; Skip abs-negate if delta Y already positive
 $B866 NEG           ;
 $B868 LD B,A        ;
 $B869 LD D,$3F      ;
*$B86B LD A,C        ;
 $B86C AND A         ;
 $B86D JP P,$B878    ; Skip abs-negate if delta X already positive
 $B870 NEG           ;
 $B872 LD C,A        ;
 $B873 LD A,D        ;
 $B874 XOR $1F       ;
 $B876 LD D,A        ;
 $B877 LD A,C        ;
*$B878 CP B          ;
 $B879 JR NC,$B881   ; Swap X/Y (octant refinement) if X >= Y
 $B87B LD C,B        ;
 $B87C LD B,A        ;
 $B87D LD A,D        ;
 $B87E XOR $0F       ;
 $B880 LD D,A        ;
*$B881 LD A,$03      ;
 $B883 CP C          ;
 $B884 JR C,$B887    ; Clamp check against threshold $03
 $B886 CP B          ;
*$B887 CCF           ;
 $B888 PUSH AF       ;
 $B889 LD E,$08      ;
 $B88B SLA B         ;
 $B88D SLA B         ;
 $B88F SLA B         ;
 $B891 LD A,C        ;
 $B892 ADD A,A       ;
 $B893 ADD A,A       ;
 $B894 ADD A,A       ;
*$B895 DEC E         ;
 $B896 JR Z,$B89C    ; Division-loop exit when remainder hits zero
 $B898 SUB C         ;
 $B899 CP B          ;
 $B89A JR NC,$B895   ; Division loop: continue while remainder >= Y
*$B89C LD A,E        ;
 $B89D XOR D         ;
 $B89E LD D,A        ;
 $B89F POP AF        ;
 $B8A0 LD A,D        ;
 $B8A1 RET           ;

; Compute velocity vector (dx,dy) from angle and speed
;
; Used by the routines at #R$B974, #R$B992, #R$BE4A, #R$C015 and #R$C3C7.
;
; A angle (0-63, index into sine table $9B5F)
; B speed/magnitude
; IY object struct base
;
; Looks up sin(A) in the table at $9B5F, sign-extends it, then multiplies by
; speed B via repeated addition to get dx (stored at IY+7/+8). Then computes
; angle-16 (mod 64, a quarter-turn) for cos(A) the same way, to get dy (stored
; at IY+9/+10). Classic 8-bit "aim/fire toward angle" trajectory calculation.
@label=angle_to_velocity
c$B8A2 LD C,B        ; {save speed (B->C), point HL at sine table $9B5F
 $B8A3 PUSH AF       ;
 $B8A4 LD HL,$9B5F   ; }
 $B8A7 LD E,A        ; {index table by angle A
 $B8A8 LD D,$00      ;
 $B8AA ADD HL,DE     ; }
 $B8AB LD A,(HL)     ; {sign-extend table value into DE
 $B8AC LD E,A        ;
 $B8AD RLA           ;
 $B8AE SBC A,A       ;
 $B8AF LD D,A        ; }
 $B8B0 LD HL,$0000   ; HL=0 (accumulator)
*$B8B3 ADD HL,DE     ; {multiply table value by speed B (repeated add)
 $B8B4 DJNZ $B8B3    ; }
 $B8B6 LD (IY+$07),L ; {store dx at IY+7/+8
 $B8B9 LD (IY+$08),H ; }
 $B8BC LD B,C        ; {restore speed and angle
 $B8BD POP AF        ; }
 $B8BE SUB $10       ; {angle-16 mod 64: quarter-turn offset for cosine
 $B8C0 AND $3F       ; }
 $B8C2 LD HL,$9B5F   ; point HL at sine table again
 $B8C5 LD E,A        ; {index table by cosine angle
 $B8C6 LD D,$00      ;
 $B8C8 ADD HL,DE     ; }
 $B8C9 LD A,(HL)     ; {sign-extend table value into DE
 $B8CA LD E,A        ;
 $B8CB RLA           ;
 $B8CC SBC A,A       ;
 $B8CD LD D,A        ; }
 $B8CE LD HL,$0000   ; HL=0 (accumulator)
*$B8D1 ADD HL,DE     ; {multiply table value by speed B (repeated add)
 $B8D2 DJNZ $B8D1    ; }
 $B8D4 LD (IY+$09),L ; {store dy at IY+9/+10
 $B8D7 LD (IY+$0A),H ; }
 $B8DA RET           ; return

; Set object position from $9C01, clamp column (IY+$0C) to 8-24
;
; Used by the routine at #R$C5D2.
;
; IY object struct base (writes position fields IY+$0B/$0C/$0D)
@label=set_object_position
c$B8DB LD A,($9C01)    ;
 $B8DE LD (IY+$0D),A   ;
 $B8E1 LD (IY+$0B),$00 ;
 $B8E5 LD A,(IY+$0C)   ;
 $B8E8 CP $08          ;
 $B8EA JR NC,$B8F1     ;
 $B8EC LD (IY+$0C),$08 ;
 $B8F0 RET             ;
*$B8F1 CP $19          ;
 $B8F3 RET C           ;
 $B8F4 LD (IY+$0C),$18 ;
 $B8F8 RET             ;

; Movement-pattern script interpreter
;
; Used by the routines at #R$C075, #R$C11C, #R$C199 and #R$C217.
;
; IY object struct base
;
; Counts down a per-object frame-delay timer (IY+18); once it expires, reads
; the next byte of a movement script (pointer at IY+15/16) into IY+17, masks it
; to 0-7, and dispatches that step through the $A076 sub-table (indices
; $3B-$48) via #R$B7F6. If a dispatched step signals carry, it loops back
; immediately to process the next script byte in the same frame; otherwise it
; returns and waits for the timer to expire again.
@label=movement_script_run
c$B8F9 DEC (IY+$18)    ;
 $B8FC JR Z,$B914      ;
 $B8FE JP P,$B904      ;
 $B901 INC (IY+$18)    ;
*$B904 LD A,(IY+$17)   ;
; This entry point is used by the routine at #R$B920.
*$B907 LD C,A          ;
 $B908 AND $07         ;
 $B90A LD HL,$A076     ;
 $B90D CALL $B7F6      ; Jump-table dispatcher
 $B910 RET NC          ;
 $B911 JP $B8F9        ; => Movement-pattern script interpreter
*$B914 LD (IY+$18),$01 ;
 $B918 LD L,(IY+$15)   ;
 $B91B LD H,(IY+$16)   ;
; This entry point is used by the routine at #R$B920.
*$B91E LD A,(HL)       ;
 $B91F INC HL          ;

; Decode movement-script "wait" byte (bit 7 set = wait N or random frames)
;
; .
;
; .
;
; Continues #R$B8F9/#R$B920's script reader: if the script byte's high bit is
; set, it's a wait command - the low 7 bits give the frame count directly,
; except value 1 which means "random wait" (1-32 frames via #R$B7FE). Result is
; stored into the frame-delay timer at IY+18. If the high bit is clear, the
; byte is instead a movement-step index, handled by the fallthrough at #R$B935.
c$B920 AND A         ;
 $B921 JP P,$B935    ;
 $B924 AND $7F       ;
 $B926 CP $01        ;
 $B928 JR NZ,$B930   ;
 $B92A CALL $B7FE    ; Pseudo-random number generator
 $B92D AND $1F       ;
 $B92F INC A         ;
*$B930 LD (IY+$18),A ;
 $B933 JR $B91E      ;
*$B935 LD (IY+$17),A ;
 $B938 LD (IY+$15),L ;
 $B93B LD (IY+$16),H ;
 $B93E JP $B907      ;

; Movement opcode $3B: dispatch sub-command (C bits 3-6) via $A082
;
; .
;
; .
;
; Handler for index $3B of the #R$A000 jump table (see #R$B7F6).
@label=mvop_dispatch_sub
c$B941 LD A,C        ;
 $B942 AND $78       ;
 $B944 RRCA          ;
 $B945 RRCA          ;
 $B946 RRCA          ;
 $B947 LD HL,$A082   ;
 $B94A CALL $B7F6    ; Jump-table dispatcher
 $B94D RET           ;

; Read next movement-script byte into E
;
; Used by the routines at #R$B95F, #R$B9CA and #R$B9F1.
;
;   IY object struct base (script pointer at IY+$15/$16)
; O:E the fetched script byte
;   HL preserved; advances the object's script pointer (IY+$15/$16)
@label=movement_next_byte
c$B94E PUSH HL       ;
 $B94F LD L,(IY+$15) ;
 $B952 LD H,(IY+$16) ;
 $B955 LD E,(HL)     ;
 $B956 INC HL        ;
 $B957 LD (IY+$15),L ;
 $B95A LD (IY+$16),H ;
 $B95D POP HL        ;
 $B95E RET           ;

; Movement opcode $3C: set field IY+$19 (from C or next script byte)
;
; .
;
; .
;
; Handler for index $3C of the #R$A000 jump table (see #R$B7F6).
@label=mvop_set_iy19
c$B95F LD A,C        ;
 $B960 AND $78       ;
 $B962 JR Z,$B96C    ;
 $B964 RRCA          ;
 $B965 RRCA          ;
 $B966 RRCA          ;
 $B967 LD (IY+$19),A ;
 $B96A SCF           ;
 $B96B RET           ;
*$B96C CALL $B94E    ; Read next movement-script byte into E
 $B96F LD (IY+$19),E ;
 $B972 SCF           ;
 $B973 RET           ;

; Movement opcode $3D: set absolute heading, apply velocity
;
; .
;
; .
;
; Handler for index $3D of the #R$A000 jump table (see #R$B7F6).
@label=mvop_set_heading
c$B974 LD A,C         ;
 $B975 AND $78        ;
 $B977 RRCA           ;
 $B978 BIT 7,(IY+$04) ;
 $B97C JR Z,$B984     ;
 $B97E NEG            ;
 $B980 ADD A,$20      ;
 $B982 AND $3F        ;
*$B984 LD (IY+$10),A  ;
 $B987 LD B,(IY+$11)  ;
 $B98A CALL $B8A2     ; Compute velocity vector (dx,dy) from angle and speed
 $B98D CALL $BA0A     ; Apply object velocity (dx,dy) to position
 $B990 AND A          ;
 $B991 RET            ;

; Movement opcode $3E: turn heading relative, apply velocity
;
; Used by the routine at #R$BA2B.
;
; .
;
; Handler for index $3E of the #R$A000 jump table (see #R$B7F6).
@label=mvop_turn_heading
c$B992 BIT 7,(IY+$04) ;
 $B996 JR Z,$B99C     ;
 $B998 LD A,C         ;
 $B999 XOR $40        ;
 $B99B LD C,A         ;
*$B99C LD A,C         ;
 $B99D AND $38        ;
 $B99F RRCA           ;
 $B9A0 RRCA           ;
 $B9A1 RRCA           ;
 $B9A2 INC A          ;
 $B9A3 BIT 6,C        ;
 $B9A5 JR Z,$B9A9     ;
 $B9A7 NEG            ;
*$B9A9 ADD A,(IY+$10) ;
 $B9AC AND $3F        ;
 $B9AE LD (IY+$10),A  ;
 $B9B1 LD B,(IY+$11)  ;
 $B9B4 CALL $B8A2     ; Compute velocity vector (dx,dy) from angle and speed
 $B9B7 CALL $BA0A     ; Apply object velocity (dx,dy) to position
 $B9BA AND A          ;
 $B9BB RET            ;

; Movement opcode $3F: set/clear mirror flag (IY+$04 bit 6)
;
; .
;
; .
;
; Handler for index $3F of the #R$A000 jump table (see #R$B7F6).
@label=mvop_set_mirror
c$B9BC SET 6,(IY+$04) ;
 $B9C0 BIT 3,C        ;
 $B9C2 JR NZ,$B9C8    ;
 $B9C4 RES 6,(IY+$04) ;
*$B9C8 SCF            ;
 $B9C9 RET            ;

; Movement opcode $40: set N object fields from script (offset,value pairs)
;
; .
;
; .
;
; Handler for index $40 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_set_fields
c$B9CA LD A,C        ;
 $B9CB AND $78       ;
 $B9CD RRCA          ;
 $B9CE RRCA          ;
 $B9CF RRCA          ;
 $B9D0 INC A         ;
 $B9D1 LD B,A        ;
*$B9D2 CALL $B94E    ; Read next movement-script byte into E
 $B9D5 LD A,E        ;
 $B9D6 LD ($B9DE),A  ;
 $B9D9 CALL $B94E    ; Read next movement-script byte into E
 $B9DC LD (IY+$00),E ;
 $B9DF DJNZ $B9D2    ;
 $B9E1 SCF           ;
 $B9E2 RET           ;

; Movement opcode $41: clear velocity (dx,dy = 0)
;
; .
;
; .
;
; Handler for index $41 of the #R$A000 jump table (see #R$B7F6).
@label=clear_velocity
c$B9E3 XOR A         ;
 $B9E4 LD (IY+$07),A ;
 $B9E7 LD (IY+$08),A ;
 $B9EA LD (IY+$09),A ;
 $B9ED LD (IY+$0A),A ;
 $B9F0 RET           ;

; Movement opcode $42: loop back in script until counter IY+$19 expires
;
; .
;
; .
;
; Handler for index $42 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_loop
c$B9F1 CALL $B94E    ; Read next movement-script byte into E
 $B9F4 DEC (IY+$19)  ;
 $B9F7 SCF           ;
 $B9F8 RET Z         ;
 $B9F9 LD D,$FF      ;
 $B9FB LD L,(IY+$15) ;
 $B9FE LD H,(IY+$16) ;
 $BA01 ADD HL,DE     ;
 $BA02 LD (IY+$15),L ;
 $BA05 LD (IY+$16),H ;
 $BA08 SCF           ;
 $BA09 RET           ;

; Apply object velocity (dx,dy) to position
;
; Used by the routines at #R$B974, #R$B992, #R$BE4A, #R$BFEB, #R$C015 and
; #R$C3C7.
;
; IY object struct base
;
; SP=IY stack trick: adds the velocity fields (set by #R$B8A2, IY+7/+8 and
; IY+9/+10) onto the position fields (IY+11/+12 and IY+13/+14). The generic
; "move by velocity" step; also index $43 of the #R$A000 jump table.
@label=apply_velocity
c$BA0A LD ($BA1F),SP ; Save caller's SP (restored at $BA1E)
 $BA0E LD SP,IY      ; {Point SP at the object's velocity fields (IY+7)
 $BA10 LD HL,$0007   ;
 $BA13 ADD HL,SP     ;
 $BA14 LD SP,HL      ; }
 $BA15 POP HL        ; {Pop dx, dy, X into HL/DE/BC
 $BA16 POP DE        ;
 $BA17 POP BC        ; }
 $BA18 ADD HL,BC     ; {X += dx
 $BA19 EX DE,HL      ; }
 $BA1A POP BC        ; {Y += dy
 $BA1B ADD HL,BC     ; }
 $BA1C PUSH HL       ; {Write both updated coordinates back
 $BA1D PUSH DE       ; }
 $BA1E LD SP,$0000   ; Restore SP
 $BA21 AND A         ;
 $BA22 RET           ;

; Movement opcode $44: no-op
;
; .
;
; .
;
; Handler for index $44 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_nop
c$BA23 AND A         ;
 $BA24 RET           ;

; Movement opcode $45: set object alive flag (IY+$04 bit 1)
;
; .
;
; .
;
; Handler for index $45 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_set_alive
c$BA25 SET 1,(IY+$04) ;
 $BA29 AND A          ;
 $BA2A RET            ;

; Movement opcode $46: turn heading toward target ($9C6D)
;
; .
;
; .
;
; Handler for index $46 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_aim_target
c$BA2B LD IX,($9C6D) ;
 $BA2F CALL $B845    ; Compute angle from object IX to target IY
 $BA32 SUB (IY+$10)  ;
 $BA35 AND $3F       ;
 $BA37 CP $20        ;
 $BA39 LD C,$00      ;
 $BA3B JR C,$BA3F    ;
 $BA3D LD C,$40      ;
*$BA3F CALL $B992    ; Movement opcode $3E
 $BA42 RET           ;

; Movement opcode $47: set random column (IY+$0C)
;
; .
;
; .
;
; Handler for index $47 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_random_column
c$BA43 CALL $B7FE    ; Pseudo-random number generator
 $BA46 AND $0F       ;
 $BA48 ADD A,$08     ;
 $BA4A LD (IY+$0C),A ;
 $BA4D SCF           ;
 $BA4E RET           ;

; Movement opcode $48: randomly set/clear direction flag (IY+$04 bit 7)
;
; .
;
; .
;
; Handler for index $48 of the #R$A000 jump table (see #R$B7F6).
@label=mvop_random_dir
c$BA4F CALL $B7FE     ; Pseudo-random number generator
 $BA52 CP $80         ;
 $BA54 SET 7,(IY+$04) ;
 $BA58 RET C          ;
 $BA59 RES 7,(IY+$04) ;
 $BA5D SCF            ;
 $BA5E RET            ;

; Spawn a group of formation objects from the free-list pool
;
; Used by the routines at #R$C981 and #R$C9AF.
;
; O:Cy set if a group was spawned
;
; Called from #R$C981 (column spawn markers) and #R$C9AF (enemy timeline).
; Finds the first free bitmap slot at $9B4F, works out how many objects to
; spawn from the remaining wave counter ($9D18) against a per-group budget
; table at $5CF4, then pops that many objects off the free list ($9D1C) via an
; SP-trick and initializes each from a spawn-template table at $5B55 (index*9 +
; $5B55), applying a difficulty offset ($9C41). Returns carry set on success.
c$BA5F EX AF,AF'       ;
 $BA60 LD A,($9D18)    ;
 $BA63 AND A           ; {Exit if wave counter is zero
 $BA64 RET Z           ; }
 $BA65 LD HL,$9B4F     ; Scan 8-slot bitmap at $9B4F for first free (zero) slot
 $BA68 LD B,$08        ;
 $BA6A XOR A           ;
*$BA6B CP (HL)         ;
 $BA6C JR Z,$BA74      ;
 $BA6E INC L           ;
 $BA6F INC L           ;
 $BA70 DJNZ $BA6B      ;
 $BA72 AND A           ;
 $BA73 RET             ;
*$BA74 LD A,$08        ; Compute slot index (8-B)
 $BA76 SUB B           ;
 $BA77 LD ($BB55),A    ; Store slot index at $BB55
 $BA7A PUSH HL         ;
 $BA7B LD A,D          ; {E = (D high nibble) + $30
 $BA7C AND $F0         ;
 $BA7E ADD A,$30       ;
 $BA80 LD E,A          ; }
 $BA81 LD A,D          ; {D = (D low nibble * 16) + 8
 $BA82 AND $0F         ;
 $BA84 ADD A,A         ;
 $BA85 ADD A,A         ;
 $BA86 ADD A,A         ;
 $BA87 ADD A,A         ;
 $BA88 ADD A,$08       ;
 $BA8A LD D,A          ; }
 $BA8B LD A,C          ; {Save C's top 2 bits to self-modified operand $BB41
 $BA8C AND $C0         ;
 $BA8E LD ($BB41),A    ; }
 $BA91 XOR C           ; Clear those bits from C (mask to 0-$3F)
 $BA92 LD H,$5B        ; {HL = $5B29 + masked C: index tag-to-group table
 $BA94 ADD A,$29       ;
 $BA96 LD L,A          ; }
 $BA97 LD C,(HL)       ; {C = looked-up group index (BC for word math)
 $BA98 LD B,$00        ; }
 $BA9A LD HL,$5CF4     ; {Index group-budget table at $5CF4 (2 bytes/entry)
 $BA9D ADD HL,BC       ;
 $BA9E ADD HL,BC       ; }
 $BA9F LD A,($9D18)    ;
 $BAA2 LD B,A          ;
 $BAA3 CP (HL)         ; {Clamp spawn count to remaining wave counter ($9D18)
 $BAA4 JR C,$BAA7      ; }
 $BAA6 LD B,(HL)       ;
*$BAA7 SUB B           ; {Deduct spawned count from wave counter
 $BAA8 LD ($9D18),A    ; }
 $BAAB INC HL          ;
 $BAAC LD A,B          ;
 $BAAD EXX             ;
 $BAAE LD B,A          ;
 $BAAF LD HL,($9D1C)   ; Pop head of free-object list ($9D1C)
 $BAB2 PUSH HL         ;
 $BAB3 POP IX          ;
 $BAB5 LD ($BAC7),SP   ; Save SP (self-modified operand, restored below)
*$BAB9 LD SP,HL        ; {SP-trick: pop B objects off the free list
 $BABA POP HL          ;
 $BABB DJNZ $BAB9      ; }
 $BABD LD ($9D1C),HL   ; Update free-list head ($9D1C)
 $BAC0 PUSH IX         ;
 $BAC2 LD ($BBB4),IX   ; Store allocated object pointer at $BBB4
 $BAC6 LD SP,$0000     ; Restore SP
 $BAC9 EXX             ;
 $BACA LD B,A          ;
 $BACB EXX             ;
 $BACC POP BC          ;
 $BACD LD (BC),A       ; {Write object-index byte
 $BACE INC C           ; }
 $BACF EXX             ;
 $BAD0 LD A,(HL)       ;
 $BAD1 INC HL          ;
 $BAD2 EXX             ;
 $BAD3 CP $01          ; {Type 1: consume a $9C69 credit
 $BAD5 JR NZ,$BAE1     ; }
 $BAD7 LD HL,$9C69     ;
 $BADA LD A,(HL)       ;
 $BADB AND A           ;
 $BADC JR Z,$BAE1      ;
 $BADE LD A,$01        ;
 $BAE0 DEC (HL)        ;
*$BAE1 LD (BC),A       ;
 $BAE2 AND A           ;
 $BAE3 JR Z,$BAEA      ;
 $BAE5 LD A,$06        ;
 $BAE7 LD ($9C44),A    ;
*$BAEA EXX             ; {Read spawn-template index byte
 $BAEB LD A,(HL)       ;
 $BAEC INC HL          ; }
 $BAED EXX             ;
 $BAEE LD L,A          ;
 $BAEF ADD A,A         ; {Index template table at $5B55 (index*9 + $5B55)
 $BAF0 ADD A,A         ;
 $BAF1 ADD A,A         ;
 $BAF2 ADD A,L         ;
 $BAF3 ADD A,$55       ; }
 $BAF5 LD L,A          ;
 $BAF6 LD H,$5B        ;
 $BAF8 LD A,(HL)       ; {Template byte 0 -> IX+$05
 $BAF9 INC HL          ;
 $BAFA LD ($BB51),A    ; }
 $BAFD LD A,(HL)       ; {Template byte 1 -> IX+$12
 $BAFE INC HL          ;
 $BAFF LD ($BB4D),A    ; }
 $BB02 LD A,(HL)       ; {Template byte 2 -> IX+$1A
 $BB03 INC HL          ;
 $BB04 LD ($BB59),A    ; }
 $BB07 LD A,($9C41)    ; {Add difficulty offset ($9C41), clamp to $FF; template
 $BB0A ADD A,(HL)      ; byte 3 -> IX+$1B
 $BB0B JR NC,$BB0F     ;
 $BB0D LD A,$FF        ; }
*$BB0F INC HL          ;
 $BB10 LD ($BB5D),A    ;
 $BB13 LD A,(HL)       ; {Template byte 4 -> IX+$11
 $BB14 INC HL          ;
 $BB15 LD ($BB61),A    ; }
 $BB18 LD A,(HL)       ; {Template byte 5 -> IX+$02 (not a code pointer - see
 $BB19 INC HL          ; #R$5B55)
 $BB1A LD ($BB45),A    ; }
 $BB1D LD A,(HL)       ; {Template byte 6 -> IX+$03
 $BB1E INC HL          ;
 $BB1F LD ($BB49),A    ; }
 $BB22 LD A,(HL)       ; {Template bytes 7,8 (little-endian) = a fixed-slot
 $BB23 INC HL          ; address ($9D1E/$9D24/$9D2A)
 $BB24 LD H,(HL)       ;
 $BB25 LD L,A          ; }
 $BB26 LD ($BBB7),HL   ; {Save that address into the read-modify-write tail's
 $BB29 LD ($BBBB),HL   ; operands ($BBB6/$BBBA)}
 $BB2C EXX             ;
 $BB2D LD A,(HL)       ;
 $BB2E INC HL          ;
 $BB2F EXX             ;
 $BB30 LD B,A          ;
 $BB31 AND $7F         ;
 $BB33 LD C,A          ;
 $BB34 XOR B           ;
 $BB35 LD B,A          ;
 $BB36 EX AF,AF'       ;
 $BB37 OR B            ;
 $BB38 LD B,A          ;
 $BB39 EXX             ;
 $BB3A LD ($BBBE),SP   ;
*$BB3E LD (IX+$04),$00 ; {Init object fields from the self-modified operands
 $BB42 LD (IX+$02),$00 ; just patched above
 $BB46 LD (IX+$03),$00 ;
 $BB4A LD (IX+$12),$00 ;
 $BB4E LD (IX+$05),$00 ;
 $BB52 LD (IX+$13),$00 ;
 $BB56 LD (IX+$1A),$00 ;
 $BB5A LD (IX+$1B),$00 ;
 $BB5E LD (IX+$11),$00 ; }
 $BB62 SET 0,(IX+$04)  ;
 $BB66 LD (IX+$1C),$10 ;
 $BB6A LD (IX+$06),$06 ;
 $BB6E LD (IX+$18),$01 ;
 $BB72 LD A,(HL)       ; {Read the byte at the fixed-slot address
 $BB73 INC HL          ; (movement-script selector)
 $BB74 EXX             ; }
 $BB75 LD L,A          ; {Index $5B00 table by that byte
 $BB76 LD H,$5B        ; }
 $BB78 LD E,(HL)       ; {E = looked-up offset, D = 0
 $BB79 LD D,$00        ; }
 $BB7B LD HL,$5BAF     ; {HL = $5BAF + 2*offset: entry point into the shared
 $BB7E ADD HL,DE       ; script bytecode
 $BB7F ADD HL,DE       ; }
 $BB80 LD (IX+$15),L   ; {Store script entry point at object's IX+$15/$16
 $BB83 LD (IX+$16),H   ; }
 $BB86 LD A,B          ;
 $BB87 LD (IX+$0F),A   ;
 $BB8A ADD A,C         ;
 $BB8B LD B,A          ;
 $BB8C EXX             ;
 $BB8D LD A,E          ;
 $BB8E ADD A,(HL)      ;
 $BB8F INC HL          ;
 $BB90 RRCA            ;
 $BB91 RRCA            ;
 $BB92 RRCA            ;
 $BB93 LD C,A          ;
 $BB94 AND $E0         ;
 $BB96 LD (IX+$0B),A   ;
 $BB99 XOR C           ;
 $BB9A LD (IX+$0C),A   ;
 $BB9D LD A,D          ;
 $BB9E ADD A,(HL)      ;
 $BB9F INC HL          ;
 $BBA0 RRCA            ;
 $BBA1 RRCA            ;
 $BBA2 RRCA            ;
 $BBA3 LD C,A          ;
 $BBA4 AND $E0         ;
 $BBA6 LD (IX+$0D),A   ;
 $BBA9 XOR C           ;
 $BBAA LD (IX+$0E),A   ;
 $BBAD LD SP,IX        ;
 $BBAF POP IX          ;
 $BBB1 DJNZ $BB3E      ;
 $BBB3 LD SP,$0000     ; Restore SP
 $BBB6 LD HL,($0000)   ; Read the word currently at the fixed-slot address
 $BBB9 EX (SP),HL      ; Swap it with the stack top
 $BBBA LD ($0000),HL   ; Write the swapped value back to the fixed-slot address
 $BBBD LD SP,$0000     ;
 $BBC0 SCF             ;
 $BBC1 RET             ;

; Clear buffers at $7F00-$7FFF and $8000-$80FF (fast PUSH fill)
;
; Used by the routines at #R$A0C4 and #R$A8C0.
;
; .
;
; Called once per frame from the main loop ($A10F). Fills 256 bytes at $7F00
; then 256 bytes at $8000 with DE ($0000), using the SP-trick PUSH-unroll
; pattern (B=$10 outer, 8 PUSHes/inner) shared with other fast fill routines in
; this game.
@label=clear_buffers
c$BBC2 LD DE,$0000   ; DE=$0000 (fill value)
 $BBC5 LD HL,$7F00   ; {Point HL/B at first buffer ($7F00, 16 groups of 8)
 $BBC8 LD B,$10      ; }
 $BBCA CALL $BBD2    ; Fill first buffer, then set up second buffer ($8000)
 $BBCD LD HL,$8000   ;
 $BBD0 LD B,$10      ;
*$BBD2 LD ($BBE2),SP ; SP-trick: save caller's SP, point SP at fill destination
 $BBD6 LD SP,HL      ;
*$BBD7 PUSH DE       ; {Unrolled PUSH DE x8, looped B times
 $BBD8 PUSH DE       ;
 $BBD9 PUSH DE       ;
 $BBDA PUSH DE       ;
 $BBDB PUSH DE       ;
 $BBDC PUSH DE       ;
 $BBDD PUSH DE       ;
 $BBDE PUSH DE       ; }
 $BBDF DJNZ $BBD7    ;
 $BBE1 LD SP,$0000   ; Restore SP and return
 $BBE4 RET           ;

; Mark active objects into the attribute-buffer collision mask
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every interrupt from #R$A0C4. Iterates the object list at $9D30 (B =
; $06 minus the count at $9D19; falls straight to #R$BC79 if none remain - the
; branch corrupted by POKE 48115,58/Immunity). For each object: E is set to C
; if (IY+$05)==$03, else 0; a row is computed from the object's Y (IY+$0D/$0E,
; then IY+$0B/$0C), and E is ORed into that row across the $7Exx/$7Fxx
; attribute buffers ($BC35/$BC3D continue the row loop started here). The
; object's bit is then stored at IY+$14 and C is rotated left (RLC C) so each
; object gets a distinct single-bit identifier for the next pass.
@label=mark_collision_masks
c$BBE5 LD ($BCDA),SP ; Save SP (restored via the $7E-page LD SP tail)
 $BBE9 LD IY,($9D30) ; IY = object list head ($9D30)
 $BBED LD HL,$9D19   ; {B = 6 - active object count ($9D19)
 $BBF0 LD A,$06      ;
 $BBF2 SUB (HL)      ; }
 $BBF3 JP Z,$BC79    ; POKE 48115,58 corrupts this JP Z, disabling the
                     ; damage/collision branch (Immunity)
 $BBF6 LD B,A        ;
 $BBF7 LD C,$01      ;
*$BBF9 LD A,(IY+$05) ; {E = object's mask bit only when type (IY+$05) is 3
 $BBFC CP $03        ;
 $BBFE LD E,C        ;
 $BBFF JR Z,$BC03    ;
 $BC01 LD E,$00      ; }
*$BC03 LD H,$7E      ;
 $BC05 LD A,(IY+$0D) ; {Compute $7Exx attribute-row address from object Y
 $BC08 AND $E0       ; (IY+$0D/$0E)
 $BC0A OR (IY+$0E)   ;
 $BC0D RLCA          ;
 $BC0E RLCA          ;
 $BC0F RLCA          ;
 $BC10 INC A         ;
 $BC11 LD L,A        ; }
 $BC12 LD A,(HL)     ; {OR mask bit into this attribute row
 $BC13 OR E          ;
 $BC14 LD (HL),A     ; }
 $BC15 INC L         ;
 $BC16 LD A,(HL)     ;
 $BC17 OR E          ;
 $BC18 LD (HL),A     ;
 $BC19 INC L         ;
 $BC1A LD A,(HL)     ;
 $BC1B OR E          ;
 $BC1C LD (HL),A     ;
 $BC1D INC L         ;
 $BC1E LD A,(HL)     ;
 $BC1F OR E          ;
 $BC20 LD (HL),A     ;
 $BC21 INC L         ;
 $BC22 LD A,(HL)     ;
 $BC23 OR E          ;
 $BC24 LD (HL),A     ;
 $BC25 INC L         ;
 $BC26 LD A,(HL)     ;
 $BC27 OR E          ;
 $BC28 LD (HL),A     ;
 $BC29 INC L         ;
 $BC2A LD A,(HL)     ;
 $BC2B OR E          ;
 $BC2C LD (HL),A     ;
 $BC2D INC L         ;
 $BC2E LD A,(HL)     ;
 $BC2F OR E          ;
 $BC30 LD (HL),A     ;
 $BC31 INC L         ;
 $BC32 LD A,(HL)     ;
 $BC33 OR E          ;
 $BC34 LD (HL),A     ;
 $BC35 INC L         ;
 $BC36 LD A,(HL)     ;
 $BC37 OR E          ;
 $BC38 LD (HL),A     ;
 $BC39 INC L         ;
 $BC3A LD A,(HL)     ;
 $BC3B OR E          ;
 $BC3C LD (HL),A     ;
 $BC3D INC L         ;
 $BC3E LD A,(HL)     ;
 $BC3F OR E          ;
 $BC40 LD (HL),A     ;
 $BC41 LD H,$7F      ;
 $BC43 LD A,(IY+$0B) ;
 $BC46 AND $E0       ;
 $BC48 OR (IY+$0C)   ;
 $BC4B RLCA          ;
 $BC4C RLCA          ;
 $BC4D RLCA          ;
 $BC4E LD L,A        ;
 $BC4F LD A,(HL)     ;
 $BC50 OR E          ;
 $BC51 LD (HL),A     ;
 $BC52 INC L         ;
 $BC53 LD A,(HL)     ;
 $BC54 OR E          ;
 $BC55 LD (HL),A     ;
 $BC56 INC L         ;
 $BC57 LD A,(HL)     ;
 $BC58 OR E          ;
 $BC59 LD (HL),A     ;
 $BC5A INC L         ;
 $BC5B LD A,(HL)     ;
 $BC5C OR E          ;
 $BC5D LD (HL),A     ;
 $BC5E INC L         ;
 $BC5F LD A,(HL)     ;
 $BC60 OR E          ;
 $BC61 LD (HL),A     ;
 $BC62 INC L         ;
 $BC63 LD A,(HL)     ;
 $BC64 OR E          ;
 $BC65 LD (HL),A     ;
 $BC66 INC L         ;
 $BC67 LD A,(HL)     ;
 $BC68 OR E          ;
 $BC69 LD (HL),A     ;
 $BC6A INC L         ;
 $BC6B LD A,(HL)     ;
 $BC6C OR E          ;
 $BC6D LD (HL),A     ;
 $BC6E LD (IY+$14),C ;
 $BC71 RLC C         ;
 $BC73 LD SP,IY      ;
 $BC75 POP IY        ;
 $BC77 DJNZ $BBF9    ;
; Entry point reached from #R$BBE5's mask-draw loop; also entered directly when
; POKE 48115,58 (Immunity) forces the mask byte to $80, skipping the normal
; per-object bit rotation (RLC C) at $BC71 and disabling the damage/collision
; branch.
*$BC79 LD C,$80      ;
 $BC7B LD H,$7E      ;

; Draw fixed 8-row collision mask into both attribute buffers
;
; .
;
; .
;
; Entered from #R$BBE5's per-object loop (and the #R$BC79 Immunity entry). ORs
; the object's mask bit into 8 consecutive rows of each of the $7Exx/$7Fxx
; attribute buffers - the fixed-height counterpart to #R$BCE9's variable-height
; object masks.
c$BC7D LD A,(IY+$0D) ; Row offset from object Y (IY+$0D/$0E)
 $BC80 AND $E0       ;
 $BC82 OR (IY+$0E)   ;
 $BC85 RLCA          ;
 $BC86 RLCA          ;
 $BC87 RLCA          ;
 $BC88 ADD A,$04     ;
 $BC8A LD L,A        ;
 $BC8B LD A,(HL)     ;
 $BC8C OR C          ;
 $BC8D LD (HL),A     ;
 $BC8E INC L         ;
 $BC8F LD A,(HL)     ;
 $BC90 OR C          ;
 $BC91 LD (HL),A     ;
 $BC92 INC L         ;
 $BC93 LD A,(HL)     ;
 $BC94 OR C          ;
 $BC95 LD (HL),A     ;
 $BC96 INC L         ;
 $BC97 LD A,(HL)     ;
 $BC98 OR C          ;
 $BC99 LD (HL),A     ;
 $BC9A INC L         ;
 $BC9B LD A,(HL)     ;
 $BC9C OR C          ;
 $BC9D LD (HL),A     ;
 $BC9E INC L         ;
 $BC9F LD A,(HL)     ;
 $BCA0 OR C          ;
 $BCA1 LD (HL),A     ;
 $BCA2 INC L         ;
 $BCA3 LD A,(HL)     ;
 $BCA4 OR C          ;
 $BCA5 LD (HL),A     ;
 $BCA6 INC L         ;
 $BCA7 LD A,(HL)     ;
 $BCA8 OR C          ;
 $BCA9 LD (HL),A     ;
 $BCAA LD H,$7F      ; Switch to second attribute page ($7Fxx)
 $BCAC LD A,(IY+$0B) ; Row offset from object Y (IY+$0B/$0C)
 $BCAF AND $E0       ;
 $BCB1 OR (IY+$0C)   ;
 $BCB4 RLCA          ;
 $BCB5 RLCA          ;
 $BCB6 RLCA          ;
 $BCB7 ADD A,$04     ;
 $BCB9 LD L,A        ;
 $BCBA LD A,(HL)     ;
 $BCBB OR C          ;
 $BCBC LD (HL),A     ;
 $BCBD INC L         ;
 $BCBE LD A,(HL)     ;
 $BCBF OR C          ;
 $BCC0 LD (HL),A     ;
 $BCC1 INC L         ;
 $BCC2 LD A,(HL)     ;
 $BCC3 OR C          ;
 $BCC4 LD (HL),A     ;
 $BCC5 INC L         ;
 $BCC6 LD A,(HL)     ;
 $BCC7 OR C          ;
 $BCC8 LD (HL),A     ;
 $BCC9 INC L         ;
 $BCCA LD A,(HL)     ;
 $BCCB OR C          ;
 $BCCC LD (HL),A     ;
 $BCCD INC L         ;
 $BCCE LD A,(HL)     ;
 $BCCF OR C          ;
 $BCD0 LD (HL),A     ;
 $BCD1 INC L         ;
 $BCD2 LD A,(HL)     ;
 $BCD3 OR C          ;
 $BCD4 LD (HL),A     ;
 $BCD5 INC L         ;
 $BCD6 LD A,(HL)     ;
 $BCD7 OR C          ;
 $BCD8 LD (HL),A     ;
 $BCD9 LD SP,$0000   ; Restore SP
 $BCDC LD A,($9D19)  ;
 $BCDF AND A         ;
 $BCE0 RET Z         ; Exit if no objects to process ($9D19 counter is zero)
*$BCE1 LD B,$33      ;
*$BCE3 DJNZ $BCE3    ;
 $BCE5 DEC A         ;
 $BCE6 JR NZ,$BCE1   ;
 $BCE8 RET           ;

; Draw active objects' collision masks into attribute buffer
;
; Used by the routines at #R$A0C4 and #R$A8C0.
;
; .
;
; Called every interrupt from #R$A0C4 and $A8E8. Iterates the object linked
; list (via $9D18/EXX, same list style as #R$BC7D/#R$BBE5), and for each object
; with the right IY+$04 status bits, computes an attribute row from its Y
; position (IY+$0D/$0E and IY+$0B/$0C) and ORs a variable-height mask (row
; count from IX-$01/IX-$02) into the $7Exx/$7Fxx attribute buffers - building
; the per-object hit/collision mask consumed elsewhere.
@label=draw_object_masks
c$BCE9 LD ($BD80),SP  ; Save SP (restored at $BD7F)
 $BCED LD HL,$9C70    ;
 $BCF0 LD A,(HL)      ;
 $BCF1 AND A          ;
 $BCF2 JR Z,$BD04     ; Skip row/page setup if flag at $9C70 is zero
 $BCF4 DEC (HL)       ;
 $BCF5 LD IY,($9C6D)  ;
 $BCF9 LD A,(IY+$0D)  ;
 $BCFC AND $E0        ;
 $BCFE OR (IY+$0E)    ;
 $BD01 RLCA           ;
 $BD02 RLCA           ;
 $BD03 RLCA           ;
*$BD04 LD ($BD46),A   ;
 $BD07 LD IY,($9D1E)  ;
 $BD0B LD HL,$9D18    ;
 $BD0E LD A,$08       ;
 $BD10 SUB (HL)       ;
 $BD11 LD HL,$9D1A    ;
 $BD14 ADD A,$04      ;
 $BD16 SUB (HL)       ;
 $BD17 JR Z,$BD78     ; No objects to draw: skip to cleanup
 $BD19 LD DE,$0008    ;
 $BD1C EXX            ;
 $BD1D LD B,A         ;
*$BD1E BIT 3,(IY+$04) ;
 $BD22 JR NZ,$BD92    ; Skip normal draw path if IY+$04 bit 3 is set
 $BD24 EXX            ;
 $BD25 XOR A          ;
 $BD26 BIT 0,(IY+$04) ;
 $BD2A JR NZ,$BD6E    ; Skip mask draw if IY+$04 bit 0 is set
 $BD2C BIT 5,(IY+$04) ;
 $BD30 JR Z,$BD6E     ; Skip mask draw unless IY+$04 bit 5 is set
 $BD32 LD SP,IY       ;
 $BD34 POP HL         ;
 $BD35 POP IX         ;
 $BD37 LD H,$7E       ;
 $BD39 LD A,(IY+$0D)  ;
 $BD3C AND $E0        ;
 $BD3E OR (IY+$0E)    ;
 $BD41 RLCA           ;
 $BD42 RLCA           ;
 $BD43 RLCA           ;
 $BD44 LD L,A         ;
 $BD45 CP $00         ;
 $BD47 LD A,$40       ;
 $BD49 JR C,$BD4C     ; Clamp row start if carry
 $BD4B XOR A          ;
*$BD4C LD B,(IX-$01)  ;
*$BD4F OR (HL)        ;
 $BD50 ADD HL,DE      ;
 $BD51 DJNZ $BD4F     ;
 $BD53 OR (HL)        ;
 $BD54 LD C,A         ;
 $BD55 LD H,$7F       ;
 $BD57 LD A,(IY+$0B)  ;
 $BD5A AND $E0        ;
 $BD5C OR (IY+$0C)    ;
 $BD5F RLCA           ;
 $BD60 RLCA           ;
 $BD61 RLCA           ;
 $BD62 LD L,A         ;
 $BD63 LD A,$40       ;
 $BD65 LD B,(IX-$02)  ;
*$BD68 OR (HL)        ;
 $BD69 ADD HL,DE      ;
 $BD6A DJNZ $BD68     ;
 $BD6C OR (HL)        ;
 $BD6D AND C          ;
*$BD6E LD (IY+$14),A  ;
 $BD71 LD SP,IY       ;
 $BD73 POP IY         ;
 $BD75 EXX            ;
 $BD76 DJNZ $BD1E     ; Next object
*$BD78 XOR A          ;
 $BD79 LD ($9C6B),A   ;
 $BD7C LD ($9C6C),A   ;
 $BD7F LD SP,$0000    ; Restore SP
 $BD82 LD HL,$9D1A    ;
 $BD85 LD A,($9D18)   ;
 $BD88 ADD A,(HL)     ;
 $BD89 RET Z          ;
*$BD8A LD B,$28       ;
*$BD8C DJNZ $BD8C     ;
 $BD8E DEC A          ;
 $BD8F JR NZ,$BD8A    ;
 $BD91 RET            ;
*$BD92 LD SP,IY       ;
 $BD94 POP IY         ;
 $BD96 JP $BD1E       ;

; Update randomized countdown, then enter player update ($BDAE)
;
; Used by the routine at #R$A0C4.
c$BD99 CALL $B7FE     ; Pseudo-random number generator
 $BD9C AND $01        ;
 $BD9E JR NZ,$BDAA    ;
 $BDA0 LD HL,$9C42    ;
 $BDA3 DEC (HL)       ;
 $BDA4 JR NZ,$BDAA    ;
 $BDA6 LD A,($9C43)   ;
 $BDA9 LD (HL),A      ;
*$BDAA LD IY,$9D1E    ;
*$BDAE LD HL,$9C33    ; {flip and mask border colour bits at $9C33/$9C34,
 $BDB1 LD A,(HL)      ; output to port $FE
 $BDB2 XOR $18        ;
 $BDB4 LD (HL),A      ; }
 $BDB5 INC HL         ;
 $BDB6 AND (HL)       ;
 $BDB7 OUT ($FE),A    ;
 $BDB9 LD L,(IY+$00)  ; {load player object pointer into IY, save previous IY
 $BDBC LD H,(IY+$01)  ;
 $BDBF LD ($B7E4),IY  ; }
 $BDC3 PUSH HL        ;
 $BDC4 POP IY         ;
 $BDC6 BIT 2,(IY+$04) ; branch on object state flag bit 2
 $BDCA JR Z,$BDD7     ;
*$BDCC LD A,(IY+$05)  ; {self-loop: advance frame counter, run per-frame update
 $BDCF LD HL,$A052    ; at $A052
 $BDD2 CALL $B7F6     ; }
 $BDD5 JR $BDAE       ;
*$BDD7 BIT 7,(IY+$0F) ; branch on respawn/blink flag bit 7
 $BDDB JR Z,$BDF6     ;
 $BDDD DEC (IY+$0F)   ; {count down respawn blink timer
 $BDE0 LD A,(IY+$0F)  ;
 $BDE3 CP $80         ;
 $BDE5 JR Z,$BDFB     ; }
 $BDE7 LD A,(IY+$0D)  ; {advance blink phase, loop
 $BDEA ADD A,$20      ;
 $BDEC LD (IY+$0D),A  ;
 $BDEF JR NC,$BDF4    ; }
 $BDF1 INC (IY+$0E)   ;
*$BDF4 JR $BDAE       ;
*$BDF6 DEC (IY+$0F)   ; count down remaining blink cycles
 $BDF9 JR NZ,$BDAE    ;
*$BDFB SET 2,(IY+$04) ; {clear blink state, resume normal update
 $BDFF JR $BDCC       ; }

; Player frozen: unwind an extra call level, then no-op
;
; .
;
; .
;
; Handler for index $2A of the #R$A000 jump table (see #R$B7F6).
c$BE01 POP HL        ;

; Player idle: no-op
;
; .
;
; .
;
; Handler for index $29 of the #R$A000 jump table (see #R$B7F6).
@label=noop_BE02
c$BE02 RET           ;

; Player: skip movement if immobilised, else read input and move
;
; .
;
; .
;
; Handler for index $2B of the #R$A000 jump table (see #R$B7F6).
c$BE03 LD A,($9C3B)  ; {skip movement if immobilised flag at $9C3B set
 $BE06 AND A         ;
 $BE07 JP NZ,$BED4   ; }
 $BE0A LD A,(IY+$18) ; {count down invulnerability timer, refresh sprite frame
 $BE0D CP $FF        ; when it expires
 $BE0F JR Z,$BE20    ;
 $BE11 AND $07       ;
 $BE13 LD (IY+$06),A ;
 $BE16 DEC (IY+$18)  ; }
 $BE19 LD DE,$0000   ;
 $BE1C CALL Z,$C5AF  ; Start object explosion sequence
 $BE1F RET           ;
*$BE20 LD A,($9C6B)  ; {check immunity flag at $9C6B
 $BE23 AND $80       ; }
 $BE25 JR Z,$BE2B    ; POKE 48677,24 forces unconditional JR, disabling damage
                     ; call (Immunity alt)
 $BE27 CALL $BF22    ; Handle player hit
 $BE2A RET           ;
*$BE2B CALL $68B1    ; Read input
 $BE2E LD A,($9CDE)  ; {decode horizontal direction bits from input (Kempston
 $BE31 LD C,A        ; layout: bit 0=Right, bit 1=Left)
 $BE32 AND $03       ;
 $BE34 LD B,$01      ; }
 $BE36 JR Z,$BE65    ; no horizontal input: skip straight to vertical/banking
                     ; step
 $BE38 LD L,(IY+$0B) ; {load X position, DE=step distance $0060
 $BE3B LD H,(IY+$0C) ;
 $BE3E LD DE,$0060   ; }
 $BE41 RRA           ; {shift Right bit into carry; assume bank-right target
 $BE42 LD B,$02      ; (B=2)}
 $BE44 JR C,$BE4C    ; if Right held, branch to add step (#R$BE4C)
 $BE46 LD B,$00      ; {Left held: bank-left target (B=0), subtract step
 $BE48 SBC HL,DE     ; }

; Clamp player position to screen bounds, update bank animation
;
; .
;
; .
;
; Clamps the player object's X position ($IY+0B/0C) between $0700 and $18E0,
; then its Y position (IY+0D/0E) between $0300 and $18E0, then steps a "bank
; angle" frame (IY+16, target IY+17) toward its target by 1 per call (with a
; short delay after a direction change) and looks up the resulting sprite frame
; from a table at $9B4C. Entered from $BE2E/#R$BE4C with B already set to the
; bank-frame target: 2 if Right is held (X increasing), 0 if Left is held (X
; decreasing), 1 if neither (level flight, no X movement) - this is the actual
; Left/Right-to-plane-tilt conversion.
@label=clamp_player_pos
c$BE4A JR $BE4D        ; entry: X delta already applied, skip add
; This entry point is used by the routine at #R$BE03.
*$BE4C ADD HL,DE       ; entry: add X delta (HL+=DE)
*$BE4D LD A,H          ; {check X within left bound
 $BE4E SUB $07         ;
 $BE50 JP P,$BE58      ; }
 $BE53 LD HL,$0700     ; {clamp X to left edge ($0700)
 $BE56 JR $BE5F        ; }
*$BE58 CP $12          ; {check X within right bound
 $BE5A JR C,$BE5F      ; }
 $BE5C LD HL,$18E0     ; clamp X to right edge ($18E0)
*$BE5F LD (IY+$0B),L   ; {store clamped X position
 $BE62 LD (IY+$0C),H   ; }
; This entry point is used by the routine at #R$BE03.
*$BE65 LD (IY+$17),B   ; {save frame-select param; decode vertical direction
 $BE68 LD A,C          ; bits
 $BE69 AND $0C         ;
 $BE6B RRA             ;
 $BE6C RRA             ; }
 $BE6D JR Z,$BE98      ; skip vertical move if no direction bit set
 $BE6F LD L,(IY+$0D)   ; {load Y position, DE=step size
 $BE72 LD H,(IY+$0E)   ;
 $BE75 LD DE,$0060     ; }
 $BE78 RRA             ; {check vertical direction bit
 $BE79 JR C,$BE7F      ; }
 $BE7B SBC HL,DE       ; {move up
 $BE7D JR $BE80        ; }
*$BE7F ADD HL,DE       ; move down
*$BE80 LD A,H          ; {check Y within top bound
 $BE81 SUB $03         ;
 $BE83 JP P,$BE8B      ; }
 $BE86 LD HL,$0300     ; {clamp Y to top edge ($0300)
 $BE89 JR $BE92        ; }
*$BE8B CP $16          ; {check Y within bottom bound
 $BE8D JR C,$BE92      ; }
 $BE8F LD HL,$18E0     ; clamp Y to bottom edge ($18E0)
*$BE92 LD (IY+$0D),L   ; {store clamped Y position
 $BE95 LD (IY+$0E),H   ; }
*$BE98 LD A,(IY+$16)   ; {read current bank frame; check banking-in-progress
 $BE9B BIT 4,(IY+$04)  ; flag}
 $BE9F JR NZ,$BEAE     ; skip if already banking
 $BEA1 CP (IY+$17)     ; {no bank change needed if already at target
 $BEA4 JR Z,$BEC7      ; }
 $BEA6 SET 4,(IY+$04)  ; {start banking, set delay timer=5
 $BEAA LD (IY+$15),$05 ; }
*$BEAE DEC (IY+$15)    ; {count down bank-delay timer
 $BEB1 JR NZ,$BEC7     ; }
 $BEB3 RES 4,(IY+$04)  ; {clear banking flag; compare target vs current bank
 $BEB7 LD A,(IY+$17)   ;
 $BEBA LD C,(IY+$16)   ; }
 $BEBD CP C            ;
 $BEBE JR Z,$BEC7      ;
 $BEC0 SBC A,A         ; {step current bank frame toward target by 1
 $BEC1 OR $01          ;
 $BEC3 ADD A,C         ;
 $BEC4 LD (IY+$16),A   ; }
*$BEC7 LD H,$9B        ; {index sprite-frame table by bank value
 $BEC9 ADD A,$4C       ;
 $BECB LD L,A          ;
 $BECC LD A,(HL)       ; }
 $BECD LD (IY+$06),A   ; store new sprite frame
 $BED0 CALL $BF42      ; Use bomb
 $BED3 RET             ;
; This entry point is used by the routine at #R$BE03.
*$BED4 LD HL,$9C3B     ;
 $BED7 AND A           ;
 $BED8 JP P,$BF1A      ;
 $BEDB LD A,(IY+$0E)   ;
 $BEDE CP $11          ;
 $BEE0 JR NZ,$BEF2     ;
 $BEE2 LD A,(IY+$0C)   ;
 $BEE5 CP $0E          ;
 $BEE7 JR NZ,$BEF2     ;
 $BEE9 LD (IY+$06),$06 ;
 $BEED LD A,$38        ;
 $BEEF ADD A,(HL)      ;
 $BEF0 LD (HL),A       ;
 $BEF1 RET             ;
*$BEF2 DEC (HL)        ;
 $BEF3 LD IX,$9CB5     ;
 $BEF7 CALL $B845      ; Compute angle from object IX to target IY
 $BEFA LD B,$03        ;
 $BEFC CALL $B8A2      ; Compute velocity vector (dx,dy) from angle and speed
 $BEFF CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $BF02 LD A,(IY+$0C)   ;
 $BF05 CP $0E          ;
 $BF07 LD (IY+$06),$06 ;
 $BF0B RET Z           ;
 $BF0C BIT 7,(IY+$07)  ;
 $BF10 LD (IY+$06),$04 ;
 $BF14 RET Z           ;
 $BF15 LD (IY+$06),$00 ;
 $BF19 RET             ;
*$BF1A DEC (HL)        ;
 $BF1B RET NZ          ;
 $BF1C LD A,$03        ;
 $BF1E CALL $A599      ; Ratchet player state forward
 $BF21 RET             ;

; Handle player hit: switch to hit/explosion animation, arm recovery timer
;
; Used by the routine at #R$BE03.
;
; IY player object base (inherited from $BDAE's caller)
;
; Called from #R$BDAE right after the immunity flag check fails (both immunity
; POKEs disable that call). Tags the object at $9C77 (the thing that hit the
; player) with the current wave/formation id from $9BA4, then repoints the
; player's per-frame update-routine pointer (IY+2/+3, little-endian) to $6B86 -
; the hit/explosion animation handler, same pointer-swap trick used by #R$C5AF
; for enemies - and arms a 38-frame ($26) timer at $9C3C, presumably the
; death/respawn delay.
@label=player_hit
c$BF22 LD IX,($9C77)   ; IX = object that hit the player
 $BF26 LD A,($9BA4)    ; {tag it with current wave/formation id
 $BF29 LD (IX+$07),A   ; }
 $BF2C LD (IY+$18),$0E ; {arm hit-reaction timer; set player's IX+$02/$03
 $BF30 LD (IY+$02),$86 ; (record ptr, not code) to $6B86...}
 $BF34 LD (IY+$03),$6B ; {...(hit/explosion animation); set visual state
 $BF38 LD (IY+$06),$06 ; }
 $BF3C LD A,$26        ; {arm 38-frame recovery/death timer at $9C3C
 $BF3E LD ($9C3C),A    ; }
 $BF41 RET             ; return

; Use bomb: consume inventory, trigger flash effect
;
; Used by the routine at #R$BE4A.
;
; .
;
; Triggered when the input state at $9CDC equals $09. Decrements the player's
; bomb count (IX+9, confirmed via #R$66DE), sets bit 2 of the deferred-event
; mask $9C27, adds to a bonus accumulator ($9C70), and points the screen-flash
; sequence pointer $9C5B at $9C5E - the same mechanism #R$6A88 and #R$C72A use
; for the corner-box/screen flash. Once the input state reaches exactly 1 (key
; released), it also allocates a new object from the free-list pool ($9D1C,
; same trick as #R$C559), copies initial fields from a spawn-parameter data
; table at #R$6BB9 (BC points there; NOT a code handler), and positions it at
; the player's location (from IY+0D/0E) - spawning the actual bomb-explosion
; object.
c$BF42 LD DE,$9CDC     ;
 $BF45 LD A,(DE)       ;
 $BF46 CP $09          ; {Trigger only when input state ($9CDC) is $09
 $BF48 JR NZ,$BF6A     ; }
 $BF4A LD IX,($9C77)   ;
 $BF4E LD A,(IX+$09)   ;
 $BF51 AND A           ;
 $BF52 JR Z,$BF6A      ;
 $BF54 DEC (IX+$09)    ; Consume one bomb (IX+$09)
 $BF57 LD HL,$9C27     ;
 $BF5A SET 2,(HL)      ; Request the screen-flash deferred event ($9C27 bit 2)
 $BF5C LD HL,$9C70     ;
 $BF5F LD A,($9C6F)    ;
 $BF62 ADD A,(HL)      ;
 $BF63 LD (HL),A       ;
 $BF64 LD HL,$9C5E     ;
 $BF67 LD ($9C5B),HL   ;
*$BF6A LD A,(DE)       ;
 $BF6B DEC A           ; {Spawn only once input state reaches 1 (key released)
 $BF6C RET NZ          ; }
 $BF6D LD ($BFE3),SP   ;
 $BF71 LD BC,$6BB9     ; BC = spawn-parameter table #R$6BB9
 $BF74 EXX             ;
 $BF75 LD DE,($9C73)   ; {DE = per-type spawn data ($9C73); B = object count
 $BF79 LD A,(DE)       ;
 $BF7A INC DE          ;
 $BF7B LD B,A          ; }
 $BF7C LD HL,$9D19     ;
*$BF7F LD A,($9C72)    ; {Skip spawn if the object pool is full (difficulty
 $BF82 ADD A,A         ; $9C72 vs $9D19)
 $BF83 NEG             ;
 $BF85 ADD A,$06       ;
 $BF87 CP (HL)         ;
 $BF88 JR NC,$BFE2     ; }
 $BF8A DEC (HL)        ;
 $BF8B EXX             ;
 $BF8C LD IX,($9D1C)   ; {Pop a free object slot ($9D1C)
 $BF90 LD SP,IX        ;
 $BF92 POP HL          ;
 $BF93 LD ($9D1C),HL   ;
 $BF96 POP HL          ;
 $BF97 PUSH BC         ; }
 $BF98 LD HL,($9D30)   ;
 $BF9B PUSH HL         ;
 $BF9C LD ($9D30),SP   ;
 $BFA0 EXX             ;
 $BFA1 SET 2,(IX+$04)  ;
 $BFA5 LD (IX+$05),$03 ;
 $BFA9 LD (IX+$06),$06 ;
 $BFAD LD (IX+$13),$FF ;
 $BFB1 LD (IX+$09),$00 ;
 $BFB5 LD (IX+$0A),$FE ;
 $BFB9 LD A,(IY+$0D)   ; {Position new object at the player (IY+$0D/$0E)
 $BFBC LD (IX+$0D),A   ;
 $BFBF LD A,(IY+$0E)   ;
 $BFC2 DEC A           ;
 $BFC3 LD (IX+$0E),A   ; }
 $BFC6 LD A,(DE)       ; {Copy velocity/offset fields from spawn data
 $BFC7 INC DE          ;
 $BFC8 ADD A,(IY+$0B)  ;
 $BFCB LD (IX+$0B),A   ;
 $BFCE LD A,(DE)       ;
 $BFCF INC DE          ;
 $BFD0 ADC A,(IY+$0C)  ;
 $BFD3 LD (IX+$0C),A   ;
 $BFD6 LD A,(DE)       ; }
 $BFD7 LD (IX+$07),A   ;
 $BFDA INC DE          ;
 $BFDB LD A,(DE)       ;
 $BFDC LD (IX+$08),A   ;
 $BFDF INC DE          ;
 $BFE0 DJNZ $BF7F      ; Next object
*$BFE2 LD SP,$0000     ; Restore SP
 $BFE5 LD A,$01        ;
 $BFE7 CALL $A1D4      ; Request sound effect if higher priority than current
 $BFEA RET             ;

; Check for bullet hit, start explosion
;
; .
;
; .
;
; Handler for index $2C of the #R$A000 jump table (see #R$B7F6).
c$BFEB LD A,($9C6B)  ;
 $BFEE AND (IY+$14)  ;
 $BFF1 JR Z,$C002    ;
 $BFF3 LD HL,$9C6C   ;
 $BFF6 AND (HL)      ;
 $BFF7 JR Z,$C00D    ;
 $BFF9 LD (HL),$00   ;
 $BFFB LD DE,$9D19   ;
 $BFFE CALL $C5AF    ; Start object explosion sequence
 $C001 RET           ;
*$C002 CALL $BA0A    ; Apply object velocity (dx,dy) to position
 $C005 LD A,(IY+$0E) ;
 $C008 CP $02        ;
 $C00A JR C,$C00D    ;
 $C00C RET           ;
*$C00D LD HL,$9D19   ;
 $C010 INC (HL)      ;
 $C011 CALL $B79F    ; Mark formation slot done, trigger completion effect when
                     ; group empties
 $C014 RET           ;

; Launch and move projectile; explode on hit
;
; .
;
; .
;
; Handler for index $36 of the #R$A000 jump table (see #R$B7F6).
; .
; On first call (IY+10 != $FF) computes a launch velocity via #R$B8A2 from
; angle IY+10/speed IY+11, then marks IY+10=$FF so it only fires once. Every
; call then moves the object via #R$BA0A. If flag bit 5 of IY+4 is set and
; IY+14 indicates a hit (bit 7 set, not bit 6), sets the global hit flag at
; $9C6B and starts an explosion via #R$C5AF; otherwise, once flag bit 5 is
; clear, retires the object and signals formation completion via #R$B79F.
c$C015 LD A,(IY+$10)   ;
 $C018 CP $FF          ;
 $C01A JP Z,$C02A      ;
 $C01D LD B,(IY+$11)   ;
 $C020 CALL $B8A2      ; Compute velocity vector (dx,dy) from angle and speed
 $C023 CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $C026 LD (IY+$10),$FF ;
*$C02A CALL $BA0A      ; Apply object velocity (dx,dy) to position
 $C02D BIT 5,(IY+$04)  ;
 $C031 JR Z,$C049      ;
 $C033 LD A,(IY+$14)   ;
 $C036 BIT 6,A         ;
 $C038 JR NZ,$C049     ;
 $C03A AND $80         ;
 $C03C RET Z           ;
 $C03D LD HL,$9C6B     ;
 $C040 SET 7,(HL)      ;
 $C042 LD DE,$9D1A     ;
 $C045 CALL $C5AF      ; Start object explosion sequence
 $C048 RET             ;
*$C049 LD HL,$9D1A     ;
 $C04C INC (HL)        ;
 $C04D CALL $B79F      ; Mark formation slot done, trigger completion effect
                       ; when group empties
 $C050 RET             ;

; Move straight down at fixed speed; advance animation frame
;
; .
;
; .
;
; Handler for index $2D of the #R$A000 jump table (see #R$B7F6).
c$C051 LD A,(IY+$0D) ; {add fixed step $20 to Y position low byte
 $C054 ADD A,$20     ;
 $C056 LD (IY+$0D),A ; }
 $C059 JR NC,$C05E   ; {carry into Y position high byte
 $C05B INC (IY+$0E)  ; }
*$C05E LD A,(IY+$06) ; {advance animation frame, check wrap at 16
 $C061 INC A         ;
 $C062 CP $10        ; }
 $C064 JR Z,$C06A    ; branch when frame wraps
 $C066 LD (IY+$06),A ; {store frame, return
 $C069 RET           ; }
*$C06A LD L,(IY+$15) ; {load pointer stored at IY+15/16
 $C06D LD H,(IY+$16) ; }
 $C070 INC (HL)      ; {increment counter at that pointer, notify #R$B7A3
 $C071 CALL $B7A3    ; }
 $C074 RET           ; return

; Multi-hit enemy: take damage, retire after hit counter (IY+12) expires
;
; .
;
; .
;
; Handler for indices $2E, $2F of the #R$A000 jump table (see #R$B7F6).
; .
; On each hit (IY+14 nonzero), ORs it into the global hit-flag $9C6B and
; decrements a per-object hit counter at IY+12; the object only dies once that
; counter reaches zero (unlike #R$C015's one-hit projectile). Also handles
; retirement via #R$B79F when the "alive" flag (bit 1 of IY+4) or "dying" flag
; (bit 4) indicate the object is done.
c$C075 CALL $B8F9      ; Movement-pattern script interpreter
 $C078 BIT 1,(IY+$04)  ;
 $C07C JR Z,$C08C      ;
 $C07E BIT 4,(IY+$04)  ;
 $C082 JR NZ,$C0D4     ;
*$C084 LD HL,$9D18     ;
 $C087 INC (HL)        ;
 $C088 CALL $B79F      ; Mark formation slot done, trigger completion effect
                       ; when group empties
 $C08B RET             ;
*$C08C BIT 4,(IY+$04)  ;
 $C090 JR NZ,$C10A     ;
 $C092 LD A,(IY+$14)   ;
 $C095 LD C,A          ;
 $C096 AND A           ;
 $C097 JR Z,$C0E0      ;
 $C099 LD HL,$9C6B     ;
 $C09C LD A,C          ;
 $C09D OR (HL)         ;
 $C09E LD (HL),A       ;
 $C09F DEC (IY+$12)    ;
 $C0A2 JR NZ,$C0E0     ;
 $C0A4 LD A,(IY+$05)   ;
 $C0A7 CP $05          ;
 $C0A9 JR NZ,$C0D4     ;
 $C0AB CALL $B7FE      ; Pseudo-random number generator
 $C0AE BIT 7,(IY+$14)  ;
 $C0B2 JR NZ,$C0B8     ;
 $C0B4 CP $40          ;
 $C0B6 JR NC,$C0D4     ;
*$C0B8 RES 7,(IY+$04)  ;
 $C0BC RRA             ;
 $C0BD JR C,$C0C3      ;
 $C0BF SET 7,(IY+$04)  ;
*$C0C3 LD (IY+$15),$F1 ;
 $C0C7 LD (IY+$16),$5C ;
 $C0CB LD (IY+$18),$01 ;
 $C0CF SET 4,(IY+$04)  ;
 $C0D3 RET             ;
*$C0D4 LD A,$04        ;
 $C0D6 CALL $66B5      ; Add BCD score value to current player's score
 $C0D9 LD DE,$9D18     ;
 $C0DC CALL $C5AF      ; Start object explosion sequence
 $C0DF RET             ;
*$C0E0 LD A,(IY+$0E)   ;
 $C0E3 CP $1E          ;
 $C0E5 JR NC,$C084     ;
 $C0E7 LD A,(IY+$10)   ;
 $C0EA ADD A,$03       ;
 $C0EC AND $38         ;
 $C0EE RRCA            ;
 $C0EF RRCA            ;
 $C0F0 RRCA            ;
 $C0F1 LD (IY+$06),A   ;
 $C0F4 LD A,(IY+$05)   ;
 $C0F7 CP $0C          ;
 $C0F9 JR NZ,$C106     ;
 $C0FB LD A,(IY+$0F)   ;
 $C0FE CP $58          ;
 $C100 JR NC,$C106     ;
 $C102 INC (IY+$0F)    ;
 $C105 RET             ;
*$C106 CALL $C43C      ; Enemy fire-decision timer and heading steering
 $C109 RET             ;
*$C10A LD A,(IY+$06)   ; {step sprite frame (IY+6), 8-direction wrap, mirrored
 $C10D DEC A           ; via IY+4 bit 7
 $C10E BIT 7,(IY+$04)  ;
 $C112 JR Z,$C116      ;
 $C114 ADD A,$02       ; }
*$C116 AND $07         ;
 $C118 LD (IY+$06),A   ;
 $C11B RET             ;

; Scripted-movement enemy: take variable damage, explode when destroyed
;
; .
;
; .
;
; Handler for index $35 of the #R$A000 jump table (see #R$B7F6). Runs the
; movement script, then handles retirement (IY+4 bit 1 -> #R$C191/#R$B79F). On
; a hit (IY+14 nonzero), decodes a variable damage amount from it via 6
; rotate/add steps into E, ORs the hit flag into the global $9C6B, and
; subtracts the damage from health (IY+12); once health goes negative it awards
; a score bonus (#R$66B5) and explodes (#R$C5AF). Otherwise falls through to
; #R$C16E, which handles fire timing and 8-direction sprite-frame selection
; from the aim angle (IY+0F/+10).
c$C11C CALL $B8F9     ; Movement-pattern script interpreter
 $C11F BIT 1,(IY+$04) ;
 $C123 JR NZ,$C191    ;
 $C125 LD A,(IY+$14)  ;
 $C128 LD C,A         ;
 $C129 AND A          ;
 $C12A JR Z,$C16E     ;
 $C12C BIT 6,A        ;
 $C12E LD E,$00       ;
 $C130 JR Z,$C134     ;
 $C132 LD E,$02       ;
*$C134 AND $3F        ;
 $C136 LD ($9C6C),A   ;
 $C139 LD L,A         ;
 $C13A LD A,E         ;
 $C13B JR Z,$C152     ;
 $C13D LD D,$00       ;
 $C13F RR L           ;
 $C141 ADC A,D        ;
 $C142 RR L           ;
 $C144 ADC A,D        ;
 $C145 RR L           ;
 $C147 ADC A,D        ;
 $C148 RR L           ;
 $C14A ADC A,D        ;
 $C14B RR L           ;
 $C14D ADC A,D        ;
 $C14E RR L           ;
 $C150 ADC A,D        ;
 $C151 LD E,A         ;
*$C152 LD HL,$9C6B    ;
 $C155 LD A,C         ;
 $C156 OR (HL)        ;
 $C157 LD (HL),A      ;
 $C158 LD A,(IY+$12)  ;
 $C15B SUB E          ;
 $C15C LD (IY+$12),A  ;
 $C15F JP P,$C16E     ;
 $C162 LD A,$09       ;
 $C164 CALL $66B5     ; Add BCD score value to current player's score
 $C167 LD DE,$9D18    ;
 $C16A CALL $C5AF     ; Start object explosion sequence
 $C16D RET            ;
*$C16E LD A,(IY+$0E)  ;
 $C171 CP $1E         ;
 $C173 JR NC,$C191    ;
 $C175 LD A,(IY+$10)  ;
 $C178 ADD A,$03      ;
 $C17A AND $38        ;
 $C17C RRCA           ;
 $C17D RRCA           ;
 $C17E RRCA           ;
 $C17F LD (IY+$06),A  ;
 $C182 LD A,(IY+$0F)  ;
 $C185 CP $58         ;
 $C187 JR NC,$C18D    ;
 $C189 INC (IY+$0F)   ;
 $C18C RET            ;
*$C18D CALL $C43C     ; Enemy fire-decision timer and heading steering
 $C190 RET            ;
*$C191 LD HL,$9D18    ;
 $C194 INC (HL)       ;
 $C195 CALL $B79F     ; Mark formation slot done, trigger completion effect
                      ; when group empties
 $C198 RET            ;

; Multi-hit enemy: move straight down, take damage
;
; .
;
; .
;
; Handler for indices $32, $33, $3A of the #R$A000 jump table (see #R$B7F6).
; .
; Runs the movement script, retires if the "alive" flag (IY+4 bit 1) is set.
; Otherwise moves straight down ($0020/frame, same as #R$C051) and retires once
; past a Y boundary ($1C). On a hit (IY+14, masked to 7 bits), ORs it into the
; global hit flag $9C6B and decrements health (IY+12); once health reaches
; zero, checks a secondary counter (IY+1A, cp $08) suggesting a
; multi-stage/multi-hit-phase enemy - not fully traced.
c$C199 CALL $B8F9      ; Movement-pattern script interpreter
 $C19C BIT 1,(IY+$04)  ;
 $C1A0 JR NZ,$C1EB     ;
 $C1A2 LD A,(IY+$0D)   ;
 $C1A5 ADD A,$20       ;
 $C1A7 LD (IY+$0D),A   ;
 $C1AA JR NC,$C1AF     ;
 $C1AC INC (IY+$0E)    ;
*$C1AF LD A,(IY+$0E)   ;
 $C1B2 CP $1C          ;
 $C1B4 JR NC,$C1EB     ;
 $C1B6 LD A,(IY+$14)   ;
 $C1B9 AND $7F         ;
 $C1BB LD C,A          ;
 $C1BC JR Z,$C1F3      ;
 $C1BE LD HL,$9C6B     ;
 $C1C1 LD A,C          ;
 $C1C2 OR (HL)         ;
 $C1C3 LD (HL),A       ;
 $C1C4 DEC (IY+$12)    ;
 $C1C7 JR NZ,$C1F3     ;
 $C1C9 LD A,(IY+$1A)   ;
 $C1CC CP $08          ;
 $C1CE JR NC,$C1DF     ;
 $C1D0 LD (IY+$1A),$FF ;
 $C1D4 LD (IY+$12),$01 ;
 $C1D8 LD A,$02        ;
 $C1DA CALL $66B5      ; Add BCD score value to current player's score
 $C1DD JR $C1F3        ;
*$C1DF LD A,$03        ;
 $C1E1 CALL $66B5      ; Add BCD score value to current player's score
 $C1E4 LD DE,$9D18     ;
 $C1E7 CALL $C5AF      ; Start object explosion sequence
 $C1EA RET             ;
*$C1EB LD HL,$9D18     ;
 $C1EE INC (HL)        ;
 $C1EF CALL $B79F      ; Mark formation slot done, trigger completion effect
                       ; when group empties
 $C1F2 RET             ;
*$C1F3 LD A,(IY+$10)   ;
 $C1F6 ADD A,$03       ;
 $C1F8 AND $38         ;
 $C1FA RRCA            ;
 $C1FB RRCA            ;
 $C1FC RRCA            ;
 $C1FD LD C,A          ;
 $C1FE LD A,(IY+$05)   ;
 $C201 CP $09          ;
 $C203 LD A,C          ;
 $C204 JR NZ,$C20B     ;
 $C206 LD A,$04        ;
 $C208 ADD A,C         ;
 $C209 AND $07         ;
*$C20B LD (IY+$06),A   ;
 $C20E LD A,(IY+$1A)   ;
 $C211 CP $FF          ;
 $C213 CALL NZ,$C43C   ; Enemy fire-decision timer and heading steering
 $C216 RET             ;

; Movement handler $37: run movement script, then advance and act on IY+$14
; flags
;
; .
;
; IY object struct base (status IY+$04 bit 1, Y at IY+$0D/$0E, action flags
; .  IY+$14)
;
; Handler for index $37 of the #R$A000 jump table (see #R$B7F6).
; .
; Handler for index $37 of the #R$A000 jump table. First calls #R$B8F9 to run
; the object's movement-pattern script. Unless status flag IY+$04 bit 1 is set,
; advances Y (IY+$0D/$0E) by $20 like the other movement handlers
; (#R$C298/#R$C31A/#R$C359/#R$C388), then decodes the IY+$14 action byte into a
; steering/target angle stored at $9C6C.
c$C217 CALL $B8F9     ; Movement-pattern script interpreter
 $C21A BIT 1,(IY+$04) ;
 $C21E JR NZ,$C270    ;
 $C220 LD A,(IY+$0D)  ;
 $C223 ADD A,$20      ;
 $C225 LD (IY+$0D),A  ;
 $C228 JR NC,$C22D    ;
 $C22A INC (IY+$0E)   ;
*$C22D LD A,(IY+$14)  ;
 $C230 LD C,A         ;
 $C231 AND $7F        ;
 $C233 JR Z,$C27C     ;
 $C235 BIT 6,A        ;
 $C237 LD E,$00       ;
 $C239 JR Z,$C23D     ;
 $C23B LD E,$02       ;
*$C23D AND $3F        ;
 $C23F LD ($9C6C),A   ;
 $C242 LD L,A         ;
 $C243 LD A,E         ;
 $C244 JR Z,$C25B     ;
 $C246 LD D,$00       ;
 $C248 RR L           ;
 $C24A ADC A,D        ;
 $C24B RR L           ;
 $C24D ADC A,D        ;
 $C24E RR L           ;
 $C250 ADC A,D        ;
 $C251 RR L           ;
 $C253 ADC A,D        ;
 $C254 RR L           ;
 $C256 ADC A,D        ;
 $C257 RR L           ;
 $C259 ADC A,D        ;
 $C25A LD E,A         ;
*$C25B LD HL,$9C6B    ;
 $C25E LD A,C         ;
 $C25F OR (HL)        ;
 $C260 LD (HL),A      ;
 $C261 LD A,(IY+$12)  ;
 $C264 SUB E          ;
 $C265 LD (IY+$12),A  ;
 $C268 JP P,$C277     ;
 $C26B LD A,$01       ;
 $C26D CALL $66B5     ; Add BCD score value to current player's score
*$C270 LD DE,$9D18    ;
 $C273 CALL $C5AF     ; Start object explosion sequence
 $C276 RET            ;
*$C277 LD A,$00       ;
 $C279 CALL $66B5     ; Add BCD score value to current player's score
*$C27C LD A,(IY+$10)  ;
 $C27F ADD A,$03      ;
 $C281 AND $38        ;
 $C283 RRCA           ;
 $C284 RRCA           ;
 $C285 RRCA           ;
 $C286 LD (IY+$06),A  ;
 $C289 LD A,(IY+$0F)  ;
 $C28C CP $28         ;
 $C28E JR NC,$C294    ;
 $C290 INC (IY+$0F)   ;
 $C293 RET            ;
*$C294 CALL $C43C     ; Enemy fire-decision timer and heading steering
 $C297 RET            ;

