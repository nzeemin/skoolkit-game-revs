 $B01C POP BC        ; {Copy column: store #R$9A00[C] straight to screen
 $B01D LD L,C        ; (opaque, no mask)
 $B01E LD A,(HL)     ;
 $B01F LD (DE),A     ;
 $B020 INC E         ; }
 $B021 POP BC        ;
 $B022 LD L,C        ;
 $B023 LD A,(HL)     ;
 $B024 LD (DE),A     ;
 $B025 INC E         ;
 $B026 POP BC        ;
 $B027 LD L,C        ;
 $B028 LD A,(HL)     ;
 $B029 LD (DE),A     ;
 $B02A INC E         ;
 $B02B POP BC        ;
 $B02C LD L,C        ;
 $B02D LD A,(HL)     ;
 $B02E LD (DE),A     ;
 $B02F INC E         ;
 $B030 POP BC        ;
 $B031 LD L,C        ;
 $B032 LD A,(HL)     ;
 $B033 LD (DE),A     ;
 $B034 INC E         ;
 $B035 POP BC        ;
 $B036 LD L,C        ;
 $B037 LD A,(HL)     ;
 $B038 LD (DE),A     ;
 $B039 INC E         ;
 $B03A POP BC        ;
 $B03B LD L,C        ;
 $B03C LD A,(HL)     ;
 $B03D LD (DE),A     ;
 $B03E INC E         ;
 $B03F POP BC        ;
 $B040 LD L,C        ;
 $B041 LD A,(HL)     ;
 $B042 LD (DE),A     ;
 $B043 INC E         ;
 $B044 POP BC        ;
 $B045 LD L,C        ;
 $B046 LD A,(HL)     ;
 $B047 LD (DE),A     ;
 $B048 INC E         ;
 $B049 POP BC        ;
 $B04A LD L,C        ;
 $B04B LD A,(HL)     ;
 $B04C LD (DE),A     ;
 $B04D INC E         ;
 $B04E POP BC        ;
 $B04F LD L,C        ;
 $B050 LD A,(HL)     ;
 $B051 LD (DE),A     ;
 $B052 INC E         ;
 $B053 POP BC        ;
 $B054 LD L,C        ;
 $B055 LD A,(HL)     ;
 $B056 LD (DE),A     ;
 $B057 INC E         ;
 $B058 POP BC        ;
 $B059 LD L,C        ;
 $B05A LD A,(HL)     ;
 $B05B LD (DE),A     ;
 $B05C INC E         ;
 $B05D POP BC        ;
 $B05E LD L,C        ;
 $B05F LD A,(HL)     ;
 $B060 LD (DE),A     ;
 $B061 INC E         ;
 $B062 POP BC        ;
 $B063 LD L,C        ;
 $B064 LD A,(HL)     ;
 $B065 LD (DE),A     ;
 $B066 INC E         ;
 $B067 POP BC        ;
 $B068 LD L,C        ;
 $B069 LD A,(HL)     ;
 $B06A LD (DE),A     ;
 $B06B DEC D         ; Next row column-base
 $B06C EXX           ;
 $B06D DJNZ $B019    ; Loop $9C1A rows
 $B06F JP $AFB8      ; => Formation script

; Update tile-block tables ($7900+) from SP-fed data (index $04)
;
; .
;
; .
;
; Handler for index $04 of the #R$A000 jump table (see #R$B7F6). Writes into
; the 2x2 tile-block lookup tables at #R$7900-$7CFF (see #R$7900) rather than
; to the screen. For B ($9C1A) passes it fills a descending run of one page
; (H=$79, L from $FF down) with the low byte of each popped word, then INC H
; advances to the next page ($7A/$7B/$7C) - so successive passes populate the
; parallel quadrant tables. Continues into the formation script (#R$AFB8).
c$B072 LD SP,($9C15) ; Source data via SP (POP-fed)
 $B076 LD A,($9C1A)  ; B = column/pass count ($9C1A)
 $B079 LD B,A        ;
 $B07A LD H,$79      ; H=$79: destination tile-block table page
 $B07C LD A,$FF      ; A=$FF: row index start (writes descending)
*$B07E LD L,A        ; Set row index for this pass
 $B07F POP DE        ; {Store low byte of popped word, descending
 $B080 LD (HL),E     ;
 $B081 DEC L         ; }
 $B082 POP DE        ;
 $B083 LD (HL),E     ;
 $B084 DEC L         ;
 $B085 POP DE        ;
 $B086 LD (HL),E     ;
 $B087 DEC L         ;
 $B088 POP DE        ;
 $B089 LD (HL),E     ;
 $B08A DEC L         ;
 $B08B POP DE        ;
 $B08C LD (HL),E     ;
 $B08D DEC L         ;
 $B08E POP DE        ;
 $B08F LD (HL),E     ;
 $B090 DEC L         ;
 $B091 POP DE        ;
 $B092 LD (HL),E     ;
 $B093 DEC L         ;
 $B094 POP DE        ;
 $B095 LD (HL),E     ;
 $B096 DEC L         ;
 $B097 POP DE        ;
 $B098 LD (HL),E     ;
 $B099 DEC L         ;
 $B09A POP DE        ;
 $B09B LD (HL),E     ;
 $B09C DEC L         ;
 $B09D POP DE        ;
 $B09E LD (HL),E     ;
 $B09F DEC L         ;
 $B0A0 POP DE        ;
 $B0A1 LD (HL),E     ;
 $B0A2 DEC L         ;
 $B0A3 POP DE        ;
 $B0A4 LD (HL),E     ;
 $B0A5 DEC L         ;
 $B0A6 POP DE        ;
 $B0A7 LD (HL),E     ;
 $B0A8 DEC L         ;
 $B0A9 POP DE        ;
 $B0AA LD (HL),E     ;
 $B0AB DEC L         ;
 $B0AC POP DE        ;
 $B0AD LD (HL),E     ;
 $B0AE INC H         ; Next page ($7A/$7B/$7C)
 $B0AF DJNZ $B07E    ; Loop B passes
 $B0B1 JP $AFB8      ; => Formation script

; Opaque tile blit (index $06): copy $9A00[C] to screen, no masking
;
; .
;
; .
;
; Handler for index $06 of the #R$A000 jump table (see #R$B7F6).
c$B0B4 LD A,($9C1A)  ;
 $B0B7 LD B,A        ;
 $B0B8 EXX           ;
 $B0B9 LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B0BD ADD A,$78     ; {Destination high byte = width + $78
 $B0BF LD D,A        ; }
 $B0C0 LD A,$FF      ;
 $B0C2 LD ($B0CA),A  ; Self-modify row-start column operand
 $B0C5 LD H,$9A      ; H=$9A: point at the #R$9A00 lookup table
 $B0C7 EXX           ;
*$B0C8 EXX           ;
 $B0C9 LD E,$00      ;
 $B0CB POP BC        ; {Copy column: store #R$9A00[C] straight to screen
 $B0CC LD L,C        ; (opaque, no mask)
 $B0CD LD A,(HL)     ;
 $B0CE LD (DE),A     ;
 $B0CF DEC E         ; }
 $B0D0 POP BC        ;
 $B0D1 LD L,C        ;
 $B0D2 LD A,(HL)     ;
 $B0D3 LD (DE),A     ;
 $B0D4 DEC E         ;
 $B0D5 POP BC        ;
 $B0D6 LD L,C        ;
 $B0D7 LD A,(HL)     ;
 $B0D8 LD (DE),A     ;
 $B0D9 DEC E         ;
 $B0DA POP BC        ;
 $B0DB LD L,C        ;
 $B0DC LD A,(HL)     ;
 $B0DD LD (DE),A     ;
 $B0DE DEC E         ;
 $B0DF POP BC        ;
 $B0E0 LD L,C        ;
 $B0E1 LD A,(HL)     ;
 $B0E2 LD (DE),A     ;
 $B0E3 DEC E         ;
 $B0E4 POP BC        ;
 $B0E5 LD L,C        ;
 $B0E6 LD A,(HL)     ;
 $B0E7 LD (DE),A     ;
 $B0E8 DEC E         ;
 $B0E9 POP BC        ;
 $B0EA LD L,C        ;
 $B0EB LD A,(HL)     ;
 $B0EC LD (DE),A     ;
 $B0ED DEC E         ;
 $B0EE POP BC        ;
 $B0EF LD L,C        ;
 $B0F0 LD A,(HL)     ;
 $B0F1 LD (DE),A     ;
 $B0F2 DEC E         ;
 $B0F3 POP BC        ;
 $B0F4 LD L,C        ;
 $B0F5 LD A,(HL)     ;
 $B0F6 LD (DE),A     ;
 $B0F7 DEC E         ;
 $B0F8 POP BC        ;
 $B0F9 LD L,C        ;
 $B0FA LD A,(HL)     ;
 $B0FB LD (DE),A     ;
 $B0FC DEC E         ;
 $B0FD POP BC        ;
 $B0FE LD L,C        ;
 $B0FF LD A,(HL)     ;
 $B100 LD (DE),A     ;
 $B101 DEC E         ;
 $B102 POP BC        ;
 $B103 LD L,C        ;
