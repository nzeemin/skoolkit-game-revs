; Enemy fire-decision timer and heading steering
;
; Used by the routines at #R$C075, #R$C11C, #R$C199, #R$C217 and #R$C298.
;
; IY enemy object struct base (status IY+$04, target ref IY+$1A, heading
; .  IY+$1C)
;
; Decrements the shared randomized-reload timer at $9C42 (reloaded from $9C43
; on expiry - same mechanism as $BD99). Once expired, checks activity flags
; (IY+4 bits 0 and 5) and a target reference (IY+1A, $FF = no target), computes
; an aim angle via $B845 toward the target (IX=($9C6D)), then turns the enemy's
; current heading (IY+1C) toward that angle by a rate-limited step (clamped to
; +-4) rather than snapping directly to it - a homing/steering behaviour.
c$C43C LD HL,$9C42     ;
 $C43F DEC (HL)        ;
 $C440 RET NZ          ;
 $C441 LD A,($9C43)    ;
 $C444 LD (HL),A       ;
 $C445 BIT 0,(IY+$04)  ;
 $C449 RET NZ          ;
 $C44A BIT 5,(IY+$04)  ;
 $C44E RET Z           ;
 $C44F LD A,(IY+$1A)   ;
 $C452 CP $FF          ;
 $C454 RET Z           ;
 $C455 LD IX,($9C6D)   ;
