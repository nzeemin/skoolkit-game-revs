 $C167 LD DE,$9D18    ;
 $C16A CALL $C5AF     ; Start object explosion sequence
 $C16D RET            ;
*$C16E LD A,(IY+$0E)  ;
 $C171 CP $1E         ;
 $C173 JR NC,$C191    ;
 $C175 LD A,(IY+$10)  ;
 $C178 ADD A,$03      ;
 $C17A AND $38        ;
 $C17C RRCA           ;
 $C17D RRCA           ;
 $C17E RRCA           ;
 $C17F LD (IY+$06),A  ;
 $C182 LD A,(IY+$0F)  ;
