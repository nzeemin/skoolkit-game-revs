 $C09D OR (HL)         ;
 $C09E LD (HL),A       ;
 $C09F DEC (IY+$12)    ;
 $C0A2 JR NZ,$C0E0     ;
 $C0A4 LD A,(IY+$05)   ;
 $C0A7 CP $05          ;
 $C0A9 JR NZ,$C0D4     ;
