 $C142 RR L           ;
 $C144 ADC A,D        ;
 $C145 RR L           ;
 $C147 ADC A,D        ;
 $C148 RR L           ;
 $C14A ADC A,D        ;
 $C14B RR L           ;
 $C14D ADC A,D        ;
 $C14E RR L           ;
 $C150 ADC A,D        ;
 $C151 LD E,A         ;
