; Initialize wave: build object pool, reset counts, spawn first object
;
; Used by the routine at #R$A612.
;
; .
;
; Builds the 19-slot object free-list at $9D40 (linked via IY+0/+1, head at
; $9D1C), inits 4 fixed slots at $9D1E (player etc, stride 6, "active"+"alive"
; flags set), clears the 15-byte formation-slot bitmap at $9B4F-$9B5E, sets
; four per-group enemy counts ($9D19=6, $9D18=8, $9D1A=4, $9D1B=1 - totalling
; 19, matching the pool size), then allocates the first object via $C559 -
; presumably a formation-spawner that runs an $AFB8 script. Called by $A696
; (not yet traced - likely the actual "start level N" entry point).
c$B730 LD HL,$9D40     ;
 $B733 LD ($9D1C),HL   ;
 $B736 LD IY,$9D40     ;
 $B73A LD HL,$9D5D     ;
 $B73D LD DE,$001D     ;
 $B740 LD B,$13        ;
*$B742 LD (IY+$00),L   ;
 $B745 LD (IY+$01),H   ;
 $B748 LD (IY+$14),$00 ;
 $B74C ADD IY,DE       ;
 $B74E ADD HL,DE       ;
 $B74F DJNZ $B742      ;
 $B751 LD IY,$9D1E     ;
 $B755 LD HL,$9D24     ;
 $B758 LD DE,$0006     ;
 $B75B LD B,$04        ;
 $B75D SET 3,(IY+$04)  ;
 $B761 SET 2,(IY+$04)  ;
*$B765 LD (IY+$00),L   ;
 $B768 LD (IY+$01),H   ;
 $B76B ADD IY,DE       ;
 $B76D SET 3,(IY+$04)  ;
 $B771 SET 2,(IY+$04)  ;
 $B775 ADD HL,DE       ;
 $B776 DJNZ $B765      ;
 $B778 LD HL,$9B4F     ;
 $B77B LD DE,$9B50     ;
 $B77E LD BC,$000F     ;
 $B781 LD (HL),$00     ;
 $B783 LDIR            ;
 $B785 LD A,$06        ;
 $B787 LD ($9D19),A    ;
 $B78A LD A,$08        ;
 $B78C LD ($9D18),A    ;
 $B78F LD A,$04        ;
 $B791 LD ($9D1A),A    ;
 $B794 LD A,$01        ;
 $B796 LD ($9D1B),A    ;
 $B799 DI              ;
 $B79A CALL $C559      ; Allocate object from free-list pool and initialize
 $B79D EI              ;
 $B79E RET             ;

; Mark formation slot done, trigger completion effect when group empties
;
; Used by the routines at #R$BFEB, #R$C015, #R$C075, #R$C11C, #R$C199, #R$C298,
; #R$C31A, #R$C359, #R$C388 and #R$C3C7.
;
; IY object struct base
;
; Clears/masks a bit in a table at $9B50 (indexed by IY+13, a formation-slot
; id) then decrements an adjacent per-formation counter; when that counter
; reaches zero, marks the slot done (IY+13=$FF) and either calls $C648 or $C5D2
; (start explosion) depending on the $9C3F flag, then decrements a group
; counter at $9D18. Entry at $B79F uses C=0 (set bit), entry at $B7A3 uses
; C=$FF (clear bit) - exact meaning of the $9B50 bitmap not yet confirmed. The
; tail from $B7DC onward (an SP=IY stack trick) is not yet analyzed.
c$B79F LD C,$00        ; {entry: normal call, C=0
 $B7A1 JR $B7A6        ; }
; This entry point is used by the routine at #R$C051.
*$B7A3 LD C,$FF        ; {entry: alternate call, C=$FF
 $B7A5 NOP             ; }
*$B7A6 LD (IY+$14),$00 ; {clear flag at IY+14; read formation-slot index from
 $B7AA LD A,(IY+$13)   ; IY+13}
 $B7AD CP $FF          ; {skip if slot unused ($FF)
 $B7AF JR Z,$B7DC      ; }
 $B7B1 ADD A,A         ; {index into bitmap table $9B50, mask bit via C
 $B7B2 ADD A,$50       ;
 $B7B4 LD L,A          ;
 $B7B5 LD H,$9B        ;
 $B7B7 LD A,(HL)       ;
 $B7B8 AND C           ; }
 $B7B9 LD (HL),A       ; write back masked bitmap byte
 $B7BA DEC L           ; {decrement adjacent slot counter; skip if still
 $B7BB DEC (HL)        ; nonzero
 $B7BC JR NZ,$B7DC     ; }
 $B7BE AND A           ; {skip if counter was already zero
 $B7BF JR Z,$B7DC      ; }
 $B7C1 LD (IY+$13),$FF ; {mark slot done; check completion mode
 $B7C5 CP $01          ; }
 $B7C7 JR Z,$B7CE      ; branch to alternate completion path
 $B7C9 CALL $C648      ; {Decrement wave-group counter
 $B7CC JR $B7D7        ; }
*$B7CE LD A,($9C3F)    ; {check game mode flag at $9C3F
 $B7D1 AND A           ;
 $B7D2 JR NZ,$B7DC     ; }
 $B7D4 CALL $C5D2      ; start object explosion sequence
*$B7D7 LD HL,$9D18     ; {decrement group counter at $9D18, return
 $B7DA DEC (HL)        ;
 $B7DB RET             ; }
*$B7DC LD ($B7EF),SP   ;
 $B7E0 LD SP,IY        ;
 $B7E2 POP HL          ;
 $B7E3 LD ($0000),HL   ;
 $B7E6 LD HL,($9D1C)   ;
 $B7E9 PUSH HL         ;
 $B7EA LD ($9D1C),SP   ;
 $B7EE LD SP,$0000     ;
 $B7F1 LD IY,($B7E4)   ;
 $B7F5 RET             ;

; Jump-table dispatcher: JP to word-sized table entry A
;
; Used by the routines at #R$A13A, #R$A3A0, #R$A561, #R$A773, #R$B8F9, #R$B941
; and #R$BD99.
;
; A word index into the jump table
; HL jump table base address
@label=jump_table_dispatch
c$B7F6 ADD A,A       ;
 $B7F7 ADD A,L       ;
 $B7F8 LD L,A        ;
 $B7F9 LD A,(HL)     ;
 $B7FA INC HL        ;
 $B7FB LD H,(HL)     ;
 $B7FC LD L,A        ;
 $B7FD JP (HL)       ;

; Pseudo-random number generator (advances LFSR state at $9C2B-$9C32)
;
; Used by the routines at #R$B920, #R$BA43, #R$BA4F, #R$BD99, #R$C075, #R$C43C
; and #R$C5D2.
;
; O:A pseudo-random byte
;   BC,DE,HL preserved (saved into self-modified operands at entry, restored
; .          before RET)
@label=random
c$B7FE LD ($B842),HL ; Self-modify: save caller's HL (restored at $B841)
 $B801 LD ($B83F),DE ; Self-modify: save caller's DE (restored at $B83E)
 $B805 LD ($B83C),BC ; Self-modify: save caller's BC (restored at $B83B)
 $B809 LD HL,$9C32   ; Point HL at LFSR state top byte
 $B80C RR (HL)       ; Rotate top byte through carry
 $B80E DEC HL        ;
 $B80F LD A,(HL)     ;
 $B810 LD E,A        ;
 $B811 RRA           ;
 $B812 LD D,A        ;
 $B813 DEC HL        ;
 $B814 LD A,(HL)     ;
 $B815 LD C,A        ;
 $B816 ADD A,A       ;
 $B817 ADD A,A       ;
 $B818 ADD A,A       ;
 $B819 ADD A,A       ;
 $B81A LD B,A        ;
 $B81B DEC HL        ;
 $B81C LD A,(HL)     ;
 $B81D INC HL        ;
 $B81E LD (HL),A     ;
 $B81F SRL A         ;
 $B821 SRL A         ;
 $B823 SRL A         ;
 $B825 SRL A         ;
 $B827 OR B          ; {Mix rotated nibbles into new state byte
 $B828 XOR D         ; }
 $B829 LD B,A        ;
 $B82A LD A,C        ;
 $B82B INC HL        ;
 $B82C LD (HL),A     ;
 $B82D LD A,($9C2E)  ;
 $B830 LD ($9C2F),A  ;
 $B833 LD A,B        ;
 $B834 LD ($9C2E),A  ;
 $B837 LD A,E        ;
 $B838 INC HL        ;
 $B839 LD (HL),A     ;
 $B83A LD A,B        ;
 $B83B LD BC,$0000   ; Restore caller's BC
 $B83E LD DE,$0000   ; Restore caller's DE
 $B841 LD HL,$0000   ; Restore caller's HL
 $B844 RET           ;

; Compute angle from object IX to target IY
;
; Used by the routines at #R$BA2B, #R$BE4A and #R$C43C.
;
; IX object position (shooter)
; IY target position (e.g. player)
;
; Rounds IX's fixed-point X/Y position (lo/hi at IX+$0B/$0C and IX+$0D/$0E) to
; the nearest integer (RLA into the low byte's top bit, then ADC A,$00 on the
; high byte), subtracts IY's integer column/row (IY+$0C/$0E) to get delta X (C)
; and delta Y (B), takes their absolute values while recording quadrant bits in
; D, then refines to an octant and runs a linear-search division ($B889-$B89C)
; to approximate the angle - a coarse atan2 feeding aiming/movement code such
; as $C43C.
c$B845 LD A,(IX+$0B) ;
 $B848 RLA           ;
 $B849 LD A,(IX+$0C) ;
 $B84C ADC A,$00     ;
 $B84E SUB (IY+$0C)  ; Delta X = rounded IX position minus IY column
 $B851 LD C,A        ;
 $B852 LD A,(IX+$0D) ;
 $B855 RLA           ;
 $B856 LD A,(IX+$0E) ;
 $B859 ADC A,$00     ;
 $B85B SUB (IY+$0E)  ; Delta Y = rounded IX position minus IY row
 $B85E LD B,A        ;
 $B85F LD D,$00      ;
 $B861 LD A,B        ;
 $B862 AND A         ;
 $B863 JP P,$B86B    ; Skip abs-negate if delta Y already positive
 $B866 NEG           ;
 $B868 LD B,A        ;
 $B869 LD D,$3F      ;
*$B86B LD A,C        ;
 $B86C AND A         ;
 $B86D JP P,$B878    ; Skip abs-negate if delta X already positive
 $B870 NEG           ;
 $B872 LD C,A        ;
 $B873 LD A,D        ;
 $B874 XOR $1F       ;
 $B876 LD D,A        ;
 $B877 LD A,C        ;
*$B878 CP B          ;
 $B879 JR NC,$B881   ; Swap X/Y (octant refinement) if X >= Y
 $B87B LD C,B        ;
 $B87C LD B,A        ;
 $B87D LD A,D        ;
 $B87E XOR $0F       ;
 $B880 LD D,A        ;
*$B881 LD A,$03      ;
 $B883 CP C          ;
 $B884 JR C,$B887    ; Clamp check against threshold $03
 $B886 CP B          ;
*$B887 CCF           ;
 $B888 PUSH AF       ;
 $B889 LD E,$08      ;
 $B88B SLA B         ;
 $B88D SLA B         ;
 $B88F SLA B         ;
 $B891 LD A,C        ;
 $B892 ADD A,A       ;
 $B893 ADD A,A       ;
 $B894 ADD A,A       ;
*$B895 DEC E         ;
 $B896 JR Z,$B89C    ; Division-loop exit when remainder hits zero
 $B898 SUB C         ;
 $B899 CP B          ;
 $B89A JR NC,$B895   ; Division loop: continue while remainder >= Y
*$B89C LD A,E        ;
 $B89D XOR D         ;
 $B89E LD D,A        ;
 $B89F POP AF        ;
 $B8A0 LD A,D        ;
 $B8A1 RET           ;

; Compute velocity vector (dx,dy) from angle and speed
;
; Used by the routines at #R$B974, #R$B992, #R$BE4A, #R$C015 and #R$C3C7.
;
; A angle (0-63, index into sine table $9B5F)
; B speed/magnitude
; IY object struct base
;
; Looks up sin(A) in the table at $9B5F, sign-extends it, then multiplies by
; speed B via repeated addition to get dx (stored at IY+7/+8). Then computes
; angle-16 (mod 64, a quarter-turn) for cos(A) the same way, to get dy (stored
; at IY+9/+10). Classic 8-bit "aim/fire toward angle" trajectory calculation.
c$B8A2 LD C,B        ; {save speed (B->C), point HL at sine table $9B5F
 $B8A3 PUSH AF       ;
 $B8A4 LD HL,$9B5F   ; }
 $B8A7 LD E,A        ; {index table by angle A
 $B8A8 LD D,$00      ;
 $B8AA ADD HL,DE     ; }
 $B8AB LD A,(HL)     ; {sign-extend table value into DE
 $B8AC LD E,A        ;
 $B8AD RLA           ;
 $B8AE SBC A,A       ;
 $B8AF LD D,A        ; }
 $B8B0 LD HL,$0000   ; HL=0 (accumulator)
*$B8B3 ADD HL,DE     ; {multiply table value by speed B (repeated add)
 $B8B4 DJNZ $B8B3    ; }
 $B8B6 LD (IY+$07),L ; {store dx at IY+7/+8
 $B8B9 LD (IY+$08),H ; }
 $B8BC LD B,C        ; {restore speed and angle
 $B8BD POP AF        ; }
 $B8BE SUB $10       ; {angle-16 mod 64: quarter-turn offset for cosine
 $B8C0 AND $3F       ; }
 $B8C2 LD HL,$9B5F   ; point HL at sine table again
 $B8C5 LD E,A        ; {index table by cosine angle
 $B8C6 LD D,$00      ;
 $B8C8 ADD HL,DE     ; }
 $B8C9 LD A,(HL)     ; {sign-extend table value into DE
 $B8CA LD E,A        ;
 $B8CB RLA           ;
 $B8CC SBC A,A       ;
 $B8CD LD D,A        ; }
 $B8CE LD HL,$0000   ; HL=0 (accumulator)
*$B8D1 ADD HL,DE     ; {multiply table value by speed B (repeated add)
 $B8D2 DJNZ $B8D1    ; }
 $B8D4 LD (IY+$09),L ; {store dy at IY+9/+10
 $B8D7 LD (IY+$0A),H ; }
 $B8DA RET           ; return

; Set object position from $9C01, clamp column (IY+$0C) to 8-24
;
; Used by the routine at #R$C5D2.
;
; IY object struct base (writes position fields IY+$0B/$0C/$0D)
c$B8DB LD A,($9C01)    ;
 $B8DE LD (IY+$0D),A   ;
 $B8E1 LD (IY+$0B),$00 ;
 $B8E5 LD A,(IY+$0C)   ;
 $B8E8 CP $08          ;
 $B8EA JR NC,$B8F1     ;
 $B8EC LD (IY+$0C),$08 ;
 $B8F0 RET             ;

; Routine at B8F1
;
; Used by the routine at #R$B8DB.
c$B8F1 CP $19          ;
 $B8F3 RET C           ;
 $B8F4 LD (IY+$0C),$18 ;
 $B8F8 RET             ;

; Movement-pattern script interpreter
;
; Used by the routines at #R$C075, #R$C11C, #R$C199 and #R$C217.
;
; IY object struct base
;
; Counts down a per-object frame-delay timer (IY+18); once it expires, reads
; the next byte of a movement script (pointer at IY+15/16) into IY+17, masks it
; to 0-7, and dispatches that step through the $A076 sub-table (indices
; $3B-$48) via $B7F6. If a dispatched step signals carry, it loops back
; immediately to process the next script byte in the same frame; otherwise it
; returns and waits for the timer to expire again.
c$B8F9 DEC (IY+$18)    ;
 $B8FC JR Z,$B914      ;
 $B8FE JP P,$B904      ;
 $B901 INC (IY+$18)    ;
*$B904 LD A,(IY+$17)   ;
; This entry point is used by the routine at #R$B920.
*$B907 LD C,A          ;
 $B908 AND $07         ;
 $B90A LD HL,$A076     ;
 $B90D CALL $B7F6      ; Jump-table dispatcher
 $B910 RET NC          ;
 $B911 JP $B8F9        ; => Movement-pattern script interpreter
*$B914 LD (IY+$18),$01 ;
 $B918 LD L,(IY+$15)   ;
 $B91B LD H,(IY+$16)   ;
; This entry point is used by the routine at #R$B920.
*$B91E LD A,(HL)       ;
 $B91F INC HL          ;

; Decode movement-script "wait" byte (bit 7 set = wait N or random frames)
;
; .
;
; .
;
; Continues $B8F9/$B920's script reader: if the script byte's high bit is set,
; it's a wait command - the low 7 bits give the frame count directly, except
; value 1 which means "random wait" (1-32 frames via $B7FE). Result is stored
; into the frame-delay timer at IY+18. If the high bit is clear, the byte is
; instead a movement-step index, handled by the fallthrough at $B935.
c$B920 AND A         ;
 $B921 JP P,$B935    ;
 $B924 AND $7F       ;
 $B926 CP $01        ;
 $B928 JR NZ,$B930   ;
 $B92A CALL $B7FE    ; Pseudo-random number generator
 $B92D AND $1F       ;
 $B92F INC A         ;
