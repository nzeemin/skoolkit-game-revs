; Routine at AC8D
;
; Used by the routines at #R$6A88 and #R$A0C4.
c$AC8D LD ($ACB5),SP  ; Save SP (restored at $ACB4)
 $AC91 LD IY,$9D1E    ; Point IY at fixed-object list head $9D1E
*$AC95 LD HL,$9C37    ;
 $AC98 LD A,(HL)      ; {Toggle border/speaker bit of state byte at $9C37 and
 $AC99 XOR $18        ; output it
 $AC9B LD (HL),A      ;
 $AC9C INC HL         ;
 $AC9D AND (HL)       ; }
 $AC9E OUT ($FE),A    ;
 $ACA0 LD SP,IY       ; {Pop next loop/duration word via SP-trick into IY
 $ACA2 POP IY         ;
 $ACA4 LD SP,IY       ; }
 $ACA6 BIT 2,(IY+$04) ; Loop while duration bit (IY+$04 bit 2) is clear
 $ACAA JR Z,$AC95     ;
 $ACAC RES 0,(IY+$04) ; Clear "busy" flag ($9D1E+$04 bit 0) once duration
                      ; elapses
 $ACB0 POP HL         ;
 $ACB1 POP HL         ;
 $ACB2 LD SP,HL       ;
 $ACB3 RET            ;
 $ACB4 LD SP,$0000    ; Entry: force-stop (reset SP, no toggle)
 $ACB7 RET            ;
 $ACB8 SET 5,(IY+$04) ; Entry: request toggle loop (sets IY+$04 bit 5)
 $ACBC BIT 4,(IY+$04) ; Only continue toggling while bit 4 flag is set
 $ACC0 JP NZ,$AC95    ;
 $ACC3 LD A,(IY+$06)  ;
 $ACC6 POP HL         ;
 $ACC7 ADD A,H        ;
 $ACC8 LD H,A         ;
 $ACC9 LD DE,$0008    ;
 $ACCC EXX            ;
 $ACCD LD A,(IY+$0C)  ;
 $ACD0 SUB $06        ;
 $ACD2 ADD A,A        ;
 $ACD3 LD E,A         ;
 $ACD4 LD D,$00       ;
 $ACD6 LD L,(IY+$0E)  ;
 $ACD9 INC L          ;
 $ACDA SLA L          ;
 $ACDC LD H,$9B       ;
 $ACDE LD SP,HL       ;
 $ACDF POP HL         ;
 $ACE0 ADD HL,DE      ;
 $ACE1 LD SP,HL       ;
 $ACE2 EXX            ;
 $ACE3 PUSH HL        ;
 $ACE4 ADD HL,DE      ;
 $ACE5 PUSH HL        ;
 $ACE6 ADD HL,DE      ;
 $ACE7 EXX            ;
 $ACE8 LD SP,$0024    ;
 $ACEB ADD HL,SP      ;
 $ACEC LD SP,HL       ;
 $ACED EXX            ;
 $ACEE PUSH HL        ;
 $ACEF ADD HL,DE      ;
 $ACF0 PUSH HL        ;
 $ACF1 JP $AC95       ;
 $ACF4 SET 5,(IY+$04) ;
 $ACF8 LD A,($9C01)   ;
 $ACFB NEG            ;
 $ACFD ADD A,(IY+$0D) ;
 $AD00 AND $E0        ;
 $AD02 RLCA           ;
 $AD03 RLCA           ;
 $AD04 RLCA           ;
 $AD05 LD E,A         ;
 $AD06 LD D,$00       ;
 $AD08 POP HL         ;
 $AD09 AND A          ;
 $AD0A SBC HL,DE      ;
 $AD0C LD ($AD86),HL  ;
 $AD0F LD ($AD65),A   ;
 $AD12 LD A,$07       ;
 $AD14 SUB E          ;
 $AD15 ADD A,A        ;
 $AD16 LD ($AD4A),A   ;
 $AD19 NEG            ;
 $AD1B ADD A,$0E      ;
 $AD1D LD ($AD68),A   ;
 $AD20 EX DE,HL       ;
 $AD21 EXX            ;
 $AD22 LD A,(IY+$0C)  ;
 $AD25 SUB $08        ;
 $AD27 ADD A,A        ;
 $AD28 LD E,A         ;
 $AD29 LD D,$00       ;
 $AD2B LD HL,$9C01    ;
 $AD2E LD A,(IY+$0D)  ;
 $AD31 CP (HL)        ;
 $AD32 CCF            ;
 $AD33 LD A,(IY+$0E)  ;
 $AD36 ADC A,D        ;
 $AD37 ADD A,A        ;
 $AD38 LD L,A         ;
 $AD39 LD H,$9B       ;
 $AD3B LD SP,HL       ;
 $AD3C POP HL         ;
 $AD3D ADD HL,DE      ;
 $AD3E LD ($AD82),HL  ;
 $AD41 LD DE,$00B4    ;
 $AD44 LD B,$04       ;
*$AD46 LD SP,HL       ;
 $AD47 EXX            ;
 $AD48 POP HL         ;
*$AD49 JR $AD49       ;
 $AD4B LDI            ;
 $AD4D LDI            ;
 $AD4F LDI            ;
 $AD51 LDI            ;
 $AD53 LDI            ;
 $AD55 LDI            ;
 $AD57 LDI            ;
 $AD59 LD HL,$0028    ;
 $AD5C ADD HL,DE      ;
 $AD5D EX DE,HL       ;
 $AD5E EXX            ;
 $AD5F ADD HL,DE      ;
 $AD60 LD SP,HL       ;
 $AD61 EXX            ;
 $AD62 POP HL         ;
 $AD63 LD A,L         ;
 $AD64 ADD A,$00      ;
 $AD66 LD L,A         ;
*$AD67 JR $AD67       ;
 $AD69 LDI            ;
 $AD6B LDI            ;
 $AD6D LDI            ;
 $AD6F LDI            ;
 $AD71 LDI            ;
 $AD73 LDI            ;
 $AD75 LDI            ;
 $AD77 LDI            ;
 $AD79 EXX            ;
 $AD7A AND A          ;
 $AD7B SBC HL,DE      ;
 $AD7D INC HL         ;
 $AD7E INC HL         ;
 $AD7F DJNZ $AD46     ;
 $AD81 LD HL,$0000    ;
 $AD84 EXX            ;
 $AD85 LD HL,$0000    ;
 $AD88 LD C,$18       ;
 $AD8A EXX            ;
 $AD8B LD DE,$0024    ;
 $AD8E LD B,$06       ;
*$AD90 LD SP,HL       ;
