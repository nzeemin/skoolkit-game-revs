; Initialize IM 2 interrupt vector table and set light ISR
;
; Used by the routine at #R$A5A5.
;
; .
;
; Standard IM 2 setup: I=$FE (vector table at #R$FE00), fills #R$FE00-$FFFF
; with $FD so every vector reads the byte at #R$FDFD, which is set to $C3 (JP
; opcode) - making #R$FDFD/$FDFE act as a self-modifying "JP (isr-handler)"
; trampoline used by #R$A0C4/#R$A0B0 elsewhere. Points that trampoline at
; #R$A0B0 (the light/per-frame ISR) before returning.
@label=init_im2
c$7D00 DI            ;
 $7D01 LD A,$FE      ;
 $7D03 LD I,A        ;
 $7D05 IM 2          ;
 $7D07 LD HL,$FE00   ;
 $7D0A LD A,$FD      ;
*$7D0C LD (HL),A     ;
 $7D0D INC L         ;
 $7D0E JR NZ,$7D0C   ;
 $7D10 INC H         ;
 $7D11 LD (HL),A     ;
 $7D12 LD A,$C3      ;
 $7D14 LD ($FDFD),A  ;
 $7D17 LD HL,$A0B0   ; point to per-frame handler #R$A0B0 (light ISR)
 $7D1A LD ($FDFE),HL ; set ISR handler address
 $7D1D EI            ;
 $7D1E RET           ;

; Clear screen and draw title screen graphics
;
; Used by the routine at #R$A5A5.
;
; .
;
; Clears the bitmap ($4000-$5AFE), sets border black, then draws two compressed
; graphic blocks (data at $CB91 and #R$CA09, via the decompressor at #R$7D5C)
; onto the screen at $4000/$5800 and $4019/$5819 - almost certainly the
; title-screen logo/artwork. The block at #R$7D4E-$7D5B is likely parameter
; data, currently mistyped as code in the ctl (renders as garbage "LD B,x"
; instructions) - not yet fixed.
@label=draw_title_screen
c$7D1F XOR A         ;
 $7D20 OUT ($FE),A   ;
 $7D22 LD HL,$4000   ;
 $7D25 LD DE,$4001   ;
 $7D28 LD (HL),A     ;
 $7D29 LD BC,$1AFF   ;
 $7D2C LDIR          ;
 $7D2E LD IY,$7D4E   ;
 $7D32 LD HL,$5800   ;
 $7D35 EXX           ;
 $7D36 LD DE,$CB91   ;
 $7D39 LD HL,$4000   ;
 $7D3C CALL $7D5C    ; Draw title screen graphic block
 $7D3F EXX           ;
 $7D40 LD HL,$5819   ;
 $7D43 EXX           ;
 $7D44 LD DE,$CA09   ;
 $7D47 LD HL,$4019   ;
 $7D4A CALL $7D5C    ; Draw title screen graphic block
 $7D4D RET           ;

; Data block at 7D4E
b$7D4E DEFB $06,$06,$06,$06,$47,$47,$45,$42
 $7D56 DEFB $42,$42,$47,$47,$47,$45

; Draw title screen graphic block (attribute rows + bitmap columns)
;
; Used by the routine at #R$7D1F.
;
; IY attribute data pointer
; DE bitmap data pointer
; HL destination screen address
@label=draw_title_block
c$7D5C LD B,$07      ;
*$7D5E PUSH BC       ;
 $7D5F LD C,$07      ;
 $7D61 LD A,B        ;
 $7D62 CP $03        ; Row 3: shadow-HL needs an extra bitmap-third adjustment
 $7D64 EXX           ;
 $7D65 JR NZ,$7D69   ;
 $7D67 INC H         ; {Bump shadow H for the bitmap-third boundary
 $7D68 INC H         ; }
*$7D69 LD A,(IY+$00) ;
 $7D6C INC IY        ;
 $7D6E LD B,$07      ;
*$7D70 LD (HL),A     ;
 $7D71 INC L         ;
 $7D72 DJNZ $7D70    ; Write attribute byte across 7 columns
 $7D74 LD A,L        ;
 $7D75 ADD A,$19     ; {Advance to next attribute row (+$19)
 $7D77 LD L,A        ; }
 $7D78 EXX           ;
*$7D79 PUSH HL       ;
 $7D7A LD B,$08      ;
*$7D7C LD A,(DE)     ;
 $7D7D LD (HL),A     ;
 $7D7E INC DE        ;
 $7D7F INC H         ;
 $7D80 DJNZ $7D7C    ; Copy 8 bitmap scanlines for this column
 $7D82 POP HL        ;
 $7D83 INC L         ;
 $7D84 DEC C         ;
 $7D85 JR NZ,$7D79   ; Next of 7 columns
 $7D87 LD A,L        ;
 $7D88 ADD A,$19     ;
 $7D8A LD L,A        ;
 $7D8B POP BC        ;
 $7D8C LD A,B        ;
 $7D8D CP $04        ; Row 4: crossing into next screen third
 $7D8F JR NZ,$7D95   ;
 $7D91 LD A,H        ;
 $7D92 ADD A,$10     ; {Bump H to next screen third (+$10)
 $7D94 LD H,A        ; }
*$7D95 DJNZ $7D5E    ; Next of 7 rows
 $7D97 RET           ;

; Decode 9 graphic blocks, then substitute every other byte via table $9A00
;
; Used by the routine at #R$A5A5.
;
; .
;
; Called from #R$A5A5/$A5B2. HL starts at #R$CA09 and is threaded, unsaved,
; through all 9 calls to #R$7DC9/#R$7DF3 as their shared output cursor -
; #R$7DF3 writes decoded graphics data to (HL) and advances it, so HL ends up
; pointing past everything written by the 9 blocks (overwriting the #R$CA09
; descriptor data in place as it's consumed). The total byte count written
; (HL-#R$CA09) is then halved and used as a loop count for a second pass:
; walking from #R$CA09, every other byte is treated as an index into a fixed
; 256-entry table at #R$9A00 and replaced with the looked-up value in place - a
; substitution/palette pass over half the decoded stream (the alternating bytes
; are left untouched).
c$7D98 LD IY,$6B42   ;
 $7D9C LD IX,$F765   ;
 $7DA0 LD HL,$CA09   ;
 $7DA3 LD B,$09      ; 9 block-descriptor entries
*$7DA5 PUSH BC       ;
 $7DA6 CALL $7DC9    ; Decode one graphic-block descriptor entry
 $7DA9 LD DE,$0011   ;
 $7DAC ADD IY,DE     ; Advance IY to the next 17-byte entry
 $7DAE POP BC        ;
 $7DAF DJNZ $7DA5    ; Loop 9 times
 $7DB1 LD DE,$CA09   ;
 $7DB4 AND A         ;
 $7DB5 SBC HL,DE     ; Total bytes written = HL - #R$CA09
 $7DB7 EX DE,HL      ;
 $7DB8 SRL D         ; {Halve the byte count (process every other byte)
 $7DBA RR E          ; }
 $7DBC LD B,$9A      ;
*$7DBE INC HL        ;
 $7DBF LD C,(HL)     ; {Substitute this byte via table #R$9A00
 $7DC0 LD A,(BC)     ;
 $7DC1 LD (HL),A     ; }
 $7DC2 INC HL        ; Skip the alternate (untouched) byte
 $7DC3 DEC DE        ;
 $7DC4 LD A,D        ;
 $7DC5 OR E          ;
 $7DC6 JR NZ,$7DBE   ; Loop until the halved count reaches zero
 $7DC8 RET           ;

; Decode one graphic-block descriptor entry (IY-indexed)
;
; Used by the routine at #R$7D98.
;
; .
;
; Called 9 times from #R$7D98's loop, once per 17-byte ($11) IY-indexed entry.
; Calls #R$7DF3 to decode the block's data, stores the resulting pointer into
; IY+$02/$03, then calls #R$7E4A; if IY+$0E (a repeat count) is nonzero,
; repeats the #R$7DF3/#R$7E4A pair that many more times. Finishes by shifting a
; flag at IY+$0A and, if IY+$06 is set, incrementing a counter at IY+$0B.
c$7DC9 CALL $7DF3    ; Expand one graphic block
 $7DCC LD (IY+$02),L ;
 $7DCF LD (IY+$03),H ;
 $7DD2 CALL $7E4A    ; Build bit-shifted copies of a graphic block
 $7DD5 LD B,(IY+$0E) ;
 $7DD8 DEC B         ;
 $7DD9 JR Z,$7DE5    ;
*$7DDB PUSH BC       ;
 $7DDC CALL $7DF3    ; Expand one graphic block
 $7DDF CALL $7E4A    ; Build bit-shifted copies of a graphic block
 $7DE2 POP BC        ;
 $7DE3 DJNZ $7DDB    ;
*$7DE5 SLA (IY+$0A)  ;
 $7DE9 LD A,(IY+$06) ;
 $7DEC AND A         ;
 $7DED JR Z,$7DF2    ;
 $7DEF INC (IY+$0B)  ;
*$7DF2 RET           ;

; Expand one graphic block (with optional blank-row padding)
;
; Used by the routine at #R$7DC9.
;
; HL destination cursor (in/out, advanced past the written data)
;
; Called from #R$7DC9. If IY+$06 is set, first pads (IY+$07) blank rows via
; #R$7E3D. Writes (IY+$0B) rows of (IY+$0A) columns, each column as two
; interleaved source bytes ($20 apart) from IX; the per-row column count is
; summed into a self-modified operand at $7E1B for later use. If IY+$06 is set,
; pads (IY+$07) more blank rows afterwards, then advances IX by the total
; column width read back from $7E1B.
c$7DF3 LD A,(IY+$06)  ;
 $7DF6 AND A          ;
 $7DF7 JR Z,$7E01     ; Skip leading padding if flag clear
 $7DF9 LD B,(IY+$07)  ;
*$7DFC CALL $7E3D     ; Write one blank padding row
 $7DFF DJNZ $7DFC     ; Pad blank rows before the block
*$7E01 PUSH HL        ;
 $7E02 XOR A          ;
 $7E03 LD B,(IY+$0B)  ;
*$7E06 ADD A,(IY+$0A) ;
 $7E09 DJNZ $7E06     ; Sum column width into A (total block width)
 $7E0B LD ($7E1B),A   ;
 $7E0E LD C,(IY+$0B)  ;
*$7E11 LD B,(IY+$0A)  ;
*$7E14 LD A,(IX+$00)  ;
 $7E17 LD (HL),A      ;
 $7E18 INC HL         ;
 $7E19 LD A,(IX+$20)  ;
 $7E1C LD (HL),A      ;
 $7E1D INC HL         ;
 $7E1E INC IX         ;
 $7E20 DJNZ $7E14     ; Write interleaved byte pair for this column
 $7E22 DEC C          ;
 $7E23 JR NZ,$7E11    ; Next row
 $7E25 LD A,(IY+$06)  ;
 $7E28 AND A          ;
 $7E29 JR Z,$7E33     ; Skip trailing padding if flag clear
 $7E2B LD B,(IY+$07)  ;
*$7E2E CALL $7E3D     ; Write one blank padding row
 $7E31 DJNZ $7E2E     ; Pad blank rows after the block
*$7E33 LD A,($7E1B)   ;
 $7E36 LD E,A         ;
 $7E37 LD D,$00       ;
 $7E39 ADD IX,DE      ; Advance IX by the block's total width
 $7E3B POP HL         ;
 $7E3C RET            ;

; Write one blank padding row (8x $00/$FF byte pairs)
;
; Used by the routine at #R$7DF3.
;
; .
;
; Called from #R$7DF3 to pad a leading/trailing blank row. Writes 8 columns of
; the same interleaved byte-pair layout #R$7DF3 writes for real data (pixel
; byte $00, mask/second-plane byte $FF - i.e. blank pixels, fully transparent).
c$7E3D PUSH BC       ;
 $7E3E LD B,$08      ;
*$7E40 LD (HL),$00   ;
 $7E42 INC HL        ;
 $7E43 LD (HL),$FF   ;
 $7E45 INC HL        ;
 $7E46 DJNZ $7E40    ;
 $7E48 POP BC        ;
 $7E49 RET           ;

; Build bit-shifted copies of a graphic block (smooth-scroll variants)
;
; Used by the routine at #R$7DC9.
;
; .
;
; Called from #R$7DC9 after #R$7DF3 has expanded the block. If IY+$06 is zero,
; just advances HL past the block (+IY+$0C) and returns. Otherwise: derives a
; shift-step count from the lowest set bit of IY+$06 doubled, and for each step
; duplicates the block (LDIR, offset by IY+$0C) into a working copy, then
; right-shifts every column of it by 1 bit with carry propagating between bytes
; (RLA/RR (HL)/RRA/ADD HL,DE) - building successive sub-pixel-shifted copies of
; the graphic for smooth horizontal scrolling.
c$7E4A LD A,(IY+$06) ;
 $7E4D ADD A,A       ;
 $7E4E JR Z,$7E92    ; Skip shift generation if flag is zero: just advance
                     ; pointer
*$7E50 SRL A         ;
 $7E52 BIT 0,A       ;
 $7E54 JR Z,$7E50    ; Shift-step count = lowest set bit of doubled flag
 $7E56 LD B,A        ;
*$7E57 PUSH BC       ;
 $7E58 LD C,(IY+$0C) ;
 $7E5B LD B,$00      ;
 $7E5D LD E,L        ;
 $7E5E LD D,H        ;
 $7E5F ADD HL,BC     ;
 $7E60 EX DE,HL      ;
 $7E61 LDIR          ; Duplicate block into working copy (offset by IY+$0C)
 $7E63 LD A,$08      ;
 $7E65 SUB (IY+$06)  ;
 $7E68 AND $07       ; Bit-shift amount = (8 - flag) mod 8
 $7E6A LD B,A        ;
*$7E6B PUSH BC       ;
 $7E6C PUSH HL       ;
 $7E6D LD C,(IY+$0A) ;
 $7E70 SLA C         ;
 $7E72 LD B,(IY+$0B) ;
 $7E75 INC B         ;
 $7E76 LD E,C        ;
 $7E77 LD D,$00      ;
*$7E79 PUSH BC       ;
 $7E7A PUSH HL       ;
 $7E7B XOR A         ;
*$7E7C RLA           ;
 $7E7D RR (HL)       ;
 $7E7F RRA           ;
 $7E80 ADD HL,DE     ;
 $7E81 DJNZ $7E7C    ; Shift this column right by 1 bit (carry-propagate)
 $7E83 POP HL        ;
 $7E84 OR (HL)       ;
 $7E85 LD (HL),A     ;
 $7E86 INC HL        ;
 $7E87 POP BC        ;
 $7E88 DEC C         ;
 $7E89 JR NZ,$7E79   ; Next column
 $7E8B POP HL        ;
 $7E8C POP BC        ;
 $7E8D DJNZ $7E6B    ; Next shift amount
 $7E8F POP BC        ;
 $7E90 DJNZ $7E57    ; Next shift step
*$7E92 LD C,(IY+$0C) ;
 $7E95 LD B,$00      ;
 $7E97 ADD HL,BC     ; Advance pointer past this block
 $7E98 RET           ;

