 $B1B2 INC E         ;
 $B1B3 LD A,(DE)     ;
 $B1B4 OR B          ;
 $B1B5 LD (DE),A     ;
 $B1B6 INC H         ; Next source page ($7A/$7B/$7C)
 $B1B7 INC D         ; Next dest row
 $B1B8 EXX           ;
 $B1B9 DJNZ $B16B    ; Loop $9C1A passes
 $B1BB JP $AFB8      ; => Formation script

