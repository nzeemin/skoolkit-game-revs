 $C383 INC (HL)       ;
 $C384 CALL $B79F     ; Mark formation slot done, trigger completion effect
                      ; when group empties
 $C387 RET            ;

; Movement handler $38: advance object down-screen; on flag, score and mark
; completion
;
; .
;
; IY object struct base (Y at IY+$0D/$0E, action flag IY+$14 bit 7)
;
; Handler for index $38 of the #R$A000 jump table (see #R$B7F6).
c$C388 LD A,($9BA0)   ;
 $C38B AND $03        ;
 $C38D JR NZ,$C39D    ;
 $C38F BIT 4,(IY+$04) ;
 $C393 RES 4,(IY+$04) ;
 $C397 JR NZ,$C39D    ;
 $C399 SET 4,(IY+$04) ;
*$C39D LD A,(IY+$0D)  ;
 $C3A0 ADD A,$20      ;
 $C3A2 LD (IY+$0D),A  ;
 $C3A5 JR NC,$C3AA    ;
 $C3A7 INC (IY+$0E)   ;
*$C3AA BIT 7,(IY+$14) ;
 $C3AE JR Z,$C3BB     ;
 $C3B0 LD A,$08       ;
 $C3B2 CALL $66B5     ; Add BCD score value to current player's score
 $C3B5 LD HL,$9C6A    ;
 $C3B8 INC (HL)       ;
 $C3B9 JR $C3BF       ;
*$C3BB DEC (IY+$15)   ;
 $C3BE RET NZ         ;
*$C3BF LD HL,$9D18    ;
 $C3C2 INC (HL)       ;
 $C3C3 CALL $B79F     ; Mark formation slot done, trigger completion effect
                      ; when group empties
 $C3C6 RET            ;

; Movement handler $30: angle-steered weave with edge bounce, velocity apply
;
; .
;
; IY object struct base (column IY+$0C, angle IY+$10, direction-rate IY+$15,
; .  speed IY+$11, action flag IY+$14 bit 7)
;
; Handler for index $30 of the #R$A000 jump table (see #R$B7F6).
; .
; Outside a central column band (IY+$0C-6 not in 0-$14), flips the
; direction-rate sign (IY+$15) and mirrors the angle target ($20-(IY+$10),
; masked to 0-$3F) - an edge-bounce for a zigzag/weaving movement. Advances
; angle (IY+$10) by the direction-rate, computes velocity via #R$B8A2 and
; applies it via #R$BA0A. If the action flag (IY+$14 bit 7) is set, scores +5,
; conditionally bumps the wave counter $9C68 and the explosion-data pointer
; $9C73 (13-byte stride, see #R$A612), then joins the plain down-screen-advance
; tail shared with #R$C388/#R$C298/#R$C31A/#R$C359.
c$C3C7 LD A,(IY+$0C)  ;
 $C3CA SUB $06        ;
 $C3CC CP $15         ;
 $C3CE JR C,$C3E2     ;
 $C3D0 LD A,(IY+$15)  ;
 $C3D3 NEG            ;
 $C3D5 LD (IY+$15),A  ;
 $C3D8 LD A,$20       ;
 $C3DA SUB (IY+$10)   ;
 $C3DD AND $3F        ;
 $C3DF LD (IY+$10),A  ;
*$C3E2 LD A,(IY+$10)  ;
 $C3E5 ADD A,(IY+$15) ;
 $C3E8 AND $3F        ;
 $C3EA LD (IY+$10),A  ;
 $C3ED LD B,(IY+$11)  ;
 $C3F0 CALL $B8A2     ; Compute velocity vector (dx,dy) from angle and speed
 $C3F3 CALL $BA0A     ; Apply object velocity (dx,dy) to position
 $C3F6 BIT 7,(IY+$14) ;
 $C3FA JR Z,$C41D     ;
 $C3FC LD HL,$9C68    ;
 $C3FF INC (HL)       ;
 $C400 LD A,$05       ;
 $C402 CALL $66B5     ; Add BCD score value to current player's score
 $C405 LD HL,$9C71    ;
 $C408 LD C,(HL)      ;
 $C409 LD HL,$9C72    ;
 $C40C LD A,(HL)      ;
 $C40D CP C           ;
 $C40E JR NC,$C41B    ;
 $C410 INC (HL)       ;
 $C411 LD HL,($9C73)  ;
 $C414 LD DE,$000D    ;
 $C417 ADD HL,DE      ;
 $C418 LD ($9C73),HL  ;
*$C41B JR $C434       ;
*$C41D LD A,(IY+$0D)  ;
 $C420 ADD A,$20      ;
 $C422 LD (IY+$0D),A  ;
 $C425 LD A,(IY+$0E)  ;
 $C428 JR NC,$C42E    ;
 $C42A INC A          ;
 $C42B LD (IY+$0E),A  ;
*$C42E CP $1C         ;
 $C430 RET C          ;
 $C431 CP $22         ;
 $C433 RET NC         ;
*$C434 LD HL,$9D18    ;
 $C437 INC (HL)       ;
 $C438 CALL $B79F     ; Mark formation slot done, trigger completion effect
                      ; when group empties
 $C43B RET            ;

; Enemy fire-decision timer and heading steering
;
; Used by the routines at #R$C075, #R$C11C, #R$C199, #R$C217 and #R$C298.
;
; IY enemy object struct base (status IY+$04, target ref IY+$1A, heading
; .  IY+$1C)
;
; Decrements the shared randomized-reload timer at $9C42 (reloaded from $9C43
; on expiry - same mechanism as #R$BD99). Once expired, checks activity flags
; (IY+4 bits 0 and 5) and a target reference (IY+1A, $FF = no target), computes
; an aim angle via #R$B845 toward the target (IX=($9C6D)), then turns the
; enemy's current heading (IY+1C) toward that angle by a rate-limited step
; (clamped to +-4) rather than snapping directly to it - a homing/steering
; behaviour.
@label=enemy_fire_steer
c$C43C LD HL,$9C42     ;
 $C43F DEC (HL)        ; {Fire timer countdown; exit until it expires
 $C440 RET NZ          ; }
 $C441 LD A,($9C43)    ; {Reload fire timer from $9C43
 $C444 LD (HL),A       ; }
 $C445 BIT 0,(IY+$04)  ; {Exit if busy flag set (IY+$04 bit 0)
 $C449 RET NZ          ; }
 $C44A BIT 5,(IY+$04)  ; {Exit unless active flag set (IY+$04 bit 5)
 $C44E RET Z           ; }
 $C44F LD A,(IY+$1A)   ; {Exit if no target (IY+$1A = $FF)
 $C452 CP $FF          ;
 $C454 RET Z           ; }
 $C455 LD IX,($9C6D)   ;
 $C459 CALL $B845      ; Compute angle from object IX to target IY
 $C45C LD C,A          ;
 $C45D EX AF,AF'       ;
 $C45E LD A,(IY+$1A)   ;
 $C461 AND A           ;
 $C462 JP M,$C499      ;
 $C465 LD A,(IY+$1C)   ;
 $C468 LD B,A          ;
 $C469 SUB C           ; {Angle difference (target minus current heading)
 $C46A AND $3F         ; }
 $C46C CP $20          ;
 $C46E LD E,$FC        ;
 $C470 JR C,$C478      ;
 $C472 LD E,$04        ;
 $C474 NEG             ;
 $C476 AND $3F         ;
*$C478 CP $04          ;
 $C47A JR NC,$C47F     ;
 $C47C LD A,C          ;
 $C47D JR $C483        ;
*$C47F LD A,B          ;
 $C480 ADD A,E         ; {Step heading toward target by +-4
 $C481 AND $3F         ; }
*$C483 LD (IY+$1C),A   ; Store new heading (IY+$1C)
 $C486 LD E,A          ;
 $C487 ADD A,$03       ;
 $C489 AND $38         ;
 $C48B RRCA            ;
 $C48C RRCA            ;
 $C48D RRCA            ;
 $C48E LD (IY+$1A),A   ; Store target sector (IY+$1A)
 $C491 LD A,E          ;
 $C492 CP C            ;
 $C493 JR Z,$C497      ;
 $C495 AND A           ;
 $C496 RET             ;
*$C497 LD A,$01        ;
*$C499 LD B,A          ;
 $C49A EX AF,AF'       ;
 $C49B CCF             ;
 $C49C RET NC          ;
 $C49D LD A,($9D1A)    ;
 $C4A0 LD HL,$9D1B     ; {Fire only if free-object slots remain ($9D1A - $9D1B)
 $C4A3 SUB (HL)        ;
 $C4A4 RET Z           ; }
 $C4A5 LD E,A          ;
 $C4A6 CALL $B7FE      ; Pseudo-random number generator
 $C4A9 CP (IY+$1B)     ; {Fire only below probability threshold (IY+$1B)
 $C4AC RET NC          ; }
 $C4AD LD A,B          ;
 $C4AE AND $03         ;
 $C4B0 RET Z           ;
 $C4B1 LD HL,$9D1A     ;
 $C4B4 CP E            ;
 $C4B5 JR C,$C4B8      ;
 $C4B7 LD A,E          ;
*$C4B8 LD B,A          ;
 $C4B9 NEG             ;
 $C4BB ADD A,(HL)      ;
 $C4BC LD (HL),A       ;
 $C4BD LD A,B          ;
 $C4BE DEC A           ;
 $C4BF ADD A,A         ;
 $C4C0 NEG             ;
 $C4C2 ADD A,C         ;
 $C4C3 AND $3F         ;
 $C4C5 LD C,A          ;
 $C4C6 LD E,(IY+$0D)   ;
 $C4C9 LD D,(IY+$0E)   ;
 $C4CC LD L,(IY+$0B)   ;
 $C4CF LD H,(IY+$0C)   ;
 $C4D2 LD A,($9C40)    ;
 $C4D5 LD ($C54E),A    ;
 $C4D8 LD A,(IY+$05)   ;
 $C4DB CP $0E          ;
 $C4DD JR NZ,$C4F6     ;
 $C4DF LD A,E          ;
 $C4E0 ADD A,$80       ;
 $C4E2 LD E,A          ;
 $C4E3 LD A,D          ;
 $C4E4 ADC A,$01       ;
 $C4E6 LD D,A          ;
 $C4E7 LD A,L          ;
 $C4E8 ADD A,$80       ;
 $C4EA LD L,A          ;
 $C4EB LD A,H          ;
 $C4EC ADC A,$01       ;
 $C4EE LD H,A          ;
 $C4EF LD A,($9C40)    ;
 $C4F2 INC A           ;
 $C4F3 LD ($C54E),A    ;
*$C4F6 EXX             ;
 $C4F7 LD BC,$6BB9     ;
 $C4FA EXX             ;
*$C4FB EXX             ;
 $C4FC LD ($C515),SP   ;
 $C500 LD IX,($9D1C)   ; {Pop a bullet object from the free list ($9D1C)
 $C504 LD SP,IX        ;
 $C506 POP HL          ;
 $C507 LD ($9D1C),HL   ;
 $C50A POP HL          ;
 $C50B PUSH BC         ; }
 $C50C LD HL,($9D2A)   ;
 $C50F PUSH HL         ;
 $C510 LD ($9D2A),SP   ;
 $C514 LD SP,$0000     ;
 $C517 EXX             ;
 $C518 SET 2,(IX+$04)  ;
 $C51C SET 5,(IX+$04)  ;
 $C520 LD (IX+$05),$0D ;
 $C524 LD (IX+$06),$06 ;
 $C528 LD (IX+$13),$FF ;
 $C52C LD (IX+$0D),E   ; {Position bullet at the firing enemy
 $C52F LD (IX+$0E),D   ;
 $C532 LD (IX+$0B),L   ;
 $C535 LD (IX+$0C),H   ; }
 $C538 CALL $B7FE      ; Pseudo-random number generator
 $C53B AND $03         ;
 $C53D CP $03          ;
 $C53F JR NZ,$C543     ;
 $C541 LD A,$01        ;
*$C543 SUB $01         ;
 $C545 ADD A,C         ;
 $C546 AND $3F         ;
 $C548 LD (IX+$10),A   ; Set bullet heading (IX+$10)
 $C54B LD (IX+$11),$00 ;
 $C54F LD A,C          ;
 $C550 ADD A,$04       ; {Advance spread angle for next bullet
 $C552 AND $3F         ; }
 $C554 LD C,A          ;
 $C555 DJNZ $C4FB      ; Loop for each bullet
 $C557 SCF             ; {Signal fired (carry set) and return
 $C558 RET             ; }

; Allocate object from free-list pool and initialize
;
; Used by the routine at #R$B730.
;
; .
;
; Pops a free object slot from the linked list at $9D1C (pushing the previous
; head onto a secondary stack at $9D30), then initializes its struct:
; IX+$02/$03 (a record pointer into the shared #R$6B42 table, not executable
; code - see #R$5B55) -> $6B42 (record 0), state flags, default position, and
; stores the new object's address into $9C6D - the same field #R$C43C reads as
; its aim/steering target. Looks like the enemy-bullet or enemy-spawn
; allocator.
@label=alloc_object
c$C559 LD ($C570),SP   ; Save caller's SP (restored at $C56F)
 $C55D LD IX,($9D1C)   ; {Pop free-list head ($9D1C) into IX
 $C561 LD SP,IX        ;
 $C563 POP HL          ; }
 $C564 LD ($9D1C),HL   ;
 $C567 LD HL,($9D30)   ; {Push old head onto secondary stack ($9D30)
 $C56A PUSH HL         ;
 $C56B LD ($9D30),SP   ; }
 $C56F LD SP,$0000     ;
 $C572 LD (IX+$04),$00 ; {Clear status, set "active" bit 2
 $C576 SET 2,(IX+$04)  ; }
 $C57A LD (IX+$02),$42 ; Per-frame handler pointer -> $6B42
 $C57E LD (IX+$03),$6B ;
 $C582 LD (IX+$05),$02 ;
 $C586 LD (IX+$16),$01 ;
 $C58A LD (IX+$17),$01 ;
 $C58E LD (IX+$06),$06 ;
 $C592 LD (IX+$13),$FF ;
 $C596 LD (IX+$18),$FF ;
 $C59A LD (IX+$0B),$00 ;
 $C59E LD (IX+$0C),$10 ; Default column (IX+$0C=$10)
 $C5A2 LD (IX+$0D),$00 ;
 $C5A6 LD (IX+$0E),$16 ; Default row (IX+$0E=$16)
 $C5AA LD ($9C6D),IX   ; Publish object as current aim target ($9C6D)
 $C5AE RET             ;

; Start object explosion sequence
;
; Used by the routines at #R$BE03, #R$BFEB, #R$C015, #R$C075, #R$C11C, #R$C199,
; #R$C217 and #R$C298.
;
; IY object struct base
; D,E position offset for the explosion
;
; Sets the object's per-frame update-routine pointer (IY+2/+3, little-endian)
; to $6BCA and initializes state fields IY+5/IY+6, then resets two global
; countdown/growth values at $9C35 and $9C39. Called by 7 different
; enemy/object update routines (BDAE, BF42, C0B2, C168, C1E0, C1E8, C2D6), very
; likely the shared "object destroyed, switch to explosion animation" entry
; point. $6BCA itself and the exact role of $9C35/$9C39 not yet traced.
@label=start_explosion
c$C5AF LD (IY+$02),$CA ; {set object's IX+$02/$03 (record ptr into #R$6B42's
 $C5B3 LD (IY+$03),$6B ; table, not code) to $6BCA (record 8)}
 $C5B7 LD (IY+$05),$04 ; {init state fields IY+5=4, IY+6=8
 $C5BB LD (IY+$06),$08 ; }
 $C5BF LD (IY+$15),E   ; {store caller's position offset (D,E) into object
 $C5C2 LD (IY+$16),D   ; struct}
 $C5C5 LD HL,$FD50     ; {reset global timer/counter $9C35
 $C5C8 LD ($9C35),HL   ; }
 $C5CB LD HL,$EEA0     ; {reset global timer/counter $9C39
 $C5CE LD ($9C39),HL   ; }
 $C5D1 RET             ; return

; Convert object to explosion (set state-record pointer to $6BF3)
;
; Used by the routine at #R$B79F.
;
; IY object struct base
;
; Called from #R$B79F on the $9C3F path. Increments $9C3F, positions the object
; via #R$B8DB, then sets IY+$02/$03 to $6BF3 - entry 4 of the #R$6BDB
; explosion/state descriptor table (not executable code, see #R$5B55/#R$6BDB) -
; and inits state fields; the sibling of #R$C5AF (which uses $6BCA, record 8 of
; #R$6B42's table). The #R$C5EE entry (from #R$C648) additionally awards score
; (+8) and sets up a follow-up object based on the current player's state.
@label=object_to_explosion
c$C5D2 LD HL,$9C3F     ;
 $C5D5 INC (HL)        ;
 $C5D6 CALL $B8DB      ; Set object position from $9C01, clamp column (IY+$0C)
                       ; to 8-24
 $C5D9 RES 4,(IY+$04)  ;
 $C5DD LD (IY+$02),$F3 ;
 $C5E1 LD (IY+$03),$6B ;
 $C5E5 LD (IY+$05),$08 ;
 $C5E9 LD (IY+$06),$00 ;
 $C5ED RET             ;
; This entry point is used by the routine at #R$C648.
*$C5EE CALL $B8DB      ; Set object position from $9C01, clamp column (IY+$0C)
                       ; to 8-24
 $C5F1 LD A,$08        ;
 $C5F3 CALL $66B5      ; Add BCD score value to current player's score
 $C5F6 RES 4,(IY+$04)  ;
 $C5FA LD (IY+$06),$00 ;
 $C5FE LD A,($9C01)    ;
 $C601 LD (IY+$0D),A   ;
 $C604 LD (IY+$0B),$00 ;
 $C608 LD IX,($9C77)   ;
 $C60C LD A,(IX+$0B)   ;
 $C60F AND A           ;
 $C610 JR Z,$C620      ;
 $C612 LD A,($9C6A)    ;
 $C615 CP $03          ;
 $C617 JR Z,$C631      ;
 $C619 CALL $B7FE      ; Pseudo-random number generator
 $C61C CP $0F          ;
 $C61E JR C,$C631      ;
*$C620 LD (IY+$02),$ED ;
 $C624 LD (IY+$03),$6B ;
 $C628 LD (IY+$05),$0F ;
 $C62C LD (IY+$15),$33 ;
 $C630 RET             ;
*$C631 XOR A           ;
 $C632 LD ($9C6A),A    ;
 $C635 CALL $B8DB      ; Set object position from $9C01, clamp column (IY+$0C)
                       ; to 8-24
 $C638 DEC (IX+$0B)    ;
 $C63B LD (IY+$02),$E7 ;
 $C63F LD (IY+$03),$6B ;
 $C643 LD (IY+$05),$10 ;
 $C647 RET             ;

; Decrement wave-group counter; trigger group-clear bonus when it hits zero
;
; Used by the routine at #R$B79F.
;
; .
;
; Called from #R$B79F when a formation slot finishes. Decrements the wave-group
; counter at $9C68; while nonzero, falls through into #R$C5EE (per-kill
; score/bonus handling). Once it reaches zero, reloads it from $9C72 and sets
; up a bonus-animation script on IY (pointer $6B97, duration fields), choosing
; between two outcomes based on IY+$0C vs $12.
c$C648 LD HL,$9C68     ;
 $C64B DEC (HL)        ;
 $C64C JR NZ,$C5EE     ;
 $C64E LD A,($9C72)    ; get Wave type / group id
 $C651 LD (HL),A       ;
 $C652 LD (IY+$02),$97 ;
 $C656 LD (IY+$03),$6B ;
 $C65A LD (IY+$05),$07 ;
 $C65E LD (IY+$06),$06 ;
 $C662 LD A,(IY+$0C)   ;
 $C665 CP $12          ;
 $C667 JR C,$C673      ;
 $C669 LD (IY+$15),$01 ;
 $C66D LD (IY+$10),$20 ;
 $C671 JR $C67B        ;
*$C673 LD (IY+$15),$FF ;
 $C677 LD (IY+$10),$00 ;
*$C67B LD (IY+$11),$03 ;
 $C67F RET             ;

; Scroll background (periodic LDDR shift, gated by counter $9C2A)
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every frame from #R$A0C4. Decrements counter $9C2A; every 3rd call
; ($9C2A reloaded to 3) it shifts two 15-byte blocks ($850E-$851D and
; $851E-$852D) backward by one byte via LDDR - the periodic scroll-step
; mechanism for the background graphics.
@label=scroll_background
c$C680 LD HL,$9C2A   ;
 $C683 DEC (HL)      ; {Act only every 3rd frame ($9C2A countdown)
 $C684 RET NZ        ; }
 $C685 LD (HL),$03   ; Reload the frame counter (3)
 $C687 LD HL,$850E   ; First block: shift $850E-$851D back one byte
 $C68A LD DE,$850F   ;
 $C68D LD BC,$000F   ;
 $C690 LD A,(DE)     ;
 $C691 LDDR          ; Shift 15 bytes down (LDDR)
 $C693 LD ($8500),A  ; Wrap the scrolled-off byte to $8500
 $C696 LD HL,$851E   ; Second block: shift $851E-$852D back one byte
 $C699 LD DE,$851F   ;
 $C69C LD BC,$000F   ;
 $C69F LD A,(DE)     ;
 $C6A0 LDDR          ; Shift 15 bytes down (LDDR)
 $C6A2 LD ($8510),A  ; Wrap the scrolled-off byte to $8510
 $C6A5 RET           ;

; Screen wipe transition effect (colour set in $9C59)
;
; Used by the routines at #R$6498, #R$6A88, #R$A6BB, #R$A6E5, #R$A783 and
; #R$A802.
;
; none; uses colour from $9C59 (set by caller beforehand)
;
; Diamond/cross wipe: repeatedly paints a full-height column and full-width row
; on each side of screen centre, growing outward frame by frame, using #R$C6D3
; (fill column) and #R$C6EB (fill row) with the attribute byte at $9C59. All
; callers set $9C59 to the desired colour just before calling this.
@label=screen_wipe
c$C6A6 LD B,$12      ; wait ~18 frames before starting wipe
*$C6A8 HALT          ; {loop: wait 18 frames
 $C6A9 DJNZ $C6A8    ; }
 $C6AB LD A,$0B      ; {wait one more frame; init centre offset
 $C6AD HALT          ; }
 $C6AE CALL $C6EB    ; Fill screen attribute row with colour from $9C59
 $C6B1 LD B,A        ; B = wipe step count
*$C6B2 PUSH BC       ; save loop counter
 $C6B3 LD A,$04      ; {compute column right of centre, wait a frame
 $C6B5 ADD A,B       ;
 $C6B6 HALT          ; }
 $C6B7 CALL $C6D3    ; Fill screen attribute column with colour from $9C59
 $C6BA NEG           ; {mirror to column left of centre
 $C6BC ADD A,$1F     ; }
 $C6BE CALL $C6D3    ; Fill screen attribute column with colour from $9C59
 $C6C1 POP BC        ; {restore counter, compute row below centre
 $C6C2 PUSH BC       ;
 $C6C3 LD A,B        ;
 $C6C4 DEC A         ; }
 $C6C5 CALL $C6EB    ; Fill screen attribute row with colour from $9C59
 $C6C8 NEG           ; {mirror to row above centre
 $C6CA ADD A,$16     ; }
 $C6CC CALL $C6EB    ; Fill screen attribute row with colour from $9C59
 $C6CF POP BC        ; {repeat, shrinking step outward
 $C6D0 DJNZ $C6B2    ; }
 $C6D2 RET           ; return

; Fill screen attribute column with colour from $9C59
;
; Used by the routine at #R$C6A6.
;
; A screen column (7-24 valid, else no-op)
@label=fill_attr_column
c$C6D3 CP $07        ;
 $C6D5 RET C         ;
 $C6D6 CP $19        ;
 $C6D8 RET NC        ;
 $C6D9 PUSH AF       ;
 $C6DA LD L,A        ;
 $C6DB LD H,$58      ;
 $C6DD LD DE,$0020   ;
 $C6E0 LD B,$17      ;
 $C6E2 LD A,($9C59)  ; get Active colour scheme
*$C6E5 LD (HL),A     ;
 $C6E6 ADD HL,DE     ;
 $C6E7 DJNZ $C6E5    ;
 $C6E9 POP AF        ;
 $C6EA RET           ;

; Fill screen attribute row with colour from $9C59
;
; Used by the routine at #R$C6A6.
;
; A row/column offset (encodes screen position)
@label=fill_attr_row
c$C6EB PUSH AF       ;
 $C6EC RRCA          ; {Rotate position code into attribute-row high bits
 $C6ED RRCA          ;
 $C6EE RRCA          ; }
 $C6EF LD H,A        ;
 $C6F0 AND $E0       ;
 $C6F2 ADD A,$07     ;
 $C6F4 LD L,A        ;
 $C6F5 AND $E0       ;
 $C6F7 XOR H         ;
 $C6F8 ADD A,$58     ; {Form attribute-area address in $58xx
 $C6FA LD H,A        ; }
 $C6FB LD E,L        ;
 $C6FC LD D,H        ;
 $C6FD INC E         ; {Set up LDIR: dest = src+1, length 17
 $C6FE LD BC,$0011   ; }
 $C701 LD A,($9C59)  ; {Load fill colour from $9C59
 $C704 LD (HL),A     ; }
 $C705 LDIR          ; Propagate colour across the row (18 cells)
 $C707 POP AF        ;
 $C708 RET           ;

; Fill entire attribute screen with colour A (fast SP-push fill)
;
; Used by the routine at #R$C72A.
;
; A attribute colour
@label=fill_attr_screen
c$C709 LD ($C727),SP ; Save caller's SP (restored at $C726)
 $C70D LD C,A        ;
 $C70E LD B,A        ;
 $C70F LD A,$17      ; A = 23 row groups to fill
 $C711 LD HL,$5819   ; HL = attribute area start ($5819)
 $C714 LD DE,$0020   ;
*$C717 LD SP,HL      ; Point SP at this row for the PUSH fill
 $C718 PUSH BC       ; {Fast fill: 9x PUSH BC (18 attribute bytes)
 $C719 PUSH BC       ;
 $C71A PUSH BC       ;
 $C71B PUSH BC       ;
 $C71C PUSH BC       ;
 $C71D PUSH BC       ;
 $C71E PUSH BC       ;
 $C71F PUSH BC       ;
 $C720 PUSH BC       ; }
 $C721 ADD HL,DE     ; {Advance HL to next row ($20 stride)
 $C722 DEC A         ; }
 $C723 JP NZ,$C717   ; Loop 23 rows
 $C726 LD SP,$0000   ; Restore SP
 $C729 RET           ;

; Animate active player's indicator box colour
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every interrupt from #R$A0C4. Reads the next colour byte from a
; repeating sequence (pointer $9C45, reset via $9C44/$9C47 on terminator $FF),
; then applies it to the active player's corner box ($58C4 or $58DA, chosen via
; $9C76) - the same corner boxes highlighted (statically) by #R$6A88's credits
; screen.
@label=animate_player_box
c$C72A LD HL,($9C45) ;
 $C72D LD A,(HL)     ;
 $C72E CP $FF        ;
 $C730 JR NZ,$C740   ;
 $C732 LD HL,$9C44   ;
 $C735 LD A,(HL)     ;
 $C736 AND A         ;
 $C737 LD C,$07      ;
 $C739 JR Z,$C745    ;
 $C73B DEC (HL)      ;
 $C73C LD HL,$9C47   ;
 $C73F LD A,(HL)     ;
*$C740 INC HL        ;
 $C741 LD ($9C45),HL ;
 $C744 LD C,A        ;
*$C745 LD A,($9C76)  ; get Active player
 $C748 LD HL,$58C4   ;
 $C74B DEC A         ;
 $C74C JR Z,$C750    ;
 $C74E LD L,$DA      ;
*$C750 LD (HL),C     ;
 $C751 INC L         ;
 $C752 LD (HL),C     ;
 $C753 LD A,L        ;
 $C754 ADD A,$1F     ;
 $C756 LD L,A        ;
 $C757 LD (HL),C     ;
 $C758 INC L         ;
 $C759 LD (HL),C     ;
 $C75A LD HL,($9C5B) ; read next full-screen flash colour byte (sequence $9C5B,
                     ; set by #R$6A88)
 $C75D LD A,(HL)     ;
 $C75E CP $FF        ;
 $C760 RET Z         ;
 $C761 INC HL        ;
 $C762 LD ($9C5B),HL ;
 $C765 LD C,A        ;
 $C766 LD A,($9C59)  ; get Active colour scheme
 $C769 LD HL,$9C5D   ;
 $C76C AND (HL)      ;
 $C76D OR C          ;
 $C76E CALL $C709    ; Fill entire attribute screen with colour A
 $C771 RET           ;

; Fast column mover: copy the built scroll row to the attribute screen
;
; Used by the routines at #R$6498, #R$6A88 and #R$A0C4.
;
; .
;
; Called every frame from the main loop. Uses an unrolled
; POP/self-modified-store SP-trick to move the scroll-window row prepared by
; #R$C84C into the on-screen attribute area, with #R$C825 selecting the
; per-frame store-opcode variant and $C804 advancing between row groups.
@label=fast_attr_mover
c$C772 CALL $C825    ; Configure $C772 mover
 $C775 LD ($C81F),SP ; Save caller's SP
 $C779 LD SP,$F6D1   ; SP=#R$F6D1: fast POP-based read pointer into source data
 $C77C LD HL,$0007   ;
 $C77F LD DE,$4007   ;
 $C782 LD A,E        ; {Stash E in shadow A', A=D (destination page high byte)
 $C783 EX AF,AF'     ;
 $C784 LD A,D        ; }
 $C785 LD ($C7A0),A  ; {Patch destination high byte into 3 self-modified store
 $C788 LD ($C7BC),A  ; targets ($C7A0/$C7BC/$C7D8)
 $C78B LD ($C7D8),A  ; }
 $C78E LD A,H        ; {EXX: switch to shadow registers for the unroll loop
 $C78F EXX           ; }
 $C790 LD E,$18      ; E=$18: outer pass counter
*$C792 LD B,$06      ; Inner unroll count B=$06 (6x3 stores per pass)
*$C794 POP HL        ;
 $C795 POP IX        ;
 $C797 POP IY        ;
 $C799 LD ($C7F2),SP ; Save source read pointer (SP) before switching back
 $C79D LD SP,HL      ; SP=HL: point stack at destination write area
 $C79E EXX           ; EXX: back to normal registers for the unrolled store
                     ; sequence
 $C79F LD D,$00      ;
 $C7A1 POP BC        ;
 $C7A2 LD (HL),C     ;
 $C7A3 INC H         ;
 $C7A4 LD (HL),B     ;
 $C7A5 INC H         ;
 $C7A6 POP BC        ;
 $C7A7 LD (HL),C     ;
 $C7A8 INC H         ;
 $C7A9 LD (HL),B     ;
 $C7AA INC H         ;
 $C7AB POP BC        ;
 $C7AC LD (HL),C     ;
 $C7AD INC H         ;
 $C7AE LD (HL),B     ;
 $C7AF INC H         ;
 $C7B0 POP BC        ;
 $C7B1 LD (HL),C     ;
 $C7B2 INC H         ;
 $C7B3 LD (HL),B     ;
 $C7B4 INC H         ;
 $C7B5 EX DE,HL      ;
 $C7B6 LD H,A        ;
 $C7B7 INC L         ;
 $C7B8 INC E         ;
 $C7B9 LD SP,IX      ;
 $C7BB LD D,$00      ;
 $C7BD POP BC        ;
 $C7BE LD (HL),C     ;
 $C7BF INC H         ;
 $C7C0 LD (HL),B     ;
 $C7C1 INC H         ;
 $C7C2 POP BC        ;
 $C7C3 LD (HL),C     ;
 $C7C4 INC H         ;
 $C7C5 LD (HL),B     ;
 $C7C6 INC H         ;
 $C7C7 POP BC        ;
 $C7C8 LD (HL),C     ;
 $C7C9 INC H         ;
 $C7CA LD (HL),B     ;
 $C7CB INC H         ;
 $C7CC POP BC        ;
 $C7CD LD (HL),C     ;
 $C7CE INC H         ;
 $C7CF LD (HL),B     ;
 $C7D0 INC H         ;
 $C7D1 EX DE,HL      ;
 $C7D2 LD H,A        ;
 $C7D3 INC L         ;
 $C7D4 INC E         ;
 $C7D5 LD SP,IY      ;
 $C7D7 LD D,$00      ;
 $C7D9 POP BC        ;
 $C7DA LD (HL),C     ;
 $C7DB INC H         ;
 $C7DC LD (HL),B     ;
 $C7DD INC H         ;
 $C7DE POP BC        ;
 $C7DF LD (HL),C     ;
 $C7E0 INC H         ;
 $C7E1 LD (HL),B     ;
 $C7E2 INC H         ;
 $C7E3 POP BC        ;
 $C7E4 LD (HL),C     ;
 $C7E5 INC H         ;
 $C7E6 LD (HL),B     ;
 $C7E7 INC H         ;
 $C7E8 POP BC        ;
 $C7E9 LD (HL),C     ;
 $C7EA INC H         ;
 $C7EB LD (HL),B     ;
 $C7EC INC H         ;
 $C7ED EX DE,HL      ;
 $C7EE LD H,A        ;
 $C7EF INC L         ;
 $C7F0 INC E         ;
 $C7F1 LD SP,$0000   ;
 $C7F4 EXX           ;
 $C7F5 DJNZ $C794    ;
 $C7F7 EXX           ;
 $C7F8 EX AF,AF'     ;
 $C7F9 LD L,A        ;
 $C7FA LD H,D        ;
 $C7FB ADD A,$20     ;
 $C7FD LD E,A        ;
 $C7FE JR C,$C809    ;
 $C800 EX AF,AF'     ;
 $C801 LD A,H        ;
 $C802 EXX           ;
 $C803 DEC E         ;
 $C804 JP NZ,$C792   ;
 $C807 JR $C81E      ;
*$C809 EX AF,AF'     ;
 $C80A LD A,($C7A0)  ; {Advance the 3 self-modified destination operands by 8
 $C80D ADD A,$08     ;
 $C80F LD ($C7A0),A  ;
 $C812 LD ($C7BC),A  ;
 $C815 LD ($C7D8),A  ; }
 $C818 LD A,H        ;
 $C819 EXX           ;
 $C81A DEC E         ; Next row-group
 $C81B JP NZ,$C792   ; Loop back into the unrolled mover body
*$C81E LD SP,$0000   ; Done: restore SP
 $C821 CALL $C839    ; Reset $C772 mover body opcodes to INC H
 $C824 RET           ;

; Configure $C772 mover: set fill displacement, patch 3 body opcodes to EX
; DE,HL
;
; Used by the routine at #R$C772.
;
; .
;
; Patches the IX-displacement operand at $C846 from the frame-indexed table
; ($9C02 + $9C00 mod 8), then via the shared tail writes $EB (EX DE,HL) into
; three opcode slots ($C7A1/$C7BD/$C7D9) in #R$C772's unrolled store body.
c$C825 LD A,($9C00)  ;
 $C828 AND $07       ; {Frame counter $9C00 mod 8
 $C82A LD E,A        ; }
 $C82B LD D,$00      ;
 $C82D LD HL,$9C02   ;
 $C830 ADD HL,DE     ; {Index byte table at $9C02
 $C831 LD A,(HL)     ; }
 $C832 LD ($C846),A  ; Patch fill-loop IX displacement operand ($C846)
 $C835 LD A,$EB      ; A=$EB (EX DE,HL opcode)
 $C837 JR $C83B      ;

; Reset $C772 mover body opcodes to INC H
;
; Used by the routine at #R$C772.
;
; .
;
; Alternate entry to #R$C825's tail: writes $24 (INC H) into the three opcode
; slots instead of $EB.
c$C839 LD A,$24      ; A=$24 (INC H opcode)
; This entry point is used by the routine at #R$C825.
*$C83B LD B,$03      ; {Set up 3-slot patch loop (stride $1C from $C7A1)
 $C83D LD DE,$001C   ; }
 $C840 LD IX,$C7A1   ;
*$C844 LD (IX+$00),A ; Write opcode into this store-body slot
 $C847 ADD IX,DE     ; Advance to next slot (+$1C)
 $C849 DJNZ $C844    ; Loop 3 slots
 $C84B RET           ;

; Build wrapped scroll-window row into $F6D1 buffer
;
; Used by the routines at #R$6A88 and #R$A0C4.
;
; .
;
; Called every interrupt from #R$A0C4. Source is the circular scroll buffer:
; base pointer ($9BF9)+$0024 plus a wrap count derived from the scroll offset
; at $9BF8. Copies up to 24 bytes via LDI into #R$F6D1, and if the window runs
; past the buffer end, continues the remaining bytes from the wrap point at
; $FA79 (the same circular buffer filled by #R$6498). The resulting #R$F6D1 row
; is consumed by #R$C772's fast attribute mover.
@label=build_scroll_row
c$C84C LD HL,($9BF9) ; {HL = scroll-window source pointer, DE = dest #R$F6D1
 $C84F LD DE,$0024   ;
 $C852 ADD HL,DE     ;
 $C853 LD DE,$F6D1   ; }
 $C856 LD A,($9BF8)  ;
 $C859 LD C,A        ; {C = scroll offset, B = bytes remaining before wrap
 $C85A NEG           ; ($18-offset)
 $C85C ADD A,$18     ;
 $C85E LD B,A        ;
 $C85F LD A,C        ;
 $C860 JR Z,$C8AE    ; }
*$C862 LD C,$FF      ;
 $C864 LDI           ;
 $C866 LDI           ;
 $C868 LDI           ;
 $C86A LDI           ;
 $C86C LDI           ;
 $C86E LDI           ;
 $C870 LDI           ;
 $C872 LDI           ;
 $C874 LDI           ;
 $C876 LDI           ;
 $C878 LDI           ;
 $C87A LDI           ;
 $C87C LDI           ;
 $C87E LDI           ;
 $C880 LDI           ;
 $C882 LDI           ;
 $C884 LDI           ;
 $C886 LDI           ;
 $C888 LDI           ;
 $C88A LDI           ;
 $C88C LDI           ;
 $C88E LDI           ;
 $C890 LDI           ;
 $C892 LDI           ;
 $C894 LDI           ;
 $C896 LDI           ;
 $C898 LDI           ;
 $C89A LDI           ;
 $C89C LDI           ;
 $C89E LDI           ;
 $C8A0 LDI           ;
 $C8A2 LDI           ;
 $C8A4 LDI           ;
 $C8A6 LDI           ;
 $C8A8 LDI           ;
 $C8AA LDI           ;
 $C8AC DJNZ $C862    ;
*$C8AE LD HL,$FA79   ; {Wrap: continue remaining bytes from buffer start $FA79
 $C8B1 LD B,A        ;
 $C8B2 AND A         ;
 $C8B3 LD A,$00      ;
 $C8B5 JR NZ,$C862   ; }
 $C8B7 RET           ;

; Advance background scroll: every 8th frame swap column buffer and render row
;
; Used by the routines at #R$A0C4 and #R$A4E7.
;
; .
;
; Called every frame from #R$A0C4 and #R$A4E7. Advances a mod-8 frame counter
; at $9C00; only on the 8th frame does it request deferred event bit 3 ($9C27),
; toggle the ping-pong column-buffer selector ($9BAE), copy the active 18-byte
; column row into staging ($9BD4), call #R$C941 to decode the next column, and
; convert each row cell into an attribute-code pair (>=$60 clamped to $62)
; written to the on-screen scroll target ($9BF9).
c$C8B8 LD HL,$9C00   ;
 $C8BB LD A,(HL)     ;
 $C8BC INC A         ;
 $C8BD CP $08        ; Test for 8th frame (mod-8 wrap)
 $C8BF RES 3,A       ;
 $C8C1 LD (HL),A     ;
 $C8C2 RRCA          ;
 $C8C3 RRCA          ;
 $C8C4 RRCA          ;
 $C8C5 INC HL        ;
 $C8C6 LD (HL),A     ;
 $C8C7 AND A         ; {Only continue every 8th call
 $C8C8 RET NZ        ; }
 $C8C9 LD HL,$9C27   ;
 $C8CC SET 3,(HL)    ; Mark deferred event bit 3 pending
 $C8CE LD HL,$9BAE   ;
 $C8D1 LD A,(HL)     ;
 $C8D2 XOR $01       ; Toggle ping-pong buffer selector
 $C8D4 LD (HL),A     ;
 $C8D5 LD HL,$9BB0   ;
 $C8D8 LD IY,$9BC2   ;
 $C8DC JR Z,$C8E5    ; Select this pass's ping-pong buffer
 $C8DE LD HL,$9BC2   ;
 $C8E1 LD IY,$9BB0   ;
*$C8E5 LD DE,$9BD4   ;
 $C8E8 LD BC,$0012   ;
 $C8EB LDIR          ; Copy 18-byte row into staging buffer $9BD4
 $C8ED CALL Z,$C941  ; Decode next column's tile data into ping-pong buffer
 $C8F0 LD HL,$9BD4   ;
 $C8F3 LD DE,($9BF9) ;
 $C8F7 LD B,$12      ;
 $C8F9 LD C,(HL)     ;
 $C8FA INC HL        ;
 $C8FB LD A,(IY+$00) ;
 $C8FE JR $C907      ;
*$C900 LD C,(HL)     ;
 $C901 INC HL        ;
 $C902 LD A,(IY+$00) ;
 $C905 INC IY        ;
*$C907 CP $0C        ;
 $C909 JR C,$C916    ;
 $C90B CP $60        ;
 $C90D JR NC,$C916   ;
 $C90F LD A,C        ;
 $C910 CP $60        ;
 $C912 JR C,$C917    ;
 $C914 LD C,$62      ;
*$C916 LD A,C        ;
*$C917 RLCA          ;
 $C918 RLCA          ;
 $C919 RLCA          ;
 $C91A LD C,A        ;
 $C91B AND $F8       ;
 $C91D LD (DE),A     ;
 $C91E INC DE        ;
 $C91F XOR C         ;
 $C920 ADD A,$80     ;
 $C922 LD (DE),A     ;
 $C923 INC DE        ;
 $C924 DJNZ $C900    ;
 $C926 LD HL,($9BF9) ;
 $C929 LD DE,$FFDC   ;
 $C92C ADD HL,DE     ;
 $C92D EX DE,HL      ;
 $C92E LD HL,$9BF8   ;
 $C931 LD A,(HL)     ;
 $C932 DEC A         ;
 $C933 JP P,$C93B    ;
 $C936 LD A,$18      ;
 $C938 LD DE,$FDD9   ;
*$C93B LD (HL),A     ;
 $C93C LD ($9BF9),DE ;
 $C940 RET           ;

; Decode next column's tile data into ping-pong buffer
;
; Used by the routine at #R$C8B8.
;
; .
;
; Called from #R$C8B8 every 8th frame. If the column-ready flag ($9BA2 bit 5)
; is clear, first calls #R$C981 to scan/spawn enemies from the previous column.
; Then decodes 9 map cells from the column-source pointer ($9BA9) into the
; ping-pong buffer at $9BB0: each cell byte indexes the four 2x2 tile-block
; tables at #R$7900-$7CFF (see #R$7900), and the four resulting character codes
; are stored as top pair (#R$7900/$7A00 -> IX+0/IX+1, row A) and bottom pair
; ($7B00/$7C00 -> IX+$12/IX+$13, row B). So the 9 cells expand to two 18-char
; column rows. Advances the source pointer ($9BA9) and bumps a level-progress
; counter ($9BAD) clamped at $1C.
@label=decode_column
c$C941 LD HL,$9BA2   ;
 $C944 BIT 5,(HL)    ; Check "column ready" flag before advancing
 $C946 CALL Z,$C981  ; Scan incoming column for spawn markers and allocate
                     ; enemy objects
 $C949 LD HL,($9BA9) ;
 $C94C LD IX,$9BB0   ;
 $C950 LD C,$79      ;
 $C952 LD B,$09      ;
*$C954 LD E,(HL)     ; Start of 9-entry decode loop
 $C955 LD D,C        ;
 $C956 LD A,(DE)     ;
 $C957 INC D         ;
 $C958 LD (IX+$00),A ;
 $C95B LD A,(DE)     ;
 $C95C INC D         ;
 $C95D LD (IX+$01),A ;
 $C960 LD A,(DE)     ;
 $C961 INC D         ;
 $C962 LD (IX+$12),A ;
 $C965 LD A,(DE)     ;
 $C966 LD (IX+$13),A ;
 $C969 INC IX        ; {Advance to next buffer entry (IX+=2)
 $C96B INC IX        ; }
 $C96D INC L         ;
 $C96E EX AF,AF'     ;
 $C96F ADD A,$10     ;
 $C971 EX AF,AF'     ;
 $C972 DJNZ $C954    ; Loop 9 times
 $C974 LD ($9BA9),HL ;
 $C977 LD HL,$9BAD   ;
 $C97A LD A,(HL)     ;
 $C97B CP $1C        ; Clamp progress counter at $1C
 $C97D RET NC        ; Stop if counter already at max
 $C97E INC A         ;
 $C97F LD (HL),A     ;
 $C980 RET           ;

; Scan incoming column for spawn markers and allocate enemy objects
;
; Used by the routine at #R$C941.
;
; .
;
; Called from #R$C941 when the "column ready" flag ($9BA2 bit 5) is clear.
; Scans 9 entries of the newly-decoded column buffer ($9BA9, stride $10) for
; spawn markers $05/$55; for each match, calls #R$BA5F to spawn a group (D =
; entry offset, used there as the enemy's row/type). #R$BA5F returns carry set
; on success: on a successful spawn the marker byte is left unchanged, but if
; the pool was full (carry clear) the cell is overwritten with $33 to mark it
; consumed/blocked.
@label=scan_spawn_markers
c$C981 LD HL,$9BA2   ;
 $C984 BIT 5,(HL)    ; Skip if column-ready flag already set
 $C986 RET NZ        ;
 $C987 LD HL,($9BA9) ;
 $C98A LD B,$09      ;
 $C98C LD C,$10      ;
*$C98E LD A,(HL)     ;
 $C98F CP $05        ; Check for spawn marker $05
 $C991 JR Z,$C997    ;
 $C993 CP $55        ; {Check for spawn marker $55; skip entry if neither
 $C995 JR NZ,$C9A7   ; }
*$C997 PUSH HL       ;
 $C998 PUSH BC       ;
 $C999 LD D,C        ;
 $C99A LD C,$00      ;
 $C99C LD A,$09      ;
 $C99E CALL $BA5F    ; Spawn a group of formation objects from the free-list
                     ; pool
 $C9A1 POP BC        ;
 $C9A2 POP HL        ;
 $C9A3 JR C,$C9A7    ; Skip the $33 write if the spawn succeeded (carry set)
 $C9A5 LD (HL),$33   ; Pool full (carry clear): mark cell $33
                     ; (consumed/blocked)
*$C9A7 INC L         ;
 $C9A8 LD A,C        ;
 $C9A9 ADD A,$10     ;
 $C9AB LD C,A        ;
 $C9AC DJNZ $C98E    ; Loop 9 entries
 $C9AE RET           ;

; Advance enemy timeline: fire due entries and dispatch their commands
;
; Used by the routine at #R$A0C4.
;
; .
;
; Called every frame from #R$A0C4. Every 16th tick, advances the level-progress
; counter ($9BA4) and processes all timeline entries whose trigger byte matches
; it: each 3-byte entry [trigger, param D, command] either dispatches a special
; command ($FB-$FE) or, for any other value, treats it as a formation tag and
; spawns via $C9E4/#R$BA5F. Ends the frame's processing at the first
; non-matching or $FF entry. See docs/Level-Format.md.
@label=enemy_timeline
c$C9AF LD HL,$9BA3   ; POKE 51631,201 patches entry to RET, disabling this
                     ; routine (No Enemies)
 $C9B2 LD A,(HL)     ;
 $C9B3 INC A         ; {Advance tick counter mod 16; act only every 16th tick
 $C9B4 AND $0F       ;
 $C9B6 LD (HL),A     ; }
 $C9B7 RET NZ        ;
 $C9B8 LD HL,$9BA4   ;
 $C9BB INC (HL)      ; Advance level-progress counter ($9BA4)
 $C9BC LD A,(HL)     ;
*$C9BD LD HL,($9BA5) ; Point at current timeline entry ($9BA5)
 $C9C0 LD A,(HL)     ;
 $C9C1 CP $FF        ; {End of table when trigger byte is $FF
 $C9C3 JR Z,$C9EB    ; }
 $C9C5 LD A,($9BA4)  ; get Level progress / index
 $C9C8 CP (HL)       ; {Fire only when progress counter matches the trigger
 $C9C9 JR NZ,$C9EB   ; byte}
 $C9CB INC HL        ; {Read param D and command byte; advance past 3-byte
 $C9CC LD D,(HL)     ; entry
 $C9CD INC HL        ;
 $C9CE LD A,(HL)     ;
 $C9CF INC HL        ;
 $C9D0 LD ($9BA5),HL ; }
 $C9D3 CP $FC        ; {Command $FC: reset $9D1B
 $C9D5 JR Z,$C9F8    ; }
 $C9D7 CP $FE        ; {Command $FE: set $9C3B=$FF
 $C9D9 JR Z,$C9EC    ; }
 $C9DB CP $FD        ; {Command $FD: bump counter $9C69
 $C9DD JR Z,$C9F2    ; }
 $C9DF CP $FB        ; {Command $FB: screen/timing poke ($5B56/$C2E1)
 $C9E1 JR Z,$C9FE    ; }
 $C9E3 LD C,A        ; Else: command byte is a formation tag (falls into $C9E4)
 $C9E4 LD A,$01      ;
 $C9E6 CALL $BA5F    ; Spawn a group of formation objects from the free-list
                     ; pool
 $C9E9 JR $C9BD      ;
*$C9EB RET           ;
*$C9EC LD A,$FF      ;
 $C9EE LD ($9C3B),A  ;
 $C9F1 RET           ;
*$C9F2 LD HL,$9C69   ;
 $C9F5 INC (HL)      ;
 $C9F6 JR $C9BD      ;
*$C9F8 XOR A         ;
 $C9F9 LD ($9D1B),A  ;
 $C9FC JR $C9BD      ;
*$C9FE LD A,D        ;
 $C9FF LD ($5B56),A  ;
 $CA02 SRL A         ;
 $CA04 LD ($C2E1),A  ;
 $CA07 JR $C9BD      ;

; Player-plane masked sprite (24x16, interleaved pixel/mask, mask bit-reversed)
;
; .
;
; .
;
; Each frame is 24px wide x 16px tall = 3 vertical 8px strips of 32 bytes (16
; rows of a [pixel, mask] pair). The mask byte is stored bit-reversed and must
; be flipped through the #R$9A00 table to align with the pixel byte. Successive
; frames are pre-shifted horizontal copies (each +1px) built by #R$7E4A for
; smooth sub-pixel movement; #R$7DF3 interleaves the pixel/mask pairs and
; #R$7D98 generates mirrored halves via #R$9A00.
b$CA09 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ; {32-byte gap before sprite group
 $CA11 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ;
 $CA19 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ;
 $CA21 DEFB $00,$FF,$00,$FF,$00,$FF,$00,$FF ; }
; Masked sprites: Plane
