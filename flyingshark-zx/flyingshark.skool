; Update tile-block tables ($7900+) from SP-fed data (index $04)
;
; .
;
; .
;
; Handler for index $04 of the $A000 jump table (see $B7F6). Writes into the
; 2x2 tile-block lookup tables at $7900-$7CFF (see $7900) rather than to the
; screen. For B ($9C1A) passes it fills a descending run of one page (H=$79, L
; from $FF down) with the low byte of each popped word, then INC H advances to
; the next page ($7A/$7B/$7C) - so successive passes populate the parallel
; quadrant tables. Continues into the formation script ($AFB8).
c$B072 LD SP,($9C15) ; Source data via SP (POP-fed)
 $B076 LD A,($9C1A)  ; B = column/pass count ($9C1A)
 $B079 LD B,A        ;
 $B07A LD H,$79      ; H=$79: destination tile-block table page
 $B07C LD A,$FF      ; A=$FF: row index start (writes descending)
*$B07E LD L,A        ; Set row index for this pass
 $B07F POP DE        ; {Store low byte of popped word, descending
 $B080 LD (HL),E     ;
 $B081 DEC L         ; }
 $B082 POP DE        ;
 $B083 LD (HL),E     ;
 $B084 DEC L         ;
 $B085 POP DE        ;
 $B086 LD (HL),E     ;
 $B087 DEC L         ;
 $B088 POP DE        ;
 $B089 LD (HL),E     ;
 $B08A DEC L         ;
 $B08B POP DE        ;
 $B08C LD (HL),E     ;
 $B08D DEC L         ;
 $B08E POP DE        ;
 $B08F LD (HL),E     ;
 $B090 DEC L         ;
 $B091 POP DE        ;
 $B092 LD (HL),E     ;
 $B093 DEC L         ;
 $B094 POP DE        ;
 $B095 LD (HL),E     ;
 $B096 DEC L         ;
 $B097 POP DE        ;
 $B098 LD (HL),E     ;
 $B099 DEC L         ;
 $B09A POP DE        ;
 $B09B LD (HL),E     ;
 $B09C DEC L         ;
 $B09D POP DE        ;
 $B09E LD (HL),E     ;
 $B09F DEC L         ;
 $B0A0 POP DE        ;
 $B0A1 LD (HL),E     ;
 $B0A2 DEC L         ;
 $B0A3 POP DE        ;
 $B0A4 LD (HL),E     ;
 $B0A5 DEC L         ;
 $B0A6 POP DE        ;
 $B0A7 LD (HL),E     ;
 $B0A8 DEC L         ;
 $B0A9 POP DE        ;
 $B0AA LD (HL),E     ;
 $B0AB DEC L         ;
 $B0AC POP DE        ;
 $B0AD LD (HL),E     ;
 $B0AE INC H         ; Next page ($7A/$7B/$7C)
 $B0AF DJNZ $B07E    ; Loop B passes
 $B0B1 JP $AFB8      ; => Formation script

