 $C0B6 JR NC,$C0D4     ;
*$C0B8 RES 7,(IY+$04)  ;
 $C0BC RRA             ;
 $C0BD JR C,$C0C3      ;
 $C0BF SET 7,(IY+$04)  ;
*$C0C3 LD (IY+$15),$F1 ;
 $C0C7 LD (IY+$16),$5C ;
 $C0CB LD (IY+$18),$01 ;
 $C0CF SET 4,(IY+$04)  ;
 $C0D3 RET             ;
*$C0D4 LD A,$04        ;
 $C0D6 CALL $66B5      ; Add BCD score value to current player's score
 $C0D9 LD DE,$9D18     ;
 $C0DC CALL $C5AF      ; Start object explosion sequence
 $C0DF RET             ;
*$C0E0 LD A,(IY+$0E)   ;
 $C0E3 CP $1E          ;
 $C0E5 JR NC,$C084     ;
 $C0E7 LD A,(IY+$10)   ;
 $C0EA ADD A,$03       ;
 $C0EC AND $38         ;
 $C0EE RRCA            ;
 $C0EF RRCA            ;
 $C0F0 RRCA            ;
 $C0F1 LD (IY+$06),A   ;
 $C0F4 LD A,(IY+$05)   ;
 $C0F7 CP $0C          ;
 $C0F9 JR NZ,$C106     ;
 $C0FB LD A,(IY+$0F)   ;
