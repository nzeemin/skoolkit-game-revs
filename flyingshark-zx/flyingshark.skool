 $B181 POP BC        ;
 $B182 LD A,(DE)     ;
 $B183 OR C          ;
 $B184 LD (DE),A     ;
 $B185 INC E         ;
 $B186 LD A,(DE)     ;
 $B187 OR B          ;
 $B188 LD (DE),A     ;
 $B189 INC E         ;
