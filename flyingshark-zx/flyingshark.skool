; Masked tile blit setup (index $01): to tile-block table, run $B1BE body
;
; .
;
; .
;
; Sets up a masked blit with destination $79F0 (into the 2x2 tile-block tables,
; not the screen) and jumps into the shared body at #R$B1C6 inside #R$B1BE.
c$B121 LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B125 LD DE,$79F0   ; Destination = tile-block buffer $79F0
 $B128 JP $B1C6      ; Run the shared masked-blit body (#R$B1BE)

; Masked tile blit setup (index $03): configure, then run $B24A body
;
; .
;
; .
;
; Handler for index $03 of the #R$A000 jump table (see #R$B7F6). Sets up a
; masked tile blit (source via SP, dest high = width+$78, self-modified
; row-start operand = $F0) and jumps into the shared blit body at #R$B25E
; inside #R$B24A.
c$B12B LD A,($9C1A)  ;
 $B12E LD B,A        ;
 $B12F EXX           ;
 $B130 LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B134 ADD A,$78     ; {Destination high byte = width + $78
 $B136 LD D,A        ; }
 $B137 LD A,$F0      ;
 $B139 LD ($B263),A  ; Self-modify #R$B24A's row-start operand ($F0)
 $B13C JP $B25E      ; Run the shared masked-blit body (#R$B25E)

; Masked tile blit setup (index $05): to tile-block table, run $B2DA body
;
; .
;
; .
;
; Sets up a masked blit with destination page $79 (into the 2x2 tile-block
; tables, not the screen) and jumps into the shared body at #R$B2E7 inside
; #R$B2DA.
c$B13F LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B143 LD D,$79      ; Destination page = $79 (tile-block table)
 $B145 LD A,$FF      ;
 $B147 JP $B2E7      ; Run the shared masked-blit body (#R$B2DA)

; Masked tile blit setup (index $07): run $B36A body
;
; .
;
; .
;
; Sets up a masked blit with destination high byte = width+$78 (screen) and
; jumps into the shared body at #R$B37F inside #R$B36A.
c$B14A LD A,($9C1A)  ; B = column/pass count ($9C1A)
 $B14D LD B,A        ;
 $B14E EXX           ;
 $B14F LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B153 ADD A,$78     ; {Destination high byte = width + $78
 $B155 LD D,A        ; }
 $B156 LD A,$FF      ;
 $B158 JP $B37F      ; Run the shared masked-blit body (#R$B36A)

; OR-composite tile-block pages onto screen (index $10)
;
; .
;
; .
;
; Handler for index $10 of the #R$A000 jump table (see #R$B7F6). Reads the four
; tile-block table pages ($79F0 upward, SP-fed) and OR-merges them onto the
; destination screen area at $9C13: for each of B ($9C1A) passes it ORs a run
; of source bytes into consecutive dest cells (additive overlay, not opaque),
; then INC H moves to the next source page ($7A/$7B/$7C) and INC D to the next
; dest row. Continues into the formation script (#R$AFB8).
c$B15B LD DE,($9C13) ; Destination screen address ($9C13)
 $B15F LD A,E        ;
 $B160 LD ($B16E),A  ; Self-modify row-start column operand
 $B163 LD HL,$79F0   ; Source = tile-block buffer $79F0
 $B166 EXX           ;
 $B167 LD A,($9C1A)  ;
 $B16A LD B,A        ;
