 $B16C LD SP,HL      ; Source via SP (POP-fed)
 $B16D LD E,$00      ;
 $B16F POP BC        ; {OR-merge two source bytes into consecutive dest cells
 $B170 LD A,(DE)     ;
 $B171 OR C          ;
 $B172 LD (DE),A     ;
 $B173 INC E         ;
 $B174 LD A,(DE)     ;
 $B175 OR B          ;
 $B176 LD (DE),A     ;
 $B177 INC E         ; }
 $B178 POP BC        ;
 $B179 LD A,(DE)     ;
 $B17A OR C          ;
 $B17B LD (DE),A     ;
 $B17C INC E         ;
 $B17D LD A,(DE)     ;
 $B17E OR B          ;
 $B17F LD (DE),A     ;
