; Formation script: read next byte, dispatch via $A000 table (SP=addr/RET
; trick)
;
; Used by the routines at #R$ADB8, #R$AFC3, #R$B005, #R$B072, #R$B0B4, #R$B15B,
; #R$B1BE, #R$B24A, #R$B2DA, #R$B36A, #R$B3FE, #R$B452, #R$B4AA, #R$B502,
; #R$B567, #R$B61A, #R$B6BF and #R$B72D.
;
; IX formation-script pointer
;
; Reads the byte at (IX), advances IX, then forms address $A0xx (xx = that
; byte) and jumps there by setting SP to it and executing RET - the byte value
; doubles as a direct low-byte offset into the same $A000 word table used by
; $B7F6 elsewhere. Called by 17 different formation/wave routines ($ADB8,
; $AFC3, $B005, $B072, $B0B4, $B15B, $B1BE, $B24A, $B2DA, $B36A, $B3FE, $B452,
; $B4AA, $B567, $B5FE, $B61A, $B6BF, $B72D) - this is the shared
; bytecode-dispatch core of the enemy formation/wave scripting system.
c$AFB8 LD L,(IX+$00) ; {read next script byte from (IX), advance script pointer
 $AFBB INC IX        ; }
 $AFBD LD H,$A0      ; {form address $A0xx from script byte, jump there via
 $AFBF LD SP,HL      ; faked RET
 $AFC0 RET           ; }

; Routine at AFC1
;
; .
;
; .
;
; Handler for index $14 of the $A000 jump table (see $B7F6).
c$AFC1 JP (IX)       ;

; Update tile-block tables ($7900+) from SP-fed data (index $00, INC L)
;
; .
;
; .
;
; Handler for index $00 of the $A000 jump table (see $B7F6). Twin of $B072 but
; fills ascending: writes the low byte of each popped word into a page of the
; 2x2 tile-block tables ($7900-$7CFF, see $7900), L rising from $F0, then INC H
; advances to the next page ($7A/$7B/$7C) for each of B ($9C1A) passes.
; Continues into the formation script ($AFB8).
c$AFC3 LD SP,($9C15) ; Source data via SP (POP-fed)
 $AFC7 LD A,($9C1A)  ; B = column/pass count ($9C1A)
 $AFCA LD B,A        ;
 $AFCB LD H,$79      ; H=$79: destination tile-block table page
 $AFCD LD A,$F0      ; A=$F0: row index start (writes ascending)
*$AFCF LD L,A        ; Set row index for this pass
 $AFD0 POP DE        ; {Store low byte of popped word, ascending
 $AFD1 LD (HL),E     ;
 $AFD2 INC L         ; }
 $AFD3 POP DE        ;
 $AFD4 LD (HL),E     ;
 $AFD5 INC L         ;
 $AFD6 POP DE        ;
 $AFD7 LD (HL),E     ;
 $AFD8 INC L         ;
 $AFD9 POP DE        ;
 $AFDA LD (HL),E     ;
 $AFDB INC L         ;
 $AFDC POP DE        ;
 $AFDD LD (HL),E     ;
 $AFDE INC L         ;
 $AFDF POP DE        ;
 $AFE0 LD (HL),E     ;
 $AFE1 INC L         ;
 $AFE2 POP DE        ;
 $AFE3 LD (HL),E     ;
 $AFE4 INC L         ;
 $AFE5 POP DE        ;
 $AFE6 LD (HL),E     ;
 $AFE7 INC L         ;
 $AFE8 POP DE        ;
 $AFE9 LD (HL),E     ;
 $AFEA INC L         ;
 $AFEB POP DE        ;
 $AFEC LD (HL),E     ;
 $AFED INC L         ;
 $AFEE POP DE        ;
 $AFEF LD (HL),E     ;
 $AFF0 INC L         ;
 $AFF1 POP DE        ;
 $AFF2 LD (HL),E     ;
 $AFF3 INC L         ;
 $AFF4 POP DE        ;
 $AFF5 LD (HL),E     ;
 $AFF6 INC L         ;
 $AFF7 POP DE        ;
 $AFF8 LD (HL),E     ;
 $AFF9 INC L         ;
 $AFFA POP DE        ;
 $AFFB LD (HL),E     ;
 $AFFC INC L         ;
 $AFFD POP DE        ;
 $AFFE LD (HL),E     ;
 $AFFF INC H         ; Next page ($7A/$7B/$7C)
 $B000 DJNZ $AFCF    ; Loop B passes
 $B002 JP $AFB8      ; => Formation script

; Opaque tile blit (index $02): copy $9A00[C] to screen, INC E stride
;
; .
;
; .
;
; Handler for index $02 of the $A000 jump table (see $B7F6).
c$B005 LD A,($9C1A)  ;
 $B008 LD B,A        ;
 $B009 EXX           ;
 $B00A LD SP,($9C15) ; Source tile data via SP (POP-fed)
 $B00E ADD A,$78     ; {Destination high byte = width + $78
 $B010 LD D,A        ; }
 $B011 LD A,$F0      ;
 $B013 LD ($B01B),A  ; Self-modify row-start column operand
 $B016 LD H,$9A      ; H=$9A: point at the $9A00 lookup table
 $B018 EXX           ;
*$B019 EXX           ;
 $B01A LD E,$00      ;
 $B01C POP BC        ; {Copy column: store $9A00[C] straight to screen (opaque,
 $B01D LD L,C        ; no mask)
 $B01E LD A,(HL)     ;
 $B01F LD (DE),A     ;
 $B020 INC E         ; }
