 $9E73 LD HL,$5C46   ;
 $9E76 LD A,($5B98)  ;
 $9E79 CP $FF        ;
 $9E7B JR Z,$9E83    ;
 $9E7D LD DE,$8400   ;
 $9E80 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
*$9E83 LD IY,$5BD6   ;
 $9E87 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9E8A LD HL,$5032   ;
 $9E8D LD B,$03      ;
 $9E8F LD IY,$5BD6   ;
 $9E93 JP $9F86      ;

