 $9502 JR Z,$9516    ; }
 $9504 PUSH DE       ;
 $9505 PUSH HL       ;
 $9506 CALL $90C6    ; Draw character bitmap
 $9509 POP HL        ;
 $950A PUSH HL       ;
 $950B CALL $9536    ; Convert screen address to attribute address
 $950E EX AF,AF'     ; {write attribute
 $950F LD (HL),A     ; }
 $9510 EX AF,AF'     ;
 $9511 POP HL        ;
 $9512 INC L         ;
 $9513 POP DE        ;
 $9514 JR $94FC      ;
*$9516 LD HL,$50A2   ; newline: reload HL
 $9519 LD A,L        ;
 $951A ADD A,$20     ; {next char row
 $951C LD L,A        ; }
 $951D JR NC,$94F9   ; => Print string from DE at screen HL, attr in AF'
 $951F LD A,H        ;
 $9520 ADD A,$08     ;
 $9522 LD H,A        ;
 $9523 JR $94F9      ; => Print string from DE at screen HL, attr in AF'

