 $BC70 JP $9EBD      ; => Init $5BD6 object slots from $5C23

; Room $5B98=$0C seesaw trigger: position gate, toggle Y $46/$48, room-state
; trigger
;
; Used by the routine at #R$B9FA.
;
; .
;
; Gated on room-category $5B98=$0C and the hero standing at Y=$46 or $48, X in
; a fixed range. Every other frame (frame counter bit0), flips the hero's Y
; between $46 and $48 - a two-frame teeter/seesaw motion - and arms the hero's
; direction flag. Once fully settled at X in [$28,$34), on a 4-frame cadence
; sets room-state to 6 (#R$BCB4) and increments a counter at (HL); reaching $0C
; fires #R$AE84 (reset). Between $06 and $0C it instead computes an index into
; a sound-effect table ($F928) and plays it via #R$9A52's write-and-dual-buffer
; path. Reads as a seesaw/rocking-platform puzzle piece: stand at the sweet
; spot, it rocks you for a few frames, plays an escalating sound cue, then
; resolves.
c$BC73 LD HL,$5C24     ; {gate: flag ($5C24)!=$0D
 $BC76 LD A,(HL)       ;
 $BC77 CP $0D          ;
 $BC79 RET Z           ; }
 $BC7A LD A,($5B98)    ; {room ($5B98)==$0C?
 $BC7D CP $0C          ;
 $BC7F RET NZ          ; }
 $BC80 LD A,(IX+$01)   ; {player Y==$48 or $46?
 $BC83 CP $48          ;
 $BC85 JR Z,$BC8A      ;
 $BC87 CP $46          ;
 $BC89 RET NZ          ; }
*$BC8A LD E,A          ; {player X in [$28,$34)?
 $BC8B LD A,(IX+$00)   ;
 $BC8E CP $34          ;
 $BC90 RET NC          ;
 $BC91 CP $28          ;
 $BC93 RET C           ; }
 $BC94 SET 7,(IX+$03)  ; arm flag (IX+3) bit7
 $BC98 LD A,($5C02)    ; get Frame counter
 $BC9B AND $01         ; {frame bit0: toggle Y=$46/$48
 $BC9D JR NZ,$BCAC     ; }
 $BC9F LD (IX+$01),$46 ; store Y=$46
 $BCA3 LD A,E          ; {restore Y=$48 unless already there
 $BCA4 CP $48          ;
 $BCA6 JR Z,$BCAC      ;
 $BCA8 LD (IX+$01),$48 ; }
*$BCAC LD A,($5C02)    ; get Frame counter
 $BCAF AND $03         ; {frame&3!=0? RET; else A=6
 $BCB1 RET NZ          ;
 $BCB2 LD A,$06        ; }
 $BCB4 LD ($5C06),A    ; {store room-state=6; read/inc counter (HL)
 $BCB7 LD A,(HL)       ;
 $BCB8 INC (HL)        ; }
 $BCB9 CP $0C          ; counter==$0C?
 $BCBB JP Z,$AE84      ; => Reset room state=0 and hazard counter ($5C07)
 $BCBE SUB $06         ; {counter-6; RET C if negative; C=A; compute 6-C
 $BCC0 RET C           ;
 $BCC1 LD C,A          ;
 $BCC2 LD A,$06        ;
 $BCC4 SUB C           ;
 $BCC5 LD L,A          ; }
 $BCC6 LD H,$00        ; {HL=(6-C)*32 (table row offset)
 $BCC8 ADD HL,HL       ;
 $BCC9 ADD HL,HL       ;
 $BCCA ADD HL,HL       ;
 $BCCB ADD HL,HL       ;
 $BCCC ADD HL,HL       ; }
 $BCCD LD DE,$F928     ; {HL += $F928 (sound-effect table); save HL; A=$98
 $BCD0 ADD HL,DE       ;
 $BCD1 PUSH HL         ;
 $BCD2 LD A,$98        ; }
 $BCD4 CALL $9A52      ; Write A to (HL)+$6000 (secondary buffer), then #R$9A62
                       ; dual-write loop
 $BCD7 POP HL          ; {restore HL, HL++; A=$99
 $BCD8 INC HL          ;
 $BCD9 LD A,$99        ; }
 $BCDB JP $9A52        ; => Write A to (HL)+$6000 (secondary buffer), then
                       ; #R$9A62 dual-write loop

; Negate 4-byte value ($5C18) via CPL chain, falls into #R$BD15 (add DE:BC=1)
;
; Used by the routine at #R$BD75.
c$BCDE LD A,(HL)     ; {negate 3 bytes (CPL each), HL-- between (unrolled)
 $BCDF CPL           ;
 $BCE0 LD (HL),A     ;
 $BCE1 DEC HL        ;
 $BCE2 LD A,(HL)     ;
 $BCE3 CPL           ;
 $BCE4 LD (HL),A     ;
 $BCE5 DEC HL        ;
 $BCE6 LD A,(HL)     ;
 $BCE7 CPL           ;
 $BCE8 LD (HL),A     ;
 $BCE9 DEC HL        ; }
 $BCEA LD A,(HL)     ; {negate last byte (CPL), no HL--
 $BCEB CPL           ;
 $BCEC LD (HL),A     ; }
 $BCED LD DE,$0001   ; {DE=1; JR into #R$BD15 (add path)
 $BCF0 JR $BD15      ; }

; Save all registers (context-save wrapper)
;
; Used by the routines at #R$8F47, #R$A851, #R$B4E2, #R$B5DD, #R$B9FA and
; #R$BB5D.
;
; DE score delta to add (passed through to #R$BD11)
c$BCF2 PUSH IX       ; {push main regs (IX,IY,HL,BC,AF)
 $BCF4 PUSH IY       ;
 $BCF6 PUSH HL       ;
 $BCF7 PUSH BC       ;
 $BCF8 PUSH AF       ; }
 $BCF9 EXX           ; {EXX; push alt regs (HL',BC',DE')
 $BCFA PUSH HL       ;
 $BCFB PUSH BC       ;
 $BCFC PUSH DE       ;
 $BCFD EXX           ; }
 $BCFE CALL $BD11    ; {Add 32-bit value ($5C18) by DE:BC
 $BD01 CALL $BD75    ; }
 $BD04 EXX           ; {EXX; pop alt regs; EXX; pop main regs
 $BD05 POP HL        ;
 $BD06 POP BC        ;
 $BD07 POP DE        ;
 $BD08 EXX           ;
 $BD09 POP AF        ;
 $BD0A POP BC        ;
 $BD0B POP HL        ;
 $BD0C POP IY        ;
 $BD0E POP IX        ; }
 $BD10 RET           ;

; Add 32-bit value ($5C18) by DE:BC (BC sign-extended from D)
;
; Used by the routine at #R$BCF2.
c$BD11 LD IX,$5C18   ; IX=$5C18 (target)
; This entry point is used by the routine at #R$BCDE.
*$BD15 LD BC,$FFFF   ; {BC = -1 if D negative, else 0 (sign-extend)
 $BD18 BIT 7,D       ;
 $BD1A JR NZ,$BD1F   ; }
 $BD1C LD BC,$0000   ;
*$BD1F LD L,(IX+$00) ; {HL=(IX+0/1) low word
 $BD22 LD H,(IX+$01) ; }
 $BD25 ADD HL,DE     ; {HL+=DE; store low word
 $BD26 LD (IX+$00),L ;
 $BD29 LD (IX+$01),H ; }
 $BD2C LD L,(IX+$02) ; {HL=(IX+2/3) high word
 $BD2F LD H,(IX+$03) ; }
 $BD32 ADC HL,BC     ; {HL+=BC with carry; store high word; RET
 $BD34 LD (IX+$02),L ;
 $BD37 LD (IX+$03),H ; }
 $BD3A RET           ;

; Print hi-score ($5B78) at screen $5049 via #R$BD78
;
; Used by the routine at #R$BD50.
c$BD3B LD HL,($BD89) ;
 $BD3E PUSH HL       ;
 $BD3F LD HL,$5B78   ;
 $BD42 LD ($BD89),HL ;
 $BD45 LD HL,$5049   ;
 $BD48 CALL $BD78    ;
 $BD4B POP HL        ;
 $BD4C LD ($BD89),HL ;
 $BD4F RET           ;

; New high-score check: compare $5C1B vs stored $5B7B, save if beaten
;
; Used by the routine at #R$8F47.
c$BD50 LD HL,$5C1B   ; {HL=candidate ($5C1B); already flagged (bit7) -> skip
 $BD53 BIT 7,(HL)    ;
 $BD55 RET NZ        ; }
 $BD56 LD DE,$5B7B   ; {DE=stored record ($5B7B); B=4 digits
 $BD59 LD B,$04      ; }
*$BD5B LD A,(DE)     ; {compare digit-by-digit (candidate vs stored), high
 $BD5C CP (HL)       ; digit first
 $BD5D JR C,$BD67    ;
 $BD5F JR Z,$BD62    ;
 $BD61 RET           ; }
*$BD62 DEC HL        ; {next digit (both pointers-- ); loop
 $BD63 DEC DE        ;
 $BD64 DJNZ $BD5B    ;
 $BD66 RET           ; }
*$BD67 LD HL,$5C18   ; {new record: copy 4 bytes $5C18 to $5B78, #R$BD3B
 $BD6A LD DE,$5B78   ;
 $BD6D LD BC,$0004   ;
 $BD70 LDIR          ;
 $BD72 JP $BD3B      ; }

; Print current score at screen $5029, falls into #R$BD78
;
; Used by the routine at #R$BCF2.
c$BD75 LD HL,$5029   ; {HL=$5029; save HL
; This entry point is used by the routine at #R$BD3B.
*$BD78 PUSH HL       ; }
 $BD79 LD B,$04      ; {B=4 (digit count); A=$20 (space, clear digits)
*$BD7B LD A,$20      ; }
 $BD7D CALL $90C6    ; Draw character bitmap
 $BD80 DJNZ $BD7B    ; {loop 4 spaces; restore HL
 $BD82 POP HL        ; }
 $BD83 EXX           ; {clear leading-zero flag ($5C20); HL=$5C18
 $BD84 XOR A         ;
 $BD85 LD ($5C20),A  ;
 $BD88 LD HL,$5C18   ; }
 $BD8B LD DE,$5C1C   ; {DE=$5C1C; BC=4; copy score to work buffer
 $BD8E LD BC,$0004   ;
 $BD91 LDIR          ; }
 $BD93 EX DE,HL      ; {swap; DEC HL; IX=$5C1C
 $BD94 DEC HL        ;
 $BD95 LD IX,$5C1C   ; }
 $BD99 BIT 7,(HL)    ; {sign bit set?
 $BD9B JR Z,$BDA2    ; }
 $BD9D CALL $BCDE    ; Negate 4-byte value ($5C18) via CPL chain, falls into
                     ; #R$BD15
 $BDA0 JR $BDA2      ; {skip negate; IY=$BE18 (digit-weight table)
*$BDA2 LD IY,$BE18   ; }
 $BDA6 LD B,$04      ; {B=4 digits; save BC
*$BDA8 PUSH BC       ; }
 $BDA9 LD C,$00      ; {C=0 (digit counter); DE:B=divisor from table; IY+=3
 $BDAB LD E,(IY+$00) ; (next entry)
 $BDAE LD D,(IY+$01) ;
 $BDB1 LD B,(IY+$02) ;
 $BDB4 INC IY        ;
 $BDB6 INC IY        ;
 $BDB8 INC IY        ; }
 $BDBA CALL $BDDF    ; Repeated-subtraction division
 $BDBD LD A,($5C20)  ; {leading-zero flag; digit!=0? skip
 $BDC0 OR A          ;
 $BDC1 LD A,C        ;
 $BDC2 JR NZ,$BDCA   ; }
 $BDC4 OR A          ; {else re-check leading-zero flag; set if digit=0
 $BDC5 JR Z,$BDD5    ;
 $BDC7 LD ($5C20),A  ; }
*$BDCA ADD A,$30     ; convert digit to ASCII
 $BDCC EXX           ; EXX
 $BDCD CALL $90C6    ; Draw character bitmap
 $BDD0 EXX           ; {EXX; restore BC
 $BDD1 POP BC        ; }
*$BDD2 DJNZ $BDA8    ; {loop 4 digits; RET
 $BDD4 RET           ; }
*$BDD5 POP BC        ; {restore BC; last digit (B==1)? force display
 $BDD6 LD A,B        ;
 $BDD7 CP $01        ;
 $BDD9 JR NZ,$BDD2   ;
 $BDDB DEC A         ; }
 $BDDC PUSH BC       ; {push BC; back to convert (force minimum one digit)
 $BDDD JR $BDCA      ; }

; Repeated-subtraction division: subtract DE from 32-bit (IX+0..3), C=count
;
; Used by the routine at #R$BD75.
c$BDDF LD L,(IX+$00) ; {HL = (IX+0)/(IX+1) (low word)
 $BDE2 LD H,(IX+$01) ;
 $BDE5 PUSH HL       ; }
 $BDE6 AND A         ; {subtract DE from HL, store back
 $BDE7 SBC HL,DE     ;
 $BDE9 LD (IX+$00),L ;
 $BDEC LD (IX+$01),H ; }
 $BDEF LD A,(IX+$02) ; {subtract borrow from (IX+2)
 $BDF2 PUSH AF       ;
 $BDF3 SBC A,B       ;
 $BDF4 LD (IX+$02),A ; }
 $BDF7 LD A,(IX+$03) ; {subtract borrow from (IX+3); stop if underflow
 $BDFA PUSH AF       ;
 $BDFB SBC A,$00     ;
 $BDFD LD (IX+$03),A ;
 $BE00 JR C,$BE08    ; }
 $BE02 POP AF        ; {no underflow: pop, C++, loop
 $BE03 POP AF        ;
 $BE04 POP HL        ;
 $BE05 INC C         ;
 $BE06 JR $BDDF      ; }
*$BE08 POP AF        ; {underflow: restore previous values, return
 $BE09 LD (IX+$03),A ;
 $BE0C POP AF        ;
 $BE0D LD (IX+$02),A ;
 $BE10 POP HL        ;
 $BE11 LD (IX+$01),H ;
 $BE14 LD (IX+$00),L ;
 $BE17 RET           ; }

