; Convert HL to attribute address (variant)
;
; Used by the routine at #R$91C0.
;
;   HL screen address
; O:HL attribute address (same third)
;
; Turns a screen pixel address into the matching color-attribute address - a
; different bit-twiddling method from #R$A293, used by the sparkle-effect
; drawing code.
c$92F0 LD A,H        ; {H AND $03
 $92F1 AND $03       ; }
 $92F3 LD H,A        ;
 $92F4 ADD HL,HL     ; <<3 (three ADD HL,HL)
 $92F5 ADD HL,HL     ;
 $92F6 ADD HL,HL     ;
 $92F7 LD A,H        ; A = H
 $92F8 ADD A,A       ; <<3 (three ADD A,A)
 $92F9 ADD A,A       ;
 $92FA ADD A,A       ;
 $92FB LD H,A        ; back into H
 $92FC RET           ;

