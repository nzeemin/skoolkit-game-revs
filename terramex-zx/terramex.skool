 $AC68 DEC A          ; }
*$AC69 BIT 1,E        ; {direction bit1 (left)?
 $AC6B JR Z,$AC7B     ; }
 $AC6D BIT 0,(IY+$00) ; blocked flag set? skip
 $AC71 JR NZ,$AC7B    ;
 $AC73 SUB $02        ; X-=2
 $AC75 CP $08         ; {X below 8?
 $AC77 JR NC,$AC7B    ; }
 $AC79 ADD A,$02      ; undo the -2
*$AC7B LD ($5C25),A   ; {store clamped X ($5C25, IX+0)
 $AC7E LD (IX+$00),A  ; }
*$AC81 LD A,($5B98)   ; A=room category ($5B98)
 $AC84 CP $06         ; {category 6?
 $AC86 JR Z,$AC8E     ; }
 $AC88 CP $07         ; {category 7?
 $AC8A JR Z,$AC95     ; }
 $AC8C JR $ACC4       ;
*$AC8E LD A,$08       ; {status=8
 $AC90 LD ($5C06),A   ; }
 $AC93 JR $AC9A       ;
*$AC95 LD A,$07       ; {status=7
 $AC97 LD ($5C06),A   ; }
*$AC9A LD A,(IX+$01)  ; {Y-1
 $AC9D DEC A          ; }
 $AC9E CP $18         ; {Y still >= $18? skip level change
 $ACA0 JR NC,$ACB1    ; }
 $ACA2 LD C,A         ;
 $ACA3 LD A,($5C01)   ; get Current room number
 $ACA6 CP $03         ; room 3?
 $ACA8 LD A,C         ;
 $ACA9 JR Z,$ACB8     ;
 $ACAB CALL $A69B     ; Move up a level
 $ACAE LD A,(IX+$01)  ; reload Y
*$ACB1 LD (IX+$01),A  ; {store Y and $5C26
 $ACB4 LD ($5C26),A   ; }
 $ACB7 RET            ;
*$ACB8 LD A,($5C06)   ; {status already 8? RET
 $ACBB CP $08         ; }
 $ACBD RET Z          ;
 $ACBE LD A,$09       ; {else status=9
 $ACC0 LD ($5C06),A   ; }
 $ACC3 RET            ;
*$ACC4 LD A,(IY+$03)  ; {(IY+3) set?
 $ACC7 OR A           ; }
 $ACC8 JR Z,$ACEF     ;
 $ACCA LD A,(IX+$01)  ; {Y+=2
 $ACCD ADD A,$02      ; }
 $ACCF LD (IX+$01),A  ; {store, reload Y
 $ACD2 LD A,(IX+$01)  ; }
 $ACD5 CP $66         ; {if <$66, skip level-down
 $ACD7 JR C,$ACE8     ; }
 $ACD9 PUSH IX        ; push IX
 $ACDB CALL $A6AE     ; Move down a level
 $ACDE POP IX         ;
 $ACE0 LD A,(IX+$01)  ; {Y+=$18 (wrap below)
 $ACE3 ADD A,$18      ; }
 $ACE5 LD (IX+$01),A  ;
*$ACE8 LD A,(IX+$01)  ; A=Y
 $ACEB LD ($5C26),A   ; store $5C26
 $ACEE RET            ;
*$ACEF LD A,(IX+$01)  ; {store Y ($5C26) alt path
 $ACF2 LD ($5C26),A   ; }
 $ACF5 LD A,E         ; {direction bits, none set? RET
 $ACF6 AND $03        ; }
 $ACF8 RET Z          ;
 $ACF9 AND $02        ; {bit1 set? branch $AD0B
 $ACFB JR NZ,$AD0B    ; }
 $ACFD LD A,(IX+$00)  ; {X+=2
 $AD00 ADD A,$02      ; }
 $AD02 CP $E7         ; {past $E7? RET
 $AD04 RET NC         ; }
 $AD05 LD (IX+$00),A  ;
 $AD08 JP $AE84       ; => Set hero status ($5C06), clear hazard timer ($5C07)
*$AD0B LD A,(IX+$00)  ; {X-=2
 $AD0E SUB $02        ; }
 $AD10 RET C          ; below 0? RET
 $AD11 LD (IX+$00),A  ;
 $AD14 JP $AE84       ; => Set hero status ($5C06), clear hazard timer ($5C07)

; Creature Y-=4; move up a level via #R$A69B if off-screen, else trigger event
; 2
;
; .
;
; .
;
; Moves a creature up four pixels, changing level if that takes it off the top
; of the screen, and otherwise fires a status trigger.
c$AD17 POP HL        ;
 $AD18 LD A,(IX+$01) ;
 $AD1B DEC A         ; Y -= 4 (four DEC A)
 $AD1C DEC A         ;
 $AD1D DEC A         ;
 $AD1E DEC A         ;
 $AD1F JP M,$A69B    ; => Move up a level
 $AD22 LD (IX+$01),A ; store new Y
 $AD25 CALL $A102    ; Clear a 4-byte record at $A0FE
 $AD28 LD A,(IY+$03) ; {already triggered? ((IY+3))
 $AD2B OR A          ; }
 $AD2C RET NZ        ;
 $AD2D LD A,$02      ; status=2
 $AD2F JP $AE85      ;

; Creature trap-entry: room $5B98 check, move X by direction bits (E)
;
; .
;
; .
;
; Fixed-track obstacle from the same family as #R$AC35, but gated by room
; category rather than by the hazard timer: outside category $0A it just flags
; the object and resets it to status 0. Inside it, the object walks 2px per
; frame in its current direction and flips direction at the screen edges
; instead of crossing into the next room.
c$AD32 POP HL         ;
 $AD33 LD A,($5B98)   ; {room category ($5B98)==$0A?
 $AD36 CP $0A         ; }
 $AD38 JR Z,$AD42     ;
 $AD3A LD A,$02       ; {no: store $5C03=2
 $AD3C LD ($5C03),A   ; }
 $AD3F JP $AE84       ; => Set hero status ($5C06), clear hazard timer ($5C07)
*$AD42 LD A,$1D       ; {(IX+2)=$1D
 $AD44 LD (IX+$02),A  ; }
 $AD47 BIT 0,E        ; {direction bit0 (right)?
 $AD49 JR Z,$AD5B     ; }
 $AD4B LD A,(IX+$00)  ; {X+=2
 $AD4E ADD A,$02      ; }
 $AD50 CP $E7         ; {past $E7? skip
 $AD52 JR NC,$AD5B    ; }
 $AD54 SET 7,(IX+$03) ; set direction flag
 $AD58 LD (IX+$00),A  ; store X
*$AD5B BIT 1,E        ; {direction bit1 (left)?
 $AD5D JR Z,$AD6F     ; }
 $AD5F LD A,(IX+$00)  ; {X-=2
 $AD62 SUB $02        ; }
 $AD64 CP $04         ; {below 4? skip
 $AD66 JR C,$AD6F     ; }
 $AD68 RES 7,(IX+$03) ; clear direction flag
 $AD6C LD (IX+$00),A  ; store X
*$AD6F BIT 3,E        ; {direction bit3 (down)?
 $AD71 JR Z,$AD8B     ; }
 $AD73 LD A,(IX+$01)  ; {Y-=2
 $AD76 DEC A          ; }
 $AD77 JP M,$AD82     ; off-screen? branch $AD82
 $AD7A DEC A          ; Y-=2 again
 $AD7B JP M,$AD82     ;
 $AD7E LD (IX+$01),A  ; store Y
 $AD81 RET            ;
*$AD82 LD A,($5C01)   ; get Current room number
 $AD85 CP $08         ; {room==8? RET Z
 $AD87 RET Z          ; }
 $AD88 JP $A69B       ; => Move up a level
*$AD8B BIT 2,E        ; {direction bit2 (up)? RET Z
 $AD8D RET Z          ; }
 $AD8E LD A,(IX+$01)  ; {Y+=2
 $AD91 ADD A,$02      ; }
 $AD93 LD C,A         ;
 $AD94 LD A,($5C01)   ; get Current room number
 $AD97 CP $14         ; room==$14?
 $AD99 LD A,C         ;
 $AD9A JR NZ,$ADA3    ;
 $AD9C CP $57         ; {Y<$57? else RET NC
 $AD9E RET NC         ; }
 $AD9F LD (IX+$01),C  ; store Y
 $ADA2 RET            ;
*$ADA3 CP $67         ; Y>=$67?
 $ADA5 JP NC,$A6AE    ; => Move down a level
 $ADA8 LD (IX+$01),A  ; store Y
 $ADAB RET            ;

; Creature update: Y-state via #R$AE76, hazard-timer++, room-cross via
; #R$A671/#R$A640
;
; .
;
; .
;
; A patrolling creature that walks off one side of the room and reappears in
; the next, stepping left or right each frame according to a direction flag.
; Its Y position follows a pre-authored curve, and the whole thing resets once
; the hazard counter runs out.
c$ADAC POP HL        ;
 $ADAD LD DE,$AE8D   ; DE=Y-position table ($AE8D)
 $ADB0 CALL $AE76    ; Look up a table by hazard counter ($5C07), store into
 $ADB3 LD HL,$5C07   ;
 $ADB6 LD A,(HL)     ;
 $ADB7 INC (HL)      ; hazard counter++
 $ADB8 CP $11        ; {counter==$11 (sequence end)?
 $ADBA JR NZ,$ADC7   ; }
 $ADBC LD A,(IX+$01) ; {snap Y down to tile boundary
 $ADBF AND $F8       ; }
 $ADC1 LD (IX+$01),A ;
 $ADC4 JP $AE84      ; => Set hero status ($5C06), clear hazard timer ($5C07)
*$ADC7 CALL $AE37    ; Creature Y-bound check via #R$AF09/table $AE9E, move up
                     ; via #R$A69B or clamp
 $ADCA LD A,($5C08)  ;
 $ADCD LD E,A        ;
 $ADCE AND $03       ; {no direction set? RET
 $ADD0 RET Z         ; }
 $ADD1 BIT 0,E       ; {bit0 set? move right
 $ADD3 JR Z,$AE06    ; }
 $ADD5 LD A,(IX+$00) ;
 $ADD8 INC A         ;
 $ADD9 INC A         ;
 $ADDA CP $E7        ; {X past right edge ($E7)?
 $ADDC JR C,$ADEC    ; }
 $ADDE PUSH IX       ;
 $ADE0 PUSH IY       ;
 $ADE2 CALL $A671    ; Move right
 $ADE5 POP IY        ;
 $ADE7 POP IX        ;
 $ADE9 LD A,(IX+$00) ;
*$ADEC LD L,(IX+$00) ;
 $ADEF LD H,(IX+$01) ;
 $ADF2 LD (IX+$00),A ;
 $ADF5 PUSH HL       ;
 $ADF6 CALL $A102    ; Clear a 4-byte record at $A0FE
 $ADF9 LD A,(IY+$01) ;
 $ADFC POP HL        ;
 $ADFD OR A          ; {flag set? keep new position
 $ADFE RET Z         ; }
 $ADFF LD (IX+$00),L ;
 $AE02 LD (IX+$01),H ;
 $AE05 RET           ;
*$AE06 LD A,(IX+$00) ;
 $AE09 DEC A         ; {X at left edge?
 $AE0A JR Z,$AE0F    ; }
 $AE0C DEC A         ;
 $AE0D JR NZ,$AE1D   ;
*$AE0F PUSH IX       ;
 $AE11 PUSH IY       ;
 $AE13 CALL $A640    ; Move left
 $AE16 POP IY        ;
 $AE18 POP IX        ;
 $AE1A LD A,(IX+$00) ;
*$AE1D LD L,(IX+$00) ;
 $AE20 LD H,(IX+$01) ;
 $AE23 LD (IX+$00),A ;
 $AE26 PUSH HL       ;
 $AE27 CALL $A102    ; Clear a 4-byte record at $A0FE
 $AE2A LD A,(IY+$00) ;
 $AE2D POP HL        ;
 $AE2E OR A          ;
 $AE2F RET Z         ;
 $AE30 LD (IX+$00),L ;
 $AE33 LD (IX+$01),H ;
 $AE36 RET           ;

; Creature Y-bound check via #R$AF09/table $AE9E, move up via #R$A69B or clamp
;
; Used by the routine at #R$ADAC.
;
; .
;
; Keeps a creature within its allowed vertical range, either nudging it up a
; level or clamping it at a per-room boundary.
c$AE37 CALL $AF09      ; Type-$10 gate
 $AE3A LD L,A          ;
 $AE3B LD H,$00        ;
 $AE3D LD BC,$AE9E     ;
 $AE40 ADD HL,BC       ;
 $AE41 LD A,(IX+$01)   ;
 $AE44 SUB (HL)        ;
 $AE45 JP P,$AE54      ;
 $AE48 PUSH IX         ;
 $AE4A PUSH IY         ;
 $AE4C CALL $A69B      ; Move up a level
 $AE4F POP IY          ;
 $AE51 POP IX          ;
 $AE53 RET             ;
*$AE54 CP $68          ;
 $AE56 JR NC,$AE6A     ;
 $AE58 LD (IX+$01),A   ;
 $AE5B CALL $A102      ; Clear a 4-byte record at $A0FE
 $AE5E LD A,(IY+$03)   ;
 $AE61 OR A            ;
 $AE62 RET NZ          ;
 $AE63 LD (IX+$02),$02 ;
 $AE67 JR $AE84        ; => Set hero status ($5C06), clear hazard timer ($5C07)

; Data block at AE69
b$AE69 DEFB $C9,$DD,$E5,$FD,$E5,$CD,$AE,$A6
 $AE71 DEFB $FD,$E1,$DD,$E1,$C9

; Look up a table by hazard counter ($5C07), store into (IX+2)
;
; Used by the routine at #R$ADAC.
;
; DE lookup table base
; IX creature object (frame stored at +2)
;
; Picks this frame's animation frame for a creature from a per-trap table,
; indexed by how far the hazard timer has advanced.
c$AE76 LD A,($5C07)  ;
 $AE79 PUSH HL       ;
 $AE7A LD L,A        ; {HL = table + counter
 $AE7B LD H,$00      ; }
 $AE7D ADD HL,DE     ;
 $AE7E LD A,(HL)     ; A = table entry
 $AE7F LD (IX+$02),A ; store as creature frame
 $AE82 POP HL        ;
 $AE83 RET           ;

; Set hero status ($5C06), clear hazard timer ($5C07) ($AE84: status=0; $AE85:
; status=A)
;
; Used by the routines at #R$A34B, #R$A851, #R$A8EA, #R$A9A1, #R$AA3C, #R$AA6F,
; #R$AC35, #R$AD32, #R$ADAC, #R$AE37, #R$B370, #R$B409 and #R$BC73.
;
; .
;
; The single choke point for changing the hero's status: every scripted
; trigger, hazard, and reset in the game passes through here to set the new
; status and restart the hazard clock.
c$AE84 XOR A         ;
; This entry point is used by the routines at #R$91C0, #R$935D, #R$A102,
; #R$A3E1, #R$AA3C, #R$AD17, #R$AF81, #R$B02E, #R$B03B, #R$B370, #R$B4E2,
; #R$B562, #R$B6EE, #R$B704, #R$B784 and #R$C0AC.
*$AE85 LD ($5C06),A  ;
 $AE88 XOR A         ;
 $AE89 LD ($5C07),A  ;
 $AE8C RET           ;

; Y-position table, indexed by hazard counter (#R$AE76)
b$AE8D DEFB $0C,$0C,$0D,$0D,$0E,$0E,$0E,$0E
 $AE95 DEFB $0E,$0F,$0F,$0F,$0F,$0F,$0F,$02
 $AE9D DEFB $02,$04,$03,$03,$03,$02,$02,$01
 $AEA5 DEFB $00,$00,$00,$FF,$FE,$FE,$FD,$FD
 $AEAD DEFB $FD,$FC

; Store scripted-zone list pointer ($AEED) from HL
;
; Used by the routine at #R$A3E1.
c$AEAF LD ($AEED),HL ;
 $AEB2 RET           ;

; Data block at AEB3
b$AEB3 DEFB $2A,$ED,$AE,$7C,$B5,$C8

; Scripted-zone list step: $FF ends list, else store trigger code, advance
; $AEED
;
; Used by the routine at #R$A3E1.
;
; .
;
; Reads the next entry of a scripted-zone list and applies it to the creature,
; stopping and clearing the list pointer when it hits the end marker.
c$AEB9 LD A,(HL)     ;
 $AEBA CP $FF        ; {$FF end-of-list marker?
 $AEBC JR NZ,$AEC5   ; }
 $AEBE LD HL,$0000   ;
 $AEC1 LD ($AEED),HL ;
 $AEC4 RET           ;
*$AEC5 LD (IX+$02),A ; store step as creature frame
 $AEC8 INC HL        ; {advance list pointer
 $AEC9 LD ($AEED),HL ; }
 $AECC RET           ;

; Scripted-zone step list (loaded by #R$AEAF)
b$AECD DEFB $02,$02,$04,$04,$05,$05,$04,$04
 $AED5 DEFB $02,$02,$06,$06,$02,$02,$04,$04
 $AEDD DEFB $05,$05,$04,$04,$02,$02,$06,$06
 $AEE5 DEFB $02,$04,$05,$04,$02,$06,$02,$FF
 $AEED DEFB $00,$00

; Decode room number ($5C01) to row/col
;
; Used by the routines at #R$A640, #R$A671, #R$A69B and #R$A6AE.
;
; O:B row
; O:C col
;
; Divmod by 12: B=row (quotient), C=col (remainder). Rooms are numbered
; row*12+col, i.e. 12 rooms per horizontal row (matches the player-drawn map's
; row width).
c$AEEF LD A,($5C01)  ;
 $AEF2 LD B,$FF      ;
*$AEF4 INC B         ;
 $AEF5 SUB $0C       ;
 $AEF7 JR NC,$AEF4   ;
 $AEF9 ADD A,$0C     ;
 $AEFB LD C,A        ;
 $AEFC RET           ;

; Encode row/col to room number
;
; Used by the routines at #R$A640, #R$A671, #R$A69B and #R$A6AE.
;
; B row
; C col
;
; room = B*12 + C. Stores result to ($5C01).
c$AEFD INC B         ;
 $AEFE LD A,$F4      ;
*$AF00 ADD A,$0C     ;
 $AF02 DJNZ $AF00    ;
 $AF04 ADD A,C       ;
 $AF05 LD ($5C01),A  ; set Current room number
 $AF08 RET           ;

; Type-$10 gate: proximity check via #R$AF22, move down a level if room-state 2
;
; Used by the routine at #R$AE37.
;
; .
;
; For one particular creature type, drops the hero to the level below if they
; are close enough and the game is in the right state.
c$AF09 CP $10        ;
 $AF0B RET NZ        ;
 $AF0C EX AF,AF'     ;
 $AF0D CALL $AF22    ; Proximity check
 $AF10 JR C,$AF20    ;
 $AF12 LD A,($5C06)  ;
 $AF15 CP $02        ;
 $AF17 JR NZ,$AF20   ;
 $AF19 LD SP,($AF39) ;
 $AF1D JP $A6AE      ; => Move down a level
*$AF20 EX AF,AF'     ;
 $AF21 RET           ;

; Proximity check: player X vs pointer ($5BA2) column
;
; Used by the routines at #R$9A09 and #R$AF09.
;
; .
;
; Checks whether the hero is horizontally close to a specific tracked position
; - a lighter-weight proximity test than #R$9140, used for a single X-only
; check.
c$AF22 LD HL,($5BA2) ; HL = tracked pointer ($5BA2)
 $AF25 LD A,H        ; {null?
 $AF26 OR L          ; }
 $AF27 SCF           ; {yes: carry set, RET
 $AF28 RET Z         ; }
 $AF29 LD A,L        ; {keep the column bits
 $AF2A AND $1F       ; }
 $AF2C ADD A,A       ; column *= 8 (three ADD A,A)
 $AF2D ADD A,A       ;
 $AF2E ADD A,A       ;
 $AF2F LD L,A        ; back into L
 $AF30 LD A,($5B04)  ; A = player X ($5B04)
 $AF33 SUB L         ; distance from the target
 $AF34 RET C         ; behind it? RET
 $AF35 CP $08        ; {within 8 pixels? (result in carry)
 $AF37 CCF           ; }
 $AF38 RET           ;

; Saved stack pointer (trap-entry mechanism)
b$AF39 DEFB $00,$00

; Scripted zone trigger: set special-encounter flag ($5C06)
;
; Used by the routine at #R$A3E1.
;
; .
;
; Checks whether the hero has just entered a room with a scripted encounter
; and, if so, kicks off the associated status trigger.
c$AF3B LD HL,$5C01   ; {HL=$5C01, A=current room
 $AF3E LD A,(HL)     ; }
 $AF3F CP $1D        ; {room $1D? use alt check
 $AF41 JR Z,$AF64    ; }
 $AF43 LD A,($5C27)  ; A = scripted room ($5C27)
 $AF46 CP (HL)       ; {matches current? else RET
 $AF47 RET NZ        ; }
 $AF48 LD A,($5C26)  ; {target Y ($5C26) minus player Y
 $AF4B SUB (IX+$01)  ; }
 $AF4E ADD A,$02     ; centre the window
 $AF50 CP $04        ; {within 4 pixels?
 $AF52 RET NC        ; }
 $AF53 LD A,($5C25)  ; {same test for X ($5C25)
 $AF56 SUB (IX+$00)  ; }
 $AF59 ADD A,$02     ;
 $AF5B CP $04        ; {within 4 pixels?
 $AF5D RET NC        ; }
 $AF5E LD A,$07      ; {status=7
 $AF60 LD ($5C06),A  ; }
 $AF63 RET           ;
*$AF64 BIT 1,E       ; {alt: skip unless left pressed
 $AF66 RET Z         ; }
 $AF67 LD A,(IX+$01) ; {player Y == $48?
 $AF6A CP $48        ; }
 $AF6C RET NZ        ;
 $AF6D LD A,(IX+$00) ; {player X >= $1C?
 $AF70 CP $1C        ; }
 $AF72 RET C         ;
 $AF73 CP $20        ; {and below $20?
 $AF75 RET NC        ; }
 $AF76 LD A,$1E      ; {snap player X to $1E
 $AF78 LD (IX+$00),A ; }
 $AF7B LD A,$0D      ; {status=$0D
 $AF7D LD ($5C06),A  ; }
 $AF80 RET           ;

; Room-entry trigger: check position/input for a special zone
;
; Used by the routine at #R$8F47.
;
; IX hero object (position at +0/+1)
;
; Watches for the hero standing in one particular spot in one particular room
; and pressing up or down, firing a scripted event when they do - one of
; several small "stand here and press a key" puzzle triggers.
c$AF81 LD A,$24      ; {frame $24 -> $5B14
 $AF83 LD ($5B14),A  ; }
 $AF86 LD A,($5B9F)  ; {$5B9F -> $5B15
 $AF89 LD ($5B15),A  ; }
 $AF8C SUB $08       ; A -= 8
 $AF8E CP (IX+$01)   ; {matches player Y?
 $AF91 JR NZ,$AFD1   ; }
 $AF93 LD A,(IX+$00) ; {player X >= $12?
 $AF96 CP $12        ; }
 $AF98 JR C,$AFD1    ;
 $AF9A CP $38        ; {and below $38?
 $AF9C JR NC,$AFD1   ; }
 $AF9E PUSH AF       ;
 $AF9F XOR A         ; {clear $5BA0
 $AFA0 LD ($5BA0),A  ; }
 $AFA3 POP AF        ;
 $AFA4 CP $1A        ; {player Y >= $1A?
 $AFA6 JR C,$AFD1    ; }
 $AFA8 CP $30        ; {and below $30?
 $AFAA JR NC,$AFD1   ; }
 $AFAC LD A,($5C06)  ; {status ($5C06) zero?
 $AFAF OR A          ; }
 $AFB0 JR Z,$AFBA    ;
 $AFB2 CP $13        ; {or $13?
 $AFB4 JR Z,$AFBA    ; }
 $AFB6 CP $14        ; {or $14? else skip
 $AFB8 JR NZ,$AFD1   ; }
*$AFBA CALL $B87D    ; Resolve conflicting L/R, U/D input via #R$B894
 $AFBD BIT 2,E       ; {down pressed?
 $AFBF JR Z,$AFC8    ; }
 $AFC1 LD A,$14      ; status=$14
 $AFC3 CALL $AE85    ; Set hero status ($5C06), clear hazard timer ($5C07)
 $AFC6 JR $AFD1      ;
*$AFC8 BIT 3,E       ; {up pressed? else skip
 $AFCA JR Z,$AFD1    ; }
 $AFCC LD A,$13      ; {trigger $13 via #R$AE85
 $AFCE CALL $AE85    ; }
*$AFD1 LD A,$9F      ; {$5B16=$9F
 $AFD3 LD ($5B16),A  ; }
 $AFD6 RET           ;

; Init a room-specific decorative object ($5B10-$5B17) by room category
;
; .
;
; .
;
; Sets up a decorative object whose look depends on which room the hero is in -
; only runs for the one room it's scripted for.
c$AFD7 LD HL,$5C01   ; {scripted room ($5C27) vs current
 $AFDA LD A,($5C27)  ; }
 $AFDD CP (HL)       ; {no match? RET
 $AFDE RET NZ        ; }
 $AFDF LD A,($5C06)  ; {status $12?
 $AFE2 CP $12        ; }
 $AFE4 RET Z         ;
 $AFE5 CP $1A        ; {or $1A? RET
 $AFE7 RET Z         ; }
 $AFE8 LD A,($5C25)  ; A = base X ($5C25)
 $AFEB LD ($5B14),A  ; {store to $5B14 and $5B10
 $AFEE LD ($5B10),A  ; }
 $AFF1 LD A,($5C26)  ; {A = base Y ($5C26), store $5B15
 $AFF4 LD ($5B15),A  ; }
 $AFF7 SUB $10       ; {Y-16 -> $5B11
 $AFF9 LD ($5B11),A  ; }
 $AFFC LD A,($5C06)  ; A = status
 $AFFF LD C,$99      ; C=$99 (default sprite)
 $B001 CP $07        ; {category 7?
 $B003 JR Z,$B00F    ; }
 $B005 CP $08        ; {category 8?
 $B007 JR Z,$B00F    ; }
 $B009 CP $09        ; {category 9?
 $B00B JR Z,$B00F    ; }
 $B00D JR $B020      ; else default
*$B00F PUSH AF       ;
 $B010 LD C,$24      ; C=$24
 $B012 LD A,($5B07)  ; A = frame ($5B07)
 $B015 LD ($5B17),A  ; {store to $5B17 and $5B13
 $B018 LD ($5B13),A  ; }
 $B01B POP AF        ;
 $B01C CP $09        ; {category 9? use $B02A
 $B01E JR Z,$B02A    ; }
*$B020 LD A,$9A      ; {sprite id $9A -> $5B12
*$B022 LD ($5B12),A  ; }
 $B025 LD A,C        ; {C -> $5B16
 $B026 LD ($5B16),A  ; }
 $B029 RET           ;
*$B02A LD A,$7F      ; {category 9: A=$7F, JR back to store
 $B02C JR $B022      ; }

; Check ENTER key (port $FBFE), trigger state $0A via #R$AE85
;
; Used by the routine at #R$A3E1.
c$B02E LD BC,$FBFE   ;
 $B031 IN A,(C)      ;
 $B033 AND $10       ;
 $B035 RET NZ        ;
