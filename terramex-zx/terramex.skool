 $B038 JP $AE85      ;

; Scripted zone trigger by room+position table ($B073)
;
; Used by the routine at #R$A3E1.
;
; .
;
; Checks the hero's position against a small table of room+position hotspots
; and fires a one-shot scripted event when they step into one.
c$B03B LD B,$03      ; B=3 entries
 $B03D LD HL,$B073   ; HL=$B073 (hotspot table)
 $B040 LD A,($5C01)  ; get Current room number
*$B043 CP (HL)       ; {room matches entry?
 $B044 JR Z,$B050    ; }
 $B046 INC HL        ; next entry (stride 3)
 $B047 INC HL        ;
 $B048 INC HL        ;
 $B049 DJNZ $B043    ; loop
*$B04B XOR A         ; {no match: clear one-shot flag ($B072)
 $B04C LD ($B072),A  ; }
 $B04F RET           ;
*$B050 INC HL        ;
 $B051 LD A,(IX+$01) ; {player Y matches entry?
 $B054 CP (HL)       ; }
 $B055 JR NZ,$B04B   ;
 $B057 INC HL        ;
 $B058 LD C,(HL)     ; {C = entry X threshold
 $B059 LD A,(IX+$00) ; }
 $B05C CP C          ; {player X below it? skip
 $B05D JR C,$B04B    ; }
 $B05F PUSH AF       ;
 $B060 LD A,C        ; {C = threshold + 8
 $B061 ADD A,$08     ; }
 $B063 LD C,A        ; keep it
 $B064 POP AF        ;
 $B065 CP C          ; {player X past it? skip
 $B066 JR NC,$B04B   ; }
 $B068 LD A,($B072)  ; {already triggered ($B072)?
 $B06B OR A          ; }
 $B06C RET NZ        ;
 $B06D LD A,$16      ; status=$16
 $B06F JP $AE85      ; Set hero status ($5C06), clear hazard timer ($5C07)

