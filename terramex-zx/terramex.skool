; input bitmask (#R$B894/#R$B87D) into a direction bitmask (E) and a velocity
; pair (BC, persisted at $5C34 between frames rather than recomputed from
; scratch each time). Before committing a Y move, checks #R$A1D3 to see whether
; the destination tile is blocked and flips the velocity's sign if so (a
; bounce/reject rather than a hard stop). Updates the hero's direction flag
; ((IX+3) bit7) from the resulting velocity's sign, applies the X/Y deltas to
; the position, and - only when X crosses 4 - hands off to the room-edge
; handler at #R$A640. This is the routine that actually moves the hero object;
; #R$A3E1 is the outer per-frame driver that calls it.
c$A34B POP AF          ;
 $A34C CALL $AE84      ;
 $A34F LD (IX+$02),$1A ;
 $A353 CALL $A102      ; Clear a 4-byte record at $A0FE
 $A356 CALL $B87D      ; Resolve conflicting L/R, U/D input via #R$B894
 $A359 LD E,A          ; {E=direction bitmask, BC=velocity ($5C34)
 $A35A LD BC,($5C34)   ; }
 $A35E BIT 0,E         ;
 $A360 JR Z,$A369      ;
 $A362 INC C           ;
 $A363 LD A,C          ;
 $A364 CP $04          ;
 $A366 JR NZ,$A369     ;
 $A368 DEC C           ;
*$A369 BIT 1,E         ;
 $A36B JR Z,$A374      ;
 $A36D DEC C           ;
 $A36E LD A,C          ;
 $A36F CP $FC          ;
 $A371 JR NZ,$A374     ;
 $A373 INC C           ;
*$A374 BIT 2,E         ;
 $A376 JR Z,$A37F      ;
 $A378 INC B           ;
 $A379 LD A,B          ;
 $A37A CP $04          ;
 $A37C JR NZ,$A37F     ;
 $A37E DEC B           ;
*$A37F BIT 3,E         ;
 $A381 JR Z,$A38A      ;
 $A383 DEC B           ;
 $A384 LD A,B          ;
 $A385 CP $FC          ;
 $A387 JR NZ,$A38A     ;
 $A389 INC B           ;
*$A38A BIT 7,C         ;
 $A38C JR NZ,$A39A     ;
 $A38E BIT 0,(IY+$01)  ;
 $A392 JR Z,$A3A4      ;
 $A394 LD A,C          ;
 $A395 NEG             ;
 $A397 LD C,A          ;
 $A398 JR $A3A4        ;
*$A39A BIT 0,(IY+$00)  ;
 $A39E JR Z,$A3A4      ;
 $A3A0 LD A,C          ;
 $A3A1 NEG             ;
 $A3A3 LD C,A          ;
*$A3A4 BIT 7,B         ;
 $A3A6 JR NZ,$A3B4     ;
 $A3A8 LD A,(IY+$03)   ; {resolve Y-velocity sign (blocked check via #R$A1D3)
 $A3AB OR A            ;
 $A3AC JR NZ,$A3BD     ;
 $A3AE LD A,B          ;
 $A3AF NEG             ;
 $A3B1 LD B,A          ;
 $A3B2 JR $A3BD        ;
*$A3B4 CALL $A1D3      ;
 $A3B7 JR NZ,$A3BD     ;
 $A3B9 LD A,B          ;
 $A3BA NEG             ;
 $A3BC LD B,A          ; }
*$A3BD LD ($5C34),BC   ; store velocity ($5C34)
 $A3C1 RES 7,(IX+$03)  ; {update direction flag (IX+3) from velocity sign
 $A3C5 BIT 7,C         ;
 $A3C7 JR NZ,$A3CD     ;
 $A3C9 SET 7,(IX+$03)  ; }
*$A3CD LD A,B          ; {Y+=B (IX+1), X+=C (IX+0)
 $A3CE ADD A,(IX+$01)  ;
 $A3D1 LD (IX+$01),A   ;
 $A3D4 LD A,C          ;
 $A3D5 ADD A,(IX+$00)  ;
 $A3D8 LD (IX+$00),A   ; }
 $A3DB CP $04          ; {if X>=4, jump to room-edge handler #R$A640
 $A3DD RET NC          ;
 $A3DE JP $A640        ; }

; Main per-frame player update: input, movement, room-state/hazard dispatch
;
; Used by the routine at #R$8F47.
;
; .
;
; Called once per frame for the hero object (IX=$5B04). Runs, in order:
; per-room init dispatch (once per room load), a scripted-zone list step
; (triggers tied to fixed room+position combinations, e.g. $B073's table), the
; resolved-input read (#R$B894/#R$B87D) feeding into #R$A34B for movement and
; room-edge crossing (right/left/up/down handlers), a room-state dispatch
; indexed by $5C06 (#R$A6CC), the ENTER-key confirm check (port $FBFE, sets
; $5C06=$0A), and the sound-effect dispatcher. The large tail (roughly
; $A457-$A640) is a long chain of hardcoded room+tile+position checks that
; force specific $5C06 values - see Actors.md's status-code table for what's
; known about each. This is the busiest routine in the disassembly (264
; instructions) and the natural place to look first for any hero-behavior
; question not already answered elsewhere.
