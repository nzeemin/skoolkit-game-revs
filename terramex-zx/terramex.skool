; Set up the current room (called right after every room-number change)
;
; Used by the routines at #R$8F47, #R$935D, #R$A640, #R$A671, #R$A69B, #R$A6AE,
; #R$A8EA and #R$B6EE.
;
; A room number
;
; Room-entry entry point, reached after every write of a new room number.
; Applies two per-room special cases (one forced state value, one table-driven
; call), then falls through into #R$9880 to do the actual room setup.
c$9855 PUSH AF       ;
 $9856 CALL $BE42    ; Decode room's creatures/hazards from the room data table
 $9859 CP $2C        ;
 $985B JR NZ,$9863   ;
 $985D LD HL,$FF02   ;
 $9860 LD ($5C34),HL ;
*$9863 LD HL,$9AF5   ;
*$9866 BIT 7,(HL)    ;
 $9868 JR NZ,$9877   ;
 $986A CP (HL)       ;
 $986B JR Z,$9870    ;
 $986D INC HL        ;
 $986E JR $9866      ;
*$9870 LD A,($5C05)  ;
 $9873 OR A          ;
 $9874 CALL Z,$9AA1  ; Snapshot current room/position into respawn staging
*$9877 POP AF        ;
 $9878 PUSH IX       ;
 $987A CALL $9880    ; Per-room setup
 $987D POP IX        ;
 $987F RET           ;

; Per-room setup (tileset select, hazard tuning, lift init)
;
; Used by the routine at #R$9855.
;
; A room number
;
; Per-room setup run on every room entry: looks the room up in the list at
; $9AC6 and swaps the tile set (#R$918D) so the flag matches, builds the tile
; background (#R$9914), initializes the sparkle/animation command list for
; whichever tile set is now loaded, and resets the per-room counters. A couple
; of rooms get extra treatment - one adjusts a tuning value, another populates
; a 12-entry table that looks like moving-lift setup.
c$9880 PUSH AF       ;
 $9881 LD HL,$9AC6   ; HL=alternate-tileset room list ($9AC6)
 $9884 LD B,$0F      ;
*$9886 CP (HL)       ;
 $9887 JR Z,$9895    ;
 $9889 INC HL        ;
 $988A DJNZ $9886    ;
 $988C LD A,($918C)  ;
 $988F OR A          ;
 $9890 CALL NZ,$918D ; not listed: make sure the base tileset is loaded
 $9893 JR $989C      ;
*$9895 LD A,($918C)  ;
 $9898 OR A          ;
 $9899 CALL Z,$918D  ; listed: make sure the alternate tileset is loaded
*$989C POP AF        ;
 $989D PUSH AF       ;
 $989E LD HL,$0000   ;
 $98A1 LD ($5BA2),HL ;
 $98A4 CALL $9914    ; Build room background from its back-tile map
 $98A7 LD HL,$9AD5   ;
 $98AA LD DE,$9AD6   ;
 $98AD LD BC,$001F   ;
 $98B0 LD (HL),$00   ;
 $98B2 LDIR          ;
 $98B4 LD C,$B5      ;
 $98B6 LD A,($918C)  ;
 $98B9 OR A          ;
 $98BA JR Z,$98BE    ;
 $98BC LD C,$DD      ; C=$DD for the alternate tileset
*$98BE LD A,C        ;
 $98BF LD DE,$9AD5   ;
 $98C2 CALL $9A8C    ; Find all tile-map ($F800) positions matching A, store
                     ; coords list at DE
 $98C5 LD A,($918C)  ;
 $98C8 OR A          ;
 $98C9 JR Z,$98D3    ;
 $98CB LD DE,$9AE5   ;
 $98CE LD A,$8C      ;
 $98D0 CALL $9A8C    ; Find all tile-map ($F800) positions matching A, store
                     ; coords list at DE
*$98D3 XOR A         ;
 $98D4 LD ($5C0C),A  ;
 $98D7 LD ($5C41),A  ;
 $98DA LD ($5BA1),A  ;
 $98DD INC A         ;
 $98DE LD ($B072),A  ;
 $98E1 POP AF        ;
 $98E2 CP $10        ;
 $98E4 JR NZ,$98ED   ;
 $98E6 PUSH AF       ;
 $98E7 LD A,$06      ; {room $10: $A6F5=6
 $98E9 LD ($A6F5),A  ; }
 $98EC POP AF        ;
*$98ED CP $1C        ;
 $98EF JR NZ,$9907   ;
 $98F1 LD A,($5C24)  ;
 $98F4 OR A          ;
 $98F5 JR Z,$9907    ;
 $98F7 LD B,$0C      ;
 $98F9 LD HL,$F808   ;
*$98FC LD (HL),$98   ; {lift table entries point to $9998
 $98FE INC HL        ; }
 $98FF LD (HL),$99   ;
 $9901 LD DE,$001F   ; lift table stride = 31 bytes
 $9904 ADD HL,DE     ;
 $9905 DJNZ $98FC    ;
*$9907 XOR A         ; {clear $5C24
 $9908 LD ($5C24),A  ; }
 $990B CALL $917C    ; Init $5B0A/$5B0E/$5B12/$5B16 to $007F
 $990E CALL $99A4    ; Blit the room's tile-index map ($F800) onto the real
                     ; screen
 $9911 JP $B93F      ; => Reset object slots ($5C0E), scan $B99D table for
                     ; current room

; Build room background from its back-tile map
;
; Used by the routine at #R$9880.
;
; A room number
;
; Builds the room's tile-index map: reads the room's 32-byte list of back-tile
; indices at $D600, expands each back-tile through its 4x4 definition at $C600,
; and writes the resulting 32x16 map of 8x8 tile indices to $F800. Back-tile
; index $10 is special-cased. The bitmaps those indices resolve to live at
; ($5B72)=$F000, 8 bytes per tile, with the upper half swappable between two
; tile sets by #R$918D.
c$9914 LD L,A        ; {HL=A (room number, zero-extended)
 $9915 LD H,$00      ; }
 $9917 ADD HL,HL     ; room *= 32 (five ADD HL,HL)
 $9918 ADD HL,HL     ;
 $9919 ADD HL,HL     ;
 $991A ADD HL,HL     ;
 $991B ADD HL,HL     ;
 $991C LD DE,$D600   ; {HL = back-tile index list ($D600 + room*32)
 $991F ADD HL,DE     ; }
 $9920 LD B,$04      ; {B=4 rows, IX=room tile-index map ($F800)
 $9922 LD IX,$F800   ; }
*$9926 PUSH BC       ; save row counter
 $9927 PUSH IX       ; save row base (IX)
 $9929 LD B,$08      ; B=8 columns
*$992B PUSH BC       ;
 $992C LD A,(HL)     ; {C = back-tile index
 $992D LD C,A        ; }
 $992E PUSH HL       ;
 $992F LD L,A        ; {HL = back-tile index
 $9930 LD H,$00      ; }
 $9932 ADD HL,HL     ; index *= 16 (four ADD HL,HL)
 $9933 ADD HL,HL     ;
 $9934 ADD HL,HL     ;
 $9935 ADD HL,HL     ;
 $9936 LD DE,$C600   ; {HL = back-tile definition ($C600 + back_tile_index*16)
 $9939 ADD HL,DE     ; }
 $993A LD A,C        ; {back-tile $10?
 $993B CP $10        ; }
 $993D CALL Z,$99F0  ; yes: special case #R$99F0
 $9940 LD A,(HL)     ; {copy first sub-tile index
 $9941 LD (IX+$00),A ; }
 $9944 INC HL        ;
 $9945 LD A,(HL)     ; 15 more, unrolled into IX offsets $01-$63
 $9946 LD (IX+$01),A ;
 $9949 INC HL        ;
 $994A LD A,(HL)     ;
 $994B LD (IX+$02),A ;
 $994E INC HL        ;
 $994F LD A,(HL)     ;
 $9950 LD (IX+$03),A ;
 $9953 INC HL        ;
 $9954 LD A,(HL)     ;
 $9955 LD (IX+$20),A ;
 $9958 INC HL        ;
 $9959 LD A,(HL)     ;
 $995A LD (IX+$21),A ;
 $995D INC HL        ;
 $995E LD A,(HL)     ;
 $995F LD (IX+$22),A ;
 $9962 INC HL        ;
 $9963 LD A,(HL)     ;
 $9964 LD (IX+$23),A ;
 $9967 INC HL        ;
 $9968 LD A,(HL)     ;
 $9969 LD (IX+$40),A ;
 $996C INC HL        ;
 $996D LD A,(HL)     ;
 $996E LD (IX+$41),A ;
 $9971 INC HL        ;
 $9972 LD A,(HL)     ;
 $9973 LD (IX+$42),A ;
 $9976 INC HL        ;
 $9977 LD A,(HL)     ;
 $9978 LD (IX+$43),A ;
 $997B INC HL        ;
 $997C LD A,(HL)     ;
 $997D LD (IX+$60),A ;
 $9980 INC HL        ;
 $9981 LD A,(HL)     ;
 $9982 LD (IX+$61),A ;
 $9985 INC HL        ;
 $9986 LD A,(HL)     ;
 $9987 LD (IX+$62),A ;
 $998A INC HL        ;
 $998B LD A,(HL)     ;
 $998C LD (IX+$63),A ;
 $998F POP HL        ; {restore def pointer, advance
 $9990 INC HL        ; }
 $9991 LD BC,$0004   ; {IX += 4 (next column)
 $9994 ADD IX,BC     ; }
 $9996 POP BC        ; {loop 8 columns
 $9997 DJNZ $992B    ; }
 $9999 POP IX        ; restore row base
 $999B LD BC,$0080   ; {IX += $80 (next row)
 $999E ADD IX,BC     ; }
 $99A0 POP BC        ; {loop 4 rows
 $99A1 DJNZ $9926    ; }
 $99A3 RET           ; RET

; Blit the room's tile-index map ($F800) onto the real screen
;
; Used by the routine at #R$9880.
;
; .
;
; HL counts 0-511 (32x16 tile positions, matching the $F800 map size - loop
; exit checks BIT 1,H, i.e. stops once H=2). For each tile: reads the tile
; index from ($F800+HL), looks it up in a 256-byte table at $DF00 to get an
; attribute byte, writes that to the attribute file ($5800 + ...); then looks
; up an 8-byte bitmap at ($5B72)+tile_index*8 and copies it to the real screen
; bitmap address, one byte per pixel row (INC D each line - standard
; screen-third stride).
c$99A4 LD HL,$0000   ; HL=0 (tile counter 0-511)
 $99A7 LD DE,$F800   ; DE=$F800 (tile map)
*$99AA PUSH HL       ; {save HL/DE (for attr calc + tile index)
 $99AB PUSH DE       ; }
 $99AC LD A,H        ;
 $99AD OR $58        ; {HL = attribute address ($5800 + ...)
 $99AF LD H,A        ; }
 $99B0 LD A,(DE)     ; A = tile index
 $99B1 PUSH AF       ;
 $99B2 PUSH HL       ;
 $99B3 LD L,A        ; {HL = index
 $99B4 LD H,$00      ; }
 $99B6 LD BC,$DF00   ; {HL = $DF00 + index
 $99B9 ADD HL,BC     ; }
 $99BA LD A,(HL)     ; A = attribute byte
 $99BB POP HL        ;
 $99BC LD (HL),A     ; store attribute byte
 $99BD LD A,H        ; {H AND $03
 $99BE AND $03       ; }
 $99C0 RLCA          ; <<3 (three RLCA)
 $99C1 RLCA          ;
 $99C2 RLCA          ;
 $99C3 OR $40        ; {OR $40 (screen base)
 $99C5 LD H,A        ; }
 $99C6 POP AF        ; restore A (tile index)
 $99C7 PUSH HL       ;
 $99C8 LD L,A        ; {HL = index
 $99C9 LD H,$00      ; }
 $99CB ADD HL,HL     ; index *= 8 (three ADD HL,HL)
 $99CC ADD HL,HL     ;
 $99CD ADD HL,HL     ;
 $99CE LD DE,($5B72) ; DE = bitmap base ($5B72)
 $99D2 ADD HL,DE     ; {HL += DE (bitmap source)
 $99D3 POP DE        ; }
 $99D4 LD C,E        ; {C = screen low byte
 $99D5 LD A,D        ; }
 $99D6 OR $E0        ; {B = screen high OR $E0 (secondary buffer)
 $99D8 LD B,A        ; }
 $99D9 EX AF,AF'     ;
 $99DA LD A,$08      ; A=8 (rows)
*$99DC EX AF,AF'     ;
 $99DD LD A,(HL)     ; read the bitmap byte
 $99DE LD (DE),A     ; {write to both buffers
 $99DF LD (BC),A     ; }
 $99E0 INC D         ; {advance both to next pixel row
 $99E1 INC B         ; }
 $99E2 INC HL        ;
 $99E3 EX AF,AF'     ;
 $99E4 DEC A         ; {loop 8 rows
 $99E5 JR NZ,$99DC   ; }
 $99E7 POP DE        ; {next tile-map byte
 $99E8 INC DE        ; }
 $99E9 POP HL        ; {next screen cell
 $99EA INC HL        ; }
 $99EB BIT 1,H       ; {all 512 done? (H=2)
 $99ED JR Z,$99AA    ; }
 $99EF RET           ;

; Set redraw pointers ($5BA2=IX+$6020, $5BA4=HL+4) for #R$9A2F
;
; Used by the routine at #R$9914.
;
; HL screen address for the second pointer
; IX object address for the first pointer
;
; Works out the two screen pointers the dual-buffer redraw needs, one for each
; buffer, from the object and screen addresses handed in.
c$99F0 PUSH HL       ; save HL/IX/DE
 $99F1 PUSH IX       ;
 $99F3 PUSH DE       ;
 $99F4 LD DE,$6020   ; DE=$6020
 $99F7 ADD IX,DE     ; {IX += DE, store to $5BA2
 $99F9 LD ($5BA2),IX ; }
 $99FD LD DE,$0004   ; DE=4
 $9A00 ADD HL,DE     ; {HL += DE, store to $5BA4
 $9A01 LD ($5BA4),HL ; }
 $9A04 POP DE        ; restore DE/IX/HL
 $9A05 POP IX        ;
 $9A07 POP HL        ;
 $9A08 RET           ;

; Gated call to #R$9A2F, room/hazard-timer dependent
;
; Used by the routine at #R$9B22.
;
; .
;
; Redraws a room's dual-buffered animation only when the room and hazard timer
; are in the right state - avoids redrawing it every frame unnecessarily.
c$9A09 CALL $AF22    ; {Proximity check
 $9A0C RET C         ; }
 $9A0D LD A,($5C06)  ; A = status ($5C06)
 $9A10 CP $02        ; {status 2? use that path
 $9A12 JR Z,$9A1F    ; }
 $9A14 CP $03        ; {else room ($5C06) must be 3
 $9A16 RET NZ        ; }
 $9A17 LD A,($5C07)  ; A = hazard timer ($5C07)
 $9A1A CP $08        ; {below 8? RET
 $9A1C RET NC        ; }
 $9A1D JR $9A25      ; else draw
*$9A1F LD A,($5C07)  ; A = hazard timer ($5C07)
 $9A22 CP $08        ; {8 or more? RET
 $9A24 RET C         ; }
*$9A25 PUSH BC       ; save BC/HL/DE
 $9A26 PUSH HL       ;
 $9A27 PUSH DE       ;
 $9A28 CALL $9A2F    ; Dual-buffer redraw: 2x4 grid, each cell via #R$9A62
 $9A2B POP DE        ;
 $9A2C POP HL        ;
 $9A2D POP BC        ;
 $9A2E RET           ;

; Dual-buffer redraw: 2x4 grid, each cell via #R$9A62
;
; Used by the routine at #R$9A09.
;
; .
;
; Redraws a 2x4 block of cells into both screen buffers, used to refresh a
; small animated area without redrawing the whole room.
c$9A2F LD HL,($5BA2) ; HL = pointer ($5BA2)
 $9A32 LD A,H        ; {null pointer?
 $9A33 OR L          ; }
 $9A34 RET Z         ;
 $9A35 LD DE,($5BA4) ; DE = pointer ($5BA4)
 $9A39 LD B,$02      ; B=2 outer rows
*$9A3B PUSH BC       ; {save BC/HL
 $9A3C PUSH HL       ; }
 $9A3D LD B,$04      ; B=4 inner cells
*$9A3F CALL $9A62    ; {inner loop x4 via #R$9A62
 $9A42 DJNZ $9A3F    ; }
 $9A44 POP HL        ; restore address
 $9A45 LD BC,$0020   ; {advance a row ($20 bytes)
 $9A48 ADD HL,BC     ; }
 $9A49 POP BC        ; {loop 2 rows
 $9A4A DJNZ $9A3B    ; }
 $9A4C RET           ;

; Write A to (HL), DE=HL, fall into #R$9A62 dual-write loop
;
; Used by the routines at #R$91C0 and #R$B7A3.
;
; A byte to write (attribute or pixel value)
; HL screen/attribute address
;
; A small draw primitive: writes one byte to the screen and mirrors it through
; the shared dual-buffer/attribute write path.
c$9A4D PUSH HL       ;
 $9A4E POP DE        ;
 $9A4F LD (HL),A     ;
 $9A50 JR $9A62      ;

; Write A to (HL)+$6000 (secondary buffer), then #R$9A62 dual-write loop
;
; Used by the routines at #R$91C0, #R$BA97 and #R$BC73.
;
; A byte to write
; HL screen address (primary buffer; +$6000 = secondary)
;
; A small draw primitive: writes one byte to both the visible screen and its
; off-screen secondary copy, used wherever the game needs to place a single
; tile/icon on screen and keep the two buffers in sync.
c$9A52 PUSH HL       ; {DE = HL
 $9A53 POP DE        ; }
 $9A54 LD (HL),A     ; write A to the primary buffer
 $9A55 PUSH BC       ;
 $9A56 LD BC,$6000   ; {HL += $6000 (secondary buffer)
 $9A59 ADD HL,BC     ; }
 $9A5A POP BC        ;
 $9A5B LD C,$40      ; C=$40 (screen page)
 $9A5D CALL $9A64    ;
 $9A60 DEC L         ; {step both pointers back one
 $9A61 DEC DE        ; }
; This entry point is used by the routines at #R$9A2F and #R$9A4D.
*$9A62 LD C,$E0      ; C=$E0 (alt attribute page)
*$9A64 PUSH HL       ; {save HL/BC
 $9A65 PUSH BC       ; }
 $9A66 PUSH DE       ;
 $9A67 LD A,H        ; {H AND $03
 $9A68 AND $03       ; }
 $9A6A RLCA          ; <<3 (three RLCA)
 $9A6B RLCA          ;
 $9A6C RLCA          ;
 $9A6D OR C          ; {OR C (page base)
 $9A6E LD H,A        ; }
 $9A6F PUSH HL       ; push HL (save attribute address)
 $9A70 LD A,(DE)     ; {A = tile index
 $9A71 LD L,A        ; }
 $9A72 LD H,$00      ; zero-extend into HL
 $9A74 ADD HL,HL     ; index *= 8 (three ADD HL,HL)
 $9A75 ADD HL,HL     ;
 $9A76 ADD HL,HL     ;
 $9A77 LD DE,($5B72) ; {DE = bitmap base ($5B72)
 $9A7B ADD HL,DE     ; }
 $9A7C EX DE,HL      ; {swap, restore screen address
 $9A7D POP HL        ; }
 $9A7E LD B,$08      ; B=8 rows
*$9A80 LD A,(DE)     ; {copy one bitmap row
 $9A81 LD (HL),A     ; }
 $9A82 INC H         ; {advance both
 $9A83 INC DE        ; }
 $9A84 DJNZ $9A80    ; loop 8 rows
 $9A86 POP DE        ; {restore DE, advance
 $9A87 INC DE        ; }
 $9A88 POP BC        ; {restore BC/HL
 $9A89 POP HL        ; }
 $9A8A INC L         ; advance to next cell
 $9A8B RET           ;

; Find all tile-map ($F800) positions matching A, store coords list at DE
;
; Used by the routine at #R$9880.
;
;   A tile index to search for
;   DE destination coords-list address
; O:DE past the last coord pair written
;
; Scans the whole room for every tile of a given type and builds a list of
; where they are - used to find all copies of a specific animated tile so they
; can be redrawn together.
c$9A8C LD BC,$01FF   ; {BC=$1FF bytes, HL=$F800
 $9A8F LD HL,$F800   ; }
*$9A92 CPIR          ; {search for a matching tile
 $9A94 RET PO        ; }
 $9A95 PUSH AF       ;
 $9A96 DEC HL        ; {back up to the match
 $9A97 LD A,L        ; }
 $9A98 LD (DE),A     ; store the column
 $9A99 INC DE        ; {store the row
 $9A9A LD A,H        ; }
 $9A9B LD (DE),A     ;
 $9A9C INC DE        ; advance the output
 $9A9D INC HL        ; {step past the match
 $9A9E POP AF        ; }
 $9A9F JR $9A92      ; keep searching

; Snapshot current room/position into respawn staging ($5C2B-$5C32)
;
; Used by the routines at #R$8F47 and #R$9855.
;
; .
;
; Records where the hero currently is - room, status, position - so that if
; they die shortly after, #R$9090 can respawn them back in the same spot rather
; than restarting the room.
c$9AA1 LD A,($5C01)  ; {room ($5C01) -> $5C2D
 $9AA4 LD ($5C2D),A  ; }
 $9AA7 LD A,($5C06)  ; {save status ($5C06)
 $9AAA LD ($5C2B),A  ; }
 $9AAD LD A,($5C07)  ; A = hazard counter ($5C07)
 $9AB0 LD ($5C2C),A  ;
 $9AB3 LD HL,($5B04) ; {player X/Y ($5B04) -> $5C2E
 $9AB6 LD ($5C2E),HL ; }
 $9AB9 LD HL,($5B06) ; {($5B06) -> $5C30
 $9ABC LD ($5C30),HL ; }
 $9ABF LD HL,($5B9E) ; {($5B9E) -> $5C32
 $9AC2 LD ($5C32),HL ; }
 $9AC5 RET           ; RET

; Rooms that use the alternate tileset (15 entries, read by #R$9880)
b$9AC6 DEFB $12,$1E,$1F,$20,$2B,$2C,$37,$38
 $9ACE DEFB $39,$3A,$3B,$3C,$43,$44,$45

; Per-room command/animation list (31 bytes)
b$9AD5 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $9ADD DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $9AE5 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $9AED DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $9AF5 DEFB $00,$01,$09,$08,$07,$13,$14,$15
 $9AFD DEFB $17,$0C,$0D,$0E,$04,$12,$18,$19
 $9B05 DEFB $1A,$1B,$1F,$21,$22,$23,$26,$27
 $9B0D DEFB $28,$29,$2A,$2C,$30,$31,$32,$33
 $9B15 DEFB $34,$35,$36,$38,$39,$3A,$3B,$3D
 $9B1D DEFB $3E,$40,$44,$45,$FF

; Per-frame update for 5 party slots ($5B04): plot pixel, screen addr, sprite
; frame init, redraw
;
; Used by the routine at #R$8F47.
;
; .
;
; Main per-frame draw/update pump, called by #R$9018's loop. Walks the 5
; world-object slots ($5B04 - hero plus up to 4 creatures/hazards, see
; Actors.md) twice: once to cache each slot's screen address and plot routine,
; once to run the slot's animation-frame init chain. Then erases last frame's
; sprites from saved background, redraws the sprites, and adds the sparkle and
; party-slot overlays.
c$9B22 LD IX,$5B04    ;
 $9B26 LD B,$05       ;
*$9B28 PUSH BC        ;
 $9B29 LD L,(IX+$00)  ;
 $9B2C LD H,(IX+$01)  ;
 $9B2F CALL $9CEE     ; Compute screen address (BC) + pick plot routine (IY)
                      ; for pixel HL
 $9B32 PUSH IY        ;
 $9B34 POP HL         ;
 $9B35 LD (IX+$42),L  ;
 $9B38 LD (IX+$43),H  ;
 $9B3B LD (IX+$40),C  ;
 $9B3E LD (IX+$41),B  ;
 $9B41 INC IX         ;
 $9B43 INC IX         ;
 $9B45 INC IX         ;
 $9B47 INC IX         ;
 $9B49 POP BC         ;
 $9B4A DJNZ $9B28     ;
 $9B4C LD IX,$5B04    ;
 $9B50 LD B,$05       ;
*$9B52 PUSH BC        ;
 $9B53 LD A,(IX+$02)  ;
 $9B56 LD L,A         ;
 $9B57 LD H,$00       ;
 $9B59 ADD HL,HL      ;
 $9B5A ADD HL,HL      ;
 $9B5B ADD HL,HL      ;
 $9B5C PUSH HL        ;
 $9B5D ADD HL,HL      ;
 $9B5E ADD HL,HL      ;
 $9B5F ADD HL,HL      ;
 $9B60 POP DE         ;
 $9B61 ADD HL,DE      ;
 $9B62 LD DE,$6000    ;
 $9B65 ADD HL,DE      ;
 $9B66 EX DE,HL       ;
 $9B67 LD H,$FE       ;
 $9B69 EXX            ;
 $9B6A LD C,(IX+$40)  ;
 $9B6D LD B,(IX+$41)  ;
 $9B70 LD L,(IX+$42)  ;
 $9B73 LD H,(IX+$43)  ;
 $9B76 PUSH HL        ;
 $9B77 POP IY         ;
 $9B79 BIT 7,(IX+$03) ;
 $9B7D JR NZ,$9B99    ;
 $9B7F LD HL,$0000    ;
 $9B82 LD ($9C82),HL  ;
 $9B85 LD ($9C87),HL  ;
 $9B88 PUSH BC        ;
 $9B89 CALL $9C6A     ; Reset alt BC, run init chain
 $9B8C POP BC         ;
 $9B8D INC C          ;
 $9B8E PUSH BC        ;
 $9B8F CALL $9C6A     ; Reset alt BC, run init chain
 $9B92 POP BC         ;
 $9B93 INC C          ;
 $9B94 CALL $9C6A     ; Reset alt BC, run init chain
 $9B97 JR $9BB3       ;
*$9B99 LD HL,$7E6F    ;
 $9B9C LD ($9C82),HL  ;
 $9B9F LD ($9C87),HL  ;
 $9BA2 INC C          ;
 $9BA3 INC C          ;
 $9BA4 PUSH BC        ;
 $9BA5 CALL $9C6A     ; Reset alt BC, run init chain
 $9BA8 POP BC         ;
 $9BA9 DEC C          ;
 $9BAA PUSH BC        ;
 $9BAB CALL $9C6A     ; Reset alt BC, run init chain
 $9BAE POP BC         ;
 $9BAF DEC C          ;
 $9BB0 CALL $9C6A     ; Reset alt BC, run init chain
*$9BB3 POP BC         ;
 $9BB4 LD A,B         ;
 $9BB5 CP $05         ;
 $9BB7 CALL Z,$9A09   ; Gated call to #R$9A2F, room/hazard-timer dependent
 $9BBA INC IX         ;
 $9BBC INC IX         ;
 $9BBE INC IX         ;
 $9BC0 INC IX         ;
 $9BC2 DJNZ $9B52     ;
 $9BC4 CALL $9DE3     ; Draw active object sprites
 $9BC7 LD IX,$5AE4    ; IX=$5AE4: erase at last frame's cached addresses
                      ; ($5B24)
 $9BCB CALL $9BEB     ; Restore saved background under object (5 slots), via
                      ; #R$9DBF for row wrap
 $9BCE LD IX,$5B04    ; IX=$5B04: erase at this frame's ($5B44)
 $9BD2 CALL $9BEB     ; Restore saved background under object (5 slots), via
                      ; #R$9DBF for row wrap
 $9BD5 LD HL,$5B44    ; {copy this frame's draw cache down to $5B24
 $9BD8 LD DE,$5B24    ; }
 $9BDB LD BC,$0020    ; {32 bytes (5 slots x 4, plus slack)
 $9BDE LDIR           ; }
 $9BE0 LD IX,$5B04    ;
 $9BE4 CALL $92BD     ; Draw sparkle/effect list at $9AE5, alternate-tileset
                      ; variant, via #R$92D6
 $9BE7 CALL $9D3C     ; Draw a tile-based graphic for each of 5 party-slots at
                      ; $5B04
 $9BEA RET            ;

; Restore saved background under object (5 slots), via #R$9DBF for row wrap
;
; Used by the routine at #R$9B22.
;
; IX first object-slot base (stride 4, 5 slots); only (IX+$40)/(IX+$41) are
; .  read
;
; Erases 5 objects by copying background tiles back over the screen address
; cached at +$40/+41 of each slot. The copy alternates LDI- and LDD-based
; directions down the object's height so a sprite straddling a screen-third
; boundary is restored without an explicit branch. #R$9B22 calls it twice per
; frame, with IX=$5AE4 to clear the previous frame's positions ($5B24) and
; IX=$5B04 for this frame's ($5B44); +$40/+41 are the only fields it touches.
; The $9BF3 entry skips the slot loop for erasing a single object.
c$9BEB LD B,$05      ; B=5 slots
*$9BED LD L,(IX+$40) ; {HL = cached screen address ((IX+$40)/(IX+$41))
 $9BF0 LD H,(IX+$41) ; }
; This entry point is used by the routine at #R$9D21.
*$9BF3 LD A,H        ; {mask H to a screen address
 $9BF4 AND $5F       ; }
 $9BF6 LD D,A        ; {D/E = that address
 $9BF7 LD E,L        ; }
 $9BF8 PUSH BC       ;
 $9BF9 LD B,$04      ; B=4 sub-rows
*$9BFB PUSH BC       ;
 $9BFC LD BC,$07F0   ; BC=$07F0 (row-wrap test constant)
 $9BFF LDI           ; copy background bytes (LDI chain)
 $9C01 LDI           ;
 $9C03 LDI           ;
 $9C05 LD A,(HL)     ; {copy the fourth
 $9C06 LD (DE),A     ; }
 $9C07 INC H         ; {both pointers to the next pixel row
 $9C08 INC D         ; }
 $9C09 LD A,H        ; {crossed a char row?
 $9C0A AND B         ; }
 $9C0B CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C0E LDD           ;
 $9C10 LDD           ;
 $9C12 LDD           ;
 $9C14 LD A,(HL)     ;
 $9C15 LD (DE),A     ;
 $9C16 INC H         ;
 $9C17 INC D         ;
 $9C18 LD A,H        ;
 $9C19 AND B         ;
 $9C1A CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C1D LDI           ;
 $9C1F LDI           ;
 $9C21 LDI           ;
 $9C23 LD A,(HL)     ;
 $9C24 LD (DE),A     ;
 $9C25 INC H         ;
 $9C26 INC D         ;
 $9C27 LD A,H        ;
 $9C28 AND B         ;
 $9C29 CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C2C LDD           ;
 $9C2E LDD           ;
 $9C30 LDD           ;
 $9C32 LD A,(HL)     ;
 $9C33 LD (DE),A     ;
 $9C34 INC H         ;
 $9C35 INC D         ;
 $9C36 LD A,H        ;
 $9C37 AND B         ;
 $9C38 CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C3B LDI           ;
 $9C3D LDI           ;
 $9C3F LDI           ;
 $9C41 LD A,(HL)     ;
 $9C42 LD (DE),A     ;
 $9C43 INC H         ;
 $9C44 INC D         ;
 $9C45 LD A,H        ;
 $9C46 AND B         ;
 $9C47 CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C4A LDD           ;
 $9C4C LDD           ;
 $9C4E LDD           ;
 $9C50 LD A,(HL)     ;
 $9C51 LD (DE),A     ;
 $9C52 INC H         ;
 $9C53 INC D         ;
 $9C54 LD A,H        ;
 $9C55 AND B         ;
 $9C56 CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C59 POP BC        ; restore BC
 $9C5A DJNZ $9BFB    ; loop 4 sub-rows
 $9C5C INC IX        ; IX += 4 (next slot)
 $9C5E INC IX        ;
 $9C60 INC IX        ;
 $9C62 INC IX        ;
 $9C64 POP BC        ; restore BC
 $9C65 DEC B         ; {loop 5 slots
 $9C66 JP NZ,$9BED   ; }
 $9C69 RET           ; RET

; Reset alt BC, run init chain (#R$9C72/$9C75/$9C78/$9C7E)
;
; Used by the routine at #R$9B22.
;
;   DE packed data pointer
;   IY dispatch address (JP (IY) tail-call)
; O:DE advanced by 2
;
; Reads a packed command from a data stream and jumps to the matching drawing
; handler - a small interpreter used to play back the sparkle/effect animation
; lists elsewhere in the code.
c$9C6A EXX           ;
 $9C6B LD BC,$0000   ; clear the alt BC
 $9C6E EXX           ;
 $9C6F CALL $9C72    ;
*$9C72 CALL $9C75    ;
*$9C75 CALL $9C78    ;
*$9C78 CALL $9C7E    ;
 $9C7B CALL $9C7E    ;
*$9C7E LD H,$FF      ; {H'=$FF (mask init, alt regs)
 $9C80 EXX           ; }
 $9C81 LD A,(DE)     ; read the first data byte
 $9C82 NOP           ;
 $9C83 NOP           ;
 $9C84 INC DE        ; {advance, keep it in B
 $9C85 LD B,A        ; }
 $9C86 LD A,(DE)     ; read the second
 $9C87 NOP           ;
 $9C88 NOP           ;
 $9C89 OR B          ; {fold both into A
 $9C8A OR C          ; }
 $9C8B LD C,B        ; keep the first in C
 $9C8C EXX           ;
 $9C8D LD L,A        ; {D = byte from the alt table
 $9C8E LD D,(HL)     ; }
 $9C8F EXX           ;
 $9C90 LD A,B        ; {A = the other byte
 $9C91 EXX           ; }
 $9C92 LD L,A        ; L = A
 $9C93 LD A,H        ; {A = H, step H on
 $9C94 INC H         ; }
 $9C95 JP (IY)       ; jump to the handler

; Plot-routine jump table (indexed by screen third)
b$9C97 DEFB $29,$CB,$32,$17

; Build sub-pixel blend mask, plot into (BC); DOWN BC char-row fixup
;
; .
;
; .
;
; Plots a sprite column whose X position isn't a multiple of 8. Rotates the
; sprite byte through a mask 7 times to split it across the two character cells
; it straddles, then blends the two halves onto the screen with AND/OR so
; existing pixels survive, wrapping at char-row and screen-third boundaries as
; it walks down. Whole-byte-aligned sprites take the faster path in #R$9DE3.
c$9C9B ADD HL,HL     ; {rotate one bit into D/HL (sub-pixel shift)
 $9C9C SLL D         ; }
 $9C9E RLA           ;
 $9C9F ADD HL,HL     ; six more shift-rotates (builds the 8-bit mask)
 $9CA0 SLL D         ;
 $9CA2 RLA           ;
 $9CA3 ADD HL,HL     ;
 $9CA4 SLL D         ;
 $9CA6 RLA           ;
 $9CA7 ADD HL,HL     ;
 $9CA8 SLL D         ;
 $9CAA RLA           ;
 $9CAB ADD HL,HL     ;
 $9CAC SLL D         ;
 $9CAE RLA           ;
 $9CAF ADD HL,HL     ;
 $9CB0 SLL D         ;
 $9CB2 RLA           ;
 $9CB3 ADD HL,HL     ;
 $9CB4 SLL D         ;
 $9CB6 RLA           ;
 $9CB7 LD E,A        ; {E = mask, read screen byte
 $9CB8 LD A,(BC)     ; }
 $9CB9 AND E         ; {blend with the mask
 $9CBA OR H          ; }
 $9CBB LD (BC),A     ;
 $9CBC INC C         ; {next screen byte
 $9CBD LD A,(BC)     ; }
 $9CBE AND D         ; {blend with the mask
 $9CBF OR L          ; }
 $9CC0 LD (BC),A     ;
 $9CC1 DEC C         ; step back
; This entry point is used by the routine at #R$9CE7.
*$9CC2 INC B         ; {next pixel row
 $9CC3 LD A,B        ; }
 $9CC4 AND $07       ; {crossed a char row?
 $9CC6 RET NZ        ; }
 $9CC7 DEC B         ; {back up one row
 $9CC8 LD A,C        ; }
 $9CC9 CPL           ; {at the right-hand edge?
 $9CCA AND $E0       ; }
 $9CCC JR Z,$9CD7    ;
 $9CCE LD A,C        ;
 $9CCF ADD A,$20     ; {column += $20
 $9CD1 LD C,A        ; }
 $9CD2 LD A,B        ;
 $9CD3 AND $F8       ; {mask row bits
 $9CD5 LD B,A        ; }
 $9CD6 RET           ;
*$9CD7 LD A,C        ;
 $9CD8 AND $1F       ; wrap column to $00-$1F
 $9CDA LD C,A        ;
 $9CDB LD A,B        ;
 $9CDC AND $F8       ; {row += 8 (next screen third)
 $9CDE ADD A,$08     ; }
 $9CE0 LD B,A        ;
 $9CE1 BIT 4,A       ; {past the bottom?
 $9CE3 RET Z         ; }
 $9CE4 LD B,$E0      ; clamp to $E0
 $9CE6 RET           ;

; Write A to (BC), fall into #R$9CC2 char-row fixup
c$9CE7 LD A,(BC)     ;
 $9CE8 AND D         ;
 $9CE9 OR L          ;
 $9CEA LD (BC),A     ;
 $9CEB JP $9CC2      ;

; Compute screen address (BC) + pick plot routine (IY) for pixel HL
;
; Used by the routines at #R$9B22, #R$9D21 and #R$9DE3.
;
;   HL pixel position (X in L, Y in H)
; O:BC screen byte address for that pixel
; O:IY plot-routine address for the pixel's sub-column
;
; Works out where a given pixel lands on screen and which of the
; sub-pixel-aligned plot routines to use to draw it - the shared setup step
; before any sprite/mask drawing.
c$9CEE LD A,L        ; {save the X coordinate
 $9CEF PUSH AF       ; }
 $9CF0 RRCA          ; X >>= 3 (three RRCA)
 $9CF1 RRCA          ;
 $9CF2 RRCA          ;
 $9CF3 AND $1F       ; {keep 5 bits
 $9CF5 LD C,A        ; }
 $9CF6 LD A,H        ; {H AND $7F
 $9CF7 AND $7F       ; }
 $9CF9 RLCA          ; {<<2
 $9CFA RLCA          ; }
 $9CFB AND $E0       ; keep the row bits
 $9CFD OR C          ; {merge with the column
 $9CFE LD C,A        ; }
 $9CFF LD A,H        ; {B = screen third
 $9D00 AND $07       ; }
 $9D02 LD B,A        ; keep it
 $9D03 LD A,H        ; {pull bit6 down
 $9D04 AND $40       ; }
 $9D06 RRCA          ; >>3 (three RRCA)
 $9D07 RRCA          ;
 $9D08 RRCA          ;
 $9D09 OR B          ; {merge and set the page bits
 $9D0A OR $E0        ; }
 $9D0C LD B,A        ; back into B
 $9D0D POP AF        ; {recover the sub-column (X AND 7)
 $9D0E AND $07       ; }
 $9D10 LD IY,$9CE7   ; IY = plain-write plotter
 $9D14 RET Z         ; aligned? done
 $9D15 ADD A,A       ; {index *= 4
 $9D16 ADD A,A       ; }
 $9D17 LD E,A        ; {DE = that offset
 $9D18 LD D,$00      ; }
 $9D1A LD IY,$9C97   ; IY = $9C97 + offset
 $9D1E ADD IY,DE     ;
 $9D20 RET           ;

; Deactivate object (IX+2)=$FF, restore background via #R$9BF3
;
; Used by the routine at #R$9DE3.
;
; .
;
; Marks an object as gone and wipes it off the screen by restoring the
; background that was saved underneath it.
c$9D21 LD (IX+$02),$FF ; mark the object inactive
 $9D25 LD L,(IX+$00)   ; {HL = its position
 $9D28 LD H,(IX+$01)   ; }
 $9D2B CALL $9CEE      ; Compute screen address (BC) + pick plot routine (IY)
                       ; for pixel HL
 $9D2E PUSH BC         ; {HL = screen address
 $9D2F POP HL          ; }
 $9D30 PUSH HL         ;
 $9D31 LD B,$01        ; B=1 (one frame)
 $9D33 CALL $9D48      ; Draw a tile-based graphic for each of 5 party-slots at
                       ; $5B04
 $9D36 POP HL          ; {restore HL, B=1
 $9D37 LD B,$01        ; }
 $9D39 JP $9BF3        ; erase via #R$9BF3

; Draw a tile-based graphic for each of 5 party-slots at $5B04
;
; Used by the routine at #R$9B22.
;
; .
;
; Repaints the room background over each of the 5 object slots, working from
; the screen address the slot cached at +$40/+41. Rounds that address to a tile
; boundary, covers 3 or 4 tile rows and columns depending on whether the object
; sits exactly on a boundary, looks each covered cell up in the room's
; tile-index map at $F800, and blits its bitmap row by row. Complements
; #R$9BEB, which restores the same area with the faster straight-copy path.
c$9D3C LD IX,$5B04   ; IX=$5B04 (party slot base), B=5 slots
 $9D40 LD B,$05      ;
*$9D42 LD L,(IX+$40) ; {HL = cached screen address ((IX+$40)/(IX+$41))
 $9D45 LD H,(IX+$41) ; }
; This entry point is used by the routine at #R$9D21.
*$9D48 PUSH BC       ;
 $9D49 LD A,H        ; {align H to tile row
 $9D4A AND $F8       ; }
 $9D4C LD H,A        ;
 $9D4D LD B,$03      ; B=3 rows
 $9D4F LD A,(IX+$01) ; {position mid-tile? one more row
 $9D52 AND $07       ; }
 $9D54 JR Z,$9D57    ;
 $9D56 INC B         ;
*$9D57 PUSH BC       ;
 $9D58 PUSH HL       ;
 $9D59 LD A,(IX+$00) ; {same for columns
 $9D5C LD B,$03      ; }
 $9D5E AND $07       ;
 $9D60 JR Z,$9D63    ;
 $9D62 INC B         ;
*$9D63 PUSH HL       ;
 $9D64 LD A,H        ; H >>= 3
 $9D65 RRCA          ;
 $9D66 RRCA          ;
 $9D67 RRCA          ;
 $9D68 AND $03       ; {mask to 2 bits
 $9D6A LD H,A        ; }
 $9D6B LD DE,$F800   ; {HL = $F800 + offset
 $9D6E ADD HL,DE     ; }
 $9D6F LD L,(HL)     ; {HL = tile index
 $9D70 LD H,$00      ; }
 $9D72 ADD HL,HL     ; index *= 8 (three ADD HL,HL)
 $9D73 ADD HL,HL     ;
 $9D74 ADD HL,HL     ;
 $9D75 LD DE,($5B72) ; DE = bitmap base ($5B72)
 $9D79 ADD HL,DE     ; {HL += DE (bitmap source)
 $9D7A EX DE,HL      ; }
 $9D7B POP HL        ; {restore screen address
 $9D7C PUSH HL       ; }
 $9D7D LD A,(DE)     ; {copy first bitmap row
 $9D7E LD (HL),A     ; }
 $9D7F INC H         ;
 $9D80 INC DE        ;
 $9D81 LD A,(DE)     ;
 $9D82 LD (HL),A     ;
 $9D83 INC H         ; six more rows, unrolled
 $9D84 INC DE        ;
 $9D85 LD A,(DE)     ;
 $9D86 LD (HL),A     ;
 $9D87 INC H         ;
 $9D88 INC DE        ;
 $9D89 LD A,(DE)     ;
 $9D8A LD (HL),A     ;
 $9D8B INC H         ;
 $9D8C INC DE        ;
 $9D8D LD A,(DE)     ;
 $9D8E LD (HL),A     ;
 $9D8F INC H         ;
 $9D90 INC DE        ;
 $9D91 LD A,(DE)     ;
 $9D92 LD (HL),A     ;
 $9D93 INC H         ;
 $9D94 INC DE        ;
 $9D95 LD A,(DE)     ;
 $9D96 LD (HL),A     ;
 $9D97 INC H         ;
 $9D98 INC DE        ;
 $9D99 LD A,(DE)     ;
 $9D9A LD (HL),A     ;
 $9D9B POP HL        ;
 $9D9C INC L         ; next column
 $9D9D DJNZ $9D63    ; loop rows
 $9D9F POP HL        ;
 $9DA0 LD A,L        ;
 $9DA1 ADD A,$20     ; column += 32
 $9DA3 LD L,A        ;
 $9DA4 JR NC,$9DAA   ; no carry? skip
 $9DA6 LD A,H        ; {else row += 8
 $9DA7 ADD A,$08     ; }
 $9DA9 LD H,A        ;
*$9DAA POP BC        ;
 $9DAB DJNZ $9D57    ; loop columns
 $9DAD POP BC        ;
 $9DAE INC IX        ; IX += 4 (next slot)
 $9DB0 INC IX        ;
 $9DB2 INC IX        ;
 $9DB4 INC IX        ;
 $9DB6 DJNZ $9D42    ; loop 5 slots
 $9DB8 RET           ;

; DOWN DE, char-row fixup
;
; Used by the routine at #R$9DE3.
;
;   DE screen address
; O:HL fixed address
;
; Wraps #R$9DBF: takes address in DE (swapped into HL), fixes it, result ends
; in HL
c$9DB9 EX DE,HL      ;
 $9DBA CALL $9DBF    ; DOWN HL, char-row fixup
 $9DBD EX DE,HL      ;
 $9DBE RET           ;

; DOWN HL, char-row fixup
;
; Used by the routines at #R$9BEB, #R$9DB9 and #R$9F70.
;
;   HL screen address
; O:DE fixed address
;
; Fixes screen address HL after crossing a character-row boundary in a downward
; scan (all real callers do INC H per line, then call this every 8th line)
c$9DBF DEC H         ; DEC H (net down one line)
 $9DC0 LD A,L        ; {A = L inverted
 $9DC1 CPL           ; }
 $9DC2 AND $E0       ; at the row edge?
 $9DC4 JR Z,$9DD4    ; yes: wrap to the next third
 $9DC6 LD A,L        ; {L += $20 (next row)
 $9DC7 ADD A,$20     ; }
 $9DC9 LD L,A        ; store it
 $9DCA LD A,H        ; {mask H to the third
 $9DCB AND $F8       ; }
 $9DCD LD H,A        ; store it
 $9DCE LD A,H        ; {mask H to a screen address
 $9DCF AND $5F       ; }
 $9DD1 LD D,A        ; {D/E = result
 $9DD2 LD E,L        ; }
 $9DD3 RET           ;
*$9DD4 LD A,L        ;
 $9DD5 AND $1F       ; wrap L to $00-$1F
 $9DD7 LD L,A        ;
 $9DD8 LD A,H        ; {mask H to the third
 $9DD9 AND $F8       ; }
 $9DDB ADD A,$08     ; += 8 (next third)
 $9DDD LD H,A        ;
 $9DDE AND $5F       ; {mask to a screen address
 $9DE0 LD D,A        ; }
 $9DE1 LD E,L        ; E = L
 $9DE2 RET           ;

; Draw active object sprites (slots $5C0E,$5C13,$5B99)
;
; Used by the routine at #R$9B22.
;
; .
;
; Draws the pixel sprite for the two creature/hazard slots ($5C0E, $5C13) plus
; a third fixed slot ($5B99), skipping inactive ones. Each sprite's 72-byte
; record at $8400 (same format as the item sprites in Items-Format.md) is
; masked onto the screen a byte at a time, with the same masked write repeated
; into the attribute file so each sprite carries its own per-cell colour. This
; is the pixel-sprite counterpart of the tile-based draw in #R$9D3C.
c$9DE3 LD IX,$5C0E   ;
 $9DE7 LD B,$02      ;
*$9DE9 PUSH BC       ;
 $9DEA CALL $9DF8    ;
 $9DED POP BC        ;
 $9DEE LD IX,$5C13   ;
 $9DF2 DJNZ $9DE9    ;
 $9DF4 LD IX,$5B99   ;
*$9DF8 LD A,(IX+$02) ;
 $9DFB CP $FF        ;
 $9DFD RET Z         ;
 $9DFE CP $FE        ;
 $9E00 JP Z,$9D21    ; => Deactivate object (IX+2)=$FF, restore background via
                     ; #R$9BF3
 $9E03 LD A,(IX+$00) ;
 $9E06 AND $F8       ;
 $9E08 LD L,A        ;
 $9E09 LD H,(IX+$01) ;
 $9E0C CALL $9CEE    ; Compute screen address (BC) + pick plot routine (IY) for
                     ; pixel HL
 $9E0F PUSH BC       ;
 $9E10 LD L,(IX+$02) ;
 $9E13 LD H,$00      ;
 $9E15 ADD HL,HL     ;
 $9E16 ADD HL,HL     ;
 $9E17 ADD HL,HL     ;
 $9E18 PUSH HL       ;
 $9E19 ADD HL,HL     ;
 $9E1A ADD HL,HL     ;
 $9E1B ADD HL,HL     ;
 $9E1C POP DE        ;
 $9E1D ADD HL,DE     ;
 $9E1E EX DE,HL      ;
 $9E1F LD IX,$8400   ; {sprite table base + index*72
 $9E23 ADD IX,DE     ; }
 $9E25 POP DE        ;
 $9E26 LD B,$03      ; 3 columns
*$9E28 PUSH BC       ;
 $9E29 PUSH DE       ;
 $9E2A LD B,$18      ; 24 bytes/column
 $9E2C LD C,(IX+$00) ; {H=$FF, mask page pointer
 $9E2F LD H,$FF      ; }
*$9E31 LD A,(IX+$00) ; {combine the two mask bytes
 $9E34 OR (IX+$01)   ; }
 $9E37 OR C          ; OR in the sprite bits
 $9E38 LD C,(IX+$00) ;
 $9E3B INC IX        ;
 $9E3D LD L,A        ; {A = current screen byte
 $9E3E LD A,(DE)     ; }
 $9E3F AND (HL)      ; {punch the mask through
 $9E40 OR C          ; }
 $9E41 LD (DE),A     ; write it back
 $9E42 RES 5,D       ; {point DE at the attribute file
 $9E44 RES 7,D       ; }
 $9E46 LD (DE),A     ; write the same byte
 $9E47 LD A,D        ; {advance to the next screen third
 $9E48 ADD A,$A1     ; }
 $9E4A LD D,A        ;
 $9E4B AND $07       ;
 $9E4D JP NZ,$9E55   ;
 $9E50 CALL $9DB9    ; DOWN DE, char-row fixup
 $9E53 LD H,$FF      ;
*$9E55 DJNZ $9E31    ;
 $9E57 POP DE        ;
 $9E58 POP BC        ;
 $9E59 INC E         ;
 $9E5A DJNZ $9E28    ;
 $9E5C RET           ;

; Populate the $5BD6 object-slot table (via #R$9FBA/#R$9F86)
;
; Used by the routines at #R$8F47, #R$A851, #R$B370, #R$B5DD, #R$B72D, #R$B9FA
; and #R$BB5D.
;
; .
;
; Redraws the fixed UI status-bar icons in the $5BD6 slot table: a sound icon,
; a blank row, the currently-held item's icon (or blank if none held), and
; another blank row - the on-screen inventory bar, refreshed whenever the held
; item changes.
c$9E5D LD HL,$6288   ;
 $9E60 LD IY,$5BD6   ;
 $9E64 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9E67 LD B,$03      ;
 $9E69 LD HL,$5092   ;
 $9E6C LD IY,$5BD6   ;
 $9E70 CALL $9F86    ;
 $9E73 LD HL,$5C46   ;
 $9E76 LD A,($5B98)  ;
 $9E79 CP $FF        ;
 $9E7B JR Z,$9E83    ;
 $9E7D LD DE,$8400   ;
 $9E80 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
*$9E83 LD IY,$5BD6   ;
 $9E87 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9E8A LD HL,$5032   ;
 $9E8D LD B,$03      ;
 $9E8F LD IY,$5BD6   ;
 $9E93 JP $9F86      ;

; Draw lives-count icons ($5B97) into $5BD6 slots
;
; Used by the routines at #R$8F47 and #R$A9EE.
;
; .
;
; Draws the row of life icons in the status bar, one per remaining life.
c$9E96 LD A,($5B97)  ;
 $9E99 OR A          ;
 $9E9A RET Z         ;
 $9E9B DEC A         ;
 $9E9C LD IY,$5BD6   ;
 $9EA0 LD C,A        ;
 $9EA1 LD B,$03      ;
 $9EA3 LD A,$02      ;
*$9EA5 PUSH AF       ;
 $9EA6 LD DE,$6000   ;
 $9EA9 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9EAC DEC C         ;
 $9EAD JP P,$9EB3    ;
 $9EB0 LD HL,$5C46   ;
*$9EB3 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9EB6 POP AF        ;
 $9EB7 INC A         ;
 $9EB8 DJNZ $9EA5    ;
 $9EBA JP $9F1E      ; => Redraw $5BD6 slot at $5081

; Init $5BD6 object slots from $5C23 (calls #R$9EE3)
;
; Used by the routines at #R$8F47, #R$B9FA, #R$BB5D and #R$BC1F.
;
; .
;
; Refreshes the inventory-bar icons in the $5BD6 slot table starting from a
; given position in the pickup log ($5C23) - used whenever the held/available
; items on screen need updating, e.g. after a pickup or when cycling items.
c$9EBD CALL $9EE3    ; Fill $5BD6 slots with item icons from inventory log
 $9EC0 LD B,$04      ;
 $9EC2 LD IY,$5BD6   ;
 $9EC6 LD A,($5C23)  ;
 $9EC9 LD C,A        ;
*$9ECA LD A,C        ;
 $9ECB AND $03       ;
 $9ECD LD DE,$9FDE   ;
 $9ED0 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9ED3 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9ED6 INC C         ;
 $9ED7 LD A,C        ;
 $9ED8 CP $1B        ;
 $9EDA JR NZ,$9EDE   ;
 $9EDC XOR A         ;
 $9EDD LD C,A        ;
*$9EDE DJNZ $9ECA    ;
 $9EE0 JP $9F6B      ; => Redraw $5BD6 slot at $5096

; Fill $5BD6 slots with item icons from inventory log ($5B7C)
;
; Used by the routine at #R$9EBD.
;
; .
;
; Draws the row of collected-item icons in the status bar, reading straight
; from the inventory pickup log.
c$9EE3 LD B,$04      ; B=4 slots
 $9EE5 LD A,($5C23)  ; A = start index ($5C23)
 $9EE8 LD IY,$5BD6   ; IY=$5BD6 (slot table)
 $9EEC LD L,A        ; {keep index in L and C
 $9EED LD C,A        ; }
 $9EEE LD H,$00      ; {DE=$5B7C (inventory log)
 $9EF0 LD DE,$5B7C   ; }
 $9EF3 ADD HL,DE     ; HL = log + index
 $9EF4 PUSH HL       ; {into IX
 $9EF5 POP IX        ; }
*$9EF7 LD A,(IX+$00) ; {log entry empty ($FF)?
 $9EFA CP $FF        ; }
 $9EFC JR NZ,$9F03   ; no: look up its icon
 $9EFE LD HL,$5C46   ; HL=$5C46 (blank icon)
 $9F01 JR $9F09      ;
*$9F03 LD DE,$8400   ; DE=$8400 (item sprite table)
 $9F06 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
*$9F09 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9F0C INC IX        ; {IX++, index++
 $9F0E INC C         ; }
 $9F0F LD A,C        ; A = index
 $9F10 CP $1B        ; {reached $1B?
 $9F12 JR NZ,$9F1A   ; }
 $9F14 LD C,$00      ; wrap index to 0
 $9F16 LD IX,$5B7C   ; restart the log pointer
*$9F1A DJNZ $9EF7    ; loop 4 slots
 $9F1C JR $9F70      ; => Redraw background column for up to 9 object slots

; Redraw $5BD6 slot at $5081 (tail of #R$9E96)
;
; Used by the routine at #R$9E96.
c$9F1E LD IY,$5BD6   ;
 $9F22 LD HL,$5081   ;
 $9F25 JR $9F84      ;

; Draw main-menu UI icons/highlight bar into $5BD6 slots
;
; Used by the routine at #R$93AF.
;
; .
;
; Draws the main menu's option icons and the highlight bar over the
; currently-selected input device.
c$9F27 LD IY,$5BD6   ;
 $9F2B LD B,$04      ;
 $9F2D LD A,$71      ;
*$9F2F PUSH AF       ;
 $9F30 LD DE,$6000   ;
 $9F33 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9F36 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9F39 POP AF        ;
 $9F3A INC A         ;
 $9F3B DJNZ $9F2F    ;
 $9F3D LD IY,$5BD6   ;
 $9F41 LD B,$06      ;
 $9F43 LD HL,$4837   ;
 $9F46 CALL $9F86    ;
 $9F49 LD B,$06      ;
 $9F4B LD HL,$4897   ;
 $9F4E CALL $9F86    ;
 $9F51 LD IY,$5BD6   ;
 $9F55 LD A,$75      ;
 $9F57 LD DE,$6000   ;
 $9F5A CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9F5D CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9F60 LD B,$03      ;
 $9F62 LD HL,$4842   ;
 $9F65 LD IY,$5BD6   ;
 $9F69 JR $9F86      ;

; Redraw $5BD6 slot at $5096 (tail of #R$9EBD)
;
; Used by the routine at #R$9EBD.
c$9F6B LD HL,$5096   ;
 $9F6E JR $9F73      ;

; Redraw background column for up to 9 object slots ($5BD6)
;
; Used by the routine at #R$9EE3.
;
; .
;
; Draws the graphics for up to 9 status-bar slots, each as a 24-row-tall
; column, skipping the first few according to the inventory scroll offset
; ($5C22) so the bar can slide as the player cycles items.
c$9F70 LD HL,$5036   ;
; This entry point is used by the routine at #R$9F6B.
*$9F73 LD IY,$5BD6   ; IY = slot table ($5BD6)
 $9F77 LD A,($5C22)  ; {A = scroll offset ($5C22)
 $9F7A OR A          ; }
 $9F7B JR Z,$9F84    ; none? start at slot 0
*$9F7D INC IY        ; {IY += 2 (skip a slot)
 $9F7F INC IY        ; }
 $9F81 DEC A         ; {count down
 $9F82 JR NZ,$9F7D   ; }
; This entry point is used by the routine at #R$9F1E.
*$9F84 LD B,$09      ; B=9 slots
; This entry point is used by the routines at #R$9E5D and #R$9F27.
*$9F86 PUSH HL       ; {save HL/BC
 $9F87 PUSH BC       ; }
 $9F88 LD E,(IY+$00) ; {DE = the slot graphic
 $9F8B LD D,(IY+$01) ; }
 $9F8E LD B,$18      ; B=24 rows
*$9F90 LD A,(DE)     ;
 $9F91 INC DE        ;
 $9F92 LD (HL),A     ;
 $9F93 INC H         ;
 $9F94 LD A,H        ;
 $9F95 AND $07       ;
 $9F97 JR NZ,$9F9E   ;
 $9F99 PUSH DE       ;
 $9F9A CALL $9DBF    ; DOWN HL, char-row fixup
 $9F9D POP DE        ;
*$9F9E DJNZ $9F90    ;
 $9FA0 POP BC        ; {restore BC/HL
 $9FA1 POP HL        ; }
 $9FA2 INC L         ; next column
 $9FA3 INC IY        ; {IY += 2 (next slot)
 $9FA5 INC IY        ; }
 $9FA7 DJNZ $9F86    ; loop slots
 $9FA9 RET           ;

; Compute HL = A*24-ish, entry point for #R$9FBA
;
; Used by the routines at #R$9E5D, #R$9E96, #R$9EBD, #R$9EE3 and #R$9F27.
;
;   A index value
; O:HL A*72 + caller's DE
;   DE table base the computed offset is added to
;
; Turns a small index into the address of the matching sprite/icon graphic - a
; shared lookup used whenever the game needs to find where an item or icon's
; picture data lives.
c$9FAA PUSH DE       ; save caller DE
 $9FAB LD L,A        ; {HL = A (zero-extended)
 $9FAC LD H,$00      ; }
 $9FAE ADD HL,HL     ; HL *= 8 (three ADD HL,HL)
 $9FAF ADD HL,HL     ;
 $9FB0 ADD HL,HL     ;
 $9FB1 PUSH HL       ; save A*8
 $9FB2 ADD HL,HL     ; HL *= 8 again (A*64)
 $9FB3 ADD HL,HL     ;
 $9FB4 ADD HL,HL     ;
 $9FB5 POP DE        ; {HL += A*8 (A*72)
 $9FB6 ADD HL,DE     ; }
 $9FB7 POP DE        ; {add the caller table base
 $9FB8 ADD HL,DE     ; }
 $9FB9 RET           ;

; Store HL into an IY-indexed table entry, advance IY/HL by stride
;
; Used by the routines at #R$9E5D, #R$9E96, #R$9EBD, #R$9EE3 and #R$9F27.
;
;   HL value to store
;   IY table entry address
; O:IY advanced past 3 entries
; O:HL value + 3*stride
;
; Fills 3 consecutive $5BD6 status-bar slots with the same graphic address,
; spaced by the slot table's row stride - used to draw a repeated icon (e.g. a
; row of blank tiles) in one call.
c$9FBA LD (IY+$00),L ; {store the address in entry 0
 $9FBD LD (IY+$01),H ; }
 $9FC0 INC IY        ; {IY += 2
 $9FC2 INC IY        ; }
 $9FC4 LD DE,$0018   ; {advance the address by one row ($18)
 $9FC7 ADD HL,DE     ; }
 $9FC8 LD (IY+$00),L ; {store it in entry 1
 $9FCB LD (IY+$01),H ; }
 $9FCE ADD HL,DE     ; advance a row again
 $9FCF INC IY        ; {advance IY by 2
 $9FD1 INC IY        ; }
 $9FD3 LD (IY+$00),L ; {store it in entry 2
 $9FD6 LD (IY+$01),H ; }
 $9FD9 INC IY        ; {IY += 2
 $9FDB INC IY        ; }
 $9FDD RET           ;

; Status-bar icon index table (used by #R$9EBD)
b$9FDE DEFB $00,$01,$03,$16,$17,$0C,$1B,$1D
 $9FE6 DEFB $1A,$2D,$27,$33,$0D,$1E,$1F,$16
 $9FEE DEFB $17,$0B,$00,$01,$02,$00,$3F,$00
 $9FF6 DEFB $AA,$01,$EF,$38,$11,$D6,$30,$BB
 $9FFE DEFB $01,$FE,$93,$29,$C7,$7C,$83,$FE
 $A006 DEFB $EF,$93,$EE,$01,$AA,$50,$07,$00
 $A00E DEFB $00,$00,$80,$D0,$D0,$20,$B0,$50
 $A016 DEFB $88,$48,$D8,$80,$60,$F0,$D0,$D0
 $A01E DEFB $A0,$40,$00,$00,$80,$00,$E0,$00
 $A026 DEFB $00,$00,$00,$00,$01,$01,$06,$03
 $A02E DEFB $04,$01,$01,$01,$00,$07,$0F,$0B
 $A036 DEFB $0D,$06,$00,$01,$02,$00,$3F,$00
 $A03E DEFB $38,$7C,$EE,$FE,$01,$55,$10,$BB
 $A046 DEFB $00,$FE,$D7,$AB,$C6,$7D,$83,$FF
 $A04E DEFB $EF,$54,$EE,$01,$AA,$50,$07,$00
 $A056 DEFB $00,$00,$00,$00,$00,$00,$40,$80
 $A05E DEFB $C0,$00,$00,$00,$C0,$E0,$A0,$A0
 $A066 DEFB $40,$80,$00,$00,$80,$00,$E0,$00
 $A06E DEFB $01,$00,$01,$03,$03,$06,$06,$06
 $A076 DEFB $07,$07,$23,$25,$33,$0B,$1A,$1B
 $A07E DEFB $15,$1D,$09,$00,$01,$00,$00,$01
 $A086 DEFB $55,$AA,$55,$AB,$FF,$FE,$FE,$00
 $A08E DEFB $6D,$83,$FF,$83,$29,$C7,$FE,$6D
 $A096 DEFB $01,$55,$AB,$FE,$01,$AA,$00,$EF
 $A09E DEFB $00,$00,$00,$80,$80,$C0,$C0,$C0
 $A0A6 DEFB $D4,$CA,$85,$43,$87,$A1,$B1,$B9
 $A0AE DEFB $1D,$0B,$06,$00,$00,$00,$00,$00
 $A0B6 DEFB $00,$00,$03,$03,$05,$0A,$1B,$37
 $A0BE DEFB $67,$47,$67,$33,$19,$02,$07,$0F
 $A0C6 DEFB $0A,$05,$00,$01,$03,$01,$0F,$00
 $A0CE DEFB $FE,$7C,$01,$FF,$55,$00,$55,$93
 $A0D6 DEFB $BB,$45,$FF,$29,$C7,$7C,$83,$FF
 $A0DE DEFB $EE,$93,$FE,$01,$AB,$93,$C7,$00
 $A0E6 DEFB $00,$00,$80,$40,$40,$A0,$B0,$D8
 $A0EE DEFB $CC,$C4,$CC,$98,$20,$80,$C0,$C0
 $A0F6 DEFB $80,$00,$00,$00,$80,$00,$E0,$00
 $A0FE DEFB $00,$00,$00,$00

; Clear a 4-byte record at $A0FE
;
; Used by the routines at #R$A34B, #R$A3E1, #R$AC35, #R$AD17, #R$ADAC and
; #R$AE37.
;
; DE preserved (pushed/popped, not used)
;
; Per-frame ground/hazard-tile sensor for the hero, called every frame from
; #R$A3E1. Samples nearby tiles for a ledge-edge trigger, checks the tile under
; the hero for a sticky-hazard timeout, and refreshes a solid-ground flag for
; next frame - all gated off while a status is already active or the alternate
; tileset is loaded.
c$A102 LD IY,$A0FE   ;
 $A106 PUSH DE       ;
 $A107 XOR A         ;
 $A108 LD (IY+$00),A ; clear 4-byte record ($A0FE)
 $A10B LD (IY+$01),A ;
 $A10E LD (IY+$02),A ;
 $A111 LD (IY+$03),A ;
 $A114 LD A,($5C06)  ;
 $A117 OR A          ; {skip if status active or alternate tileset
 $A118 JR NZ,$A132   ; }
 $A11A LD A,($918C)  ;
 $A11D OR A          ;
 $A11E JR NZ,$A132   ;
 $A120 CALL $A176    ; Sample two nearby tiles (below/right of object) for
                     ; collision
 $A123 LD A,B        ;
 $A124 CP $A5        ; {tile==$A5 (either sample)? trigger $1A
 $A126 JR Z,$A12D    ; }
 $A128 LD A,C        ;
 $A129 CP $A5        ;
 $A12B JR NZ,$A132   ;
*$A12D LD A,$1A      ;
 $A12F CALL $AE85    ;
*$A132 CALL $A1F4    ; Check object position against screen bounds, sample tile
                     ; ahead
 $A135 XOR A         ;
 $A136 LD ($5C28),A  ;
 $A139 LD A,(IY+$03) ;
 $A13C OR A          ;
 $A13D JR NZ,$A161   ;
 $A13F LD A,($918C)  ;
 $A142 OR A          ;
 $A143 JR NZ,$A161   ;
 $A145 LD A,(HL)     ;
 $A146 CP $BC        ; {tile under feet == $BC? branch
 $A148 JR Z,$A14E    ; }
 $A14A CP $BD        ;
 $A14C JR NZ,$A161   ;
*$A14E LD ($5C28),A  ;
 $A151 LD HL,$5C29   ;
 $A154 INC (HL)      ;
 $A155 LD A,(HL)     ;
 $A156 CP $32        ; {hazard counter >=50 frames? sets status $11
 $A158 JR C,$A165    ; }
 $A15A LD A,$11      ;
 $A15C LD ($5C06),A  ;
 $A15F JR $A165      ;
*$A161 XOR A         ;
 $A162 LD ($5C29),A  ;
*$A165 CALL $A2AC    ; Scan tile column below feet against solid-tile list
                     ; ($A24B/$A271), flag (IY+0)
 $A168 CALL $A2FA    ; Scan tile column right of object (X+23) via #R$A2B2
 $A16B LD A,($5BA0)  ;
 $A16E OR A          ;
 $A16F JR NZ,$A174   ;
 $A171 LD (IY+$03),A ;
*$A174 POP DE        ; restore DE
 $A175 RET           ;

; Sample two nearby tiles (below/right of object) for collision
;
; Used by the routine at #R$A102.
;
;   IX object (position at +0/+1)
; O:C tile index below feet
; O:B tile index right of object
;
; Reads the tile-index map at two points near the object: one below its feet,
; one to its right - the two spots #R$A102 checks for a "walked off a ledge"
; style hazard.
c$A176 LD L,(IX+$00) ;
 $A179 LD H,(IX+$01) ;
 $A17C LD A,H        ;
 $A17D ADD A,$17     ; {Y+=$17 (sample point below feet)
 $A17F LD H,A        ; }
 $A180 PUSH HL       ;
 $A181 LD A,L        ;
 $A182 ADD A,$08     ;
 $A184 LD L,A        ;
 $A185 CALL $A293    ; Convert pixel position (HL) to character-cell
                     ; coordinates
 $A188 LD C,(HL)     ; C=tile below
 $A189 POP HL        ;
 $A18A LD A,L        ;
 $A18B ADD A,$10     ; {X+=$10 (sample point right of object)
 $A18D LD L,A        ; }
 $A18E CALL $A293    ; Convert pixel position (HL) to character-cell
                     ; coordinates
 $A191 LD B,(HL)     ; B=tile right
 $A192 RET           ;

; Check tile below-left of feet (X+12,Y+23) against special-tile lists
;
; Used by the routine at #R$A3E1.
;
;   IX object (position at +0/+1)
; O:Zf set if tile matches
;
; Checks the tile just below-left of the object's feet against one of two
; special-tile lists, chosen by whether the current room is $0C; falls back to
; a second pair of lists when the alternate tileset is loaded. Used as a
; ground/edge sensor, similar to #R$A1F4 but sampling one tile position over.
c$A193 LD A,(IX+$00) ;
 $A196 ADD A,$0C     ; {X+12 off-screen? -> blocked
 $A198 JR C,$A1C0    ; }
 $A19A LD L,A        ;
 $A19B LD A,(IX+$01) ;
 $A19E ADD A,$17     ;
 $A1A0 LD H,A        ;
 $A1A1 LD A,($918C)  ;
 $A1A4 OR A          ; {alternate tileset? use alt list
 $A1A5 JR NZ,$A1C3   ; }
 $A1A7 LD A,($5C01)  ; get Current room number
 $A1AA CP $0C        ; {room==$0C? (stash for after tile lookup)
 $A1AC PUSH AF       ; }
 $A1AD CALL $A293    ; Convert pixel position (HL) to character-cell
                     ; coordinates
 $A1B0 POP AF        ;
 $A1B1 LD A,(HL)     ;
 $A1B2 JR NC,$A1BA   ; room==$0C? check $92/$95 too
 $A1B4 CP $92        ;
 $A1B6 RET Z         ;
 $A1B7 CP $95        ;
 $A1B9 RET Z         ;
*$A1BA CP $98        ;
 $A1BC RET Z         ;
 $A1BD CP $99        ;
 $A1BF RET           ;
*$A1C0 XOR A         ; {off-screen: A=1 (blocked)
 $A1C1 INC A         ; }
 $A1C2 RET           ;
*$A1C3 CALL $A293    ; Convert pixel position (HL) to character-cell
                     ; coordinates
 $A1C6 LD A,(HL)     ;
 $A1C7 CP $C6        ;
 $A1C9 RET Z         ;
 $A1CA CP $C7        ;
 $A1CC RET Z         ;
 $A1CD CP $CE        ;
 $A1CF RET Z         ;
 $A1D0 CP $CF        ;
 $A1D2 RET           ;

; Blocked-check wrapper (Y-1) via #R$A208, save/restore (IY+3)
;
; Used by the routine at #R$A34B.
;
;   IX object (position at +0/+1)
;   IY object's tile-flag record (shared with #R$A102/#R$A1F4)
; O:Zf set if blocked
;
; Checks whether the tile one row above the object's current position is
; blocked, without disturbing the object's own blocked-flag record - used by
; the movement code to test a move before committing to it.
c$A1D3 PUSH BC         ;
 $A1D4 LD A,(IY+$03)   ;
 $A1D7 PUSH AF         ;
 $A1D8 LD (IY+$03),$00 ; clear (IY+3)=0 (result init)
 $A1DC LD A,(IX+$00)   ;
 $A1DF ADD A,$0C       ;
 $A1E1 LD L,A          ;
 $A1E2 LD A,(IX+$01)   ;
 $A1E5 DEC A           ;
 $A1E6 CALL $A208      ; BC = (X+12, Y+24)
 $A1E9 LD C,(IY+$03)   ; C=(IY+3) result
 $A1EC POP AF          ;
 $A1ED LD (IY+$03),A   ;
 $A1F0 LD A,C          ;
 $A1F1 POP BC          ;
 $A1F2 OR A            ;
 $A1F3 RET             ;

; Check object position against screen bounds, sample tile ahead
;
; Used by the routine at #R$A102.
;
;   IX object (position at +0/+1)
;   IY object's tile-flag record (shared with #R$A102/#R$A1D3)
; O:(IY+3) rows climbed before match/off-screen (5 = off-screen)
; O:Zf set on tile match
;
; Scans upward from the tile just ahead of the object (X+12, Y+24) against a
; special-tile list ($A234, or $A264 for the alternate tileset), counting rows
; climbed in (IY+3) until a match is found or the scan runs off the top of the
; screen.
c$A1F4 LD A,(IX+$00)   ;
 $A1F7 ADD A,$0C       ;
 $A1F9 LD L,A          ;
 $A1FA LD A,(IX+$01)   ;
 $A1FD ADD A,$18       ;
 $A1FF CP $7F          ; {Y+24 off-screen ($7F)?
 $A201 JR C,$A208      ; }
*$A203 LD (IY+$03),$05 ; off-screen: (IY+3)=5
 $A207 RET             ;
; This entry point is used by the routine at #R$A1D3.
*$A208 LD H,A          ; H = Y
 $A209 PUSH HL         ; {BC = the position
 $A20A POP BC          ; }
*$A20B CALL $A293      ; Convert pixel position (HL) to character-cell
                       ; coordinates
 $A20E EX DE,HL        ;
 $A20F LD HL,$A234     ;
 $A212 LD A,($918C)    ;
 $A215 OR A            ; {alternate tileset? use alt list ($A264)
 $A216 JR Z,$A21B      ; }
 $A218 LD HL,$A264     ;
*$A21B LD A,(DE)       ;
 $A21C CP (HL)         ; {tile matches? RET
 $A21D RET Z           ; }
 $A21E LD A,(HL)       ;
 $A21F OR A            ; {row empty (list end)? stop scanning
 $A220 JR Z,$A225      ; }
 $A222 INC HL          ;
 $A223 JR $A21B        ;
*$A225 LD A,B          ;
 $A226 LD L,C          ;
 $A227 ADD A,$08       ;
 $A229 LD H,A          ;
 $A22A LD B,A          ;
 $A22B CP $80          ; {reached bottom? off-screen
 $A22D JR NC,$A203     ; }
 $A22F INC (IY+$03)    ; else: next row up
 $A232 JR $A20B        ;

; Special-tile list, base tileset (used by #R$A1F4)
b$A234 DEFB $95,$AC,$AD,$AE,$AF,$B0,$CF,$BC
 $A23C DEFB $BD,$C0,$C1,$C8,$C9,$CA,$1E,$1F
 $A244 DEFB $31,$32,$33,$3C,$3D,$3E,$3F

; Solid-tile list, base tileset (25 bytes, $00-terminated; used by #R$A2AC)
b$A24B DEFB $07,$08,$09,$0A,$0B,$0D,$0E,$0F
 $A253 DEFB $10,$12,$13,$14,$16,$18,$59,$86
 $A25B DEFB $87,$88,$89,$8A,$8B,$8F,$90,$D2
 $A263 DEFB $00

; Special-tile list, alternate tileset (used by #R$A1F4)
b$A264 DEFB $C6,$C7,$BF,$C0,$1E,$1F,$31,$32
 $A26C DEFB $33,$3C,$3D,$3E,$3F

; Solid-tile list, alternate tileset (34 bytes; shares only the first 15
; entries with #R$A24B, then diverges - the alternate set treats far more tiles
; as solid)
b$A271 DEFB $07,$08,$09,$0A,$0B,$0D,$0E,$0F
 $A279 DEFB $10,$12,$13,$14,$16,$18,$59,$95
 $A281 DEFB $96,$9E,$A3,$C3,$C4,$C5,$CC,$CD
 $A289 DEFB $D3,$D4,$D5,$E0,$F3,$F4,$F5,$FE
 $A291 DEFB $86,$00

; Convert pixel position (HL) to character-cell coordinates
;
; Used by the routines at #R$A176, #R$A193, #R$A1F4, #R$A2AC and #R$A31F.
;
;   HL pixel position (X in L, Y in H)
; O:HL tile-index map address ($F800+offset)
;   DE preserved
;
; Converts a pixel position (HL) into the address of that pixel's entry in the
; 32x16 tile-index map at $F800 - the shared coordinate-to-tile-map lookup used
; throughout the tile-scanning and collision routines.
c$A293 PUSH DE       ;
 $A294 SRL L         ; X>>=3 (pixel -> char column)
 $A296 SRL L         ;
 $A298 SRL L         ;
 $A29A LD A,H        ;
 $A29B RLCA          ; {H<<=2 (row bits into position)
 $A29C RLCA          ; }
 $A29D LD H,A        ;
 $A29E AND $E0       ;
 $A2A0 OR L          ;
 $A2A1 LD L,A        ;
 $A2A2 LD A,H        ;
 $A2A3 AND $01       ;
 $A2A5 LD H,A        ;
 $A2A6 LD DE,$F800   ; {HL += $F800 (tile-index map base)
 $A2A9 ADD HL,DE     ; }
 $A2AA POP DE        ;
 $A2AB RET           ;

; Scan tile column below feet against solid-tile list ($A24B/$A271), flag
; (IY+0)
;
; Used by the routines at #R$A102 and #R$C0FD.
;
;   IX object (position at +0/+1)
;   IY flag record (result byte at +0)
; O:(IY+0) 0 or 1 (solid-tile match)
;
; Checks the ground under an object across several tile rows and flags whether
; it's standing on solid/special ground - the shared "is this object on the
; ground" test used by both the hero and creatures.
c$A2AC LD L,(IX+$00)   ; {HL = object position
 $A2AF LD H,(IX+$01)   ; }
; This entry point is used by the routine at #R$A2FA.
*$A2B2 LD (IY+$00),$00 ; clear the result flag
 $A2B6 LD B,$03        ; B=3 rows
 $A2B8 LD A,H          ; {position mid-tile?
 $A2B9 AND $07         ; }
 $A2BB JR Z,$A2BE      ;
 $A2BD INC B           ; yes: scan a 4th row
*$A2BE PUSH BC         ; {save BC/HL
 $A2BF PUSH HL         ; }
 $A2C0 CALL $A293      ; Convert pixel position (HL) to character-cell
                       ; coordinates
 $A2C3 LD DE,$A24B     ; DE=$A24B (solid-tile list)
 $A2C6 LD A,($918C)    ; {alternate tileset?
 $A2C9 OR A            ; }
 $A2CA JR Z,$A2CF      ;
 $A2CC LD DE,$A271     ; yes: use list $A271
*$A2CF LD A,($5C01)    ; get Current room number
 $A2D2 CP $18          ; {room>=$18?
 $A2D4 JR C,$A2E2      ; }
 $A2D6 LD DE,$A242     ; DE=$A242 (alt list)
 $A2D9 LD A,($918C)    ; {alternate tileset?
 $A2DC OR A            ; }
 $A2DD JR Z,$A2E2      ;
 $A2DF LD DE,$A268     ; alternate tileset -> DE=$A268 instead
*$A2E2 LD A,(DE)       ; {tile matches list entry?
*$A2E3 CP (HL)         ; }
 $A2E4 JR Z,$A2ED      ;
 $A2E6 INC DE          ; {next entry
 $A2E7 LD A,(DE)       ; }
 $A2E8 OR A            ; {end of list ($00)?
 $A2E9 JR NZ,$A2E3     ; }
 $A2EB JR $A2F1        ; no match: leave flag clear
*$A2ED LD (IY+$00),$01 ; match: flag = 1
*$A2F1 POP HL          ; {restore address
 $A2F2 LD A,H          ; }
 $A2F3 ADD A,$08       ; {row += 8
 $A2F5 LD H,A          ; }
 $A2F6 POP BC          ; restore counter
 $A2F7 DJNZ $A2BE      ; loop rows
 $A2F9 RET             ;

; Scan tile column right of object (X+23) via #R$A2B2
;
; Used by the routines at #R$A102 and #R$C109.
;
; IX object (position at +0/+1)
; IY flag record (result byte at +1, not +0 - IY is bumped before the call)
;
; Checks the tiles just to the right of an object for solid ground - the
; sideways counterpart to #R$A2AC's below-feet check.
c$A2FA LD A,(IX+$00) ;
 $A2FD ADD A,$17     ; X+$17 (right of object)
 $A2FF LD L,A        ;
 $A300 LD H,(IX+$01) ;
 $A303 INC IY        ; IY++ so result lands at (IY+1)
 $A305 CALL $A2B2    ; Scan tile column below feet against solid-tile list
                     ; ($A24B/$A271), flag (IY+0)
 $A308 DEC IY        ;
 $A30A RET           ;

; Scan tile below-right of feet (X+12,Y+24) via #R$A328
;
; Used by the routine at #R$C121.
;
; IX object (position at +0/+1)
; IY flag record (result byte at +1 - IY is bumped before the call)
;
; Checks the tile just below and right of an object, writing the result into
; the second slot of the caller's flag record.
c$A30B LD A,(IX+$00) ;
 $A30E ADD A,$0C     ;
 $A310 LD L,A        ;
 $A311 LD A,(IX+$01) ;
 $A314 ADD A,$18     ; Y+$18 (below feet)
 $A316 LD H,A        ;
 $A317 INC IY        ; IY++ so result lands at (IY+1)
 $A319 CALL $A328    ; Scan tile at (X+12) against special-tile list
                     ; ($A242/$A268), flag (IY+0)
 $A31C DEC IY        ;
 $A31E RET           ;

; Scan tile at (X+12) against special-tile list ($A242/$A268), flag (IY+0)
;
; Used by the routine at #R$C115.
;
; IY flag record (result byte at +0)
;
; Checks the tile just ahead of an object against a list of special tiles
; (ladders, water, etc.) rather than plain solid ground - feeds the movement
; code's "is this tile special" checks.
c$A31F LD A,(IX+$00)   ; {X + $0C
 $A322 ADD A,$0C       ; }
 $A324 LD L,A          ; {HL = that position
 $A325 LD H,(IX+$01)   ; }
; This entry point is used by the routine at #R$A30B.
*$A328 LD (IY+$00),$00 ; clear flag (IY+0)=0
 $A32C CALL $A293      ; Convert pixel position (HL) to character-cell
                       ; coordinates
 $A32F LD DE,$A242     ; DE=$A242 (tile list)
 $A332 LD A,($918C)    ; {alternate tileset?
 $A335 OR A            ; }
 $A336 JR Z,$A33B      ; no: use this list
 $A338 LD DE,$A268     ; DE=$A268 (alternate-tileset list)
*$A33B LD A,(DE)       ; {tile matches list entry?
*$A33C CP (HL)         ; }
 $A33D JR Z,$A346      ;
 $A33F INC DE          ; {next entry
 $A340 LD A,(DE)       ; }
 $A341 OR A            ; {end of list?
 $A342 JR NZ,$A33C     ; }
 $A344 JR $A34A        ; no match: leave the flag clear
*$A346 LD (IY+$00),$01 ; match: flag = 1
*$A34A RET             ; RET

; Apply joystick input to object position, trigger room edge at $A640
;
; .
;
; IX=$5B04 (hero, implicit - always the same object)
;
; Moves the hero for one frame based on the current joystick/keyboard input:
; turns the input into a direction and speed, checks the tile ahead isn't
; blocked before committing to it, and updates the hero's position and facing
; direction accordingly. Also hands off to the room-edge handler once the hero
; walks far enough to leave the room. Called every frame by #R$A3E1, which is
; the outer driver.
c$A34B POP AF          ;
 $A34C CALL $AE84      ; Set hero status ($5C06), clear hazard timer ($5C07)
 $A34F LD (IX+$02),$1A ; frame=$1A
 $A353 CALL $A102      ; Clear a 4-byte record at $A0FE
 $A356 CALL $B87D      ; Resolve conflicting L/R, U/D input via #R$B894
 $A359 LD E,A          ; E=input bitmask
 $A35A LD BC,($5C34)   ; BC=velocity ($5C34)
 $A35E BIT 0,E         ; {right? X-velocity++
 $A360 JR Z,$A369      ; }
 $A362 INC C           ;
 $A363 LD A,C          ;
 $A364 CP $04          ; {clamp at +4
 $A366 JR NZ,$A369     ; }
 $A368 DEC C           ;
*$A369 BIT 1,E         ; {left? X-velocity--
 $A36B JR Z,$A374      ; }
 $A36D DEC C           ;
 $A36E LD A,C          ;
 $A36F CP $FC          ;
 $A371 JR NZ,$A374     ;
 $A373 INC C           ;
*$A374 BIT 2,E         ; {down? Y-velocity++
 $A376 JR Z,$A37F      ; }
 $A378 INC B           ;
 $A379 LD A,B          ;
 $A37A CP $04          ;
 $A37C JR NZ,$A37F     ;
 $A37E DEC B           ;
*$A37F BIT 3,E         ; {up? Y-velocity--
 $A381 JR Z,$A38A      ; }
 $A383 DEC B           ;
 $A384 LD A,B          ;
 $A385 CP $FC          ;
 $A387 JR NZ,$A38A     ;
 $A389 INC B           ;
*$A38A BIT 7,C         ; {X-velocity sign picks which blocked flag to test
 $A38C JR NZ,$A39A     ; }
 $A38E BIT 0,(IY+$01)  ;
 $A392 JR Z,$A3A4      ;
 $A394 LD A,C          ;
 $A395 NEG             ; blocked: reverse X-velocity
 $A397 LD C,A          ;
 $A398 JR $A3A4        ;
*$A39A BIT 0,(IY+$00)  ;
 $A39E JR Z,$A3A4      ;
 $A3A0 LD A,C          ;
 $A3A1 NEG             ;
 $A3A3 LD C,A          ;
*$A3A4 BIT 7,B         ; {Y-velocity sign picks which blocked test
 $A3A6 JR NZ,$A3B4     ; }
 $A3A8 LD A,(IY+$03)   ;
 $A3AB OR A            ;
 $A3AC JR NZ,$A3BD     ;
 $A3AE LD A,B          ;
 $A3AF NEG             ; blocked: reverse Y-velocity
 $A3B1 LD B,A          ;
 $A3B2 JR $A3BD        ;
*$A3B4 CALL $A1D3      ; Blocked-check wrapper (Y-1) via #R$A208, save/restore
                       ; (IY+3)
 $A3B7 JR NZ,$A3BD     ;
 $A3B9 LD A,B          ;
 $A3BA NEG             ;
 $A3BC LD B,A          ;
*$A3BD LD ($5C34),BC   ; store velocity ($5C34)
 $A3C1 RES 7,(IX+$03)  ;
 $A3C5 BIT 7,C         ; {direction flag from X-velocity sign
 $A3C7 JR NZ,$A3CD     ; }
 $A3C9 SET 7,(IX+$03)  ;
*$A3CD LD A,B          ;
 $A3CE ADD A,(IX+$01)  ; Y += Y-velocity
 $A3D1 LD (IX+$01),A   ;
 $A3D4 LD A,C          ;
 $A3D5 ADD A,(IX+$00)  ; X += X-velocity
 $A3D8 LD (IX+$00),A   ;
 $A3DB CP $04          ; {X wrapped below 4? cross to next room
 $A3DD RET NC          ; }
 $A3DE JP $A640        ; => Move left

; Main per-frame player update: input, movement, room-state/hazard dispatch
;
; Used by the routine at #R$8F47.
;
; IX=$5B04 (hero, implicit - always the same object)
;
; The hero's main per-frame update, called once every frame. Moves the hero
; (#R$A34B), checks for scripted room events and status changes, and reacts to
; a long list of specific room/position combinations that trigger scripted
; moments (cutscenes, hazards, sound effects). This is the busiest routine in
; the disassembly, and the natural place to look first for any hero-behavior
; question not already answered elsewhere - see Actors.md's status-code table
; for what's known about the values it sets.
c$A3E1 CALL $B7DD      ; Per-room init dispatch
 $A3E4 LD IY,$A0FE     ;
 $A3E8 LD ($AF39),SP   ;
 $A3EC LD HL,($AEED)   ;
 $A3EF LD A,H          ;
 $A3F0 OR L            ;
 $A3F1 JP NZ,$AEB9     ; => Scripted-zone list step
 $A3F4 CALL $B87D      ; Resolve conflicting L/R, U/D input via #R$B894
 $A3F7 LD E,A          ;
 $A3F8 LD A,($5C06)    ;
 $A3FB OR A            ;
 $A3FC CALL Z,$AF3B    ; Scripted zone trigger
 $A3FF LD IX,$5B04     ;
 $A403 LD L,(IX+$00)   ;
 $A406 LD H,(IX+$01)   ;
 $A409 LD ($5C09),HL   ;
 $A40C CALL $A6CC      ; Room-state dispatch
 $A40F CALL $B03B      ; Scripted zone trigger by room+position table
 $A412 LD A,(IY+$03)   ;
 $A415 OR A            ;
 $A416 CALL Z,$B02E    ; Check ENTER key (port $FBFE), trigger state $0A via
                       ; #R$AE85
 $A419 LD A,($5B98)    ;
 $A41C CP $0A          ; {room-category ($5B98)==$0A?
 $A41E JR NZ,$A43F     ; }
 $A420 LD A,($5C01)    ; get Current room number
 $A423 CP $14          ; {room==$14 or $08?
 $A425 JR Z,$A42B      ; }
 $A427 CP $08          ;
 $A429 JR NZ,$A43F     ;
*$A42B LD A,$04        ; {status=4
 $A42D LD ($5C06),A    ; }
 $A430 LD A,$1D        ; {frame=$1D
 $A432 LD (IX+$02),A   ; }
 $A435 LD A,(IX+$01)   ;
 $A438 SUB $08         ; Y-8, underflow? keep Y
 $A43A RET C           ;
 $A43B LD (IX+$01),A   ;
 $A43E RET             ;
*$A43F LD A,($5C04)    ;
 $A442 OR A            ;
 $A443 JR Z,$A447      ;
 $A445 LD E,$00        ;
*$A447 BIT 4,E         ; {bit4 of E set?
 $A449 JR Z,$A487      ; }
 $A44B LD A,($5BA0)    ;
 $A44E OR A            ;
 $A44F JR Z,$A487      ;
 $A451 LD A,($5BFA)    ;
 $A454 OR A            ;
 $A455 JR NZ,$A487     ;
 $A457 LD A,($5C01)    ; get Current room number
 $A45A CP $1A          ; {room==$1A?
 $A45C JR NZ,$A465     ; }
 $A45E LD A,(IX+$01)   ;
 $A461 CP $3A          ;
 $A463 JR C,$A487      ;
*$A465 LD L,(IX+$00)   ;
 $A468 LD H,(IX+$01)   ;
 $A46B LD ($5C09),HL   ;
 $A46E LD A,(IY+$03)   ;
 $A471 OR A            ;
 $A472 JR NZ,$A487     ;
 $A474 LD A,$02        ; {status=2
 $A476 LD ($5C06),A    ; }
 $A479 LD A,$82        ;
 $A47B LD ($5C03),A    ;
 $A47E LD A,E          ; {store direction bits ($5C08)
 $A47F LD ($5C08),A    ; }
 $A482 LD A,$06        ;
 $A484 JP $C4B2        ; => Sound-effect dispatcher wrapper
*$A487 BIT 0,E         ; {right pressed?
 $A489 JR Z,$A49D      ; }
 $A48B SET 7,(IX+$03)  ;
 $A48F INC (IX+$00)    ;
 $A492 INC (IX+$00)    ;
 $A495 LD A,(IX+$00)   ; {X>=$E8? cross room right
 $A498 CP $E8          ; }
 $A49A JP NC,$A671     ; => Move right
*$A49D BIT 1,E         ; {left pressed?
 $A49F JR Z,$A4B3      ; }
 $A4A1 RES 7,(IX+$03)  ;
 $A4A5 DEC (IX+$00)    ;
 $A4A8 DEC (IX+$00)    ;
 $A4AB LD A,(IX+$00)   ;
 $A4AE CP $04          ; X<4? cross room left
 $A4B0 JP C,$A640      ; => Move left
*$A4B3 BIT 2,E         ; {down pressed?
 $A4B5 JR Z,$A4D1      ; }
 $A4B7 INC (IX+$01)    ;
 $A4BA CALL $A193      ; Check tile below-left of feet (X+12,Y+23) against
                       ; special-tile lists
 $A4BD JR Z,$A4C4      ;
 $A4BF DEC (IX+$01)    ;
 $A4C2 JR $A4D1        ;
*$A4C4 INC (IX+$01)    ;
 $A4C7 LD A,(IX+$01)   ; {Y>=$67? move down a level
 $A4CA CP $67          ; }
 $A4CC JP NC,$A6AE     ; => Move down a level
 $A4CF JR $A4E8        ;
*$A4D1 BIT 3,E         ; {up pressed?
 $A4D3 JR Z,$A50D      ; }
 $A4D5 CALL $A193      ; Check tile below-left of feet (X+12,Y+23) against
                       ; special-tile lists
 $A4D8 JR NZ,$A50D     ;
 $A4DA LD A,(IX+$01)   ;
 $A4DD DEC A           ; {Y-2 off-screen (top)?
 $A4DE JP M,$A4F1      ; }
 $A4E1 DEC A           ;
 $A4E2 JP M,$A4F1      ;
 $A4E5 LD (IX+$01),A   ;
*$A4E8 AND $06         ;
 $A4EA RRCA            ;
 $A4EB ADD A,$20       ;
 $A4ED LD (IX+$02),A   ;
 $A4F0 RET             ;
*$A4F1 LD A,($5C01)    ; get Current room number
 $A4F4 CP $18          ; room==$18?
 $A4F6 JP NZ,$A69B     ; => Move up a level
 $A4F9 PUSH IX         ;
 $A4FB CALL $A69B      ; Move up a level
 $A4FE POP IX          ;
 $A500 LD (IX+$01),$60 ; Y=$60 (top row)
 $A504 XOR A           ; {clear direction ($5C08)
 $A505 LD ($5C08),A    ; }
 $A508 LD A,$03        ; {status=3 via #R$AE85
 $A50A JP $AE85        ; }
*$A50D PUSH DE         ;
 $A50E CALL $A102      ; Clear a 4-byte record at $A0FE
 $A511 POP DE          ;
 $A512 XOR A           ;
 $A513 BIT 0,E         ; {right pressed?
 $A515 JR Z,$A51A      ; }
 $A517 LD A,(IY+$01)   ;
*$A51A BIT 1,E         ; {left pressed?
 $A51C JR Z,$A521      ; }
 $A51E LD A,(IY+$00)   ;
*$A521 OR A            ; {either direction pressed?
 $A522 JR Z,$A52E      ; }
 $A524 LD HL,($5C09)   ;
 $A527 LD (IX+$00),L   ;
 $A52A LD A,E          ;
 $A52B AND $0C         ; mask to down/up bits
 $A52D LD E,A          ;
*$A52E CALL $A193      ; Check tile below-left of feet (X+12,Y+23) against
                       ; special-tile lists
 $A531 JP Z,$A5E3      ;
 $A534 LD A,(IY+$03)   ; {already triggered? (IY+3)
 $A537 OR A            ; }
 $A538 JR Z,$A5B9      ;
 $A53A CP $05          ; {hazard timer <5?
 $A53C JR C,$A56D      ; }
 $A53E LD A,($5B98)    ; {room-category ($5B98)==5?
 $A541 CP $05          ; }
 $A543 JR Z,$A56D      ;
 $A545 LD HL,($5C09)   ;
 $A548 LD (IX+$00),L   ;
 $A54B LD (IX+$01),H   ;
 $A54E LD HL,$5C03     ;
 $A551 LD A,(HL)       ;
 $A552 AND $7F         ; {counter <3? (masked)
 $A554 CP $03          ; }
 $A556 JR Z,$A570      ;
 $A558 INC (HL)        ;
 $A559 LD A,(HL)       ; {counter reached 3?
 $A55A CP $03          ; }
 $A55C JR NZ,$A567     ;
 $A55E LD A,E          ; {store direction ($5C08)
 $A55F LD ($5C08),A    ; }
 $A562 LD A,$01        ; {status=1
 $A564 LD ($5C06),A    ; }
*$A567 LD HL,$AECD     ;
 $A56A JP $AEAF        ; => Store scripted-zone list pointer ($AEED) from HL
*$A56D OR A            ;
 $A56E JR Z,$A5B9      ;
*$A570 INC (IX+$01)    ;
 $A573 INC (IX+$01)    ;
 $A576 CALL $A102      ; Clear a 4-byte record at $A0FE
 $A579 LD A,(IY+$03)   ;
 $A57C OR A            ;
 $A57D JR Z,$A5A8      ;
 $A57F INC (IX+$01)    ;
 $A582 INC (IX+$01)    ;
 $A585 LD A,($5C01)    ; get Current room number
 $A588 CP $35          ; {room>=$35?
 $A58A JR NC,$A5A1     ; }
 $A58C BIT 7,(IX+$00)  ; {flag bit7 set? (IX+0)
 $A590 JR NZ,$A59A     ; }
 $A592 CP $10          ; {room==$10?
 $A594 JR Z,$A5A1      ; }
 $A596 CP $1C          ; {room==$1C?
 $A598 JR Z,$A5A1      ; }
*$A59A LD A,($5B98)    ; {room-category ($5B98)==5?
 $A59D CP $05          ; }
 $A59F JR Z,$A5A8      ;
*$A5A1 LD HL,$5C05     ; {bump respawn-skip counter ($5C05)
 $A5A4 INC (HL)        ; }
 $A5A5 JR NZ,$A5A8     ;
 $A5A7 DEC (HL)        ;
*$A5A8 LD E,$00        ;
 $A5AA LD A,$01        ;
 $A5AC LD ($5C04),A    ;
 $A5AF LD A,(IX+$01)   ; {Y>=$68? move down a level
 $A5B2 CP $68          ; }
 $A5B4 JP NC,$A6AE     ; => Move down a level
 $A5B7 JR $A5EA        ;
*$A5B9 LD HL,$5C05     ;
 $A5BC LD A,(HL)       ;
 $A5BD LD (HL),$00     ;
 $A5BF CP $14          ;
 $A5C1 LD A,$1A        ;
 $A5C3 CALL NC,$AE85   ;
 $A5C6 LD A,(IX+$01)   ;
 $A5C9 AND $F8         ;
 $A5CB LD (IX+$01),A   ;
 $A5CE LD A,($5C28)    ; {tile flag ($5C28) set?
 $A5D1 OR A            ; }
 $A5D2 JR Z,$A5E3      ;
 $A5D4 LD C,$02        ;
 $A5D6 CP $BC          ; {tile==$BC? pick offset
 $A5D8 JR Z,$A5DC      ; }
 $A5DA LD C,$04        ;
*$A5DC LD A,(IX+$01)   ;
 $A5DF OR C            ;
 $A5E0 LD (IX+$01),A   ;
*$A5E3 XOR A           ;
 $A5E4 LD ($5C03),A    ;
 $A5E7 LD ($5C04),A    ;
*$A5EA LD A,E          ; {any direction pressed (masked)?
 $A5EB AND $0F         ; }
 $A5ED JR Z,$A639      ;
 $A5EF PUSH AF         ;
 $A5F0 POP AF          ;
 $A5F1 LD A,($5C02)    ; get Frame counter
 $A5F4 AND $01         ; {frame odd? advance animation
 $A5F6 JR Z,$A601      ; }
 $A5F8 LD A,(IX+$02)   ;
 $A5FB INC A           ;
 $A5FC AND $03         ;
 $A5FE LD (IX+$02),A   ;
*$A601 LD A,($5BFA)    ; {sound-effect flag set?
 $A604 OR A            ; }
 $A605 JR Z,$A611      ;
 $A607 LD A,(IX+$02)   ;
 $A60A AND $03         ;
 $A60C ADD A,$3C       ;
 $A60E LD (IX+$02),A   ;
*$A611 LD A,($5B98)    ; {room-category ($5B98)==$0C?
 $A614 CP $0C          ; }
 $A616 JR NZ,$A623     ;
 $A618 LD A,(IX+$02)   ;
 $A61B CP $04          ;
 $A61D JR NC,$A623     ;
 $A61F SET 4,(IX+$02)  ;
*$A623 LD A,($5C04)    ; {any movement this frame?
 $A626 OR A            ; }
 $A627 RET Z           ;
 $A628 LD A,($5B98)    ; {room-category ($5B98)==5?
 $A62B CP $05          ; }
 $A62D RET NZ          ;
 $A62E LD A,(IY+$03)   ;
 $A631 CP $04          ;
 $A633 RET C           ;
 $A634 LD (IX+$02),$0B ;
 $A638 RET             ;
*$A639 LD A,$02        ;
 $A63B LD (IX+$02),A   ;
 $A63E JR $A601        ;

; Move left: next room = same row, col-1 (wraps), or reverse portal lookup if
; leaving room $29
;
; Used by the routines at #R$A34B, #R$A3E1 and #R$ADAC.
;
; .
;
; Handles the hero walking off the left edge of a room: works out the room to
; the west (with a special-case for the portal rooms) and switches into it.
c$A640 LD A,($5C01)    ; get Current room number
 $A643 CP $29          ; A = portal index ($5B70)
 $A645 JR NZ,$A657     ;
 $A647 LD A,($5B70)    ;
 $A64A LD L,A          ; {HL = that index
 $A64B LD H,$00        ; }
 $A64D LD DE,$A66C     ; {HL = $A66C + index
 $A650 ADD HL,DE       ; }
 $A651 LD A,(HL)       ; A = the destination room
 $A652 LD ($5C01),A    ; set Current room number
 $A655 JR $A665        ;
*$A657 CALL $AEEF      ; Decode room number ($5C01) to row/col
 $A65A LD A,C          ;
 $A65B SUB $01         ;
 $A65D JR NC,$A661     ;
 $A65F LD A,$0B        ;
*$A661 LD C,A          ;
 $A662 CALL $AEFD      ; Encode row/col to room number
*$A665 LD (IX+$00),$E6 ;
 $A669 JP $9855        ; => Set up the current room

; Portal source rooms
;
; .
;
; .
;
; Table of 5 "portal" source room numbers; any room matching one of these
; forces a jump to fixed room $29 on exit-right, instead of normal row/col+1
; grid math. Referenced by #R$A671 and #R$A64D.
b$A66C DEFB $2D,$2E,$2F,$46,$47 ; portal source rooms: $2D,$2E,$2F,$46,$47

; Move right: next room = same row, col+1 (wraps 12->0); portal check via
; #R$A66C
;
; Used by the routines at #R$A3E1 and #R$ADAC.
;
; .
;
; Decodes current room ($5C01) to (row,col) via #R$AEEF, increments col (wraps
; at 12), re-encodes via #R$AEFD, places player near the left edge of the new
; room ((IX+0)=$02), then redraws (#R$9855). If the current room is listed in
; #R$A66C, jumps straight to room $29 instead.
c$A671 LD HL,$A66C     ;
 $A674 LD B,$05        ;
 $A676 LD A,($5C01)    ; get Current room number
*$A679 CP (HL)         ;
 $A67A JR Z,$A694      ;
 $A67C INC HL          ;
 $A67D DJNZ $A679      ;
 $A67F CALL $AEEF      ; Decode room number ($5C01) to row/col
 $A682 LD A,C          ;
 $A683 INC A           ;
 $A684 CP $0C          ;
 $A686 JR NZ,$A689     ;
 $A688 XOR A           ;
*$A689 LD C,A          ;
 $A68A CALL $AEFD      ; Encode row/col to room number
*$A68D LD (IX+$00),$02 ;
 $A691 JP $9855        ; => Set up the current room
*$A694 LD A,$29        ;
 $A696 LD ($5C01),A    ; set Current room number
 $A699 JR $A68D        ;

; Move up a level: row-1, blocked at row<0
;
; Used by the routines at #R$A3E1, #R$AC35, #R$AD17, #R$AD32 and #R$AE37.
;
; .
;
; Decodes room to (row,col) via #R$AEEF, decrements row (B); if it underflows
; (already on the topmost level), leaves the room unchanged. Otherwise
; re-encodes via #R$AEFD, places player near the bottom edge of the new room
; ((IX+1)=$66), then redraws (#R$9855).
c$A69B CALL $AEEF      ; Decode room number ($5C01) to row/col
 $A69E LD A,B          ;
 $A69F SUB $01         ;
 $A6A1 JR C,$A6C2      ;
 $A6A3 LD B,A          ;
 $A6A4 CALL $AEFD      ; Encode row/col to room number
 $A6A7 LD (IX+$01),$66 ;
 $A6AB JP $9855        ; => Set up the current room

; Move down a level: row+1, blocked at row=6 (only 6 levels)
;
; Used by the routines at #R$A3E1, #R$A9C4, #R$AC35, #R$AD32 and #R$AF09.
;
; .
;
; Decodes room to (row,col) via #R$AEEF, increments row (B); if it reaches 6
; (only 6 vertical levels exist), leaves the room unchanged. Otherwise
; re-encodes via #R$AEFD, places player near the top edge of the new room
; ((IX+1)=$02), then redraws (#R$9855).
c$A6AE CALL $AEEF      ; Decode room number ($5C01) to row/col
 $A6B1 LD A,B          ;
 $A6B2 INC A           ;
 $A6B3 CP $06          ;
 $A6B5 JR Z,$A6C2      ;
 $A6B7 LD B,A          ;
 $A6B8 CALL $AEFD      ; Encode row/col to room number
 $A6BB LD (IX+$01),$02 ;
 $A6BF JP $9855        ; => Set up the current room
; This entry point is used by the routine at #R$A69B.
*$A6C2 LD HL,($5C09)   ;
 $A6C5 LD (IX+$00),L   ;
 $A6C8 LD (IX+$01),H   ;
 $A6CB RET             ;

; Room-state dispatch: jump via table at $A72E, indexed by ($5C06)
;
; Used by the routine at #R$A3E1.
;
; .
;
; Jumps to whichever handler matches the hero's current status, via a jump
; table - this is how a status code set by #R$AE85 actually turns into
; behaviour each frame.
c$A6CC LD A,($5C06)  ; A = status ($5C06)
 $A6CF OR A          ; {zero? nothing to dispatch
 $A6D0 RET Z         ; }
 $A6D1 LD C,$FF      ;
 $A6D3 DEC A         ; {(status-1) * 2
 $A6D4 ADD A,A       ; }
 $A6D5 LD L,A        ; {HL = that index
 $A6D6 LD H,$00      ; }
 $A6D8 PUSH DE       ;
 $A6D9 LD DE,$A72E   ; {HL = $A72E + index
 $A6DC ADD HL,DE     ; }
; This entry point is used by the routine at #R$B7DD.
*$A6DD LD E,(HL)     ; {DE = handler address
 $A6DE INC HL        ; }
 $A6DF LD D,(HL)     ;
 $A6E0 EX DE,HL      ; {into HL, restore DE
 $A6E1 POP DE        ; }
 $A6E2 LD A,H        ; {no handler?
 $A6E3 OR L          ; }
 $A6E4 RET Z         ;
 $A6E5 JP (HL)       ; jump to it

; Data block at A6E6
b$A6E6 DEFB $FF,$05,$FF,$FF,$05,$FF,$FF,$08
 $A6EE DEFB $0A,$1A,$05,$05,$FF,$FF,$FF,$07
