; Sound-effect dispatcher wrapper: save regs, call #R$C4BC
;
; Used by the routines at #R$A3E1, #R$A8AB, #R$AA3C, #R$B0B6, #R$BB5D and
; #R$BFF6.
;
; A sound-effect index (0-6)
;
; Plays a sound effect by number without disturbing any registers - the generic
; "make this sound" entry point called from all over the game.
c$C4B2 PUSH HL       ;
 $C4B3 PUSH DE       ;
 $C4B4 PUSH BC       ;
 $C4B5 CALL $C4BC    ; Sound-effect table lookup
 $C4B8 POP BC        ;
 $C4B9 POP DE        ;
 $C4BA POP HL        ;
 $C4BB RET           ;

; Sound-effect table lookup ($C55B): push handler address, E=$10, tail-call
;
; Used by the routine at #R$C4B2.
;
; .
;
; Turns a sound-effect number into the address of its player routine and
; tail-jumps there, so the effect runs as if it had been called directly.
c$C4BC CP $07        ; {index past 6? RET
 $C4BE RET NC        ; }
 $C4BF ADD A,A       ; index *= 2
 $C4C0 LD L,A        ; {HL = index
 $C4C1 LD H,$00      ; }
 $C4C3 LD DE,$C55B   ; {HL = $C55B + index
 $C4C6 ADD HL,DE     ; }
 $C4C7 LD E,(HL)     ; {DE = handler address
 $C4C8 INC HL        ; }
 $C4C9 LD D,(HL)     ;
 $C4CA PUSH DE       ; push it as the return address
 $C4CB LD E,$10      ; E=$10 (speaker bit mask)
 $C4CD RET           ;

; Beeper tone-sweep effect (raw OUT $FE)
;
; .
;
; .
;
; Sweeps the beeper through a falling pitch by halving its delay each pass - a
; short "whoop" cue rather than a fixed tone.
c$C4CE LD H,$7F      ; H=$7F (sweep count)
*$C4D0 XOR A         ;
 $C4D1 LD B,$0A      ; B=$0A (bit count)
*$C4D3 PUSH BC       ;
 $C4D4 LD B,H        ; B = H (duty)
*$C4D5 OUT ($FE),A   ; toggle beeper
 $C4D7 EX (SP),HL    ; {delay
 $C4D8 EX (SP),HL    ; }
 $C4D9 DJNZ $C4D5    ; loop duty
 $C4DB XOR $10       ; flip the speaker bit
 $C4DD POP BC        ;
 $C4DE DJNZ $C4D3    ; loop bits
 $C4E0 SRL H         ; {H >>= 2 (raise the pitch)
 $C4E2 SRL H         ; }
 $C4E4 LD A,H        ; {H reached 0?
 $C4E5 OR A          ; }
 $C4E6 JR NZ,$C4D0   ;
 $C4E8 RET           ;

; Play sound effect (raw OUT $FE beeper timing loop)
;
; .
;
; .
;
; A beeper sound-effect player: plays back a sample, then a tone sweep,
; entirely through timed port writes rather than an interrupt-driven player.
c$C4E9 LD HL,$0000   ; HL=0 (sample pointer)
 $C4EC LD BC,$2328   ; BC=$2328 (sample count)
*$C4EF LD A,$23      ; {delay = $23 - B
 $C4F1 SUB B         ; }
 $C4F2 JR Z,$C4F9    ; zero? no delay
 $C4F4 PUSH BC       ;
 $C4F5 LD B,A        ; B = delay
*$C4F6 DJNZ $C4F6    ; busy-wait
 $C4F8 POP BC        ;
*$C4F9 LD A,(HL)     ; {read sample byte
 $C4FA INC HL        ; }
 $C4FB AND E         ; {mask and send to speaker
 $C4FC OUT ($FE),A   ; }
 $C4FE DEC BC        ; BC -= 4 (four DEC BC)
 $C4FF DEC BC        ;
 $C500 DEC BC        ;
 $C501 DEC BC        ;
 $C502 LD A,C        ; {count exhausted?
 $C503 OR B          ; }
 $C504 JR NZ,$C4EF   ;
 $C506 LD H,$03      ; H=3 (sweep count)
*$C508 XOR A         ;
 $C509 LD B,$0A      ; B=$0A (bit count)
*$C50B PUSH BC       ;
 $C50C LD B,H        ; B = H (duty)
*$C50D OUT ($FE),A   ; toggle speaker
 $C50F EX (SP),HL    ; {delay
 $C510 EX (SP),HL    ; }
 $C511 DJNZ $C50D    ; loop duty
 $C513 XOR $10       ; flip the speaker bit
 $C515 POP BC        ;
 $C516 DJNZ $C50B    ; loop bits
 $C518 SCF           ; {shift a 1 into H
 $C519 RL H          ; }
 $C51B LD A,H        ; {H all ones?
 $C51C CP $FF        ; }
 $C51E JR NZ,$C508   ;
 $C520 RET           ;

; Play noise-type sound effect (R-register based)
;
; .
;
; .
;
; Makes a noise burst by toggling the speaker with bits taken from low ROM
; ($0000-$003F) at an offset driven by the refresh register - a cheap random
; source, so the result is hiss rather than a tone.
c$C521 LD B,$64      ;
*$C523 LD A,R        ; A = R (refresh counter, pseudo-random)
 $C525 AND $3F       ; {index 0-$3F into low ROM
 $C527 LD L,A        ; }
 $C528 LD H,$00      ;
 $C52A LD A,(HL)     ; {read ROM byte, keep only the speaker bit
 $C52B AND $10       ; }
 $C52D OUT ($FE),A   ;
 $C52F DJNZ $C523    ;
 $C531 RET           ;

; Beeper tone effect variant A (HL=$03C8), falls into #R$C53A
c$C532 LD HL,$03C8   ;
 $C535 JR $C53A      ;

; Beeper tone effect variant B (HL=$0564)
;
; .
;
; .
;
; Plays a fixed-pitch beep by toggling the speaker on a timed loop - the
; longer-period twin of #R$C532.
c$C537 LD HL,$0564   ; HL=$0564 (tone period)
; This entry point is used by the routine at #R$C532.
*$C53A XOR A         ; {A=0, B = period
 $C53B LD B,L        ; }
 $C53C OUT ($FE),A   ; speaker low
*$C53E DJNZ $C53E    ; busy-wait
 $C540 LD A,E        ; {speaker high
 $C541 OUT ($FE),A   ; }
 $C543 LD B,L        ; B = period again
*$C544 DJNZ $C544    ; {busy-wait delay
 $C546 DEC H         ; }
 $C547 JR NZ,$C53A   ; loop until H runs out
 $C549 RET           ;

; Data block at C54A
b$C54A DEFB $21

; Beeper noise/sample effect (raw OUT $FE)
;
; .
;
; .
;
; Plays a short noise burst by streaming bytes straight to the speaker port,
; used for impact-type effects.
c$C54B NOP           ; {timing pad (two NOPs)
 $C54C NOP           ; }
 $C54D LD B,L        ; B = outer count
*$C54E LD C,$05      ; C=5 (inner count)
*$C550 LD A,(HL)     ; {read a sample byte, mask it
 $C551 AND E         ; }
 $C552 OUT ($FE),A   ; send it to the speaker
 $C554 INC HL        ; {advance, count down
 $C555 DEC C         ; }
 $C556 JR NZ,$C550   ; loop 5 bytes
 $C558 DJNZ $C54E    ; loop the outer count
 $C55A RET           ;

