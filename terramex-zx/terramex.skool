 $992F LD L,A        ; {HL = back_tile_index*16
 $9930 LD H,$00      ;
 $9932 ADD HL,HL     ;
 $9933 ADD HL,HL     ;
 $9934 ADD HL,HL     ;
 $9935 ADD HL,HL     ; }
 $9936 LD DE,$C600   ; {HL = back-tile definition ($C600 + back_tile_index*16)
 $9939 ADD HL,DE     ; }
