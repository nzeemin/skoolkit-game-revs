b$8F39 DEFB $0E,$35,$3A,$03,$5B,$B7,$28,$02
 $8F41 DEFB $0E,$B7,$79,$32,$FD,$A9

; Show main menu, then initialize game state
;
; .
;
; .
;
; After #R$93AF returns (device chosen, "0" pressed): pages in a helper 128K
; bank to run a setup routine at $C000 if needed, clears game variable tables,
; resets item/collision flags, blits the background graphic ($E000 -> $5000,
; one screen third + extra strip), sets up pointers/counters, clears the
; object-state table at $5BFA, sets the level data pointer ($5C25=$6070,
; $5C27=$0F, purpose unconfirmed - not total room count, game has 66+ rooms),
; then redraws the screen before falling through into the main game loop at
; $9018 (per-frame updates, respawn-in-room handling via $9090 after a life is
; lost, and game-over exit back to this same routine via $906D/$908D).
c$8F47 CALL $93AF    ; Main menu
 $8F4A LD A,($5FFE)  ; {128K: check paging flag $5FFE
 $8F4D OR A          ;
 $8F4E JR Z,$8F69    ; }
 $8F50 LD BC,$7FFD   ; {128K: page in bank, call $C000, restore paging
 $8F53 LD A,$11      ;
 $8F55 PUSH BC       ;
 $8F56 LD ($5FE5),A  ;
 $8F59 OUT (C),A     ;
 $8F5B LD BC,$C000   ;
 $8F5E CALL $C000    ;
 $8F61 POP BC        ;
 $8F62 LD A,$10      ;
 $8F64 LD ($5FE5),A  ;
 $8F67 OUT (C),A     ; }
*$8F69 LD HL,$5B04   ; {clear $5B04-$5B66 (99 bytes)
 $8F6C LD BC,$0063   ;
 $8F6F LD DE,$5B05   ;
 $8F72 LD (HL),$00   ; }
 $8F74 LDIR          ;
 $8F76 LD HL,$5B7C   ; {clear inventory ($5B7C-$5B95, 26 bytes) to $FF
 $8F79 LD DE,$5B7D   ;
 $8F7C LD BC,$001A   ;
 $8F7F LD (HL),$FF   ; }
 $8F81 LDIR          ;
 $8F83 CALL $B932    ; {Clear active flag (bit7) across all $B99D
 $8F86 LD HL,$B9D9   ; creature-table entries
 $8F89 SET 7,(HL)    ; }
 $8F8B LD HL,$E000   ; {copy background $E000 -> $5000 (one screen third)
 $8F8E LD DE,$5000   ;
 $8F91 LD BC,$0800   ;
 $8F94 LDIR          ; }
 $8F96 LD DE,$5A00   ; {copy extra strip to $5A00
 $8F99 LD BC,$0100   ;
 $8F9C LDIR          ; }
 $8F9E LD HL,$F000   ; {buffer base pointer ($5B72)=$F000
 $8FA1 LD ($5B72),HL ; }
 $8FA4 LD A,$FF      ; {reset sentinels/counters to $FF; $A6F5=7 (per-room
 $8FA6 LD ($5C3C),A  ; tuning value, overridden to 6 for room $10 by #R$9880;
 $8FA9 LD ($A6FD),A  ; not lives - lives is $5B97 per the Infinite Lives POKE)
 $8FAC LD ($A700),A  ;
 $8FAF LD ($5B98),A  ;
 $8FB2 LD ($5B9B),A  ;
 $8FB5 LD A,$07      ;
 $8FB7 LD ($A6F5),A  ; }
 $8FBA XOR A         ; {reset counter $5B06
 $8FBB LD ($5B06),A  ; }
 $8FBE LD HL,$5BFA   ; {clear object-state table at $5BFA (147 bytes)
 $8FC1 LD DE,$5BFB   ;
 $8FC4 LD BC,$0093   ;
