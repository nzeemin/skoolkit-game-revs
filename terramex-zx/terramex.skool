; Decode room's creatures/hazards from the room data table ($C152)
;
; Used by the routine at #R$9855.
;
; A room number
;
; A = current room number (from $5C01, still live in A when #R$9855 falls
; through into this). HL = $C152 + A*12 - the room data table, one 12-byte
; record per room (0-based, matching the level*12+col numbering). Clears a
; 29-byte scratch buffer at $BE24, then decodes the record as 3 sub-records of
; 4 raw bytes each: byte0 low nibble (creature type ID, written twice - see
; #R$C152), byte0 bit7 (flag), byte0 bits4-6 (3-bit field), byte1 and byte2
; (raw copy), byte3 low 7 bits and byte3 bit7 (separately). 3 creature/hazard
; slots per room; all-zero sub-record = empty slot. Meaning of byte1-3 within a
; filled slot (position? behavior?) not yet confirmed. Returns A unchanged
; (original value restored via the outer PUSH/POP AF).
c$BE42 PUSH AF       ; save A (room number)
 $BE43 LD HL,$BE24   ;
 $BE46 LD DE,$BE25   ;
 $BE49 LD BC,$001D   ;
 $BE4C LD (HL),$00   ; {clear 29-byte scratch buffer
 $BE4E LDIR          ; }
 $BE50 LD L,A        ;
 $BE51 LD H,$00      ;
 $BE53 ADD HL,HL     ;
 $BE54 ADD HL,HL     ;
 $BE55 PUSH HL       ;
 $BE56 ADD HL,HL     ;
 $BE57 POP DE        ;
 $BE58 ADD HL,DE     ;
 $BE59 LD DE,$C152   ; {HL = room data table + A*12
 $BE5C ADD HL,DE     ; }
 $BE5D LD DE,$BE24   ;
 $BE60 LD B,$03      ;
*$BE62 PUSH DE       ;
 $BE63 LD A,(HL)     ;
 $BE64 PUSH AF       ;
 $BE65 AND $0F       ; byte0 low nibble = creature type ID
 $BE67 LD (DE),A     ;
 $BE68 INC DE        ;
 $BE69 LD (DE),A     ;
 $BE6A INC DE        ;
 $BE6B POP AF        ;
 $BE6C AND $80       ; byte0 bit7 = flag
 $BE6E LD (DE),A     ;
 $BE6F INC DE        ;
 $BE70 LD A,(HL)     ;
 $BE71 RRCA          ;
 $BE72 RRCA          ;
 $BE73 RRCA          ;
 $BE74 RRCA          ;
 $BE75 AND $07       ; byte0 bits4-6
 $BE77 LD (DE),A     ;
 $BE78 INC DE        ;
 $BE79 INC HL        ;
 $BE7A LD A,(HL)     ;
 $BE7B LD (DE),A     ;
 $BE7C INC DE        ;
 $BE7D INC HL        ;
 $BE7E LD A,(HL)     ;
 $BE7F LD (DE),A     ;
 $BE80 INC DE        ;
 $BE81 INC HL        ;
 $BE82 LD A,(HL)     ;
 $BE83 AND $7F       ;
 $BE85 LD (DE),A     ;
 $BE86 INC DE        ;
 $BE87 LD A,(HL)     ;
 $BE88 AND $80       ;
 $BE8A LD (DE),A     ;
 $BE8B INC HL        ;
 $BE8C POP DE        ;
 $BE8D PUSH HL       ;
 $BE8E LD HL,$000A   ; {advance output pointer +10, next slot
 $BE91 ADD HL,DE     ; }
 $BE92 EX DE,HL      ;
 $BE93 POP HL        ;
 $BE94 DJNZ $BE62    ;
 $BE96 POP AF        ; {restore A, return
 $BE97 RET           ; }

; Dispatch per-creature-type init (jump table $BECA) for the 3 hazard slots
;
; Used by the routine at #R$8F47.
c$BE98 LD B,$03      ; {B=3 slots; DE=decoded record ($BE24); IX=$5B08 object
 $BE9A LD DE,$BE24   ; base
 $BE9D PUSH IX       ;
 $BE9F LD IX,$5B08   ; }
*$BEA3 PUSH BC       ;
 $BEA4 PUSH DE       ;
 $BEA5 LD A,(DE)     ; {HL = creature type * 2
 $BEA6 LD L,A        ;
 $BEA7 LD H,$00      ;
 $BEA9 ADD HL,HL     ; }
 $BEAA LD BC,$BECA   ; {HL = jump table entry ($BECA + type*2)
 $BEAD ADD HL,BC     ; }
 $BEAE LD A,(HL)     ; {HL = jump target address
 $BEAF INC HL        ;
 $BEB0 LD H,(HL)     ;
 $BEB1 LD L,A        ; }
 $BEB2 PUSH DE       ; {IY=record pointer; CALL #R$BEC9 (trampoline to type
 $BEB3 POP IY        ; handler)
 $BEB5 CALL $BEC9    ; }
 $BEB8 LD DE,$0004   ; {IX += 4 (next object slot)
 $BEBB ADD IX,DE     ; }
 $BEBD POP DE        ; {advance DE by 10, next record
 $BEBE LD HL,$000A   ;
 $BEC1 ADD HL,DE     ;
 $BEC2 EX DE,HL      ;
 $BEC3 POP BC        ;
 $BEC4 DJNZ $BEA3    ; }
 $BEC6 POP IX        ;
 $BEC8 RET           ;

; Jump to handler in HL (dispatch tail of #R$BE98)
;
; Used by the routine at #R$BE98.
