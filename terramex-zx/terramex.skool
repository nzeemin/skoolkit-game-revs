 $B443 POP AF          ;
 $B444 CALL Z,$B47E    ; Move object down toward floor, bounce via #R$B4A3
 $B447 LD A,E          ;
 $B448 OR A            ;
 $B449 RET NZ          ;
 $B44A CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $B44D RET NC          ;
 $B44E LD (HL),$02     ;
 $B450 LD A,($5C40)    ;
 $B453 XOR $01         ;
 $B455 LD ($5C40),A    ;
 $B458 LD A,$15        ;
 $B45A LD ($5C06),A    ;
