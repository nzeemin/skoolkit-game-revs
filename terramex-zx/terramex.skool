; Set up the current room (called right after every room-number change)
;
; Used by the routines at #R$8F47, #R$935D, #R$A640, #R$A671, #R$A69B, #R$A6AE,
; #R$A8EA and #R$B6EE.
;
; .
;
; A = current room number (from #R$BE42, still live from $5C01). If it's $2C,
; forces ($5C34)=$FF02. Then checks the room number against a bit7-terminated
; list at $9AF5; if matched and $5C05=0, calls #R$9AA1. Falls through into
; #R$9880 to run the per-room setup (music, hazard-count tuning, moving-lift
; init, etc). Called after every #R$AEFD room-number write we've found:
; #R$A671/#R$A69B/#R$A6AE (edge transitions), #R$9090 (respawn), and #R$8F47
; (init) - the actual "build new room" entry point.
c$9855 PUSH AF       ;
 $9856 CALL $BE42    ; Decode room's creatures/hazards from the room data table
 $9859 CP $2C        ;
 $985B JR NZ,$9863   ;
 $985D LD HL,$FF02   ;
 $9860 LD ($5C34),HL ;
*$9863 LD HL,$9AF5   ;
*$9866 BIT 7,(HL)    ;
 $9868 JR NZ,$9877   ;
 $986A CP (HL)       ;
 $986B JR Z,$9870    ;
 $986D INC HL        ;
 $986E JR $9866      ;
*$9870 LD A,($5C05)  ;
 $9873 OR A          ;
 $9874 CALL Z,$9AA1  ; Snapshot current room/position into respawn staging
*$9877 POP AF        ;
 $9878 PUSH IX       ;
 $987A CALL $9880    ; Per-room setup
 $987D POP IX        ;
 $987F RET           ;

; Per-room setup (music, hazard tuning, lift init)
;
; Used by the routine at #R$9855.
;
; .
;
; Checks the room number (from #R$9855) against a 15-entry table at $9AC6 to
; decide the music track (toggled via #R$918D). Clears $5BA2 and calls #R$9914
; (builds the room's tile background), then initializes a 31-byte
; command/animation list at $9AD5 via #R$9A8C. Resets several per-room counters
; ($5C0C, $5C41, $5BA1) and sets $B072=1. Room $10 sets $A6F5=6 (a per-room
; tuning value - default is 7, set at #R$8F47). Room $1C, if $5C24 is set,
; fills a 12-entry table at $F808 with pointers to $9998 spaced 31 bytes apart
; - looks like moving-lift/platform setup (matches sprite #31 "Lift"). Finishes
; by clearing $5C24 and calling #R$917C.
c$9880 PUSH AF       ;
 $9881 LD HL,$9AC6   ; HL=music-track table ($9AC6)
 $9884 LD B,$0F      ;
*$9886 CP (HL)       ;
 $9887 JR Z,$9895    ;
 $9889 INC HL        ;
 $988A DJNZ $9886    ;
 $988C LD A,($918C)  ;
 $988F OR A          ;
 $9890 CALL NZ,$918D ; Swap music data buffers, toggling the music flag
 $9893 JR $989C      ;
*$9895 LD A,($918C)  ;
 $9898 OR A          ;
 $9899 CALL Z,$918D  ; Swap music data buffers, toggling the music flag
*$989C POP AF        ;
 $989D PUSH AF       ;
 $989E LD HL,$0000   ;
 $98A1 LD ($5BA2),HL ;
 $98A4 CALL $9914    ; Build room background from its back-tile map
 $98A7 LD HL,$9AD5   ;
 $98AA LD DE,$9AD6   ;
 $98AD LD BC,$001F   ;
 $98B0 LD (HL),$00   ;
 $98B2 LDIR          ;
 $98B4 LD C,$B5      ;
 $98B6 LD A,($918C)  ;
 $98B9 OR A          ;
 $98BA JR Z,$98BE    ;
 $98BC LD C,$DD      ; C=$DD if music playing
*$98BE LD A,C        ;
 $98BF LD DE,$9AD5   ;
 $98C2 CALL $9A8C    ; Find all tile-map ($F800) positions matching A, store
                     ; coords list at DE
 $98C5 LD A,($918C)  ;
 $98C8 OR A          ;
 $98C9 JR Z,$98D3    ;
 $98CB LD DE,$9AE5   ;
 $98CE LD A,$8C      ;
 $98D0 CALL $9A8C    ; Find all tile-map ($F800) positions matching A, store
                     ; coords list at DE
*$98D3 XOR A         ;
 $98D4 LD ($5C0C),A  ;
 $98D7 LD ($5C41),A  ;
 $98DA LD ($5BA1),A  ;
 $98DD INC A         ;
 $98DE LD ($B072),A  ;
 $98E1 POP AF        ;
 $98E2 CP $10        ;
 $98E4 JR NZ,$98ED   ;
 $98E6 PUSH AF       ;
 $98E7 LD A,$06      ; {room $10: $A6F5=6
 $98E9 LD ($A6F5),A  ; }
 $98EC POP AF        ;
*$98ED CP $1C        ;
 $98EF JR NZ,$9907   ;
 $98F1 LD A,($5C24)  ;
 $98F4 OR A          ;
 $98F5 JR Z,$9907    ;
 $98F7 LD B,$0C      ;
 $98F9 LD HL,$F808   ;
*$98FC LD (HL),$98   ; {lift table entries point to $9998
 $98FE INC HL        ; }
 $98FF LD (HL),$99   ;
 $9901 LD DE,$001F   ; lift table stride = 31 bytes
 $9904 ADD HL,DE     ;
 $9905 DJNZ $98FC    ;
*$9907 XOR A         ; {clear $5C24
