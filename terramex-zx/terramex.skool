c$94EF LD DE,$9540   ; string: "1 : KEYBOARD" (#R$9540)
 $94F2 LD HL,$4808   ; position: row 1, col 8
 $94F5 EX AF,AF'     ;
 $94F6 LD A,$44      ;
 $94F8 EX AF,AF'     ;

; Print string from DE at screen HL, attr in AF'
;
; Used by the routine at #R$93AF.
;
; DE string address (null-terminated, $0D=newline)
; HL screen address
; AF' attribute byte
;
; A generic text printer: draws a null-terminated string at a screen position
; in a given color, character by character.
c$94F9 LD ($9517),HL ;
*$94FC LD A,(DE)     ; read a character
 $94FD INC DE        ;
 $94FE OR A          ; {zero terminator? done
 $94FF RET Z         ; }
