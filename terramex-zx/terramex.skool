 $9474 LD E,$00      ; E=0
 $9476 CP $1E        ; {key 1?
 $9478 JR Z,$9484    ; }
 $947A INC E         ;
 $947B CP $1D        ; {key 2? (E=1)
 $947D JR Z,$9484    ; }
 $947F INC E         ;
 $9480 CP $1B        ; {key 3? (E=2)
 $9482 JR NZ,$9488   ; }
*$9484 LD A,E        ; {store selected device
 $9485 LD ($94AF),A  ; }
*$9488 LD B,$EF      ; {read key row $EFFE
 $948A IN A,(C)      ; }
 $948C AND $01       ; mask key 0
 $948E RET Z         ; key 0? start the game
 $948F JR $9440      ; else keep polling

; Interrupt handler: page in 128K bank $16, call music player #R$C000, restore,
; EI
;
; Used by the routine at #R$5F5F.
;
; .
;
; The interrupt handler. Pages in the 128K RAM bank holding the music player,
; calls it, then restores the previous paging and re-enables interrupts.
c$9491 PUSH AF       ;
 $9492 LD A,($5FFE)  ; {A = 128K flag ($5FFE)
 $9495 OR A          ; }
 $9496 JR Z,$94AC    ; not 128K? skip paging
 $9498 PUSH BC       ;
 $9499 LD BC,$7FFD   ; {BC=$7FFD, A=bank $16
 $949C LD A,$16      ; }
 $949E OUT (C),A     ; page it in
 $94A0 CALL $C000    ; CALL music player #R$C000
 $94A3 LD A,($5FE5)  ; {A = saved bank ($5FE5)
 $94A6 LD BC,$7FFD   ; }
 $94A9 OUT (C),A     ; page it back
 $94AB POP BC        ; {restore BC/AF
*$94AC POP AF        ; }
 $94AD EI            ; re-enable interrupts
 $94AE RET           ;

; Input device selector
b$94AF DEFB $00      ; Input device: 0=keyboard, 1=Kempston, 2=Sinclair 2

; Blit 32x8 byte block (menu border-frame graphic)
;
; Used by the routine at #R$93AF.
;
; HL source address
; DE destination address
;
; Copies 32 bytes per row for 8 rows, advancing both HL and DE down one pixel
; row each time (plain INC H/INC D, no char-row wrap fixup - source and dest
; must stay within one screen third).
c$94B0 LD B,$08      ; B=8 rows
*$94B2 PUSH BC       ; save BC/HL/DE
 $94B3 PUSH HL       ;
 $94B4 PUSH DE       ;
 $94B5 LD BC,$0020   ; BC=$20 bytes
 $94B8 LDIR          ; copy one row
 $94BA POP DE        ; {restore DE/HL
 $94BB POP HL        ; }
 $94BC INC D         ; {both to the next pixel row
 $94BD INC H         ; }
 $94BE POP BC        ; restore BC
 $94BF DJNZ $94B2    ; loop 8 rows
 $94C1 RET           ;

; Draw left/right piece at HL/DE, then advance to next screen third
;
; Used by the routine at #R$93AF.
;
;   HL left-piece screen address
;   DE right-piece screen address
; O:HL/DE advanced to next screen third
;
; Draws one row of the menu's left and right border pieces and steps both
; positions down to the next row - called repeatedly to build the whole frame.
c$94C2 PUSH DE       ;
 $94C3 PUSH HL       ;
 $94C4 CALL $94E4    ; Blit 1x8 byte column (menu border piece)
 $94C7 POP HL        ;
 $94C8 POP DE        ;
 $94C9 LD A,L        ; {L to the row-end column
 $94CA OR $1F        ; }
 $94CC LD L,A        ;
 $94CD LD A,E        ; {same for E
 $94CE OR $1F        ; }
 $94D0 LD E,A        ;
 $94D1 PUSH DE       ;
 $94D2 PUSH HL       ;
 $94D3 CALL $94E4    ; Blit 1x8 byte column (menu border piece)
 $94D6 POP HL        ;
 $94D7 POP DE        ;
 $94D8 LD A,E        ; {E to the next third column
 $94D9 AND $E0       ; }
 $94DB ADD A,$20     ; {carry set if it wrapped
 $94DD LD E,A        ; }
 $94DE RET NC        ;
 $94DF LD A,D        ; {wrapped: D += 8 (next third row)
 $94E0 ADD A,$08     ; }
 $94E2 LD D,A        ;
 $94E3 RET           ;

; Blit 1x8 byte column (menu border piece)
;
; Used by the routine at #R$94C2.
;
;   HL source address
;   DE destination address
; O:HL/DE +8 (next third down)
;
; Copies one 8-pixel-tall column of graphic data - the smallest building block
; of the menu border-drawing code.
c$94E4 PUSH BC       ;
 $94E5 LD B,$08      ;
*$94E7 LD A,(HL)     ;
 $94E8 LD (DE),A     ;
 $94E9 INC H         ;
 $94EA INC D         ;
 $94EB DJNZ $94E7    ;
 $94ED POP BC        ;
 $94EE RET           ;

