; Alternate-tileset flag
;
; .
;
; .
;
; Selects which of the two tile sets is currently swapped into place: 0 = base
; set, $FF = alternate. Toggled only by #R$918D, which is called from #R$9880
; on every room entry to match the room against the list at $9AC6 (and from
; #R$8F47/#R$9090 to force it back to 0). Read at 16 sites to pick the matching
; variant of the solid/special tile lists, the sparkle effect lists and the
; draw routines - the most-referenced flag in the disassembly. It is not a
; music flag; the music player is the separate paged-bank routine reached via
; #R$9491.
b$918C DEFB $00      ; 0=base tileset, $FF=alternate tileset

; Swap the alternate tileset in/out, toggling ($918C)
;
; Used by the routines at #R$8F47 and #R$9880.
;
; .
;
; Exchanges the upper half of the tile bitmap table ($F400, 1K = 128 tiles of 8
; bytes) with the spare copy held at $FA00, and the matching 128 per-tile
; attribute bytes at $C580 with those at $DF80, then flips the ($918C) flag.
; Swapping rather than copying means the set that was in use is preserved for
; the next call, so rooms can move back and forth between the two sets at no
; cost.
c$918D LD A,($918C)  ; {save the current flag
 $9190 PUSH AF       ; }
 $9191 LD HL,$FA00   ; {HL/DE = region 1 ($FA00/$F400)
 $9194 LD DE,$F400   ; }
 $9197 LD BC,$0400   ; BC=$400 bytes
*$919A PUSH BC       ;
 $919B LD C,(HL)     ; {read both bytes
 $919C LD A,(DE)     ; }
 $919D LD (HL),A     ; write the first back
 $919E LD A,C        ;
 $919F LD (DE),A     ;
 $91A0 POP BC        ;
 $91A1 DEC BC        ; count one byte off
 $91A2 INC HL        ; {advance both pointers
 $91A3 INC DE        ; }
 $91A4 LD A,C        ; {count reached zero?
 $91A5 OR B          ; }
 $91A6 JR NZ,$919A   ;
 $91A8 LD HL,$C580   ; HL=$C580
 $91AB LD B,$80      ; B=$80 bytes
 $91AD LD DE,$DF80   ; DE=$DF80
*$91B0 LD C,(HL)     ;
 $91B1 LD A,(DE)     ;
 $91B2 LD (HL),A     ;
 $91B3 LD A,C        ;
 $91B4 LD (DE),A     ;
 $91B5 INC DE        ;
 $91B6 INC HL        ;
 $91B7 DJNZ $91B0    ;
 $91B9 POP AF        ;
 $91BA XOR $FF       ; {flip and store the tileset flag
 $91BC LD ($918C),A  ; }
 $91BF RET           ;

