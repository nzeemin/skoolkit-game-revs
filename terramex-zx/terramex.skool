 $5B20 DEFB $5B,$E6,$EF,$32
; Previous frame's copy of the draw cache at $5B44, taken by the LDIR at the
; end of #R$9B22. #R$9BEB erases from it by being called with IX=$5AE4, which
; is not a real object array - it is just $5B24-$40, chosen so the routine's
; (IX+$40)/(IX+$41) reads land here. Nothing ever writes the $5AE4-$5AF7 bytes
; those offsets nominally belong to.
 $5B24 DEFB $5C,$5B,$01,$FD,$7F,$ED,$79,$FB ; {previous frame's draw cache
 $5B2C DEFB $C3,$C3,$00,$21,$D8,$06,$18,$03 ; (copy of $5B44)
 $5B34 DEFB $21,$CA,$07,$08,$01,$FD,$7F,$3A ;
 $5B3C DEFB $5C,$5B,$F5,$E6,$EF,$F3,$32,$5C ; }
; Current frame's draw cache for the 5 $5B04 object slots, 4 bytes per slot at
; slot_base+$40: screen address (+$40/+$41) and plot-routine pointer
; (+$42/+$43), written by #R$9B22 from #R$9CEE and read back by #R$9BEB and
; #R$9D3C. Copied down to $5B24 at the end of each frame.
 $5B44 DEFB $5B,$ED,$79,$C3,$E6,$05,$08,$F1 ; {current frame's draw cache
 $5B4C DEFB $01,$FD,$7F,$F3,$32,$5C,$5B,$ED ; (screen address + plotter, 4
 $5B54 DEFB $79,$FB,$08,$C9,$DE,$1C,$D9,$18 ; bytes per slot)
 $5B5C DEFB $10,$CF,$00,$0B,$00,$00,$00,$00 ; }
 $5B64 DEFB $50,$00,$11,$00,$00,$00,$00,$00
 $5B6C DEFB $00,$00,$00,$00,$00,$00
 $5B72 DEFB $00,$00                         ; Screen/buffer base pointer, set
                                            ; to $F000 by #R$8F47
 $5B74 DEFB $00,$00,$00,$00,$00,$00,$00,$00
; Inventory: sequential item-pickup log, one byte per collected item (index
; into the $8400 sprite table, i.e. (addr-$8400)/72). $FF = slot not yet used.
; The last non-$FF entry is the item currently carried. Cleared to $FF by
; #R$8F47.
 $5B7C DEFB $00,$00,$00,$00,$00,$F3,$5B,$EC ; {item pickup order (index into
 $5B84 DEFB $EB,$EC,$2B,$01,$01,$33,$00,$21 ; $8400 sprite table), $FF=empty
 $5B8C DEFB $03,$00,$00,$00,$00,$00,$00,$00 ;
 $5B94 DEFB $0A,$00,$0A                     ; }
