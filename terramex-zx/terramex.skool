; Used by the routines at #R$8F47, #R$B9FA, #R$BB5D and #R$BC1F.
c$9EBD CALL $9EE3    ; Fill $5BD6 slots with item icons from inventory log
 $9EC0 LD B,$04      ;
 $9EC2 LD IY,$5BD6   ;
 $9EC6 LD A,($5C23)  ;
 $9EC9 LD C,A        ;
*$9ECA LD A,C        ;
 $9ECB AND $03       ;
 $9ECD LD DE,$9FDE   ;
 $9ED0 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9ED3 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9ED6 INC C         ;
 $9ED7 LD A,C        ;
 $9ED8 CP $1B        ;
 $9EDA JR NZ,$9EDE   ;
 $9EDC XOR A         ;
 $9EDD LD C,A        ;
*$9EDE DJNZ $9ECA    ;
 $9EE0 JP $9F6B      ; => Redraw $5BD6 slot at $5096

; Fill $5BD6 slots with item icons from inventory log ($5B7C)
;
; Used by the routine at #R$9EBD.
c$9EE3 LD B,$04      ; {B=4 slots; A=index ($5C23); IY=$5BD6; L=C=A
 $9EE5 LD A,($5C23)  ;
 $9EE8 LD IY,$5BD6   ;
 $9EEC LD L,A        ;
 $9EED LD C,A        ; }
 $9EEE LD H,$00      ; {IX = inventory log ($5B7C) + index
 $9EF0 LD DE,$5B7C   ;
 $9EF3 ADD HL,DE     ;
 $9EF4 PUSH HL       ;
 $9EF5 POP IX        ; }
*$9EF7 LD A,(IX+$00) ; {log entry==$FF (empty)? skip lookup
 $9EFA CP $FF        ;
