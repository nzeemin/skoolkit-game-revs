 $9C80 EXX           ; }
 $9C81 LD A,(DE)     ; {read 2 bytes via DE, combine into B/C (self-modifying
 $9C82 NOP           ; call-chain trick above)
 $9C83 NOP           ;
 $9C84 INC DE        ;
 $9C85 LD B,A        ;
 $9C86 LD A,(DE)     ;
 $9C87 NOP           ;
 $9C88 NOP           ;
 $9C89 OR B          ;
 $9C8A OR C          ;
 $9C8B LD C,B        ; }
 $9C8C EXX           ; {EXX; build D/L from alt B/A; JP (IY) dispatch
 $9C8D LD L,A        ;
 $9C8E LD D,(HL)     ;
 $9C8F EXX           ;
 $9C90 LD A,B        ;
 $9C91 EXX           ;
 $9C92 LD L,A        ;
 $9C93 LD A,H        ;
 $9C94 INC H         ;
 $9C95 JP (IY)       ; }

; Data block at 9C97
b$9C97 DEFB $29,$CB,$32,$17

; Build sub-pixel blend mask, plot into (BC); DOWN BC char-row fixup
;
; .
;
; .
;
; Plots a sprite pixel-column that isn't aligned to a character boundary:
; builds an 8-bit blend mask by rotating HL (the sprite's raw byte, pre-shifted
; into a carry chain) through D one bit at a time, 7 times, producing a mask
; that splits one sprite byte across two adjacent screen bytes at the sub-pixel
; offset. Blends the mask into (BC) and (BC)+1 using AND/OR (so it merges with,
; rather than overwrites, whatever's already on screen - needed since a
; sub-pixel-shifted sprite always straddles two character cells), then advances
; the column and wraps at char-row/screen-third boundaries like the other
; DOWN-HL/DOWN-DE fixups. This is the "position not divisible by 8" sibling of
; the fast whole-byte sprite blit in #R$9DE3.
c$9C9B ADD HL,HL     ; {rotate a bit into D/HL (sub-pixel shift)
 $9C9C SLL D         ;
 $9C9E RLA           ; }
 $9C9F ADD HL,HL     ; {repeat shift-rotate 6 more times (build 8-bit mask)
 $9CA0 SLL D         ;
 $9CA2 RLA           ;
 $9CA3 ADD HL,HL     ;
 $9CA4 SLL D         ;
 $9CA6 RLA           ;
 $9CA7 ADD HL,HL     ;
 $9CA8 SLL D         ;
 $9CAA RLA           ;
 $9CAB ADD HL,HL     ;
 $9CAC SLL D         ;
 $9CAE RLA           ;
 $9CAF ADD HL,HL     ;
 $9CB0 SLL D         ;
 $9CB2 RLA           ;
 $9CB3 ADD HL,HL     ;
 $9CB4 SLL D         ;
 $9CB6 RLA           ; }
 $9CB7 LD E,A        ; {E=mask; blend into (BC)
 $9CB8 LD A,(BC)     ;
 $9CB9 AND E         ;
 $9CBA OR H          ;
 $9CBB LD (BC),A     ; }
 $9CBC INC C         ; {blend into (BC)+1
 $9CBD LD A,(BC)     ;
 $9CBE AND D         ;
 $9CBF OR L          ;
 $9CC0 LD (BC),A     ;
 $9CC1 DEC C         ; }
; This entry point is used by the routine at #R$9CE7.
*$9CC2 INC B         ; {DOWN BC: advance column, char-row wrap
 $9CC3 LD A,B        ;
 $9CC4 AND $07       ;
 $9CC6 RET NZ        ; }
 $9CC7 DEC B         ; {column wraps at char boundary? adjust C+=$20, mask B
 $9CC8 LD A,C        ;
 $9CC9 CPL           ;
 $9CCA AND $E0       ;
 $9CCC JR Z,$9CD7    ;
 $9CCE LD A,C        ;
 $9CCF ADD A,$20     ;
 $9CD1 LD C,A        ;
 $9CD2 LD A,B        ;
 $9CD3 AND $F8       ;
 $9CD5 LD B,A        ;
 $9CD6 RET           ; }
*$9CD7 LD A,C        ; {char-row wrap (alt branch)
 $9CD8 AND $1F       ;
 $9CDA LD C,A        ; }
 $9CDB LD A,B        ; {next screen-third row; clamp at bottom (B=$E0)
 $9CDC AND $F8       ;
 $9CDE ADD A,$08     ;
 $9CE0 LD B,A        ;
 $9CE1 BIT 4,A       ;
 $9CE3 RET Z         ;
 $9CE4 LD B,$E0      ;
 $9CE6 RET           ; }

; Write A to (BC), fall into #R$9CC2 char-row fixup
c$9CE7 LD A,(BC)     ;
 $9CE8 AND D         ;
 $9CE9 OR L          ;
 $9CEA LD (BC),A     ;
 $9CEB JP $9CC2      ;

; Compute screen address (BC) + pick plot routine (IY) for pixel HL
;
; Used by the routines at #R$9B22, #R$9D21 and #R$9DE3.
;
;   HL pixel position (X in L, Y in H)
; O:BC screen byte address for that pixel
; O:IY plot-routine address for the pixel's sub-column
c$9CEE LD A,L        ; {C = pixel row bits (sub-char)
 $9CEF PUSH AF       ;
 $9CF0 RRCA          ;
 $9CF1 RRCA          ;
 $9CF2 RRCA          ;
 $9CF3 AND $1F       ;
 $9CF5 LD C,A        ; }
 $9CF6 LD A,H        ; {merge into C (attribute-style address)
 $9CF7 AND $7F       ;
 $9CF9 RLCA          ;
 $9CFA RLCA          ;
 $9CFB AND $E0       ;
 $9CFD OR C          ;
 $9CFE LD C,A        ; }
 $9CFF LD A,H        ; {B = screen-third/page bits
 $9D00 AND $07       ;
 $9D02 LD B,A        ;
 $9D03 LD A,H        ;
 $9D04 AND $40       ;
 $9D06 RRCA          ;
 $9D07 RRCA          ;
 $9D08 RRCA          ;
 $9D09 OR B          ;
 $9D0A OR $E0        ;
 $9D0C LD B,A        ; }
 $9D0D POP AF        ; {room-third 0: IY=#R$9CE7 (plain write)
 $9D0E AND $07       ;
 $9D10 LD IY,$9CE7   ;
 $9D14 RET Z         ; }
 $9D15 ADD A,A       ; {else: IY = table[$9C97 + third*4]
 $9D16 ADD A,A       ;
 $9D17 LD E,A        ;
 $9D18 LD D,$00      ;
 $9D1A LD IY,$9C97   ;
 $9D1E ADD IY,DE     ; }
 $9D20 RET           ;

; Deactivate object (IX+2)=$FF, restore background via #R$9BF3
;
; Used by the routine at #R$9DE3.
c$9D21 LD (IX+$02),$FF ; {mark inactive; HL=(X,Y)
 $9D25 LD L,(IX+$00)   ;
 $9D28 LD H,(IX+$01)   ; }
 $9D2B CALL $9CEE      ; Compute screen address (BC) + pick plot routine (IY)
                       ; for pixel HL
 $9D2E PUSH BC         ; {BC->HL; B=1; draw one frame via #R$9D48; restore HL;
 $9D2F POP HL          ; tail-jump erase via #R$9BF3
 $9D30 PUSH HL         ;
 $9D31 LD B,$01        ;
 $9D33 CALL $9D48      ;
 $9D36 POP HL          ;
 $9D37 LD B,$01        ;
 $9D39 JP $9BF3        ; }

; Draw a tile-based graphic for each of 5 party-slots at $5B04
;
; Used by the routine at #R$9B22.
;
; .
;
; For each of the 5 object slots, reads a tile reference from the slot's
; +$40/+41 fields and draws it as a small tile-based graphic (as opposed to the
; pixel-sprite draw path in #R$9DE3): works out how many 8x8-tile rows/columns
; are covered from the position's alignment (3 or 4, depending whether the
; position sits exactly on a tile boundary), looks up each covered tile's index
; in the $F800 room tile-index map, fetches its 8-byte bitmap from
; ($5B72)+tile*8, and blits it row by row (unrolled, with #R$9DBF handling the
; char-row-boundary wrap every 8th line). Whether this draws world-embedded
; tile graphics (e.g. a lift or door built from room tiles) or UI icons is not
; confirmed - see Actors.md's open question about slot offset $40/$41 being
; reused for two different purposes.
c$9D3C LD IX,$5B04   ; IX=$5B04 (party slot base), B=5 slots
 $9D40 LD B,$05      ;
*$9D42 LD L,(IX+$40) ; {HL = tile reference ((IX+$40)/(IX+$41))
 $9D45 LD H,(IX+$41) ; }
; This entry point is used by the routine at #R$9D21.
*$9D48 PUSH BC       ; {count sub-tile rows/cols (3 or 4) from position
 $9D49 LD A,H        ; alignment
 $9D4A AND $F8       ;
 $9D4C LD H,A        ;
 $9D4D LD B,$03      ;
 $9D4F LD A,(IX+$01) ;
 $9D52 AND $07       ;
 $9D54 JR Z,$9D57    ;
 $9D56 INC B         ;
*$9D57 PUSH BC       ;
 $9D58 PUSH HL       ;
 $9D59 LD A,(IX+$00) ;
 $9D5C LD B,$03      ;
 $9D5E AND $07       ;
 $9D60 JR Z,$9D63    ;
 $9D62 INC B         ; }
*$9D63 PUSH HL       ; {HL = tile-index map offset ($F800 + ...)
 $9D64 LD A,H        ;
 $9D65 RRCA          ;
 $9D66 RRCA          ;
 $9D67 RRCA          ;
 $9D68 AND $03       ;
 $9D6A LD H,A        ; }
 $9D6B LD DE,$F800   ; {HL = tile bitmap source ($5B72 + tile*8)
 $9D6E ADD HL,DE     ;
 $9D6F LD L,(HL)     ;
 $9D70 LD H,$00      ;
 $9D72 ADD HL,HL     ;
 $9D73 ADD HL,HL     ;
 $9D74 ADD HL,HL     ;
 $9D75 LD DE,($5B72) ; }
 $9D79 ADD HL,DE     ; {restore/save screen address (HL)
 $9D7A EX DE,HL      ;
 $9D7B POP HL        ;
 $9D7C PUSH HL       ; }
 $9D7D LD A,(DE)     ; {copy 8-byte tile bitmap, one row per INC H
 $9D7E LD (HL),A     ;
 $9D7F INC H         ;
 $9D80 INC DE        ;
 $9D81 LD A,(DE)     ;
 $9D82 LD (HL),A     ; }
 $9D83 INC H         ; {6 more row copies (unrolled, INC H each line)
 $9D84 INC DE        ;
 $9D85 LD A,(DE)     ;
 $9D86 LD (HL),A     ;
 $9D87 INC H         ;
 $9D88 INC DE        ;
 $9D89 LD A,(DE)     ;
 $9D8A LD (HL),A     ;
 $9D8B INC H         ;
 $9D8C INC DE        ;
 $9D8D LD A,(DE)     ;
 $9D8E LD (HL),A     ;
 $9D8F INC H         ;
 $9D90 INC DE        ;
 $9D91 LD A,(DE)     ;
 $9D92 LD (HL),A     ;
 $9D93 INC H         ;
 $9D94 INC DE        ;
 $9D95 LD A,(DE)     ;
 $9D96 LD (HL),A     ;
 $9D97 INC H         ;
 $9D98 INC DE        ;
 $9D99 LD A,(DE)     ;
 $9D9A LD (HL),A     ; }
 $9D9B POP HL        ; {restore/advance HL; loop 3 rows; restore HL
 $9D9C INC L         ;
 $9D9D DJNZ $9D63    ;
 $9D9F POP HL        ; }
 $9DA0 LD A,L        ; {advance column by 32, carry into row+8
 $9DA1 ADD A,$20     ;
 $9DA3 LD L,A        ; }
 $9DA4 JR NC,$9DAA   ; {apply row carry; restore BC; loop 3 cols; restore BC
 $9DA6 LD A,H        ;
 $9DA7 ADD A,$08     ;
 $9DA9 LD H,A        ;
*$9DAA POP BC        ;
 $9DAB DJNZ $9D57    ;
 $9DAD POP BC        ; }
 $9DAE INC IX        ; {IX+=4, next slot
 $9DB0 INC IX        ;
 $9DB2 INC IX        ; }
 $9DB4 INC IX        ; {loop 5 slots; RET
 $9DB6 DJNZ $9D42    ;
 $9DB8 RET           ; }

; DOWN DE, char-row fixup
;
; Used by the routine at #R$9DE3.
;
;   DE screen address
; O:HL fixed address
;
; Wraps #R$9DBF: takes address in DE (swapped into HL), fixes it, result ends
; in HL
c$9DB9 EX DE,HL      ;
 $9DBA CALL $9DBF    ; DOWN HL, char-row fixup
 $9DBD EX DE,HL      ;
 $9DBE RET           ;

; DOWN HL, char-row fixup
;
; Used by the routines at #R$9BEB, #R$9DB9 and #R$9F70.
;
;   HL screen address
; O:DE fixed address
;
; Fixes screen address HL after crossing a character-row boundary in a downward
; scan (all real callers do INC H per line, then call this every 8th line)
c$9DBF DEC H         ; DEC H (net down one line)
 $9DC0 LD A,L        ; {check L's top bits, branch
 $9DC1 CPL           ;
 $9DC2 AND $E0       ;
 $9DC4 JR Z,$9DD4    ; }
 $9DC6 LD A,L        ; {L+=$20, H&=$F8 (next row, same third)
 $9DC7 ADD A,$20     ;
 $9DC9 LD L,A        ;
 $9DCA LD A,H        ;
 $9DCB AND $F8       ;
 $9DCD LD H,A        ; }
 $9DCE LD A,H        ; {D/E = fixed-up screen address
 $9DCF AND $5F       ;
 $9DD1 LD D,A        ;
 $9DD2 LD E,L        ;
 $9DD3 RET           ; }
*$9DD4 LD A,L        ; {alt: L AND $1F
 $9DD5 AND $1F       ;
 $9DD7 LD L,A        ; }
 $9DD8 LD A,H        ; {H = (H AND $F8)+8 (next third); D/E = result
 $9DD9 AND $F8       ;
 $9DDB ADD A,$08     ;
 $9DDD LD H,A        ;
 $9DDE AND $5F       ;
 $9DE0 LD D,A        ;
 $9DE1 LD E,L        ;
 $9DE2 RET           ; }

; Draw active object sprites (slots $5C0E,$5C13,$5B99)
;
; Used by the routine at #R$9B22.
;
; .
;
; Draws the pixel sprite for each of the two creature/hazard slots ($5C0E,
; $5C13) plus a third fixed slot ($5B99), skipping any whose type byte is $FF
; (inactive). For each: computes the screen plot address (#R$9CEE), looks up
; the sprite's 72-byte record ($8400 + index*72, 3 columns x 24 bytes, same
; layout as the item sprites in Items-Format.md) and masks it onto the screen a
; byte at a time using an AND-mask/OR-data pair, duplicating the same masked
; write to the attribute file at $9E42 (so each sprite carries its own per-cell
; color), advancing across screen thirds and wrapping char-rows via
; #R$9E50/#R$9DB9. This is the pixel-sprite counterpart to #R$9D3C's tile-based
; draw - creatures/hazards and collectible items share this one draw routine
; and the $8400 sprite format.
c$9DE3 LD IX,$5C0E   ;
 $9DE7 LD B,$02      ;
*$9DE9 PUSH BC       ;
 $9DEA CALL $9DF8    ;
 $9DED POP BC        ;
 $9DEE LD IX,$5C13   ;
 $9DF2 DJNZ $9DE9    ;
 $9DF4 LD IX,$5B99   ;
*$9DF8 LD A,(IX+$02) ;
 $9DFB CP $FF        ;
 $9DFD RET Z         ;
 $9DFE CP $FE        ;
 $9E00 JP Z,$9D21    ; => Deactivate object (IX+2)=$FF, restore background via
                     ; #R$9BF3
 $9E03 LD A,(IX+$00) ;
 $9E06 AND $F8       ;
 $9E08 LD L,A        ;
 $9E09 LD H,(IX+$01) ;
 $9E0C CALL $9CEE    ; Compute screen address (BC) + pick plot routine (IY) for
                     ; pixel HL
 $9E0F PUSH BC       ;
 $9E10 LD L,(IX+$02) ;
 $9E13 LD H,$00      ;
 $9E15 ADD HL,HL     ;
 $9E16 ADD HL,HL     ;
 $9E17 ADD HL,HL     ;
 $9E18 PUSH HL       ;
 $9E19 ADD HL,HL     ;
 $9E1A ADD HL,HL     ;
 $9E1B ADD HL,HL     ;
 $9E1C POP DE        ;
 $9E1D ADD HL,DE     ;
 $9E1E EX DE,HL      ;
 $9E1F LD IX,$8400   ; {sprite table base + index*72
 $9E23 ADD IX,DE     ; }
 $9E25 POP DE        ;
 $9E26 LD B,$03      ; 3 columns
*$9E28 PUSH BC       ;
 $9E29 PUSH DE       ;
 $9E2A LD B,$18      ; 24 bytes/column
 $9E2C LD C,(IX+$00) ; {H=$FF, mask page pointer
 $9E2F LD H,$FF      ; }
*$9E31 LD A,(IX+$00) ; {blend sprite byte with mask
 $9E34 OR (IX+$01)   ;
 $9E37 OR C          ; }
 $9E38 LD C,(IX+$00) ;
 $9E3B INC IX        ;
 $9E3D LD L,A        ; {AND-mask then OR onto screen byte
 $9E3E LD A,(DE)     ;
 $9E3F AND (HL)      ;
 $9E40 OR C          ;
 $9E41 LD (DE),A     ; }
 $9E42 RES 5,D       ; {duplicate write to attribute byte
 $9E44 RES 7,D       ;
 $9E46 LD (DE),A     ; }
 $9E47 LD A,D        ; {advance to next screen third
 $9E48 ADD A,$A1     ;
 $9E4A LD D,A        ; }
 $9E4B AND $07       ;
 $9E4D JP NZ,$9E55   ;
 $9E50 CALL $9DB9    ; DOWN DE, char-row fixup
 $9E53 LD H,$FF      ;
*$9E55 DJNZ $9E31    ;
 $9E57 POP DE        ;
 $9E58 POP BC        ;
 $9E59 INC E         ;
 $9E5A DJNZ $9E28    ;
 $9E5C RET           ;

; Populate the $5BD6 object-slot table (via #R$9FBA/#R$9F86)
;
; Used by the routines at #R$8F47, #R$A851, #R$B370, #R$B5DD, #R$B72D, #R$B9FA
; and #R$BB5D.
c$9E5D LD HL,$6288   ;
