; Gate + room-specific visual effect (room $3A special-cased)
;
; Used by the routine at #R$B9FA.
;
; .
;
; Gated by a per-frame flag ($5C0C/$5C0D); room $3A gets special-cased clamping
; of the player's X against fixed bounds. Drives a room-specific animated
; visual effect: an effect index (masked to 7 bits from a stored byte) selects
; into a table at $F968, throttled by the frame counter so it advances slower
; than every frame, then drawn via #R$9A52. The (HL)=1 vs (HL)=$10 branch on
; the effect index ($BAD1/$BAD7) picks between two effect speeds/phases
; depending on whether the index is past $7A. Likely the room $3A steam/water
; effect seen on the player-made map notes, but not confirmed live.
c$BA97 LD C,A        ; {C=A; if ($5C0C) set, go to alt path
 $BA98 LD HL,$5C0C   ;
 $BA9B LD A,(HL)     ;
 $BA9C OR A          ;
 $BA9D JR NZ,$BADF   ; }
 $BA9F CALL $BB59    ; {Always-true stub (CP A), used by #R$BA97
 $BAA2 RET NZ        ; }
 $BAA3 LD A,C        ; {room match check ($3A)
 $BAA4 CP $3A        ; }
 $BAA6 JR NZ,$BAB6   ;
 $BAA8 LD A,($5C3E)  ;
 $BAAB OR A          ;
 $BAAC JR NZ,$BABC   ;
 $BAAE LD A,($5B98)  ;
 $BAB1 CP $0F        ;
 $BAB3 JR Z,$BABC    ;
 $BAB5 RET           ;
*$BAB6 LD A,($5B98)  ;
 $BAB9 CP $0B        ;
 $BABB RET NZ        ;
*$BABC LD A,($5B04)  ; {clamp player X, low bound
 $BABF CP $2C        ;
 $BAC1 RET C         ; }
 $BAC2 CP $B8        ; {clamp player X, high bound
 $BAC4 RET NC        ;
 $BAC5 CP $36        ;
 $BAC7 JR C,$BACC    ;
 $BAC9 CP $B2        ;
 $BACB RET C         ; }
*$BACC PUSH AF       ; {arm timer flag ($5C0D)=0
 $BACD XOR A         ;
 $BACE LD ($5C0D),A  ; }
 $BAD1 POP AF        ; {(HL)=1 if effect index < $7A
 $BAD2 LD (HL),$01   ;
 $BAD4 CP $7A        ; }
 $BAD6 RET C         ;
 $BAD7 LD (HL),$10   ; {else (HL)=$10, flag=1
 $BAD9 LD A,$01      ;
 $BADB LD ($5C0D),A  ;
 $BADE RET           ; }
*$BADF LD E,A        ; {E=A; A&=$7F (effect index)
 $BAE0 AND $7F       ; }
 $BAE2 LD HL,$F968   ; HL = effect table base ($F968)
 $BAE5 DEC A         ;
 $BAE6 LD C,A        ;
 $BAE7 LD B,$00      ;
 $BAE9 LD A,($5C02)  ; get Frame counter
 $BAEC AND $03       ;
 $BAEE RET NZ        ;
 $BAEF ADD HL,BC     ;
 $BAF0 BIT 7,E       ;
 $BAF2 JR Z,$BB0D    ;
 $BAF4 LD A,L        ;
 $BAF5 AND $03       ;
 $BAF7 EXX           ;
 $BAF8 LD L,A        ;
 $BAF9 LD H,$00      ;
 $BAFB LD DE,$BB51   ;
 $BAFE LD A,($5C01)  ; get Current room number
 $BB01 CP $3A        ;
 $BB03 JR NZ,$BB08   ;
 $BB05 LD DE,$BB55   ;
*$BB08 ADD HL,DE     ;
 $BB09 LD A,(HL)     ;
 $BB0A EXX           ;
 $BB0B JR $BB19      ;
*$BB0D LD C,$07      ;
 $BB0F LD A,($5C01)  ; get Current room number
 $BB12 CP $3A        ;
 $BB14 JR NZ,$BB18   ;
 $BB16 LD C,$BF      ;
*$BB18 LD A,C        ;
*$BB19 CALL $9A52    ; Write A to (HL)+$6000 (secondary buffer), then #R$9A62
                     ; dual-write loop
 $BB1C LD HL,$5C0C   ;
 $BB1F LD A,($5C0D)  ;
 $BB22 OR A          ;
 $BB23 JR NZ,$BB3D   ;
 $BB25 LD A,(HL)     ;
 $BB26 AND $7F       ;
 $BB28 CP $10        ;
 $BB2A INC (HL)      ;
 $BB2B RET C         ;
 $BB2C BIT 7,(HL)    ;
 $BB2E JR NZ,$BB3A   ;
 $BB30 DEC (HL)      ;
 $BB31 LD A,($5B04)  ;
 $BB34 CP $BA        ;
 $BB36 RET C         ;
 $BB37 LD (HL),$81   ;
 $BB39 RET           ;
*$BB3A LD (HL),$00   ;
 $BB3C RET           ;
*$BB3D LD A,(HL)     ;
 $BB3E DEC (HL)      ;
 $BB3F AND $7E       ;
 $BB41 RET NZ        ;
 $BB42 LD A,(HL)     ;
 $BB43 CP $80        ;
 $BB45 JR Z,$BB3A    ;
 $BB47 INC (HL)      ;
 $BB48 LD A,($5B04)  ;
 $BB4B CP $30        ;
 $BB4D RET NC        ;
 $BB4E LD (HL),$90   ;
 $BB50 RET           ;

