*$B45E CP $02          ; {stage 2 dispatch
 $B460 RET NZ          ; }
 $B461 LD A,($5C40)    ;
 $B464 LD C,A          ;
 $B465 OR A            ;
 $B466 PUSH AF         ;
 $B467 CALL NZ,$B4B5   ;
 $B46A POP AF          ;
 $B46B CALL Z,$B483    ;
