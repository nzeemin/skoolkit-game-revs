 $99AB PUSH DE       ; }
 $99AC LD A,H        ; {HL = attribute address ($5800 + ...)
 $99AD OR $58        ;
 $99AF LD H,A        ; }
 $99B0 LD A,(DE)     ; {A = tile index; look up attribute byte via $DF00 table
 $99B1 PUSH AF       ;
 $99B2 PUSH HL       ;
 $99B3 LD L,A        ;
 $99B4 LD H,$00      ;
 $99B6 LD BC,$DF00   ;
 $99B9 ADD HL,BC     ;
 $99BA LD A,(HL)     ; }
 $99BB POP HL        ; {restore HL; store attribute byte
 $99BC LD (HL),A     ; }
 $99BD LD A,H        ; {HL = screen bitmap address
 $99BE AND $03       ;
 $99C0 RLCA          ;
 $99C1 RLCA          ;
 $99C2 RLCA          ;
 $99C3 OR $40        ;
 $99C5 LD H,A        ; }
 $99C6 POP AF        ; {restore A (tile index); save HL (screen address)
 $99C7 PUSH HL       ; }
 $99C8 LD L,A        ; {HL = ($5B72) + tile_index*8 (bitmap source)
 $99C9 LD H,$00      ;
 $99CB ADD HL,HL     ;
 $99CC ADD HL,HL     ;
 $99CD ADD HL,HL     ;
 $99CE LD DE,($5B72) ; }
 $99D2 ADD HL,DE     ; {HL+=DE; BC/DE = screen+secondary-buffer addrs; B OR=
 $99D3 POP DE        ; $E0
 $99D4 LD C,E        ;
 $99D5 LD A,D        ;
 $99D6 OR $E0        ;
 $99D8 LD B,A        ; }
 $99D9 EX AF,AF'     ; {save row counter; A=8 (rows)
 $99DA LD A,$08      ; }
*$99DC EX AF,AF'     ; {copy byte to screen + secondary buffer; advance D/B/HL;
 $99DD LD A,(HL)     ; loop 8 rows
 $99DE LD (DE),A     ;
 $99DF LD (BC),A     ;
 $99E0 INC D         ;
 $99E1 INC B         ;
 $99E2 INC HL        ;
 $99E3 EX AF,AF'     ;
 $99E4 DEC A         ;
 $99E5 JR NZ,$99DC   ; }
 $99E7 POP DE        ; {advance DE/HL (next tile); loop until H=2 (512 tiles
 $99E8 INC DE        ; done); RET
 $99E9 POP HL        ;
 $99EA INC HL        ;
 $99EB BIT 1,H       ;
 $99ED JR Z,$99AA    ;
 $99EF RET           ; }

