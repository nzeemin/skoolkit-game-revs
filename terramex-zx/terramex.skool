; Sound-effect dispatcher wrapper: save regs, call #R$C4BC
;
; Used by the routines at #R$A3E1, #R$A8AB, #R$AA3C, #R$B0B6, #R$BB5D and
; #R$BFF6.
;
; A sound-effect index (0-6)
c$C4B2 PUSH HL       ;
 $C4B3 PUSH DE       ;
 $C4B4 PUSH BC       ;
 $C4B5 CALL $C4BC    ; Sound-effect table lookup
 $C4B8 POP BC        ;
 $C4B9 POP DE        ;
 $C4BA POP HL        ;
 $C4BB RET           ;

; Sound-effect table lookup ($C55B): push handler address, E=$10, tail-call
;
; Used by the routine at #R$C4B2.
c$C4BC CP $07        ; {A>=7? RET NC (invalid index)
 $C4BE RET NC        ;
 $C4BF ADD A,A       ; }
 $C4C0 LD L,A        ; {HL=table ($C55B) + A*2 (index)
 $C4C1 LD H,$00      ;
 $C4C3 LD DE,$C55B   ;
 $C4C6 ADD HL,DE     ; }
 $C4C7 LD E,(HL)     ; {DE=(HL) (handler address); push DE
 $C4C8 INC HL        ;
 $C4C9 LD D,(HL)     ;
 $C4CA PUSH DE       ; }
 $C4CB LD E,$10      ; {E=$10; RET (tail-call via stack)
 $C4CD RET           ; }

; Beeper tone-sweep effect (raw OUT $FE)
c$C4CE LD H,$7F      ; {H=$7F (sweep count); A=0; B=$0A (bit count)
*$C4D0 XOR A         ;
 $C4D1 LD B,$0A      ; }
*$C4D3 PUSH BC       ; {save BC; B=H (duty count)
 $C4D4 LD B,H        ; }
*$C4D5 OUT ($FE),A   ; {toggle beeper port, delay; loop duty; then bits
 $C4D7 EX (SP),HL    ;
 $C4D8 EX (SP),HL    ;
 $C4D9 DJNZ $C4D5    ; }
 $C4DB XOR $10       ; {flip bit value; restore BC; loop bits
 $C4DD POP BC        ;
 $C4DE DJNZ $C4D3    ; }
 $C4E0 SRL H         ; {H>>=2; repeat sweep until H=0
 $C4E2 SRL H         ;
 $C4E4 LD A,H        ;
 $C4E5 OR A          ;
 $C4E6 JR NZ,$C4D0   ;
 $C4E8 RET           ; }

; Play sound effect (raw OUT $FE beeper timing loop)
c$C4E9 LD HL,$0000   ; {HL=0 (sample pointer); BC=$2328 (sample count)
 $C4EC LD BC,$2328   ; }
*$C4EF LD A,$23      ; {per-sample delay calc (A=$23-B)
 $C4F1 SUB B         ;
 $C4F2 JR Z,$C4F9    ;
 $C4F4 PUSH BC       ;
 $C4F5 LD B,A        ; }
*$C4F6 DJNZ $C4F6    ; {busy-wait delay; restore BC
 $C4F8 POP BC        ; }
*$C4F9 LD A,(HL)     ; {read+mask sample, output to speaker; HL++
 $C4FA INC HL        ;
 $C4FB AND E         ;
 $C4FC OUT ($FE),A   ; }
 $C4FE DEC BC        ; {BC-=4; loop until 0
 $C4FF DEC BC        ;
 $C500 DEC BC        ;
 $C501 DEC BC        ;
 $C502 LD A,C        ;
 $C503 OR B          ;
 $C504 JR NZ,$C4EF   ; }
 $C506 LD H,$03      ; {H=3 (sweep count); A=0; B=$0A (bit count)
*$C508 XOR A         ;
 $C509 LD B,$0A      ; }
*$C50B PUSH BC       ; {save BC; B=H (duty)
 $C50C LD B,H        ; }
*$C50D OUT ($FE),A   ; {toggle port, delay; loop duty
 $C50F EX (SP),HL    ;
 $C510 EX (SP),HL    ;
 $C511 DJNZ $C50D    ; }
 $C513 XOR $10       ; {flip bit; restore BC; loop bits
 $C515 POP BC        ;
 $C516 DJNZ $C50B    ; }
 $C518 SCF           ; {sweep H via RL/carry; loop until H=$FF; RET
 $C519 RL H          ;
 $C51B LD A,H        ;
 $C51C CP $FF        ;
 $C51E JR NZ,$C508   ;
 $C520 RET           ; }

; Play noise-type sound effect (R-register based)
c$C521 LD B,$64      ;
*$C523 LD A,R        ;
 $C525 AND $3F       ;
 $C527 LD L,A        ;
 $C528 LD H,$00      ;
 $C52A LD A,(HL)     ;
 $C52B AND $10       ;
 $C52D OUT ($FE),A   ;
 $C52F DJNZ $C523    ;
 $C531 RET           ;

; Beeper tone effect variant A (HL=$03C8), falls into #R$C53A
c$C532 LD HL,$03C8   ;
 $C535 JR $C53A      ;

; Beeper tone effect variant B (HL=$0564)
c$C537 LD HL,$0564   ; HL=$0564 (tone period)
; This entry point is used by the routine at #R$C532.
*$C53A XOR A         ; {A=0; B=L; toggle port; busy-wait delay
 $C53B LD B,L        ;
 $C53C OUT ($FE),A   ;
*$C53E DJNZ $C53E    ; }
 $C540 LD A,E        ; {A=E (mask); toggle port; B=L
 $C541 OUT ($FE),A   ;
 $C543 LD B,L        ; }
*$C544 DJNZ $C544    ; {busy-wait delay
 $C546 DEC H         ; }
 $C547 JR NZ,$C53A   ; {DEC H; loop until H=0; RET
 $C549 RET           ; }

; Data block at C54A
b$C54A DEFB $21

; Beeper noise/sample effect (raw OUT $FE)
c$C54B NOP           ; {NOPs (timing pad); B=L (outer count)
 $C54C NOP           ;
 $C54D LD B,L        ; }
*$C54E LD C,$05      ; C=5 (inner count)
*$C550 LD A,(HL)     ; {read sample byte, mask, output to port; HL++; loop 5
 $C551 AND E         ;
 $C552 OUT ($FE),A   ;
 $C554 INC HL        ;
 $C555 DEC C         ;
 $C556 JR NZ,$C550   ; }
 $C558 DJNZ $C54E    ; {loop outer; RET
 $C55A RET           ; }

