 $9E9C LD IY,$5BD6   ;
 $9EA0 LD C,A        ;
 $9EA1 LD B,$03      ;
 $9EA3 LD A,$02      ;
*$9EA5 PUSH AF       ;
 $9EA6 LD DE,$6000   ;
 $9EA9 CALL $9FAA    ; Compute HL = A*24-ish, entry point for #R$9FBA
 $9EAC DEC C         ;
 $9EAD JP P,$9EB3    ;
 $9EB0 LD HL,$5C46   ;
*$9EB3 CALL $9FBA    ; Store HL into an IY-indexed table entry, advance IY/HL
                     ; by stride
 $9EB6 POP AF        ;
 $9EB7 INC A         ;
 $9EB8 DJNZ $9EA5    ;
