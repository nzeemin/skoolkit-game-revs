 $B0FF LD (IY+$0F),$00 ;
 $B103 RET             ;
*$B104 DEC A           ; {stage 1 check
 $B105 JR NZ,$B12E     ; }
 $B107 DEC (IY+$00)    ;
 $B10A LD A,(IY+$01)   ;
 $B10D ADD A,$04       ;
 $B10F LD (IY+$01),A   ;
 $B112 CP $54          ; {target $54 reached?
 $B114 RET NZ          ; }
 $B115 INC (HL)        ;
 $B116 LD A,($5BFE)    ; {completion flag set? pick branch
 $B119 OR A            ; }
 $B11A JR Z,$B125      ;
 $B11C INC (HL)        ;
 $B11D INC (IY+$0E)    ;
 $B120 LD A,$02        ;
 $B122 JP $C4B2        ; => Sound-effect dispatcher wrapper
*$B125 LD (IY+$06),$76 ;
 $B129 LD (IY+$02),$7F ;
 $B12D RET             ;
*$B12E DEC A           ; {stage 2 check
 $B12F JR NZ,$B143     ; }
 $B131 LD A,(IY+$06)   ; {field reached target $77?
 $B134 CP $77          ; }
 $B136 JR Z,$B13C      ;
 $B138 INC (IY+$06)    ;
 $B13B RET             ;
*$B13C INC (HL)        ;
 $B13D INC (HL)        ;
 $B13E LD A,$01        ;
 $B140 JP $C4B2        ; => Sound-effect dispatcher wrapper
*$B143 DEC A           ; {stage 3 check
 $B144 JR NZ,$B15D     ; }
 $B146 DEC (IY+$01)    ;
 $B149 LD A,(IY+$00)   ;
 $B14C SUB $04         ;
 $B14E LD (IY+$00),A   ;
 $B151 CP $04          ; {target <4 reached?
 $B153 RET NC          ; }
 $B154 LD (IY+$02),$7F ;
 $B158 DEC (IY+$0E)    ;
 $B15B INC (HL)        ;
 $B15C RET             ;
*$B15D INC (HL)        ; advance the sub-stage
 $B15E RET P           ; not finished? RET
 $B15F LD A,$01        ;
 $B161 LD ($5BFF),A    ; set Game-over flag
 $B164 RET             ;

