; Creature trap-entry: room $5B98 check, move X by direction bits (E)
;
; .
;
; .
;
; Another discard-return trap entry (see #R$AC35). If the room category ($5B98)
; isn't $0A, just sets a per-object flag ($5C03) and resets to status 0 via
; #R$AE84 - i.e. this trap only does anything meaningful in room-category $0A.
; Otherwise sets the object's frame to $1D and, per direction bit (E
; bit0=right, bit1=left), nudges X by 2px and flips the direction flag when it
; does, clamping at the screen edges rather than crossing them (unlike
; #R$ADAC's room-crossing variant). Same family as #R$AC35: fixed-track
; obstacle movement, gated by room category rather than by the hazard-timer
; tables the $AA/$A8-prefixed traps use.
c$AD32 POP HL         ; {room ($5B98)==$0A? else store $5C03=2
 $AD33 LD A,($5B98)   ;
 $AD36 CP $0A         ;
 $AD38 JR Z,$AD42     ;
 $AD3A LD A,$02       ;
 $AD3C LD ($5C03),A   ; }
 $AD3F JP $AE84       ; => Reset room state=0 and hazard counter ($5C07)
*$AD42 LD A,$1D       ; {(IX+2)=$1D
 $AD44 LD (IX+$02),A  ; }
 $AD47 BIT 0,E        ; {direction bit0 (right)?
 $AD49 JR Z,$AD5B     ; }
 $AD4B LD A,(IX+$00)  ; {X+=2, clamp <$E7
 $AD4E ADD A,$02      ;
 $AD50 CP $E7         ;
 $AD52 JR NC,$AD5B    ; }
 $AD54 SET 7,(IX+$03) ; {set direction flag; store X
 $AD58 LD (IX+$00),A  ; }
*$AD5B BIT 1,E        ; {direction bit1 (left)?
 $AD5D JR Z,$AD6F     ; }
 $AD5F LD A,(IX+$00)  ; {X-=2, clamp >=4
 $AD62 SUB $02        ;
 $AD64 CP $04         ;
 $AD66 JR C,$AD6F     ; }
 $AD68 RES 7,(IX+$03) ; {clear direction flag; store X
 $AD6C LD (IX+$00),A  ; }
*$AD6F BIT 3,E        ; {direction bit3 (down)?
 $AD71 JR Z,$AD8B     ; }
 $AD73 LD A,(IX+$01)  ; {Y-=2
 $AD76 DEC A          ; }
 $AD77 JP M,$AD82     ; off-screen? branch $AD82
 $AD7A DEC A          ; {Y-=2 again; off-screen? branch $AD82
 $AD7B JP M,$AD82     ; }
 $AD7E LD (IX+$01),A  ; {store Y; RET
 $AD81 RET            ; }
*$AD82 LD A,($5C01)   ; get Current room number
 $AD85 CP $08         ; {room==8? RET Z
 $AD87 RET Z          ; }
 $AD88 JP $A69B       ; => Move up a level
*$AD8B BIT 2,E        ; {direction bit2 (up)? RET Z
 $AD8D RET Z          ; }
 $AD8E LD A,(IX+$01)  ; {Y+=2; C=Y
 $AD91 ADD A,$02      ;
 $AD93 LD C,A         ; }
 $AD94 LD A,($5C01)   ; get Current room number
 $AD97 CP $14         ; {room==$14?
 $AD99 LD A,C         ;
 $AD9A JR NZ,$ADA3    ; }
 $AD9C CP $57         ; {Y<$57? else RET NC
 $AD9E RET NC         ; }
 $AD9F LD (IX+$01),C  ; {store Y; RET
 $ADA2 RET            ; }
*$ADA3 CP $67         ; Y>=$67?
 $ADA5 JP NC,$A6AE    ; => Move down a level
 $ADA8 LD (IX+$01),A  ; {store Y; RET
 $ADAB RET            ; }

; Creature update: Y-state via #R$AE76, hazard-timer++, room-cross via
; #R$A671/#R$A640
;
; .
;
; .
;
; Another trap-entry point (discards its return like #R$AC35 and neighbors).
; Looks up the object's Y-position from a table ($AE8D) indexed by the hazard
; counter ($5C07, incremented as a side effect via #R$AE76), and once that
; counter reaches $11, snaps the object's Y down to a tile boundary and resets
; to status 0 via #R$AE84. Otherwise calls #R$AE37 for a Y-bound check that can
; move the object up a level, then reads a second per-room byte ($5C08) as a
; 2-bit direction field: bit0 pushes the object right past the screen edge into
; the next room via #R$A671, bit1 (in the alternate branch, not shown in the
; excerpt but present at $AE06) pushes it left via #R$A640. Each room-crossing
; branch restores the object's local position afterward via #R$A102 unless a
; flag byte ((IY+1)/(IY+0)) says otherwise. Reads as the "creature that patrols
; back and forth across a room boundary" behavior, distinct from the
; fixed-track traps in #R$AC35/#R$AD32.
c$ADAC POP HL        ;
 $ADAD LD DE,$AE8D   ;
 $ADB0 CALL $AE76    ; Look up a table by hazard counter ($5C07), store into
 $ADB3 LD HL,$5C07   ;
 $ADB6 LD A,(HL)     ;
 $ADB7 INC (HL)      ;
 $ADB8 CP $11        ;
 $ADBA JR NZ,$ADC7   ;
 $ADBC LD A,(IX+$01) ;
