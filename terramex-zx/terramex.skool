 $8F40 DEFB $02,$0E,$B7,$79,$32,$FD,$A9

; Show main menu, then initialize game state
;
; .
;
; .
;
; After #R$93AF returns (device chosen, "0" pressed): pages in a helper 128K
; bank to run a setup routine at $C000 if needed, clears game variable tables,
; resets item/collision flags, blits the background graphic ($E000 -> $5000,
; one screen third + extra strip), sets up pointers/counters, clears the
; object-state table at $5BFA, sets the level data pointer ($5C25=$6070,
; $5C27=$0F, purpose unconfirmed - not total room count, game has 66+ rooms),
; then redraws the screen before falling through into the main game loop at
; $9018 (per-frame updates, respawn-in-room handling via $9090 after a life is
; lost, and game-over exit back to this same routine via $906D/$908D).
c$8F47 CALL $93AF    ; Main menu
 $8F4A LD A,($5FFE)  ; A=128K paging flag ($5FFE)
 $8F4D OR A          ; {not 128K? skip
 $8F4E JR Z,$8F69    ; }
 $8F50 LD BC,$7FFD   ; {BC=$7FFD, A=bank $11
 $8F53 LD A,$11      ; }
 $8F55 PUSH BC       ;
 $8F56 LD ($5FE5),A  ; {record and page it in
 $8F59 OUT (C),A     ; }
 $8F5B LD BC,$C000   ;
 $8F5E CALL $C000    ; init music player
 $8F61 POP BC        ;
 $8F62 LD A,$10      ; {restore bank $10
 $8F64 LD ($5FE5),A  ; }
 $8F67 OUT (C),A     ; page back
*$8F69 LD HL,$5B04   ; HL=$5B04
 $8F6C LD BC,$0063   ;
 $8F6F LD DE,$5B05   ;
 $8F72 LD (HL),$00   ; clear $5B04-$5B66 (99 bytes)
 $8F74 LDIR          ;
 $8F76 LD HL,$5B7C   ; HL=$5B7C
 $8F79 LD DE,$5B7D   ;
 $8F7C LD BC,$001A   ;
 $8F7F LD (HL),$FF   ; fill inventory with $FF (26 bytes)
 $8F81 LDIR          ;
 $8F83 CALL $B932    ; Clear active flag (bit7) across all $B99D creature-table
                     ; entries
 $8F86 LD HL,$B9D9   ; {re-arm the boss entry ($B9D9)
 $8F89 SET 7,(HL)    ; }
 $8F8B LD HL,$E000   ; {HL=$E000, DE=$5000
 $8F8E LD DE,$5000   ; }
 $8F91 LD BC,$0800   ;
 $8F94 LDIR          ; restore one screen third
 $8F96 LD DE,$5A00   ; {DE=$5A00, BC=$100
 $8F99 LD BC,$0100   ; }
 $8F9C LDIR          ; restore its attributes
 $8F9E LD HL,$F000   ; {buffer base pointer ($5B72)=$F000
 $8FA1 LD ($5B72),HL ; }
 $8FA4 LD A,$FF      ; A=$FF
 $8FA6 LD ($5C3C),A  ; reset $5C3C
 $8FA9 LD ($A6FD),A  ; {reset $A6FD/$A700
 $8FAC LD ($A700),A  ; }
 $8FAF LD ($5B98),A  ; {reset $5B98/$5B9B
 $8FB2 LD ($5B9B),A  ; }
 $8FB5 LD A,$07      ; {$A6F5=7 (per-room tuning, room $10 uses 6)
 $8FB7 LD ($A6F5),A  ; }
 $8FBA XOR A         ; {reset counter $5B06
 $8FBB LD ($5B06),A  ; }
 $8FBE LD HL,$5BFA   ; {HL=$5BFA, DE=$5BFB
 $8FC1 LD DE,$5BFB   ; }
 $8FC4 LD BC,$0093   ;
 $8FC7 LD (HL),A     ; {clear object-state table (147 bytes)
 $8FC8 LDIR          ; }
 $8FCA LD D,A        ;
 $8FCB LD E,A        ;
 $8FCC CALL $BCF2    ; Save all registers
 $8FCF LD HL,$6070   ; {level data pointer ($5C25) = $6070
 $8FD2 LD ($5C25),HL ; }
 $8FD5 LD A,$0F      ; {$5C27=$0F (scripted-room gate)
 $8FD7 LD ($5C27),A  ; }
 $8FDA LD HL,$F000   ;
 $8FDD LD ($5B72),HL ;
 $8FE0 LD A,$14      ; {attr=$14
 $8FE2 LD ($5C01),A  ; }
 $8FE5 CALL $9855    ; Set up the current room
 $8FE8 CALL $9EBD    ; Init $5BD6 object slots from $5C23
 $8FEB LD A,$04      ;
 $8FED LD ($5B97),A  ; set Lives counter
 $8FF0 CALL $9E96    ; Draw lives-count icons ($5B97) into $5BD6 slots
 $8FF3 LD A,$60      ;
 $8FF5 LD ($5B05),A  ;
 $8FF8 LD A,$0A      ;
 $8FFA LD ($5B04),A  ;
 $8FFD LD A,$2B      ;
 $8FFF LD ($5B9E),A  ;
 $9002 LD A,$30      ;
 $9004 LD ($5B9F),A  ;
 $9007 LD HL,$5BFB   ;
 $900A LD (HL),$1E   ;
 $900C INC HL        ;
 $900D LD (HL),$17   ;
 $900F INC HL        ;
 $9010 LD (HL),$3B   ;
 $9012 CALL $9AA1    ; Snapshot current room/position into respawn staging
 $9015 CALL $9E5D    ; Populate the $5BD6 object-slot table
*$9018 LD A,$01      ; {main game loop entry: mark frame active ($5BA0=1)
 $901A LD ($5BA0),A  ; }
 $901D LD IX,$5B04   ; IX=player state ($5B04)
 $9021 LD A,($5C01)  ; {room ($5C01) vs last ($5B9E)
 $9024 LD HL,$5B9E   ; }
 $9027 CP (HL)       ;
 $9028 CALL Z,$AF81  ; changed? room-entry trigger #R$AF81
 $902B CALL $A3E1    ; Main per-frame player update
 $902E LD A,($5C2A)  ; {life lost ($5C2A)?
 $9031 OR A          ; }
 $9032 JR NZ,$9090   ; yes: respawn via #R$9090
 $9034 CALL $B9FA    ; Per-frame item dispatcher
 $9037 CALL $91C0    ; Draw sparkle/flicker effect list at $9AD5
 $903A CALL $935D    ; Countdown timer
 $903D CALL $BE98    ; Dispatch per-creature-type init (jump table $BECA) for
                     ; the 3 hazard slots
 $9040 CALL $9B22    ; Per-frame update for 5 party slots
 $9043 LD A,($5BFF)  ; {game-over flag ($5BFF) set?
 $9046 OR A          ; }
 $9047 JR NZ,$906D   ; yes: exit to #R$906D
 $9049 LD A,($5C02)  ; {frame counter ($5C02)++
 $904C INC A         ; }
 $904D LD ($5C02),A  ;
 $9050 LD A,$FB      ; {read key row $FBFE
 $9052 IN A,($FE)    ; }
 $9054 AND $01       ; {held? loop
 $9056 JP NZ,$9018   ; }
 $9059 LD BC,$FEFE   ; {read key row $FEFE
 $905C IN A,(C)      ; }
 $905E AND $01       ; {pressed? exit
 $9060 JR Z,$906D    ; }
*$9062 LD A,$FD      ; {read key row $FDFE
 $9064 IN A,($FE)    ; }
 $9066 AND $01       ; {wait for release
 $9068 JR Z,$9062    ; }
 $906A JP $9018      ;
*$906D CALL $BD50    ; New high-score check
 $9070 LD HL,$5000   ; {HL=$5000, DE=$E000
 $9073 LD DE,$E000   ; }
 $9076 LD BC,$0800   ;
 $9079 LDIR          ; save screen third
 $907B LD HL,$5A00   ; {HL=$5A00, DE=$E800
 $907E LD DE,$E800   ; }
 $9081 LD BC,$0100   ;
 $9084 LDIR          ; save its attributes
 $9086 LD A,($918C)  ; {alternate tileset loaded?
 $9089 OR A          ; }
 $908A CALL NZ,$918D ; yes: restore the base tileset
 $908D JP $8F47      ; => Show main menu, then initialize game state
; Respawn handler, entered from #R$9018 when the hazard timer (#R$A9EE) has
; just cost a life. Restores the player/room state saved in $5C2B-$5C32
; (captured on room entry, likely by #R$AF81) back into the live variables, so
; the player restarts in the same room rather than switching rooms. Only writer
; of $5C2A other than #R$A9EE is this routine, clearing it as the first step.
*$9090 XOR A         ; {respawn after life lost: clear pending flag ($5C2A)
 $9091 LD ($5C2A),A  ; }
 $9094 LD ($5C05),A  ; clear $5C05
 $9097 LD A,($5C2B)  ; {restore status ($5C06)
 $909A LD ($5C06),A  ; }
 $909D LD A,($5C2C)  ; {restore hazard counter ($5C07)
 $90A0 LD ($5C07),A  ; }
 $90A3 LD HL,($5C2E) ; {restore player position ($5B04)
 $90A6 LD ($5B04),HL ; }
 $90A9 LD HL,($5C30) ;
 $90AC LD ($5B06),HL ;
 $90AF LD A,($5C2D)  ; {restore room ($5C01)
 $90B2 LD ($5C01),A  ; }
 $90B5 LD HL,($5C32) ; {restore last-room ($5B9E)
 $90B8 LD ($5B9E),HL ; }
 $90BB CALL $9855    ; Set up the current room
 $90BE LD A,$FE      ; {$5B9B=$FE (respawn marker)
 $90C0 LD ($5B9B),A  ; }
 $90C3 JP $9018      ; => main game loop

; Draw character bitmap
;
; Used by the routines at #R$94F9 and #R$BD75.
;
;   A char code
;   HL screen address
; O:HL HL+1 (next column)
;
; Font table at $3C00, 8 bytes/char. DE is used as scratch and restored,
; unaffected.
c$90C6 PUSH BC       ;
 $90C7 PUSH DE       ;
 $90C8 PUSH HL       ;
 $90C9 EX DE,HL      ;
 $90CA LD L,A        ; HL = char code
 $90CB LD H,$00      ;
 $90CD ADD HL,HL     ; * 8 (three ADD HL,HL)
 $90CE ADD HL,HL     ;
 $90CF ADD HL,HL     ;
 $90D0 LD BC,$3C00   ; {add the font base $3C00
 $90D3 ADD HL,BC     ; }
 $90D4 LD B,$08      ;
*$90D6 LD A,(HL)     ; {copy one row
 $90D7 LD (DE),A     ; }
 $90D8 INC D         ; {advance both
 $90D9 INC HL        ; }
 $90DA DJNZ $90D6    ; loop 8 rows
 $90DC POP HL        ;
 $90DD POP DE        ;
 $90DE POP BC        ;
 $90DF INC HL        ; advance to next column
 $90E0 RET           ;

