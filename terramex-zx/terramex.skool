; Clear a 4-byte record at $A0FE
;
; Used by the routines at #R$A34B, #R$A3E1, #R$AC35, #R$AD17, #R$ADAC and
; #R$AE37.
;
; DE preserved (pushed/popped, not used)
;
; Clears a 4-byte scratch record at $A0FE, then - unless the hero is already
; flagged (bit7 of that record) or music is playing - samples the two tiles
; just below and to the right of the hero's feet (#R$A176) for a "walked off a
; ledge" style collision; a match on tile $A5 in either sample triggers status
; $1A. Separately checks the tile position ahead of the hero's movement
; direction (#R$A1F4) and, unless the flag/music-on gate is set, the tile
; directly under the hero: standing on a "sticky" hazard tile ($BC/$BD) for 50
; frames (a per-tile counter at $5C29) forces status $11. Finally re-checks the
; tile column below the feet against the solid-tile lists (#R$A2AC/#R$A2FA) to
; (re)compute the record's flag byte for next frame. This is the hero's main
; per-frame ground/hazard-tile sensor, called every frame from #R$A3E1.
c$A102 LD IY,$A0FE   ; {IY=$A0FE; save DE; clear 4-byte record
 $A106 PUSH DE       ;
 $A107 XOR A         ;
 $A108 LD (IY+$00),A ;
 $A10B LD (IY+$01),A ;
 $A10E LD (IY+$02),A ;
 $A111 LD (IY+$03),A ; }
 $A114 LD A,($5C06)  ; {skip check if $5C06 set or music playing
 $A117 OR A          ;
 $A118 JR NZ,$A132   ; }
 $A11A LD A,($918C)  ; {music-on flag check, skip if set
 $A11D OR A          ;
 $A11E JR NZ,$A132   ; }
 $A120 CALL $A176    ; {Sample two nearby tiles (below/right of object) for
 $A123 LD A,B        ; collision
 $A124 CP $A5        ;
 $A126 JR Z,$A12D    ;
 $A128 LD A,C        ;
 $A129 CP $A5        ;
 $A12B JR NZ,$A132   ; }
*$A12D LD A,$1A      ; {trigger $1A via #R$AE85
 $A12F CALL $AE85    ; }
*$A132 CALL $A1F4    ; Check object position against screen bounds, sample tile
                     ; ahead
 $A135 XOR A         ; {clear tile flag ($5C28)
 $A136 LD ($5C28),A  ; }
 $A139 LD A,(IY+$03) ; {skip if flag/music set; else check tile under object
 $A13C OR A          ;
 $A13D JR NZ,$A161   ;
 $A13F LD A,($918C)  ;
 $A142 OR A          ;
 $A143 JR NZ,$A161   ; }
 $A145 LD A,(HL)     ; {tile under object is $BC/$BD?
 $A146 CP $BC        ;
 $A148 JR Z,$A14E    ;
 $A14A CP $BD        ;
 $A14C JR NZ,$A161   ; }
*$A14E LD ($5C28),A  ; {store tile flag; hazard counter ($5C29)++; >=$32 ->
 $A151 LD HL,$5C29   ; room-state=$11; else check
 $A154 INC (HL)      ;
 $A155 LD A,(HL)     ;
 $A156 CP $32        ;
 $A158 JR C,$A165    ;
 $A15A LD A,$11      ;
 $A15C LD ($5C06),A  ;
 $A15F JR $A165      ; }
*$A161 XOR A         ; {else: clear hazard counter ($5C29)
 $A162 LD ($5C29),A  ; }
*$A165 CALL $A2AC    ; {Scan tile column below feet against solid-tile list
 $A168 CALL $A2FA    ; ($A24B/$A271), flag
 $A16B LD A,($5BA0)  ;
 $A16E OR A          ;
 $A16F JR NZ,$A174   ;
 $A171 LD (IY+$03),A ; }
*$A174 POP DE        ; {restore DE; RET
 $A175 RET           ; }

