; Item pickup/hint check for both creature slots ($5C0E, $5C13)
;
; Used by the routine at #R$B9FA.
;
; .
;
; Runs once per frame for each of the two creature object slots ($5C0E, $5C13),
; checking whether that object represents a *collectible item* rather than a
; hazard (via #R$9140's type classification) and, if so, whether the hero is
; close enough and an inventory slot is free (scans the 27-slot log at $5B7C
; for a free entry). Special-cases item type $16 (latches the current room into
; $5C3F - likely a "last item room" bookmark for a specific quest item). For a
; subset of item types ($08/$0E/$14), additionally requires the hero to be in
; room-state 2 with the hazard timer past 10 before allowing pickup - i.e. some
; items can only be collected mid-animation of some other event. On a
; successful pickup: snaps the hero's position to the item, sets status $5C06=5
; (the pickup animation, see Actors.md), deactivates the item object, and
; refreshes the display slots. See Items-Format.md for the inventory log format
; itself.
c$BB5D LD IX,$5B04     ; {IX=$5B04 (player); run for slot $5C0E then $5C13
 $BB61 LD IY,$5C0E     ; }
 $BB65 CALL $BB6C      ;
 $BB68 LD IY,$5C13     ;
*$BB6C XOR A           ;
 $BB6D LD C,A          ;
 $BB6E LD E,A          ;
 $BB6F LD D,A          ;
 $BB70 CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $BB73 JP NC,$BC07     ;
 $BB76 LD A,(IY+$02)   ;
 $BB79 CP $FE          ;
 $BB7B JP NC,$BC07     ;
 $BB7E LD HL,$5B7C     ; {scan 27-slot inventory log ($5B7C) for a free ($FF)
 $BB81 PUSH BC         ; slot; C=count found
 $BB82 LD B,$1B        ;
*$BB84 LD A,(HL)       ;
 $BB85 CP $FF          ; }
 $BB87 JR Z,$BB8F      ;
 $BB89 INC HL          ;
 $BB8A INC C           ;
 $BB8B DJNZ $BB84      ;
 $BB8D JR $BC06        ;
*$BB8F LD A,(IY+$02)   ; {special item $16: latch room into $5C3F
 $BB92 CP $16          ;
 $BB94 JR NZ,$BB99     ;
 $BB96 LD ($5C3F),A    ; }
*$BB99 CP $08          ;
 $BB9B JR Z,$BC06      ;
 $BB9D CP $0E          ;
 $BB9F JR Z,$BBA5      ;
 $BBA1 CP $14          ;
 $BBA3 JR NZ,$BBDA     ;
*$BBA5 LD A,($5C06)    ; {only when ($5C06)=2 and hazard timer ($5C07)>=10
 $BBA8 CP $02          ;
 $BBAA JR NZ,$BC06     ;
 $BBAC LD A,($5C07)    ;
 $BBAF CP $0A          ; }
 $BBB1 JR C,$BC06      ;
 $BBB3 LD A,($5B04)    ; {|Y delta| vs (IY+0) must be <6 (in range)
 $BBB6 SUB (IY+$00)    ;
 $BBB9 JR NC,$BBBD     ;
 $BBBB NEG             ;
*$BBBD CP $06          ; }
 $BBBF JR NC,$BC06     ;
 $BBC1 LD A,(IY+$00)   ; {snap IX position to (IY+0/1)-23; state=15; ($5C06)=5
 $BBC4 LD (IX+$00),A   ;
 $BBC7 LD A,(IY+$01)   ;
 $BBCA SUB $17         ;
 $BBCC LD (IX+$01),A   ;
 $BBCF LD (IX+$02),$0F ; }
 $BBD3 LD A,$05        ;
 $BBD5 LD ($5C06),A    ;
 $BBD8 JR $BC06        ;
*$BBDA LD D,$01        ; {else: latch room ($5B98) into HL slot, save regs,
 $BBDC EX AF,AF'       ; fire event 2 via #R$C4B2
 $BBDD LD A,($5B98)    ;
 $BBE0 CP $FF          ;
 $BBE2 JR Z,$BBE7      ;
 $BBE4 LD (HL),A       ;
 $BBE5 LD E,$01        ;
*$BBE7 EX AF,AF'       ;
 $BBE8 PUSH DE         ;
 $BBE9 LD DE,$0032     ; }
 $BBEC CALL $BCF2      ; Save all registers
 $BBEF PUSH AF         ;
 $BBF0 LD A,$02        ;
 $BBF2 CALL $C4B2      ; Sound-effect dispatcher wrapper
 $BBF5 POP AF          ;
 $BBF6 POP DE          ;
 $BBF7 LD ($5B98),A    ;
 $BBFA LD (IY+$02),$FE ; {clear IY object (type=$FE), hide its display object
 $BBFE LD L,(IY+$03)   ; (SET 7)
 $BC01 LD H,(IY+$04)   ; }
 $BC04 SET 7,(HL)      ;
*$BC06 POP HL          ;
*$BC07 PUSH DE         ; {D!=0: #R$9E5D refresh $5BD6 slots
 $BC08 LD A,D          ;
 $BC09 OR A            ; }
 $BC0A CALL NZ,$9E5D   ; Populate the $5BD6 object-slot table
 $BC0D POP DE          ;
 $BC0E LD A,E          ;
 $BC0F OR A            ;
 $BC10 RET Z           ;
 $BC11 LD A,C          ; {pick index from C (0/1/2+), store $5C23, #R$9EBD init
 $BC12 OR A            ; slots
 $BC13 JR Z,$BC19      ;
 $BC15 DEC A           ;
 $BC16 JR Z,$BC19      ;
 $BC18 DEC A           ; }
*$BC19 LD ($5C23),A    ;
 $BC1C JP $9EBD        ; => Init $5BD6 object slots from $5C23

