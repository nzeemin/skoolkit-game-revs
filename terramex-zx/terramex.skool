; Scripted event: trigger room $1C lift sequence at a fixed spot
;
; .
;
; .
;
; Stage-0 checks the flag byte at $5C40 (via #R$B165) then initializes an
; object at $5B10 from a template; once room $5B98=2 and the hero stands at the
; fixed spot (X=$DC, Y=$48), advances the stage and fires status $1C via
; #R$AE85 (the room $1C lift trigger seen elsewhere in the room-format notes).
; Stages 1+ (dispatched at $B3AB) drive whatever animation follows - not
; detailed here, but the pattern matches the other staged-object routines
; ($B0B6, $B4E2). Reads as one of several similar "walk to this exact spot in
; this exact room to trigger a scripted lift/sequence" set-pieces.
c$B370 CALL $B165      ; Read/test flag
 $B373 RET NZ          ;
 $B374 LD IY,$5B10     ;
 $B378 LD HL,$5C41     ;
 $B37B LD A,(HL)       ;
 $B37C OR A            ; {stage 0?
 $B37D JR NZ,$B3AB     ; }
 $B37F LD (IY+$00),$64 ; init object position/frame
 $B383 LD (IY+$01),$48 ;
 $B387 LD (IY+$02),$4F ;
 $B38B LD (IY+$03),$00 ;
 $B38F LD A,($5B98)    ;
 $B392 CP $02          ; {room-category == 2?
 $B394 RET NZ          ; }
 $B395 LD A,($5B04)    ;
 $B398 CP $DC          ; {player X == $DC?
 $B39A RET NZ          ; }
 $B39B LD A,($5B05)    ;
 $B39E CP $48          ; {player Y == $48?
 $B3A0 RET NZ          ; }
 $B3A1 INC (HL)        ;
 $B3A2 RES 7,(IX+$03)  ;
 $B3A6 LD A,$1C        ; status=$1C
 $B3A8 JP $AE85        ; Set hero status ($5C06), clear hazard timer ($5C07)
*$B3AB LD A,(HL)       ; {A = stage
 $B3AC DEC A           ; }
 $B3AD JR NZ,$B3C7     ; stage 1?
 $B3AF LD A,(IX+$02)   ;
 $B3B2 CP $3E          ; {hero frame == $3E (lift ready)?
 $B3B4 RET NZ          ; }
 $B3B5 INC (HL)        ;
 $B3B6 LD (IY+$04),$C8 ;
 $B3BA LD (IY+$05),$39 ;
 $B3BE LD (IY+$06),$39 ;
 $B3C2 LD (IY+$07),$00 ;
 $B3C6 RET             ;
*$B3C7 DEC A           ;
 $B3C8 JR NZ,$B3EC     ;
 $B3CA INC (IY+$05)    ;
 $B3CD LD A,(IY+$04)   ;
 $B3D0 SUB $04         ; {lift X -= 4
 $B3D2 LD (IY+$04),A   ; }
 $B3D5 LD A,(IY+$05)   ;
 $B3D8 CP $52          ; {reached Y=$52?
 $B3DA RET NZ          ; }
 $B3DB INC (HL)        ;
 $B3DC INC (IY+$02)    ;
 $B3DF LD (IY+$04),$DC ;
 $B3E3 LD (IY+$05),$08 ;
 $B3E7 LD (IY+$06),$8F ;
 $B3EB RET             ;
*$B3EC INC (IY+$05)    ;
 $B3EF LD A,(IY+$05)   ;
 $B3F2 CP $48          ; {reached Y=$48?
 $B3F4 RET NZ          ; }
 $B3F5 LD A,$01        ; {set flag $5C00 (lift done)
 $B3F7 LD ($5C00),A    ; }
 $B3FA LD (IY+$06),$7F ;
 $B3FE LD A,$0F        ;
 $B400 LD ($5B98),A    ;
 $B403 CALL $9E5D      ; Populate the $5BD6 object-slot table
 $B406 JP $AE84        ; => Set hero status ($5C06), clear hazard timer ($5C07)

; Staged animation: init object ($5B14), branch on player side
;
; .
;
; .
;
; Room hazard that bounces an object vertically between floor and ceiling,
; starting on whichever side of the screen the hero stands on. Stage 0 picks
; that side and places the object; stage 1 hands off to the ceiling-bound or
; floor-bound mover depending on the object's type, each stepping 1px per frame
; and bouncing off both the opposite bound and the side walls; stage 2 resets
; the state.
c$B409 LD IY,$5B14     ;
 $B40D LD HL,$5C41     ;
 $B410 LD A,(HL)       ;
 $B411 OR A            ; {stage 0?
 $B412 JR NZ,$B436     ; }
 $B414 INC (HL)        ;
 $B415 LD A,(IX+$00)   ;
 $B418 LD C,$01        ;
 $B41A CP $C8          ; player left of $C8?
 $B41C LD (IY+$00),$D8 ; start at bottom (Y=$D8), else top (Y=$08)
 $B420 JR C,$B427      ;
 $B422 DEC C           ;
 $B423 LD (IY+$00),$08 ;
*$B427 LD A,C          ;
 $B428 LD ($5C40),A    ; store side flag ($5C40)
 $B42B LD A,$30        ;
 $B42D LD ($5B15),A    ;
 $B430 LD A,$9E        ;
 $B432 LD ($5B16),A    ;
 $B435 RET             ;
*$B436 CP $01          ; {stage 1 dispatch
 $B438 JR NZ,$B45E     ; }
 $B43A LD A,($5C40)    ;
 $B43D LD C,A          ;
 $B43E OR A            ; {side flag picks the up or down mover
 $B43F PUSH AF         ; }
 $B440 CALL NZ,$B4B0   ; Move object up toward ceiling, bounce via #R$B4D5
 $B443 POP AF          ;
 $B444 CALL Z,$B47E    ; Move object down toward floor, bounce via #R$B4A3
 $B447 LD A,E          ;
 $B448 OR A            ;
 $B449 RET NZ          ;
 $B44A CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $B44D RET NC          ;
 $B44E LD (HL),$02     ;
 $B450 LD A,($5C40)    ;
 $B453 XOR $01         ; {flip side flag for next time
 $B455 LD ($5C40),A    ; }
 $B458 LD A,$15        ; {status=$15
 $B45A LD ($5C06),A    ; }
 $B45D RET             ;
*$B45E CP $02          ; {stage 2 dispatch
 $B460 RET NZ          ; }
 $B461 LD A,($5C40)    ;
 $B464 LD C,A          ;
 $B465 OR A            ;
 $B466 PUSH AF         ;
 $B467 CALL NZ,$B4B5   ;
 $B46A POP AF          ;
 $B46B CALL Z,$B483    ;
 $B46E LD A,E          ;
 $B46F OR A            ;
 $B470 RET NZ          ;
 $B471 LD A,(IX+$01)   ;
 $B474 SUB $08         ; {Y -= 8
 $B476 LD (IX+$01),A   ; }
 $B479 LD (HL),$03     ;
 $B47B JP $AE84        ; => Set hero status ($5C06), clear hazard timer ($5C07)

; Move object down toward floor, bounce via #R$B4A3
;
; Used by the routine at #R$B409.
;
; .
;
; Walks an object downward one pixel per frame until it reaches the floor,
; drifting sideways as it goes and bouncing off the left and right walls.
c$B47E LD A,($5C42)  ; A = gate flag ($5C42)
 $B481 OR A          ; {set? nothing to do
 $B482 RET NZ        ; }
; This entry point is used by the routine at #R$B409.
*$B483 LD E,$00      ; E=0 (not moved)
 $B485 LD A,(IY+$00) ; {already at the floor ($D8)?
 $B488 CP $D8        ; }
 $B48A RET NC        ;
 $B48B INC E         ; {E=1, B = current X
 $B48C LD B,(IY+$01) ; }
 $B48F INC A         ; {Y += 1
 $B490 LD (IY+$00),A ; }
 $B493 CP $38        ; {past $38? bounce via #R$B4A3
 $B495 JR NC,$B4A3   ; }
 $B497 LD C,A        ;
 $B498 LD A,B        ; {X -= 2
 $B499 SUB $02       ; }
 $B49B CP $08        ; {below 8? RET
 $B49D RET C         ; }
 $B49E LD (IY+$01),A ; store X
 $B4A1 RET           ;

; Data block at B4A2
b$B4A2 DEFB $79

; Right-bounce clamp for #R$B47E: X>=$C8 -> RET, else X+=2
;
; Used by the routine at #R$B47E.
c$B4A3 CP $C8        ;
 $B4A5 RET C         ;
 $B4A6 LD A,B        ;
 $B4A7 ADD A,$02     ;
 $B4A9 CP $30        ;
 $B4AB RET NC        ;
 $B4AC LD (IY+$01),A ;
 $B4AF RET           ;

; Move object up toward ceiling, bounce via #R$B4D5
;
; Used by the routine at #R$B409.
;
; .
;
; Walks an object upward one pixel per frame until it reaches the ceiling, the
; mirror of #R$B47E.
c$B4B0 LD A,($5C42)  ; A = gate flag ($5C42)
 $B4B3 OR A          ; {clear? nothing to do
 $B4B4 RET Z         ; }
; This entry point is used by the routine at #R$B409.
*$B4B5 LD E,$00      ; E=0 (not moved)
 $B4B7 LD A,(IY+$00) ; {already at the ceiling (9)?
 $B4BA CP $09        ; }
 $B4BC RET C         ;
 $B4BD INC E         ; {E=1, B = current X
 $B4BE LD B,(IY+$01) ; }
 $B4C1 DEC A         ; {Y -= 1
 $B4C2 LD (IY+$00),A ; }
 $B4C5 CP $1C        ; {past $1C? bounce via #R$B4D5
 $B4C7 JR NC,$B4D5   ; }
 $B4C9 LD C,A        ;
 $B4CA LD A,B        ; {X += 2
 $B4CB ADD A,$02     ; }
 $B4CD CP $30        ; {past $30? RET
 $B4CF RET NC        ; }
 $B4D0 LD (IY+$01),A ; store X
 $B4D3 RET           ;

; Data block at B4D4
b$B4D4 DEFB $79

; Left-bounce clamp for #R$B4B0: X>=$7B -> RET, else X-=2
;
; Used by the routine at #R$B4B0.
c$B4D5 CP $7B        ;
 $B4D7 RET C         ;
 $B4D8 LD A,B        ;
 $B4D9 SUB $02       ;
 $B4DB CP $08        ;
 $B4DD RET C         ;
 $B4DE LD (IY+$01),A ;
 $B4E1 RET           ;

; Staged animation: init object ($5B10), scripted trigger via #R$AE85
;
; .
;
; .
;
; Drives a small scripted sequence for a set-piece object: sets it up, waits
; for the hero to approach, then plays out an animation and fires a status
; trigger.
c$B4E2 LD IY,$5B10     ;
 $B4E6 LD HL,$5C41     ;
 $B4E9 LD A,(HL)       ;
 $B4EA OR A            ; {stage 0?
 $B4EB JR NZ,$B4FA     ; }
 $B4ED LD (IY+$00),$A4 ;
 $B4F1 LD (IY+$01),$40 ;
 $B4F5 LD (IY+$02),$40 ;
 $B4F9 INC (HL)        ;
*$B4FA LD HL,$5C45     ; HL=$5C45 (sub-stage)
 $B4FD LD A,(HL)       ;
 $B4FE CP $FF          ; {sub-stage $FF (finished)?
 $B500 JR Z,$B554      ; }
 $B502 OR A            ;
 $B503 JR NZ,$B52B     ;
 $B505 LD A,(IX+$01)   ;
 $B508 CP $48          ; {player Y >= $48?
 $B50A RET NC          ; }
 $B50B LD A,(IX+$00)   ;
 $B50E CP $62          ; {player X >= $62?
 $B510 RET C           ; }
 $B511 LD A,($5B98)    ;
 $B514 CP $1D          ;
 $B516 JR Z,$B52B      ;
 $B518 SET 7,(IY+$03)  ; arm object flag
 $B51C LD (IY+$02),$44 ;
 $B520 LD A,($5C06)    ;
 $B523 CP $04          ; {status already >= 4? RET
 $B525 RET NC          ; }
 $B526 LD A,$17        ;
 $B528 JP $AE85        ;
*$B52B LD (HL),$01     ; sub-stage=1 (running)
 $B52D RES 7,(IY+$03)  ;
 $B531 LD A,(IY+$00)   ;
 $B534 CP $E6          ; {reached X limit ($E6)?
 $B536 JR C,$B540      ; }
 $B538 LD DE,$0096     ;
 $B53B CALL $BCF2      ; Save all registers
 $B53E JR $B554        ;
*$B540 INC (IY+$00)    ; {X += 2
 $B543 INC (IY+$00)    ; }
 $B546 LD C,$41        ;
 $B548 LD A,($5C02)    ; get Frame counter
 $B54B SRL A           ;
 $B54D AND $03         ;
*$B54F ADD A,C         ;
 $B550 LD (IY+$02),A   ;
 $B553 RET             ;
*$B554 LD (HL),$FF     ; sub-stage=$FF (done)
 $B556 LD A,$7F        ;
 $B558 JR $B54F        ;

; Init 2 objects ($5B0C) variant, falls into #R$B57C
c$B55A LD IY,$5B0C   ;
 $B55E LD B,$02      ;
 $B560 JR $B57C      ;

; Init 3 objects ($5B0C) from template; animate frame, room-specific variant
;
; .
;
; .
;
; Sets up and animates a group of 3 decorative objects from a shared template,
; with the exact appearance varying by room - the multi-object sibling of
; #R$B4E2's single-object staged animation.
c$B562 LD IY,$5B0C     ; IY=object ($5B0C)
 $B566 LD HL,$5C41     ; HL=stage counter ($5C41)
 $B569 LD A,(HL)       ;
 $B56A OR A            ; {stage==0? else skip init
 $B56B JR NZ,$B57A     ; }
 $B56D INC (HL)        ;
 $B56E LD HL,$B5D1     ;
 $B571 LD DE,$5B0C     ;
 $B574 LD BC,$000C     ;
 $B577 LDIR            ; copy template (12 bytes)
 $B579 RET             ;
*$B57A LD B,$03        ; B=3 objects
; This entry point is used by the routine at #R$B55A.
*$B57C LD A,(IY+$02)   ; {frame==$7F (inactive)? skip
 $B57F CP $7F          ; }
 $B581 JR Z,$B5B7      ;
 $B583 CP $55          ; {frame==$55 (trigger)? branch
 $B585 JR Z,$B5C8      ; }
 $B587 LD A,($5C02)    ; get Frame counter
 $B58A AND $01         ;
 $B58C ADD A,(IY+$02)  ;
 $B58F CP $55          ;
 $B591 JR NZ,$B595     ; {wrapped? reset to $51
 $B593 LD A,$51        ; }
*$B595 LD (IY+$02),A   ;
 $B598 LD A,($5C01)    ; get Current room number
 $B59B CP $17          ;
 $B59D JR Z,$B5A6      ;
 $B59F LD A,(IX+$01)   ;
 $B5A2 CP $3A          ;
 $B5A4 JR NC,$B5AD     ;
*$B5A6 LD A,($5B98)    ;
 $B5A9 CP $0C          ; {room-category==$0C?
 $B5AB JR Z,$B5B7      ; }
*$B5AD LD A,(IX+$00)   ;
 $B5B0 AND $FC         ; {object aligned with player (masked)?
 $B5B2 CP (IY+$00)     ; }
 $B5B5 JR Z,$B5C2      ;
*$B5B7 INC IY          ;
 $B5B9 INC IY          ;
 $B5BB INC IY          ;
 $B5BD INC IY          ;
 $B5BF DJNZ $B57C      ;
 $B5C1 RET             ;
*$B5C2 LD A,$55        ;
 $B5C4 LD (IY+$02),A   ;
 $B5C7 RET             ;
*$B5C8 LD (IY+$02),$7F ;
 $B5CC LD A,$19        ; {trigger $19 via #R$AE85
 $B5CE JP $AE85        ; }

; 12-byte object template copied by #R$B562
b$B5D1 DEFB $44,$60,$51,$00,$70,$60,$52,$80
 $B5D9 DEFB $94,$60,$53,$00

; Boss/miniboss state machine: proximity check, phase transitions
; ($5C3C-$5C3E), animation
;
; .
;
; .
;
; A fixed encounter tied to one room: once the hero gets close enough, it plays
; through a sequence of phases and eventually warps the hero to room $28 with a
; fanfare, rather than acting like a roaming creature. Between phases it also
; runs a small scripted patrol, pacing back and forth and reacting when the
; hero reaches either edge.
c$B5DD LD IY,$5B14     ;
 $B5E1 CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $B5E4 JR NC,$B612     ; not eligible? skip
 $B5E6 LD HL,$5B98     ;
 $B5E9 LD A,($5C3C)    ; {room == locked boss room ($5C3C)?
 $B5EC CP (HL)         ; }
 $B5ED JR NZ,$B612     ;
 $B5EF PUSH IY         ;
 $B5F1 PUSH IX         ;
 $B5F3 LD (HL),$FF     ; mark room handled
 $B5F5 LD ($5C3E),A    ; save type ($5C3E)
 $B5F8 CALL $B93F      ; Reset object slots ($5C0E), scan $B99D table for
                       ; current room
 $B5FB CALL $9E5D      ; Populate the $5BD6 object-slot table
 $B5FE LD DE,$0096     ;
 $B601 CALL $BCF2      ; Save all registers
 $B604 POP IX          ;
 $B606 POP IY          ;
 $B608 LD HL,$5C3D     ;
 $B60B INC (HL)        ; phase++
 $B60C LD A,(HL)       ; {phase==6?
 $B60D CP $06          ; }
 $B60F JP Z,$B6EE      ; => Force room $28, set $5BFE flag, trigger event via
                       ; #R$AE85
*$B612 LD HL,$5BA1     ;
 $B615 LD A,(HL)       ;
 $B616 OR A            ; {flag set? skip init
 $B617 JR NZ,$B62C     ; }
 $B619 INC (HL)        ;
 $B61A XOR A           ;
 $B61B LD ($B6ED),A    ;
 $B61E LD (IY+$01),$48 ;
 $B622 LD (IY+$00),$1A ;
 $B626 LD A,$30        ; {store room $30
 $B628 LD ($5B11),A    ; }
 $B62B RET             ;
*$B62C AND $7F         ; mask flag
 $B62E CP $01          ; {flag==1? branch to patrol
 $B630 JR Z,$B676      ; }
 $B632 LD HL,$B6ED     ;
 $B635 LD DE,$B6C1     ;
 $B638 CALL $ABE1      ;
 $B63B LD HL,$5BA1     ;
 $B63E CP $FF          ; {step==$FF (list end)?
 $B640 JR NZ,$B649     ; }
*$B642 LD A,$7F        ;
 $B644 LD ($5B12),A    ;
 $B647 DEC (HL)        ;
 $B648 RET             ;
*$B649 BIT 7,(HL)      ; already armed?
 $B64B JR NZ,$B651     ;
 $B64D CP $4D          ; {step==$4D? re-arm
 $B64F JR Z,$B642      ; }
*$B651 LD C,(IY+$02)   ;
 $B654 LD (IY+$02),A   ;
 $B657 CP $4D          ; {step==$4D?
 $B659 RET NZ          ; }
 $B65A LD A,C          ;
 $B65B CP $4D          ;
 $B65D RET Z           ;
 $B65E LD A,($5C3D)    ; {phase -> table index
 $B661 LD L,A          ; }
 $B662 LD H,$00        ;
 $B664 LD DE,$B6BB     ;
 $B667 ADD HL,DE       ;
 $B668 LD A,(HL)       ; {store hazard code ($5C3C)
 $B669 LD ($5C3C),A    ; }
 $B66C ADD A,$80       ;
 $B66E LD ($5B12),A    ;
 $B671 XOR A           ;
 $B672 LD ($5B13),A    ;
 $B675 RET             ;
*$B676 LD A,(IY+$00)   ;
 $B679 SET 7,(IY+$03)  ;
 $B67D LD C,$02        ;
 $B67F BIT 7,(HL)      ; {edge flag set? reverse direction
 $B681 JR Z,$B689      ; }
 $B683 RES 7,(IY+$03)  ;
 $B687 LD C,$FE        ;
*$B689 LD A,(IY+$00)   ;
 $B68C ADD A,C         ;
 $B68D LD (IY+$00),A   ;
 $B690 LD ($5B10),A    ;
 $B693 SUB $04         ; {column = (pos-4)>>2
 $B695 LD C,A          ; }
 $B696 AND $1F         ;
 $B698 OR A            ;
 $B699 JR NZ,$B6AE     ;
 $B69B INC (HL)        ;
 $B69C XOR A           ;
 $B69D LD ($B6ED),A    ;
 $B6A0 LD A,C          ;
 $B6A1 CP $C0          ; {column>=$C0? right edge
 $B6A3 JR C,$B6A8      ; }
 $B6A5 SET 7,(HL)      ;
 $B6A7 RET             ;
*$B6A8 CP $22          ; {column<$22? left edge
 $B6AA RET NC          ; }
 $B6AB RES 7,(HL)      ;
 $B6AD RET             ;
*$B6AE LD A,($5C02)    ; get Frame counter
 $B6B1 SRL A           ; {halve, keep 2 bits
 $B6B3 AND $03         ; }
 $B6B5 ADD A,$49       ; {frame = base $49 + that
 $B6B7 LD (IY+$02),A   ; }
 $B6BA RET             ;

; Per-phase hazard codes for the #R$B5DD encounter
b$B6BB DEFB $0F,$13,$12,$15,$11,$17

; Scripted step sequence for the #R$B5DD encounter
t$B6C1 DEFM "NNNNNNNNNNNEEEFGHGHGHGHGHGFEEEMMMMMMMMMMMMM"

; Data block at B6EC
b$B6EC DEFB $FF,$00

; Force room $28, set $5BFE flag, trigger event via #R$AE85
;
; Used by the routine at #R$B5DD.
c$B6EE LD A,$28      ;
 $B6F0 LD ($5C01),A  ; set Current room number
 $B6F3 CALL $9855    ; Set up the current room
 $B6F6 LD A,$1D      ;
 $B6F8 LD ($5BFE),A  ;
 $B6FB CALL $AE85    ;
 $B6FE LD A,$7F      ;
 $B700 LD ($5B06),A  ;
 $B703 RET           ;

; Position+room gate: room $5B98=$0D, status $5C06=0 -> trigger $1B via #R$AE85
;
; .
;
; .
;
; Fires a one-shot scripted trigger when the hero is standing on an exact spot
; in one particular room with nothing else already happening.
c$B704 LD A,(IX+$01) ; A = object Y
 $B707 CP $20        ; {Y == $20?
 $B709 RET NZ        ; }
 $B70A LD A,(IX+$00) ; A = object X
 $B70D CP $84        ; {X past $84? RET
 $B70F RET NC        ; }
 $B710 CP $76        ;
 $B712 RET C         ;
 $B713 LD A,($5B98)  ; A = room category
 $B716 CP $0D        ; {category $0D?
 $B718 RET NZ        ; }
 $B719 LD A,($5C06)  ; A = status ($5C06)
 $B71C OR A          ; {not idle? RET
 $B71D RET NZ        ; }
 $B71E LD A,$1B      ; {trigger $1B via #R$AE85
 $B720 JP $AE85      ; }

; Init object Y=8, falls into #R$B735
c$B723 LD IY,$5B14     ;
 $B727 LD (IY+$00),$08 ;
 $B72B JR $B735        ;

; Init object Y=$DC (variant); animation frame + type-gated deactivate
;
; .
;
; .
;
; Sets up an object at the bottom of the screen and drives its animation,
; retiring it once its type indicates it's no longer needed.
c$B72D LD IY,$5B14     ; IY=$5B14
 $B731 LD (IY+$00),$DC ; Y=$DC (variant start)
; This entry point is used by the routine at #R$B723.
*$B735 LD (IY+$01),$12 ; frame=$12
 $B739 LD C,$56        ; C=$56
 $B73B LD A,($5C43)    ; {flag $5C43 set?
 $B73E OR A            ; }
 $B73F JR Z,$B742      ;
 $B741 INC C           ; C++ (alternate frame)
*$B742 LD (IY+$02),C   ; store frame
 $B745 JR NZ,$B75C     ; flag was set? skip ahead
 $B747 LD A,($5B98)    ; {room category $10?
 $B74A CP $10          ; }
 $B74C RET NZ          ;
 $B74D CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $B750 RET NC          ; wrong type? RET
 $B751 LD A,$FF        ; {mark handled ($5B98=$FF)
 $B753 LD ($5B98),A    ; }
 $B756 LD ($5C43),A    ; and $5C43
 $B759 JP $9E5D        ; => Populate the $5BD6 object-slot table
*$B75C LD A,($5C42)    ; A=flag ($5C42)
 $B75F CALL $B779      ; arm or disarm via #R$B779
 $B762 LD HL,$5C40     ; HL=$5C40
 $B765 CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $B768 JR C,$B76D      ; wrong type? skip
 $B76A LD (HL),$00     ; clear flag ($5C40)
 $B76C RET             ;
*$B76D LD A,(HL)       ; {flag already set? RET
 $B76E OR A            ; }
 $B76F RET NZ          ;
 $B770 LD (HL),$01     ; set it
 $B772 LD HL,$5C42     ; HL=$5C42
 $B775 LD A,(HL)       ;
 $B776 XOR $FF         ; flip flag ($5C42)
 $B778 LD (HL),A       ;
*$B779 OR A            ;
 $B77A SET 7,(IY+$03)  ; arm (IY+3) bit7
 $B77E RET Z           ;
 $B77F RES 7,(IY+$03)  ; flag clear? disarm instead
 $B783 RET             ;

; Stage counter advance ($5C41); at stage $14 check $5C3F, trigger $17 via
; #R$AE85
;
; .
;
; .
;
; Advances a scripted sequence one step per frame, and at one particular step
; checks a flag before firing the trigger that ends it.
c$B784 LD HL,$5C41   ; HL = stage counter ($5C41)
 $B787 LD A,(HL)     ; {stage $14?
 $B788 CP $14        ; }
 $B78A JR Z,$B791    ; yes: check the flag
 $B78C CP $15        ; {stage $15? nothing to do
 $B78E RET Z         ; }
 $B78F INC (HL)      ; else advance the stage
 $B790 RET           ; RET
*$B791 LD A,($5C3F)  ; A = flag ($5C3F)
 $B794 OR A          ; {set? not yet
 $B795 RET NZ        ; }
 $B796 INC (HL)      ; {advance the stage, status=$17
 $B797 LD A,$17      ; }
 $B799 JP $AE85      ; Set hero status ($5C06), clear hazard timer ($5C07)

; Fill-pattern variant A (B=$15, base $F940), falls into #R$B7A8
c$B79C LD B,$15      ;
 $B79E LD HL,$F940   ;
 $B7A1 JR $B7A8      ;

; Fill-pattern variant B (B=$0B, base $F954): init position, draw pattern via
; #R$9A4D
;
; .
;
; .
;
; Stashes the object's position into the $5B14 slot fields, then paints a short
; column of cells in alternating colours (parity of the row and the frame
; counter) - reads as a beam or trail drawn from the object rather than a
; whole-screen effect.
c$B7A3 LD B,$0B      ; B=$0B rows
 $B7A5 LD HL,$F954   ; HL=$F954 (base)
; This entry point is used by the routine at #R$B79C.
*$B7A8 XOR A         ;
 $B7A9 LD ($5B09),A  ; clear $5B09
 $B7AC LD ($5B0D),A  ; {clear $5B0D and $5B11
 $B7AF LD ($5B11),A  ; }
 $B7B2 LD A,(IX+$00) ; {X ((IX+0)) -> $5B14
 $B7B5 LD ($5B14),A  ; }
 $B7B8 LD A,(IX+$01) ; {object Y + 8
 $B7BB ADD A,$08     ; }
 $B7BD CP $5A        ; {past $5A? leave $5B15 alone
 $B7BF JR NC,$B7C4   ; }
 $B7C1 LD ($5B15),A  ; store Y -> $5B15
*$B7C4 LD A,($5C02)  ; get Frame counter
 $B7C7 SRL A         ; {frame parity into C
 $B7C9 AND $01       ; }
 $B7CB LD C,A        ;
 $B7CC LD A,B        ; {row parity
 $B7CD AND $01       ; }
 $B7CF ADD A,$BC     ; {pick the colour ($BC or $BD)
 $B7D1 XOR C         ; }
 $B7D2 PUSH BC       ; {save BC/HL
 $B7D3 PUSH HL       ; }
 $B7D4 CALL $9A4D    ; Write A to (HL), DE=HL, fall into #R$9A62 dual-write
                     ; loop
 $B7D7 POP HL        ; {restore address, advance
 $B7D8 INC HL        ; }
 $B7D9 POP BC        ;
 $B7DA DJNZ $B7A8    ; loop rows
 $B7DC RET           ;

; Per-room init dispatch: table $B7EC indexed by room, jump via #R$A6DD
;
; Used by the routine at #R$A3E1.
c$B7DD LD A,($5C01)  ;
 $B7E0 LD L,A        ;
 $B7E1 LD H,$00      ;
 $B7E3 ADD HL,HL     ;
 $B7E4 PUSH DE       ;
 $B7E5 LD DE,$B7EC   ;
 $B7E8 ADD HL,DE     ;
 $B7E9 JP $A6DD      ;

; Per-room init handler table (2 bytes/room, #R$B7DD)
b$B7EC DEFB $00,$00,$00,$00,$00,$00,$D7,$AF
 $B7F4 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B7FC DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B804 DEFB $00,$00,$00,$00,$00,$00,$D7,$AF
 $B80C DEFB $00,$00,$00,$00,$6A,$B1,$00,$00
 $B814 DEFB $00,$00,$00,$00,$00,$00,$5A,$B5
 $B81C DEFB $00,$00,$00,$00,$62,$B5,$00,$00
 $B824 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B82C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B834 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B83C DEFB $B6,$B0,$00,$00,$00,$00,$00,$00
 $B844 DEFB $4B,$A3,$70,$B3,$63,$B2,$2D,$B2
 $B84C DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $B854 DEFB $00,$00,$A3,$B7,$9C,$B7,$00,$00
 $B85C DEFB $00,$00,$E2,$B4,$00,$00,$DD,$B5
 $B864 DEFB $84,$B7,$00,$00,$2D,$B7,$09,$B4
 $B86C DEFB $23,$B7,$00,$00,$00,$00,$04,$B7
 $B874 DEFB $00,$00,$00,$00,$EB,$B2,$8A,$B1
 $B87C DEFB $00                             ; Input bits: 000FUDLR

; Resolve conflicting L/R, U/D input via #R$B894 (cancel to 0)
;
; Used by the routines at #R$A34B, #R$A3E1 and #R$AF81.
;
; .
;
; Reads the current input and cancels out impossible presses (both left and
; right, or both up and down at once) before the movement code sees it.
c$B87D CALL $B894    ; Read joystick/keyboard, normalize to Kempston-style
                     ; bitmask
 $B880 LD E,A        ; keep a copy in E
 $B881 AND $03       ; {left and right both pressed?
 $B883 CP $03        ; }
 $B885 JR NZ,$B889   ;
 $B887 XOR A         ; {yes: cancel to 0
 $B888 RET           ; }
*$B889 LD A,E        ; {up and down both pressed?
 $B88A AND $0C       ; }
 $B88C CP $0C        ;
 $B88E JR NZ,$B892   ;
 $B890 XOR A         ; {yes: cancel to 0
 $B891 RET           ; }
*$B892 LD A,E        ; {return E (no conflict)
 $B893 RET           ; }

; Read joystick/keyboard, normalize to Kempston-style bitmask
;
; Used by the routine at #R$B87D.
;
; .
;
; Device selected by ($94AF): 0=keyboard (redefined keys, table at $B8D4),
; 1=Kempston (port $1F), 2=Sinclair 2 (keys 6-0, port $EFFE). Result stored at
; $B87C: bit0=right, bit1=left, bit2=down, bit3=up, bit4=fire.
c$B894 LD HL,$B87C   ;
 $B897 LD (HL),$00   ;
 $B899 LD A,($94AF)  ; {A = device ($94AF)
 $B89C OR A          ; }
 $B89D JP Z,$B8FE    ; zero? keyboard
 $B8A0 DEC A         ; {device=1: Kempston
 $B8A1 JR Z,$B8CC    ; }
 $B8A3 LD BC,$EFFE   ; {device=2: Sinclair, read port $EFFE
 $B8A6 IN A,(C)      ; }
 $B8A8 AND $1F       ;
 $B8AA BIT 0,A       ;
 $B8AC JR NZ,$B8B0   ;
 $B8AE SET 4,(HL)    ;
*$B8B0 BIT 4,A       ;
 $B8B2 JR NZ,$B8B6   ;
 $B8B4 SET 1,(HL)    ;
*$B8B6 BIT 3,A       ;
 $B8B8 JR NZ,$B8BC   ;
 $B8BA SET 0,(HL)    ;
*$B8BC BIT 1,A       ;
 $B8BE JR NZ,$B8C2   ;
 $B8C0 SET 3,(HL)    ;
*$B8C2 BIT 2,A       ;
 $B8C4 JP NZ,$B930   ; => Return normalized input bitmask
 $B8C7 SET 2,(HL)    ;
 $B8C9 JP $B930      ; => Return normalized input bitmask
*$B8CC IN A,($1F)    ; {read the Kempston port $1F
 $B8CE AND $1F       ; }
 $B8D0 LD (HL),A     ; store the result
 $B8D1 JP $B930      ; => Return normalized input bitmask

; Data block at B8D4
b$B8D4 DEFB $01,$FE,$F7,$ED,$78,$CB,$67,$20
 $B8DC DEFB $02,$CB,$CE,$01,$FE,$EF,$ED,$78
 $B8E4 DEFB $CB,$47,$20,$02,$CB,$E6,$CB,$57
 $B8EC DEFB $20,$02,$CB,$C6,$CB,$5F,$20,$02
 $B8F4 DEFB $CB,$DE,$CB,$67,$C0,$CB,$D6,$C3
 $B8FC DEFB $30,$B9,$01,$FE,$7F,$ED,$78,$CB
 $B904 DEFB $47,$20,$02,$CB,$E6,$01,$FE,$FE
 $B90C DEFB $ED,$78,$CB,$4F,$20,$02,$CB,$CE
 $B914 DEFB $CB,$57,$20,$02,$CB,$C6,$01,$FE
 $B91C DEFB $DF,$ED,$78,$CB,$4F,$20,$02,$CB
 $B924 DEFB $DE,$01,$FE,$BF,$ED,$78,$CB,$57
 $B92C DEFB $20,$02,$CB,$D6

; Return normalized input bitmask ($B87C)
;
; Used by the routine at #R$B894.
c$B930 LD A,(HL)     ;
 $B931 RET           ;

; Clear active flag (bit7) across all $B99D creature-table entries
;
; Used by the routine at #R$8F47.
c$B932 LD B,$1F      ;
 $B934 LD HL,$B99D   ;
*$B937 RES 7,(HL)    ;
 $B939 INC HL        ;
 $B93A INC HL        ;
 $B93B INC HL        ;
 $B93C DJNZ $B937    ;
 $B93E RET           ;

; Reset object slots ($5C0E), scan $B99D table for current room
;
; Used by the routines at #R$9880, #R$B5DD and #R$B9FA.
;
; .
;
; Clears the two dynamic encounter slots and repopulates them from the
; room-tagged encounter table for whatever room the hero is now in - run on
; every room entry (see Actors.md for the $B99D table itself).
c$B93F LD IX,$5C0E     ;
 $B943 LD (IX+$02),$FF ;
 $B947 LD (IX+$07),$FF ;
 $B94B LD HL,$B99D     ;
 $B94E LD A,($5C01)    ; get Current room number
 $B951 LD C,$00        ;
 $B953 LD B,$1F        ;
*$B955 CP (HL)         ;
 $B956 CALL Z,$B95F    ; Spawn a creature/hazard into slot $5C0E/$5C13 from a
                       ; room-data entry
 $B959 INC HL          ;
 $B95A INC HL          ;
 $B95B INC HL          ;
 $B95C DJNZ $B955      ;
 $B95E RET             ;

; Spawn a creature/hazard into slot $5C0E/$5C13 from a room-data entry (HL)
;
; Used by the routine at #R$B93F.
;
;   HL room-data entry ($B99D format)
;   C running spawn counter (persisted across #R$B93F's scan, incremented here)
; O:IX chosen slot ($5C0E or $5C13)
;
; Spawns one creature/hazard from a $B99D table entry. A running spawn counter
; (C, carried over from #R$B93F's scan) picks which of the two dynamic slots it
; goes into and skips the entry entirely once both slots are already filled;
; the entry's own data then supplies the type and X/Y position.
c$B95F BIT 1,C       ; {skip if both slots already filled (bit1 of counter)
 $B961 RET NZ        ; }
 $B962 LD IX,$5C0E   ;
 $B966 BIT 0,C       ; {counter bit0 picks slot ($5C0E/$5C13)
 $B968 JR Z,$B96E    ; }
 $B96A LD IX,$5C13   ;
*$B96E INC C         ; counter++ (mark this slot used)
 $B96F PUSH HL       ;
 $B970 PUSH AF       ;
 $B971 PUSH BC       ;
 $B972 LD (IX+$03),L ; {store own address (IX+3/4)
 $B975 LD (IX+$04),H ; }
 $B978 INC HL        ; {HL -> type byte
 $B979 LD A,(HL)     ; }
 $B97A INC HL        ; {step to the position byte
 $B97B LD C,(HL)     ; }
 $B97C PUSH AF       ;
 $B97D AND $1F       ; {type = entry byte1 AND $1F
 $B97F LD (IX+$02),A ; }
 $B982 POP AF        ;
 $B983 AND $E0       ; {X = entry byte2 high bits
 $B985 LD L,A        ; }
 $B986 LD A,C        ;
 $B987 AND $03       ;
 $B989 RRA           ; {rotate X bits into place
 $B98A RR L          ; }
 $B98C RRA           ;
 $B98D RR L          ;
 $B98F LD (IX+$00),L ;
 $B992 LD A,C        ; {Y from entry byte2
 $B993 AND $FC       ; }
 $B995 ADD A,A       ;
 $B996 LD (IX+$01),A ;
 $B999 POP BC        ;
 $B99A POP AF        ;
 $B99B POP HL        ;
 $B99C RET           ;

; Room-tagged creature/encounter table
;
; .
;
; .
;
; Room-tagged creature/encounter table, separate from the per-room $C152 table
; (see Actors.md). 31 entries, 3 bytes each: byte0=room number this entry
; belongs to (bit7 double-purposed as a flag - toggled in bulk at init by
; #R$B932 and individually by #R$B9FA's boss-entry check at $B9D9, entry 20;
; exact armed-vs-consumed sense of the bit not confirmed), byte1=type ID (low 5
; bits, top 3 bits unconfirmed), byte2=X/Y sub-position, decoded by #R$B95F.
; Scanned linearly by #R$B93F on room entry, which also carries a running
; counter across the scan (not part of the table) that #R$B95F uses to pick
; which of the two dynamic object slots ($5C0E/$5C13) a match goes into, and to
; skip any further matches once both are filled. Entry 20 ($B9D9, room $30) is
; the one #R$B9FA treats as "the boss" - it's the only entry individually
; addressed by room-specific code rather than only via the linear scan.
b$B99D DEFB $00,$85,$06 ; {room-tagged encounter entries (see note)
 $B9A0 DEFB $07,$09,$22 ;
 $B9A3 DEFB $08,$8B,$06 ;
 $B9A6 DEFB $04,$36,$19 ;
 $B9A9 DEFB $09,$07,$16 ;
 $B9AC DEFB $0A,$CD,$32 ;
 $B9AF DEFB $0B,$80,$15 ;
 $B9B2 DEFB $14,$0A,$32 ;
 $B9B5 DEFB $16,$6C,$31 ;
 $B9B8 DEFB $0C,$02,$33 ;
 $B9BB DEFB $10,$E6,$1D ;
 $B9BE DEFB $10,$E3,$22 ;
 $B9C1 DEFB $1C,$4E,$25 ;
 $B9C4 DEFB $1D,$28,$24 ;
 $B9C7 DEFB $1D,$BB,$24 ;
 $B9CA DEFB $21,$BC,$24 ;
 $B9CD DEFB $22,$01,$2E ;
 $B9D0 DEFB $27,$30,$26 ;
 $B9D3 DEFB $2A,$A4,$26 ;
 $B9D6 DEFB $2C,$18,$1E ;
 $B9D9 DEFB $30,$38,$31 ;
 $B9DC DEFB $31,$53,$26 ;
 $B9DF DEFB $33,$14,$33 ;
 $B9E2 DEFB $34,$32,$32 ;
 $B9E5 DEFB $3C,$15,$2D ;
 $B9E8 DEFB $42,$31,$16 ;
 $B9EB DEFB $45,$B7,$10 ;
 $B9EE DEFB $2E,$0F,$22 ;
 $B9F1 DEFB $2F,$0F,$25 ;
 $B9F4 DEFB $46,$4F,$15 ;
 $B9F7 DEFB $47,$8F,$2C ; }

; Per-frame item dispatcher: room $30 boss-defeat check, else swap held item
; (SPACE)
;
; Used by the routine at #R$8F47.
;
; .
;
; In room $30 specifically, checks whether the hero is standing in a fixed
; doorway-sized box and clears bit7 of the $B99D table's room-$30 entry ($B9D9,
; see note there), forces a permanent "boss defeated" state ($5B98/$5C44=$FF),
; rescans the $B99D table for the room, and awards score via #R$BCF2. In every
; other room, falls through to #R$BB5D's pickup/hint check, then #R$BC1F which
; handles cycling the held item via the number-row keys (port $F7FE) with an
; animated scroll. The room-$30 special-case strongly suggests this is the
; specific boss-defeat trigger room, separate from the more generic #R$B5DD
; boss state machine.
c$B9FA LD A,($5C01)  ;
 $B9FD CP $30        ;
 $B9FF JR NZ,$BA33   ;
 $BA01 LD HL,$BA36   ;
 $BA04 PUSH HL       ;
 $BA05 LD A,($5B98)  ;
 $BA08 CP $18        ;
 $BA0A RET NZ        ;
 $BA0B LD A,(IX+$01) ;
 $BA0E CP $60        ;
 $BA10 RET NZ        ;
 $BA11 LD A,(IX+$00) ;
 $BA14 CP $40        ;
 $BA16 RET C         ;
 $BA17 CP $4C        ;
 $BA19 RET NC        ;
 $BA1A LD HL,$B9D9   ;
 $BA1D RES 7,(HL)    ;
 $BA1F LD A,$FF      ;
 $BA21 LD ($5B98),A  ;
 $BA24 LD ($5C44),A  ;
 $BA27 CALL $B93F    ; Reset object slots ($5C0E), scan $B99D table for current
                     ; room
 $BA2A LD DE,$004B   ;
 $BA2D CALL $BCF2    ; Save all registers
 $BA30 JP $9E5D      ; => Populate the $5BD6 object-slot table
*$BA33 CALL $BB5D    ; Item pickup/hint check for both creature slots
 $BA36 LD A,($5C22)  ;
 $BA39 OR A          ;
 $BA3A CALL $BC1F    ; Cycle inventory selection via keys (port $F7FE), animate
                     ; scroll
 $BA3D LD BC,$FDFE   ;
 $BA40 IN A,(C)      ;
 $BA42 AND $02       ;
 $BA44 JR NZ,$BA7B   ;
 $BA46 LD A,($5C06)  ;
 $BA49 CP $1B        ;
 $BA4B JR Z,$BA7B    ;
 $BA4D CP $1C        ;
 $BA4F JR Z,$BA7B    ;
 $BA51 CP $1D        ;
 $BA53 JR Z,$BA7B    ;
 $BA55 LD A,($BA96)  ;
 $BA58 OR A          ;
 $BA59 JR NZ,$BA7F   ;
 $BA5B LD A,($5C23)  ;
 $BA5E LD E,A        ;
 $BA5F LD D,$00      ;
 $BA61 LD HL,$5B7C   ;
 $BA64 ADD HL,DE     ;
 $BA65 LD A,($5B98)  ;
 $BA68 LD E,A        ;
 $BA69 LD A,(HL)     ;
 $BA6A LD ($5B98),A  ;
 $BA6D LD (HL),E     ;
 $BA6E CALL $9EBD    ; Init $5BD6 object slots from $5C23
 $BA71 CALL $9E5D    ; Populate the $5BD6 object-slot table
 $BA74 LD A,$01      ;
 $BA76 LD ($BA96),A  ;
 $BA79 JR $BA7F      ;
*$BA7B XOR A         ;
 $BA7C LD ($BA96),A  ;
*$BA7F LD A,($5C01)  ; get Current room number
 $BA82 CP $19        ;
 $BA84 PUSH AF       ;
 $BA85 CALL Z,$BA97  ; Gate + room-specific visual effect
 $BA88 POP AF        ;
 $BA89 PUSH AF       ;
 $BA8A CP $3A        ;
 $BA8C CALL Z,$BA97  ; Gate + room-specific visual effect
 $BA8F POP AF        ;
 $BA90 CP $10        ;
 $BA92 CALL Z,$BC73  ; Room $5B98=$0C seesaw trigger
 $BA95 RET           ;

; Gate flag for the #R$BA97 room effect
b$BA96 DEFB $00

; Gate + room-specific visual effect (room $3A special-cased)
;
; Used by the routine at #R$B9FA.
;
; A packed state byte (effect index + flags)
;
; Drives a room-specific animated visual effect, gated by a per-frame flag: an
; effect index selects a frame from the table at $F968 and is advanced on a
; fraction of frames so it animates slower than the frame rate, with two
; speed/phase branches depending on how far the index has run. Room $3A
; additionally clamps the hero's X against fixed bounds.
c$BA97 LD C,A        ; save state byte in C
 $BA98 LD HL,$5C0C   ;
 $BA9B LD A,(HL)     ;
 $BA9C OR A          ; {effect already running? alt path
 $BA9D JR NZ,$BADF   ; }
 $BA9F CALL $BB59    ; Always-true stub (CP A), used by #R$BA97
 $BAA2 RET NZ        ;
 $BAA3 LD A,C        ;
 $BAA4 CP $3A        ; {room $3A?
 $BAA6 JR NZ,$BAB6   ; }
 $BAA8 LD A,($5C3E)  ;
 $BAAB OR A          ;
 $BAAC JR NZ,$BABC   ;
 $BAAE LD A,($5B98)  ;
 $BAB1 CP $0F        ;
 $BAB3 JR Z,$BABC    ;
 $BAB5 RET           ;
*$BAB6 LD A,($5B98)  ;
 $BAB9 CP $0B        ; {else room-category must be $0B
 $BABB RET NZ        ; }
*$BABC LD A,($5B04)  ;
 $BABF CP $2C        ; {player X below $2C? RET
 $BAC1 RET C         ; }
 $BAC2 CP $B8        ; {player X above $B8? RET
 $BAC4 RET NC        ; }
 $BAC5 CP $36        ; {X in dead zone [$36,$B2)? RET
 $BAC7 JR C,$BACC    ; }
 $BAC9 CP $B2        ;
 $BACB RET C         ;
*$BACC PUSH AF       ;
 $BACD XOR A         ; {clear timer flag ($5C0D)
 $BACE LD ($5C0D),A  ; }
 $BAD1 POP AF        ;
 $BAD2 LD (HL),$01   ;
 $BAD4 CP $7A        ; {effect index < $7A? done
 $BAD6 RET C         ; }
 $BAD7 LD (HL),$10   ;
 $BAD9 LD A,$01      ; {set timer flag
 $BADB LD ($5C0D),A  ; }
 $BADE RET           ;
*$BADF LD E,A        ;
 $BAE0 AND $7F       ; mask to effect index (7 bits)
 $BAE2 LD HL,$F968   ; HL = effect table base ($F968)
 $BAE5 DEC A         ;
 $BAE6 LD C,A        ;
 $BAE7 LD B,$00      ;
 $BAE9 LD A,($5C02)  ; get Frame counter
 $BAEC AND $03       ; {only every 4th frame
 $BAEE RET NZ        ; }
 $BAEF ADD HL,BC     ;
 $BAF0 BIT 7,E       ; {bit7 of state picks variant
 $BAF2 JR Z,$BB0D    ; }
 $BAF4 LD A,L        ;
 $BAF5 AND $03       ;
 $BAF7 EXX           ;
 $BAF8 LD L,A        ;
 $BAF9 LD H,$00      ;
 $BAFB LD DE,$BB51   ; DE = byte table ($BB51)
 $BAFE LD A,($5C01)  ; get Current room number
 $BB01 CP $3A        ; {room $3A? use alt table
 $BB03 JR NZ,$BB08   ; }
 $BB05 LD DE,$BB55   ;
*$BB08 ADD HL,DE     ;
 $BB09 LD A,(HL)     ;
 $BB0A EXX           ;
 $BB0B JR $BB19      ;
*$BB0D LD C,$07      ;
 $BB0F LD A,($5C01)  ; get Current room number
 $BB12 CP $3A        ;
 $BB14 JR NZ,$BB18   ;
 $BB16 LD C,$BF      ;
*$BB18 LD A,C        ;
*$BB19 CALL $9A52    ; Write A to (HL)+$6000 (secondary buffer), then #R$9A62
                     ; dual-write loop
 $BB1C LD HL,$5C0C   ;
 $BB1F LD A,($5C0D)  ; {timer flag set? alt update
 $BB22 OR A          ; }
 $BB23 JR NZ,$BB3D   ;
 $BB25 LD A,(HL)     ;
 $BB26 AND $7F       ;
 $BB28 CP $10        ; {state past $10?
 $BB2A INC (HL)      ; }
 $BB2B RET C         ;
 $BB2C BIT 7,(HL)    ;
 $BB2E JR NZ,$BB3A   ;
 $BB30 DEC (HL)      ;
 $BB31 LD A,($5B04)  ;
 $BB34 CP $BA        ; {player X past $BA? latch $81
 $BB36 RET C         ; }
 $BB37 LD (HL),$81   ;
 $BB39 RET           ;
*$BB3A LD (HL),$00   ;
 $BB3C RET           ;
*$BB3D LD A,(HL)     ;
 $BB3E DEC (HL)      ;
 $BB3F AND $7E       ;
 $BB41 RET NZ        ;
 $BB42 LD A,(HL)     ;
 $BB43 CP $80        ;
 $BB45 JR Z,$BB3A    ;
 $BB47 INC (HL)      ;
 $BB48 LD A,($5B04)  ;
 $BB4B CP $30        ; {player X below $30? latch $90
 $BB4D RET NC        ; }
 $BB4E LD (HL),$90   ;
 $BB50 RET           ;

; Effect byte table for #R$BA97 (room $3A uses $BB55)
b$BB51 DEFB $97,$9A,$9D,$9E,$81,$81,$81,$81

; Always-true stub (CP A), used by #R$BA97
;
; Used by the routine at #R$BA97.
c$BB59 PUSH HL       ;
 $BB5A CP A          ;
 $BB5B POP HL        ;
 $BB5C RET           ;

; Item pickup/hint check for both creature slots ($5C0E, $5C13)
;
; Used by the routine at #R$B9FA.
;
; .
;
; Per-frame pickup check for the two creature slots ($5C0E, $5C13): if the slot
; holds a collectible item rather than a hazard, and the hero is close enough,
; and the 27-slot inventory log at $5B7C has a free entry, the item is
; collected. A few item types have extra conditions (one latches the current
; room as a bookmark, others only allow pickup mid-animation of another event);
; a successful pickup snaps the hero to the item, starts the pickup animation
; (status 5) and deactivates the item. See Items-Format.md for the log format.
c$BB5D LD IX,$5B04     ; IX=$5B04 (player)
 $BB61 LD IY,$5C0E     ; IY=first creature slot ($5C0E)
 $BB65 CALL $BB6C      ;
 $BB68 LD IY,$5C13     ;
*$BB6C XOR A           ;
 $BB6D LD C,A          ;
 $BB6E LD E,A          ;
 $BB6F LD D,A          ;
 $BB70 CALL $9140      ; Classify object type ((IX+2)) into a size/category
                       ; flag
 $BB73 JP NC,$BC07     ; not a trackable type? skip
 $BB76 LD A,(IY+$02)   ;
 $BB79 CP $FE          ;
 $BB7B JP NC,$BC07     ;
 $BB7E LD HL,$5B7C     ; HL=inventory log ($5B7C)
 $BB81 PUSH BC         ;
 $BB82 LD B,$1B        ; B=27 slots
*$BB84 LD A,(HL)       ; {slot free ($FF)?
 $BB85 CP $FF          ; }
 $BB87 JR Z,$BB8F      ;
 $BB89 INC HL          ;
 $BB8A INC C           ;
 $BB8B DJNZ $BB84      ;
 $BB8D JR $BC06        ;
*$BB8F LD A,(IY+$02)   ; {item type $16?
 $BB92 CP $16          ; }
 $BB94 JR NZ,$BB99     ;
 $BB96 LD ($5C3F),A    ; yes: latch room into $5C3F
*$BB99 CP $08          ;
 $BB9B JR Z,$BC06      ;
 $BB9D CP $0E          ;
 $BB9F JR Z,$BBA5      ;
 $BBA1 CP $14          ;
 $BBA3 JR NZ,$BBDA     ;
*$BBA5 LD A,($5C06)    ; {status ($5C06)==2?
 $BBA8 CP $02          ; }
 $BBAA JR NZ,$BC06     ;
 $BBAC LD A,($5C07)    ; {hazard timer ($5C07)>=10?
 $BBAF CP $0A          ; }
 $BBB1 JR C,$BC06      ;
 $BBB3 LD A,($5B04)    ; {player X minus item X
 $BBB6 SUB (IY+$00)    ; }
 $BBB9 JR NC,$BBBD     ;
 $BBBB NEG             ; make positive
*$BBBD CP $06          ; in range (<6)?
 $BBBF JR NC,$BC06     ;
 $BBC1 LD A,(IY+$00)   ; {snap player X to item
 $BBC4 LD (IX+$00),A   ; }
 $BBC7 LD A,(IY+$01)   ; {player Y = item Y - $17
 $BBCA SUB $17         ; }
 $BBCC LD (IX+$01),A   ;
 $BBCF LD (IX+$02),$0F ; state=$0F
 $BBD3 LD A,$05        ;
 $BBD5 LD ($5C06),A    ;
 $BBD8 JR $BC06        ;
*$BBDA LD D,$01        ; D=1 (refresh flag)
 $BBDC EX AF,AF'       ;
 $BBDD LD A,($5B98)    ; {room ($5B98) already latched?
 $BBE0 CP $FF          ; }
 $BBE2 JR Z,$BBE7      ;
 $BBE4 LD (HL),A       ; no: latch it
 $BBE5 LD E,$01        ;
*$BBE7 EX AF,AF'       ;
 $BBE8 PUSH DE         ;
 $BBE9 LD DE,$0032     ; DE=$32 (score award)
 $BBEC CALL $BCF2      ; Save all registers
 $BBEF PUSH AF         ;
 $BBF0 LD A,$02        ;
 $BBF2 CALL $C4B2      ; Sound-effect dispatcher wrapper
 $BBF5 POP AF          ;
 $BBF6 POP DE          ;
 $BBF7 LD ($5B98),A    ;
 $BBFA LD (IY+$02),$FE ; retire the item (type=$FE)
 $BBFE LD L,(IY+$03)   ; {HL = its display object
 $BC01 LD H,(IY+$04)   ; }
 $BC04 SET 7,(HL)      ;
*$BC06 POP HL          ;
*$BC07 PUSH DE         ;
 $BC08 LD A,D          ; {refresh flag set?
 $BC09 OR A            ; }
 $BC0A CALL NZ,$9E5D   ; Populate the $5BD6 object-slot table
 $BC0D POP DE          ;
 $BC0E LD A,E          ;
 $BC0F OR A            ;
 $BC10 RET Z           ;
 $BC11 LD A,C          ; {C zero?
 $BC12 OR A            ; }
 $BC13 JR Z,$BC19      ;
 $BC15 DEC A           ; {C one?
 $BC16 JR Z,$BC19      ; }
 $BC18 DEC A           ; else index 2
*$BC19 LD ($5C23),A    ;
 $BC1C JP $9EBD        ; => Init $5BD6 object slots from $5C23

; Cycle inventory selection via keys (port $F7FE), animate scroll ($5C21/$5C22)
;
; Used by the routine at #R$B9FA.
;
; .
;
; Handles the player cycling through carried items with the number keys,
; driving the little scroll animation as the selection changes and updating
; which item is actually held.
c$BC1F JR NZ,$BC4A   ; no key pressed? skip to scroll dispatch
 $BC21 LD BC,$F7FE   ;
 $BC24 IN A,(C)      ;
 $BC26 AND $03       ; {keys 1/2 both pressed? RET
 $BC28 CP $03        ; }
 $BC2A RET Z         ;
 $BC2B AND $01       ; {key 1 pressed?
 $BC2D JR NZ,$BC43   ; }
 $BC2F LD A,$01      ; {arm scroll: dir=1, speed=4
 $BC31 LD ($5C21),A  ; }
 $BC34 LD A,$04      ;
 $BC36 LD ($5C22),A  ;
 $BC39 LD HL,$5C23   ;
 $BC3C DEC (HL)      ; selection index--
 $BC3D BIT 7,(HL)    ; {wrapped below 0? snap to $1A
 $BC3F RET Z         ; }
 $BC40 LD (HL),$1A   ;
 $BC42 RET           ;
*$BC43 XOR A         ; {key 2: clear scroll state
 $BC44 LD ($5C21),A  ; }
 $BC47 LD ($5C22),A  ;
*$BC4A LD A,($5C21)  ; {scrolling? skip re-init
 $BC4D OR A          ; }
 $BC4E JR NZ,$BC6C   ;
 $BC50 CALL $9EBD    ; Init $5BD6 object slots from $5C23
 $BC53 LD HL,$5C22   ;
 $BC56 INC (HL)      ;
 $BC57 LD A,(HL)     ; {scroll-speed counter==4?
 $BC58 CP $04        ; }
 $BC5A RET NZ        ;
 $BC5B LD (HL),$00   ;
 $BC5D LD HL,$5C23   ;
 $BC60 INC (HL)      ;
 $BC61 LD A,(HL)     ; {selection index reached $1B (wrap)?
 $BC62 CP $1B        ; }
 $BC64 JP NZ,$9EBD   ; => Init $5BD6 object slots from $5C23
 $BC67 LD (HL),$00   ;
 $BC69 JP $9EBD      ; => Init $5BD6 object slots from $5C23
*$BC6C LD HL,$5C22   ;
 $BC6F DEC (HL)      ;
 $BC70 JP $9EBD      ; => Init $5BD6 object slots from $5C23

; Room $5B98=$0C seesaw trigger: position gate, toggle Y $46/$48, room-state
; trigger
;
; Used by the routine at #R$B9FA.
;
; IX=$5B04 (hero, implicit - always the same object)
;
; A rocking-platform puzzle piece: once the hero stands at the right spot in
; the right room, it rocks them between two Y positions for a few frames, then
; plays an escalating sound cue and resolves.
c$BC73 LD HL,$5C24     ;
 $BC76 LD A,(HL)       ; {flag==$0D? skip
 $BC77 CP $0D          ; }
 $BC79 RET Z           ;
 $BC7A LD A,($5B98)    ; {room==$0C?
 $BC7D CP $0C          ; }
 $BC7F RET NZ          ;
 $BC80 LD A,(IX+$01)   ;
 $BC83 CP $48          ; {Y==$48?
 $BC85 JR Z,$BC8A      ; }
 $BC87 CP $46          ;
 $BC89 RET NZ          ;
*$BC8A LD E,A          ;
 $BC8B LD A,(IX+$00)   ;
 $BC8E CP $34          ; {X<$34? else RET
 $BC90 RET NC          ; }
 $BC91 CP $28          ;
 $BC93 RET C           ;
 $BC94 SET 7,(IX+$03)  ;
 $BC98 LD A,($5C02)    ;
 $BC9B AND $01         ; {frame bit0: toggle Y=$46/$48
 $BC9D JR NZ,$BCAC     ; }
 $BC9F LD (IX+$01),$46 ;
 $BCA3 LD A,E          ;
 $BCA4 CP $48          ;
 $BCA6 JR Z,$BCAC      ;
 $BCA8 LD (IX+$01),$48 ;
*$BCAC LD A,($5C02)    ;
 $BCAF AND $03         ; {frame&3!=0? RET
 $BCB1 RET NZ          ; }
 $BCB2 LD A,$06        ;
 $BCB4 LD ($5C06),A    ; store room-state=6
 $BCB7 LD A,(HL)       ;
 $BCB8 INC (HL)        ;
 $BCB9 CP $0C          ; counter==$0C?
 $BCBB JP Z,$AE84      ; => Set hero status ($5C06), clear hazard timer ($5C07)
 $BCBE SUB $06         ; counter-6
 $BCC0 RET C           ;
 $BCC1 LD C,A          ;
 $BCC2 LD A,$06        ;
 $BCC4 SUB C           ;
 $BCC5 LD L,A          ;
 $BCC6 LD H,$00        ;
 $BCC8 ADD HL,HL       ;
 $BCC9 ADD HL,HL       ;
 $BCCA ADD HL,HL       ;
 $BCCB ADD HL,HL       ;
 $BCCC ADD HL,HL       ;
 $BCCD LD DE,$F928     ; DE=$F928 (sound-effect table)
 $BCD0 ADD HL,DE       ;
 $BCD1 PUSH HL         ;
 $BCD2 LD A,$98        ;
 $BCD4 CALL $9A52      ; Write A to (HL)+$6000 (secondary buffer), then #R$9A62
                       ; dual-write loop
 $BCD7 POP HL          ; {restore HL, advance
 $BCD8 INC HL          ; }
 $BCD9 LD A,$99        ; A=$99 (second byte)
 $BCDB JP $9A52        ; => Write A to (HL)+$6000 (secondary buffer), then
                       ; #R$9A62 dual-write loop

; Negate 4-byte value ($5C18) via CPL chain, falls into #R$BD15 (add DE:BC=1)
;
; Used by the routine at #R$BD75.
;
; .
;
; Negates the 32-bit score value in place, so the shared add routine can be
; reused to subtract.
c$BCDE LD A,(HL)     ; negate 3 bytes (CPL each, unrolled, HL-- between)
 $BCDF CPL           ;
 $BCE0 LD (HL),A     ;
 $BCE1 DEC HL        ;
 $BCE2 LD A,(HL)     ;
 $BCE3 CPL           ;
 $BCE4 LD (HL),A     ;
 $BCE5 DEC HL        ;
 $BCE6 LD A,(HL)     ;
 $BCE7 CPL           ;
 $BCE8 LD (HL),A     ;
 $BCE9 DEC HL        ;
 $BCEA LD A,(HL)     ; {negate the last byte
 $BCEB CPL           ; }
 $BCEC LD (HL),A     ;
 $BCED LD DE,$0001   ; DE=1 (so the add becomes a two-s complement)
 $BCF0 JR $BD15      ;

; Save all registers (context-save wrapper)
;
; Used by the routines at #R$8F47, #R$A851, #R$B4E2, #R$B5DD, #R$B9FA and
; #R$BB5D.
;
; DE score delta to add (passed through to #R$BD11)
;
; Awards a score/timer delta and redraws its display, preserving every register
; around the call so it can be dropped into any piece of game logic without
; disturbing what that code was doing.
c$BCF2 PUSH IX       ; push the main registers (IX,IY,HL,BC,AF)
 $BCF4 PUSH IY       ;
 $BCF6 PUSH HL       ;
 $BCF7 PUSH BC       ;
 $BCF8 PUSH AF       ;
 $BCF9 EXX           ;
 $BCFA PUSH HL       ; push the alternate registers (HL,BC,DE)
 $BCFB PUSH BC       ;
 $BCFC PUSH DE       ;
 $BCFD EXX           ;
 $BCFE CALL $BD11    ; {Add 32-bit value ($5C18) by DE:BC
 $BD01 CALL $BD75    ; }
 $BD04 EXX           ;
 $BD05 POP HL        ; pop the alternate registers
 $BD06 POP BC        ;
 $BD07 POP DE        ;
 $BD08 EXX           ;
 $BD09 POP AF        ; pop the main registers
 $BD0A POP BC        ;
 $BD0B POP HL        ;
 $BD0C POP IY        ;
 $BD0E POP IX        ;
 $BD10 RET           ;

; Add 32-bit value ($5C18) by DE:BC (BC sign-extended from D)
;
; Used by the routine at #R$BCF2.
;
; .
;
; Adds a signed 16-bit amount to the 32-bit score, sign-extending so the same
; routine handles both awards and deductions.
c$BD11 LD IX,$5C18   ; IX=$5C18 (target)
; This entry point is used by the routine at #R$BCDE.
*$BD15 LD BC,$FFFF   ; assume a negative amount (BC=-1)
 $BD18 BIT 7,D       ; {D positive? use 0 instead
 $BD1A JR NZ,$BD1F   ; }
 $BD1C LD BC,$0000   ;
*$BD1F LD L,(IX+$00) ; {HL=(IX+0/1) low word
 $BD22 LD H,(IX+$01) ; }
 $BD25 ADD HL,DE     ; add the low word
 $BD26 LD (IX+$00),L ; {store it back
 $BD29 LD (IX+$01),H ; }
 $BD2C LD L,(IX+$02) ; {HL=(IX+2/3) high word
 $BD2F LD H,(IX+$03) ; }
 $BD32 ADC HL,BC     ; add the high word with carry
 $BD34 LD (IX+$02),L ; {store it back
 $BD37 LD (IX+$03),H ; }
 $BD3A RET           ;

; Print hi-score ($5B78) at screen $5049 via #R$BD78
;
; Used by the routine at #R$BD50.
c$BD3B LD HL,($BD89) ; {save the printer's current source pointer ($BD89)
 $BD3E PUSH HL       ; }
 $BD3F LD HL,$5B78   ; {repoint it at the hi-score ($5B78)
 $BD42 LD ($BD89),HL ; }
 $BD45 LD HL,$5049   ; HL=screen position $5049
 $BD48 CALL $BD78    ; Print current score at screen $5029, falls into #R$BD78
 $BD4B POP HL        ; {restore the original source pointer
 $BD4C LD ($BD89),HL ; }
 $BD4F RET           ;

; New high-score check: compare $5C1B vs stored $5B7B, save if beaten
;
; Used by the routine at #R$8F47.
;
; .
;
; Compares the score just made against the stored high score digit by digit
; and, if it is bigger, copies it over and redraws the display.
c$BD50 LD HL,$5C1B   ; HL = candidate score ($5C1B)
 $BD53 BIT 7,(HL)    ; {already flagged? skip
 $BD55 RET NZ        ; }
 $BD56 LD DE,$5B7B   ; DE = stored high score ($5B7B)
 $BD59 LD B,$04      ; B=4 digits
*$BD5B LD A,(DE)     ; {compare one digit
 $BD5C CP (HL)       ; }
 $BD5D JR C,$BD67    ; candidate bigger? take it
 $BD5F JR Z,$BD62    ; {equal? try the next digit
 $BD61 RET           ; }
*$BD62 DEC HL        ; {step both pointers back
 $BD63 DEC DE        ; }
 $BD64 DJNZ $BD5B    ; loop 4 digits
 $BD66 RET           ;
*$BD67 LD HL,$5C18   ; {HL=$5C18, DE=$5B78
 $BD6A LD DE,$5B78   ; }
 $BD6D LD BC,$0004   ;
 $BD70 LDIR          ; copy the 4-byte score
 $BD72 JP $BD3B      ; Print hi-score ($5B78) at screen $5049 via #R$BD78

; Print current score at screen $5029, falls into #R$BD78
;
; Used by the routine at #R$BCF2.
;
; .
;
; Draws the current score as digits on screen, blanking leading zeros - the
; shared digit-printer also reused by the high-score display.
c$BD75 LD HL,$5029   ; HL=$5029 (screen position)
; This entry point is used by the routine at #R$BD3B.
*$BD78 PUSH HL       ;
 $BD79 LD B,$04      ; B=4 digit cells
*$BD7B LD A,$20      ; A=$20 (space)
 $BD7D CALL $90C6    ; Draw character bitmap
 $BD80 DJNZ $BD7B    ; loop 4 spaces
 $BD82 POP HL        ;
 $BD83 EXX           ;
 $BD84 XOR A         ; {clear leading-zero flag ($5C20)
 $BD85 LD ($5C20),A  ; }
 $BD88 LD HL,$5C18   ; HL=$5C18 (score)
 $BD8B LD DE,$5C1C   ; {DE=$5C1C, BC=4
 $BD8E LD BC,$0004   ; }
 $BD91 LDIR          ; copy score to work buffer
 $BD93 EX DE,HL      ;
 $BD94 DEC HL        ;
 $BD95 LD IX,$5C1C   ; IX=$5C1C (work buffer)
 $BD99 BIT 7,(HL)    ; {sign bit set?
 $BD9B JR Z,$BDA2    ; }
 $BD9D CALL $BCDE    ; Negate 4-byte value ($5C18) via CPL chain, falls into
                     ; #R$BD15
 $BDA0 JR $BDA2      ;
*$BDA2 LD IY,$BE18   ; IY=$BE18 (place-value table)
 $BDA6 LD B,$04      ; B=4 digits
*$BDA8 PUSH BC       ;
 $BDA9 LD C,$00      ; C=0 (digit counter)
 $BDAB LD E,(IY+$00) ; {DE = place value from table
 $BDAE LD D,(IY+$01) ; }
 $BDB1 LD B,(IY+$02) ; B = its high byte
 $BDB4 INC IY        ; IY += 3 (next entry)
 $BDB6 INC IY        ;
 $BDB8 INC IY        ;
 $BDBA CALL $BDDF    ; Repeated-subtraction division
 $BDBD LD A,($5C20)  ; {leading-zero flag set?
 $BDC0 OR A          ; }
 $BDC1 LD A,C        ; {A=digit, non-zero? print it
 $BDC2 JR NZ,$BDCA   ; }
 $BDC4 OR A          ; {digit zero and still leading? skip
 $BDC5 JR Z,$BDD5    ; }
 $BDC7 LD ($5C20),A  ; else clear the flag
*$BDCA ADD A,$30     ; convert digit to ASCII
 $BDCC EXX           ; EXX
 $BDCD CALL $90C6    ; Draw character bitmap
 $BDD0 EXX           ;
 $BDD1 POP BC        ; restore BC
*$BDD2 DJNZ $BDA8    ; loop 4 digits
 $BDD4 RET           ;
*$BDD5 POP BC        ;
 $BDD6 LD A,B        ; {last digit (B==1)?
 $BDD7 CP $01        ; }
 $BDD9 JR NZ,$BDD2   ; no: skip
 $BDDB DEC A         ;
 $BDDC PUSH BC       ;
 $BDDD JR $BDCA      ; force printing a single zero

; Repeated-subtraction division: subtract DE from 32-bit (IX+0..3), C=count
;
; Used by the routine at #R$BD75.
;
;   IX 32-bit value to divide
;   DE low word of the divisor
;   B high byte of the divisor
; O:C quotient (number of successful subtractions)
;
; Divides a 32-bit value by repeatedly subtracting a divisor and counting how
; many times it fit - used by the score/digit-printing code to peel off one
; decimal digit at a time.
c$BDDF LD L,(IX+$00) ; {HL = low word of the value
 $BDE2 LD H,(IX+$01) ; }
 $BDE5 PUSH HL       ; save it
 $BDE6 AND A         ; {low word -= DE
 $BDE7 SBC HL,DE     ; }
 $BDE9 LD (IX+$00),L ; {store it back
 $BDEC LD (IX+$01),H ; }
 $BDEF LD A,(IX+$02) ; {A = byte 2
 $BDF2 PUSH AF       ; }
 $BDF3 SBC A,B       ; {subtract divisor high byte with borrow
 $BDF4 LD (IX+$02),A ; }
 $BDF7 LD A,(IX+$03) ; {A = byte 3
 $BDFA PUSH AF       ; }
 $BDFB SBC A,$00     ; {propagate the borrow
 $BDFD LD (IX+$03),A ; }
 $BE00 JR C,$BE08    ; went negative?
 $BE02 POP AF        ; discard the saved copies
 $BE03 POP AF        ;
 $BE04 POP HL        ;
 $BE05 INC C         ; {count one more subtraction
 $BE06 JR $BDDF      ; }
*$BE08 POP AF        ; {restore byte 3
 $BE09 LD (IX+$03),A ; }
 $BE0C POP AF        ; {restore byte 2
 $BE0D LD (IX+$02),A ; }
 $BE10 POP HL        ; restore the low word
 $BE11 LD (IX+$01),H ; {store it back
 $BE14 LD (IX+$00),L ; }
 $BE17 RET           ;

; Decimal place-value table (1000/100/10/1) for the score printer
b$BE18 DEFB $E8,$03,$00,$64,$00,$00,$0A,$00
 $BE20 DEFB $00,$01,$00,$00,$00,$00,$00,$00
 $BE28 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BE30 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BE38 DEFB $00,$00,$00,$00,$00,$00,$00,$00
 $BE40 DEFB $00,$00

; Decode room's creatures/hazards from the room data table ($C152)
;
; Used by the routine at #R$9855.
;
; A room number
;
; Decodes the current room's 12-byte record in the $C152 table into the 29-byte
; scratch buffer at $BE24, unpacking it as 3 creature/hazard sub-records of 4
; bytes each (packed type ID, flag bits and raw fields - see Actors.md). An
; all-zero sub-record means an empty slot. Returns A unchanged.
c$BE42 PUSH AF       ; save A (room number)
 $BE43 LD HL,$BE24   ;
 $BE46 LD DE,$BE25   ;
 $BE49 LD BC,$001D   ;
 $BE4C LD (HL),$00   ; {clear 29-byte scratch buffer
 $BE4E LDIR          ; }
 $BE50 LD L,A        ; {HL = room number
 $BE51 LD H,$00      ; }
 $BE53 ADD HL,HL     ;
 $BE54 ADD HL,HL     ;
 $BE55 PUSH HL       ;
 $BE56 ADD HL,HL     ;
 $BE57 POP DE        ;
 $BE58 ADD HL,DE     ;
 $BE59 LD DE,$C152   ; {HL = room data table + A*12
 $BE5C ADD HL,DE     ; }
 $BE5D LD DE,$BE24   ;
 $BE60 LD B,$03      ; B=3 slots
*$BE62 PUSH DE       ;
 $BE63 LD A,(HL)     ;
 $BE64 PUSH AF       ;
 $BE65 AND $0F       ; byte0 low nibble = creature type ID
 $BE67 LD (DE),A     ; {type written twice
 $BE68 INC DE        ; }
 $BE69 LD (DE),A     ;
 $BE6A INC DE        ;
 $BE6B POP AF        ;
 $BE6C AND $80       ; byte0 bit7 = flag
 $BE6E LD (DE),A     ;
 $BE6F INC DE        ;
 $BE70 LD A,(HL)     ;
 $BE71 RRCA          ; byte0 >>= 4 (four RRCA)
 $BE72 RRCA          ;
 $BE73 RRCA          ;
 $BE74 RRCA          ;
 $BE75 AND $07       ; byte0 bits4-6
 $BE77 LD (DE),A     ;
 $BE78 INC DE        ;
 $BE79 INC HL        ;
 $BE7A LD A,(HL)     ;
 $BE7B LD (DE),A     ;
 $BE7C INC DE        ;
 $BE7D INC HL        ;
 $BE7E LD A,(HL)     ;
 $BE7F LD (DE),A     ;
 $BE80 INC DE        ;
 $BE81 INC HL        ;
 $BE82 LD A,(HL)     ;
 $BE83 AND $7F       ; byte3 low 7 bits
 $BE85 LD (DE),A     ;
 $BE86 INC DE        ;
 $BE87 LD A,(HL)     ;
 $BE88 AND $80       ; byte3 bit7
 $BE8A LD (DE),A     ;
 $BE8B INC HL        ;
 $BE8C POP DE        ;
 $BE8D PUSH HL       ;
 $BE8E LD HL,$000A   ; {advance output pointer +10, next slot
 $BE91 ADD HL,DE     ; }
 $BE92 EX DE,HL      ;
 $BE93 POP HL        ;
 $BE94 DJNZ $BE62    ;
 $BE96 POP AF        ; {restore A
 $BE97 RET           ; }

; Dispatch per-creature-type init (jump table $BECA) for the 3 hazard slots
;
; Used by the routine at #R$8F47.
;
; .
;
; Spawns the room's creatures/hazards: for each of the 3 slots decoded from the
; room data table, jumps to the matching type's own setup routine.
c$BE98 LD B,$03      ; B=3 slots
 $BE9A LD DE,$BE24   ; DE = decoded record ($BE24)
 $BE9D PUSH IX       ;
 $BE9F LD IX,$5B08   ; IX = first object slot ($5B08)
*$BEA3 PUSH BC       ;
 $BEA4 PUSH DE       ;
 $BEA5 LD A,(DE)     ; A = creature type
 $BEA6 LD L,A        ; {zero-extend into HL
 $BEA7 LD H,$00      ; }
 $BEA9 ADD HL,HL     ; type *= 2
 $BEAA LD BC,$BECA   ; {HL = jump table entry ($BECA + type*2)
 $BEAD ADD HL,BC     ; }
 $BEAE LD A,(HL)     ; {A = handler low byte
 $BEAF INC HL        ; }
 $BEB0 LD H,(HL)     ; {HL = handler address
 $BEB1 LD L,A        ; }
 $BEB2 PUSH DE       ; {IY = record pointer
 $BEB3 POP IY        ; }
 $BEB5 CALL $BEC9    ; Jump to handler in HL (dispatch tail of #R$BE98)
 $BEB8 LD DE,$0004   ; {IX += 4 (next object slot)
 $BEBB ADD IX,DE     ; }
 $BEBD POP DE        ;
 $BEBE LD HL,$000A   ; {DE += 10 (next record)
 $BEC1 ADD HL,DE     ; }
 $BEC2 EX DE,HL      ;
 $BEC3 POP BC        ; {loop 3 slots
 $BEC4 DJNZ $BEA3    ; }
 $BEC6 POP IX        ;
 $BEC8 RET           ;

; Jump to handler in HL (dispatch tail of #R$BE98)
;
; Used by the routine at #R$BE98.
c$BEC9 JP (HL)       ;

; Creature-type handler jump table (used by #R$BE98)
b$BECA DEFB $DC,$BE,$DD,$BE,$22,$BF,$67,$BF
 $BED2 DEFB $BB,$BF,$F6,$BF,$54,$C0,$69,$C0
 $BEDA DEFB $35,$C1

; No-op stub (RET)
c$BEDC RET           ;

; Move object along X by 2px, bounce off walls/edges
;
; .
;
; .
;
; Slides an object sideways a couple of pixels each frame and turns it round
; when it meets a wall or the edge of the room - the horizontal half of the
; simple creature movement pair.
c$BEDD BIT 0,(IY+$08) ; template already applied?
 $BEE1 JR NZ,$BEE6    ;
 $BEE3 CALL $C135     ; no: stamp it via #R$C135
*$BEE6 BIT 7,(IY+$07) ; direction flag set?
 $BEEA LD A,(IX+$00)  ; A = X position
 $BEED JR NZ,$BF02    ;
 $BEEF SUB $02        ; {move -2, check underflow
 $BEF1 JR C,$BF08     ; }
 $BEF3 LD (IX+$00),A  ; store the new X
 $BEF6 CALL $C0FD     ; Wrapper: scan tile below feet via #R$A2AC, flag at
                      ; $C12D
 $BEF9 LD A,($C12D)   ; {blocked ($C12D)?
 $BEFC OR A           ; }
 $BEFD JR NZ,$BF08    ;
 $BEFF JP $C0AC       ; => Advance animation frame
*$BF02 ADD A,$02      ;
 $BF04 CP $E7         ;
 $BF06 JR C,$BF13     ;
*$BF08 LD A,(IY+$07)  ; A = direction flag
 $BF0B XOR $80        ; {flip it
 $BF0D LD (IY+$07),A  ; }
 $BF10 JP $C0AC       ; => Advance animation frame
*$BF13 LD (IX+$00),A  ;
 $BF16 CALL $C109     ; Wrapper
 $BF19 LD A,($C12E)   ;
 $BF1C OR A           ;
 $BF1D JR NZ,$BF08    ;
 $BF1F JP $C0AC       ; => Advance animation frame

; Move object along Y by 2px, bounce off walls/edges
;
; .
;
; .
;
; Slides an object up or down a couple of pixels each frame and turns it round
; when it meets floor or ceiling - the vertical twin of #R$BEDD.
c$BF22 BIT 0,(IY+$08) ; template already applied?
 $BF26 JR NZ,$BF2B    ;
 $BF28 CALL $C135     ; no: stamp it via #R$C135
*$BF2B BIT 7,(IY+$07) ; direction flag set?
 $BF2F LD A,(IX+$01)  ; A = Y position
 $BF32 JR NZ,$BF47    ;
 $BF34 SUB $02        ; {move -2, check underflow
 $BF36 JR C,$BF4D     ; }
 $BF38 LD (IX+$01),A  ; store the new Y
 $BF3B CALL $C115     ; Wrapper: scan tile via #R$A31F, flag at $C131
 $BF3E LD A,($C131)   ; {blocked ($C131)?
 $BF41 OR A           ; }
 $BF42 JR NZ,$BF4D    ;
 $BF44 JP $C0AC       ; => Advance animation frame
*$BF47 ADD A,$02      ;
 $BF49 CP $67         ;
 $BF4B JR C,$BF58     ;
*$BF4D LD A,(IY+$07)  ; A = direction flag
 $BF50 XOR $80        ; {flip it
 $BF52 LD (IY+$07),A  ; }
 $BF55 JP $C0AC       ; => Advance animation frame
*$BF58 LD (IX+$01),A  ;
 $BF5B CALL $C121     ; Wrapper
 $BF5E LD A,($C132)   ;
 $BF61 OR A           ;
 $BF62 JR NZ,$BF4D    ;
 $BF64 JP $C0AC       ; => Advance animation frame

; Move object -X by 2px (timed via #R$BFA0), bounce via #R$C0FD
;
; .
;
; .
;
; Moves an object left on a timer, reversing when it runs into something - the
; mirror of #R$BFBB.
c$BF67 LD C,$01        ;
 $BF69 CALL $BFA0      ; Countdown timer
 $BF6C LD (IX+$02),$7F ;
 $BF70 RET NZ          ;
 $BF71 RES 7,(IY+$07)  ;
 $BF75 LD A,(IX+$00)   ;
 $BF78 SUB $02         ;
 $BF7A JR NC,$BF8B     ;
 $BF7C LD (IX+$02),$7F ;
 $BF80 XOR A           ;
 $BF81 LD (IY+$08),A   ;
 $BF84 LD A,(IY+$01)   ;
 $BF87 LD (IY+$00),A   ;
 $BF8A RET             ;
*$BF8B LD (IX+$00),A   ;
 $BF8E CALL $C0FD      ; Wrapper
 $BF91 LD A,($C12D)    ;
 $BF94 OR A            ;
 $BF95 JR NZ,$BF9A     ;
 $BF97 JP $C0AC        ; => Advance animation frame
*$BF9A INC (IY+$00)    ;
 $BF9D JP $C0AC        ; => Advance animation frame

; Countdown timer (IY+8): init via #R$9390 if zero, else decrement
;
; Used by the routines at #R$BF67, #R$BFBB, #R$BFF6 and #R$C069.
;
;   C low bit merged into new random timer value
;   IY object (timer at +8)
; O:Zf set when timer reaches 0
;
; A shared per-object countdown, reseeded with a random-ish value each time it
; runs out - used to stagger creature behavior changes so objects don't all act
; in lockstep.
c$BFA0 LD A,(IY+$08) ; A = timer ((IY+8))
 $BFA3 OR A          ; {still running? just decrement
 $BFA4 JR NZ,$BFB2   ; }
 $BFA6 CALL $C135    ; gate/init via #R$C135
 $BFA9 CALL $9390    ; Pseudo-random byte
 $BFAC AND $7F       ; {mask the random value, fold in C
 $BFAE OR C          ; }
 $BFAF LD (IY+$08),A ; {store it, then reload
*$BFB2 LD A,(IY+$08) ; }
 $BFB5 DEC A         ; {count down, zero? RET
 $BFB6 RET Z         ; }
 $BFB7 LD (IY+$08),A ; store the new value
 $BFBA RET           ;

; Move object +X by 2px (timed via #R$BFA0), bounce via #R$C109
;
; .
;
; .
;
; Moves an object right on a timer, reversing when it runs into something - one
; of the four timed single-direction movers the creature code picks between.
c$BFBB LD C,$01        ;
 $BFBD CALL $BFA0      ; Countdown timer
 $BFC0 LD (IX+$02),$7F ;
 $BFC4 RET NZ          ;
 $BFC5 SET 7,(IY+$07)  ;
 $BFC9 LD A,(IX+$00)   ;
 $BFCC ADD A,$02       ;
 $BFCE CP $E7          ;
 $BFD0 JR C,$BFE1      ;
 $BFD2 LD (IX+$02),$7F ;
 $BFD6 XOR A           ;
 $BFD7 LD (IY+$08),A   ;
 $BFDA LD A,(IY+$01)   ;
 $BFDD LD (IY+$00),A   ;
 $BFE0 RET             ;
*$BFE1 LD (IX+$00),A   ;
 $BFE4 CALL $C109      ; Wrapper
 $BFE7 LD A,($C12E)    ;
 $BFEA OR A            ;
 $BFEB JR NZ,$BFF0     ;
 $BFED JP $C0AC        ; => Advance animation frame
*$BFF0 DEC (IY+$00)    ;
 $BFF3 JP $C0AC        ; => Advance animation frame

; Move object down 2px per tick, animating; continues at $C000
;
; .
;
; .
;
; Moves an object down the screen a couple of pixels each time its countdown
; fires, cycling its animation frame as it goes, and plays a sound once it
; reaches the bottom or hits something. Careful with the $C000 entry point:
; that address is only this routine's continuation in the main bank - #R$8F47
; and #R$9491 page in bank $16 first and so reach a completely different $C000
; (the music player), which this disassembly never shows.
c$BFF6 LD C,$01        ;
 $BFF8 CALL $BFA0      ; Countdown timer
 $BFFB LD (IX+$02),$7F ; frame=$7F (idle)
 $BFFF RET NZ          ;
; This entry point is used by the routines at #R$8F47 and #R$9491.
*$C000 LD A,(IX+$01)   ;
 $C003 ADD A,$02       ; Y += 2
 $C005 CP $67          ; {past bottom ($67)?
 $C007 JR C,$C012      ; }
 $C009 LD (IX+$02),$7F ;
 $C00D LD (IY+$08),$00 ; clear timer
 $C011 RET             ;
*$C012 LD (IX+$01),A   ; store new Y
 $C015 CALL $C121      ; Wrapper: scan tile below-right via #R$A30B, flag at
                       ; $C131
 $C018 LD A,($C132)    ; {blocked below? reverse branch
 $C01B OR A            ; }
 $C01C JR NZ,$C03A     ;
 $C01E LD A,(IY+$07)   ;
 $C021 INC A           ;
 $C022 LD (IY+$07),A   ;
 $C025 AND $06         ; {cycle of 4 frames
 $C027 RRCA            ; }
 $C028 CP $02          ;
 $C02A JR NZ,$C030     ;
 $C02C DEC (IY+$07)    ;
 $C02F DEC A           ;
*$C030 LD C,A          ;
 $C031 ADD A,(IY+$04)  ; frame = base + cycle
 $C034 LD (IX+$02),A   ;
 $C037 JP $C0DA        ;
*$C03A DEC (IX+$01)    ; blocked: back up 1px
 $C03D INC (IY+$07)    ;
 $C040 LD A,(IY+$07)   ;
 $C043 AND $06         ;
 $C045 RRCA            ;
 $C046 JR NZ,$C030     ;
 $C048 LD (IY+$08),A   ;
 $C04B LD (IX+$02),$7F ;
 $C04F LD A,$05        ; sound effect 5
 $C051 JP $C4B2        ; => Sound-effect dispatcher wrapper

; Idle-frame check ($55/$7F), else #R$C0AC advance animation
c$C054 BIT 0,(IY+$08) ; template already applied? (IY+8) bit0
 $C058 JR NZ,$C05D    ;
 $C05A CALL $C135     ; gate/init via #R$C135
*$C05D LD A,(IX+$02)  ;
 $C060 CP $55         ; {frame $55 (settled)? RET
 $C062 RET Z          ; }
 $C063 CP $7F         ; {frame $7F (idle)? RET
 $C065 RET Z          ; }
 $C066 JP $C0AC       ; => Advance animation frame

; Advance animation frame counter (IY+7), compute sprite frame (IX+2)
;
; .
;
; .
;
; Steps a creature to its next animation frame, cycling back to the start when
; it runs off the end, and turns that into the sprite frame the drawing code
; reads.
c$C069 LD C,$11       ; C=$11 (timer reseed bits)
 $C06B CALL $BFA0     ; Countdown timer
 $C06E RET NZ         ;
 $C06F INC (IY+$07)   ; frame counter++
 $C072 BIT 4,(IY+$07) ; cycle finished (bit4)?
 $C076 JR Z,$C085     ;
 $C078 LD A,(IY+$07)  ; {keep only the direction bit
 $C07B AND $80        ; }
 $C07D LD (IY+$07),A  ; store it back
 $C080 XOR A          ; {clear the timer
 $C081 LD (IY+$08),A  ; }
 $C084 RET            ;
*$C085 LD A,(IY+$07)  ; A = frame counter
 $C088 AND $0E        ; {keep bits 1-3, halve
 $C08A RRCA           ; }
 $C08B BIT 2,A        ; {second half of the cycle?
 $C08D JR Z,$C092     ; }
 $C08F CPL            ; {yes: run it backwards
 $C090 AND $03        ; }
*$C092 LD C,A         ; C = frame index
 $C093 ADD A,(IY+$04) ; {frame = base ((IY+4)) + index
 $C096 LD (IX+$02),A  ; }
 $C099 BIT 7,(IY+$02) ;
 $C09D RET Z          ;
 $C09E LD A,(IY+$03)  ;
 $C0A1 CP $04         ;
 $C0A3 JR NC,$C0DA    ;
 $C0A5 LD A,C         ;
 $C0A6 CP (IY+$03)    ;
 $C0A9 RET NZ         ;
 $C0AA JR $C0DA       ;

; Advance animation frame; check player collision, trigger effect via #R$AE85
;
; Used by the routines at #R$BEDD, #R$BF22, #R$BF67, #R$BFBB and #R$C054.
;
; .
;
; The shared "tick a creature" finisher: advances its animation to the next
; frame and, on the right frame, checks whether the hero is close enough to be
; hit, firing a status trigger if so.
c$C0AC LD A,(IY+$07)  ; {A = frame counter
 $C0AF INC A          ; }
 $C0B0 AND $87        ; {wrap to 7 bits, store
 $C0B2 LD (IY+$07),A  ; }
 $C0B5 AND $7E        ; {index from the counter bits
 $C0B7 RRCA           ; }
 $C0B8 ADD A,(IY+$04) ; {frame = base ((IY+4)) + index
 $C0BB LD (IX+$02),A  ; }
 $C0BE LD A,(IY+$07)  ;
 $C0C1 LD (IX+$03),A  ;
 $C0C4 BIT 7,(IY+$02) ; {skip unless (IY+2) high bit set
 $C0C8 RET Z          ; }
 $C0C9 LD A,(IY+$03)  ; A = (IY+3)
 $C0CC CP $04         ; {4 or more? go straight to the hit check
 $C0CE JR NC,$C0DA    ; }
 $C0D0 LD A,(IY+$07)  ;
 $C0D3 AND $06        ;
 $C0D5 RRCA           ;
 $C0D6 CP (IY+$03)    ;
 $C0D9 RET NZ         ;
; This entry point is used by the routines at #R$BFF6 and #R$C069.
*$C0DA PUSH IY        ; {IY=player
 $C0DC LD IY,$5B04    ; }
 $C0E0 CALL $9140     ; Classify object type ((IX+2)) into a size/category flag
 $C0E3 POP IY         ;
 $C0E5 RET NC         ;
 $C0E6 LD C,$18       ; C=$18 (default trigger)
 $C0E8 LD A,($5C06)   ; {status ($5C06) past $0F? RET
 $C0EB CP $0F         ; }
 $C0ED RET NC         ;
 $C0EE OR A           ; {status non-zero? use the default
 $C0EF JR NZ,$C0F9    ; }
 $C0F1 LD A,($A101)   ; {flag $A101 set? use the default
 $C0F4 OR A           ; }
 $C0F5 JR NZ,$C0F9    ;
 $C0F7 LD C,$1A       ; else trigger $1A
*$C0F9 LD A,C         ; {trigger via #R$AE85
 $C0FA JP $AE85       ; }

; Wrapper: scan tile below feet via #R$A2AC, flag at $C12D
;
; Used by the routines at #R$BEDD and #R$BF67.
c$C0FD PUSH IY       ;
 $C0FF LD IY,$C12D   ;
 $C103 CALL $A2AC    ; Scan tile column below feet against solid-tile list
                     ; ($A24B/$A271), flag
 $C106 POP IY        ;
 $C108 RET           ;

; Wrapper: scan tile right via #R$A2FA, flag at $C12D
;
; Used by the routines at #R$BEDD and #R$BFBB.
c$C109 PUSH IY       ;
 $C10B LD IY,$C12D   ;
 $C10F CALL $A2FA    ; Scan tile column right of object (X+23) via #R$A2B2
 $C112 POP IY        ;
 $C114 RET           ;

; Wrapper: scan tile via #R$A31F, flag at $C131
;
; Used by the routine at #R$BF22.
c$C115 PUSH IY       ;
 $C117 LD IY,$C131   ;
 $C11B CALL $A31F    ; Scan tile at (X+12) against special-tile list
                     ; ($A242/$A268), flag
 $C11E POP IY        ;
 $C120 RET           ;

; Wrapper: scan tile below-right via #R$A30B, flag at $C131
;
; Used by the routines at #R$BF22 and #R$BFF6.
c$C121 PUSH IY       ;
 $C123 LD IY,$C131   ;
 $C127 CALL $A30B    ; Scan tile below-right of feet (X+12,Y+24) via #R$A328
 $C12A POP IY        ;
 $C12C RET           ;

; Tile-scan result flags (used by #R$C0FD/#R$C109)
b$C12D DEFB $00

; Unused/scratch flag bytes (NOP-initialized, $C12E-$C132)
;
; .
;
; .
;
; Mostly padding, but the $C135 entry point here is real: it stamps an object
; with its starting position and frame from a template, and is called whenever
; a creature needs (re)initialising.
c$C12E NOP            ; unused scratch bytes (7 NOPs)
 $C12F NOP            ;
 $C130 NOP            ;
 $C131 NOP            ;
 $C132 NOP            ;
 $C133 NOP            ;
 $C134 NOP            ;
; This entry point is used by the routines at #R$BEDD, #R$BF22, #R$BFA0 and
; #R$C054.
*$C135 SET 0,(IY+$08) ; set gate flag (IY+8)=1
 $C139 LD A,(IY+$05)  ; {copy X from the template
 $C13C LD (IX+$00),A  ; }
 $C13F LD A,(IY+$06)  ; {copy Y
 $C142 LD (IX+$01),A  ; }
 $C145 LD A,(IY+$04)  ; {copy the frame
 $C148 LD (IX+$02),A  ; }
 $C14B LD A,(IY+$07)  ; {copy the direction flag
 $C14E LD (IX+$03),A  ; }
 $C151 RET            ;

; Room data table (12 bytes per room)
