 $ADCD LD E,A        ;
 $ADCE AND $03       ;
 $ADD0 RET Z         ;
 $ADD1 BIT 0,E       ;
 $ADD3 JR Z,$AE06    ;
 $ADD5 LD A,(IX+$00) ;
 $ADD8 INC A         ;
 $ADD9 INC A         ;
 $ADDA CP $E7        ;
 $ADDC JR C,$ADEC    ;
 $ADDE PUSH IX       ;
 $ADE0 PUSH IY       ;
 $ADE2 CALL $A671    ; Move right
 $ADE5 POP IY        ;
 $ADE7 POP IX        ;
 $ADE9 LD A,(IX+$00) ;
*$ADEC LD L,(IX+$00) ;
 $ADEF LD H,(IX+$01) ;
 $ADF2 LD (IX+$00),A ;
 $ADF5 PUSH HL       ;
 $ADF6 CALL $A102    ; Clear a 4-byte record at $A0FE
 $ADF9 LD A,(IY+$01) ;
 $ADFC POP HL        ;
 $ADFD OR A          ;
 $ADFE RET Z         ;
 $ADFF LD (IX+$00),L ;
 $AE02 LD (IX+$01),H ;
 $AE05 RET           ;
*$AE06 LD A,(IX+$00) ;
 $AE09 DEC A         ;
 $AE0A JR Z,$AE0F    ;
 $AE0C DEC A         ;
 $AE0D JR NZ,$AE1D   ;
*$AE0F PUSH IX       ;
 $AE11 PUSH IY       ;
 $AE13 CALL $A640    ; Move left
 $AE16 POP IY        ;
 $AE18 POP IX        ;
 $AE1A LD A,(IX+$00) ;
*$AE1D LD L,(IX+$00) ;
 $AE20 LD H,(IX+$01) ;
 $AE23 LD (IX+$00),A ;
 $AE26 PUSH HL       ;
 $AE27 CALL $A102    ; Clear a 4-byte record at $A0FE
 $AE2A LD A,(IY+$00) ;
 $AE2D POP HL        ;
 $AE2E OR A          ;
 $AE2F RET Z         ;
 $AE30 LD (IX+$00),L ;
 $AE33 LD (IX+$01),H ;
 $AE36 RET           ;

