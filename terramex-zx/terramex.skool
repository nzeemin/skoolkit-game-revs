 $9139 DEFB $EB,$CD,$C6,$90,$D1,$E1,$C9

; Classify object type ((IX+2)) into a size/category flag (C)
;
; Used by the routines at #R$B409, #R$B5DD, #R$B72D, #R$BB5D and #R$C0AC.
;
;   IX first object (position at +0/+1, type at +2)
;   IY second object (position at +0/+1)
; O:Cf set if both X and Y are within threshold
;
; Checks whether two objects (the hero and a creature/item, typically) are
; close enough to interact - the shared proximity test behind pickups, hits,
; and hazard triggers throughout the game.
c$9140 PUSH BC       ;
 $9141 LD A,(IX+$02) ; A = object type ((IX+2))
 $9144 LD C,$10      ; C=$10 (default threshold)
 $9146 CP $5C        ; {type below $5C?
 $9148 JR C,$9150    ; }
 $914A CP $60        ; {or $60 and up?
 $914C JR NC,$9150   ; }
 $914E LD C,$08      ; else threshold = $08
*$9150 LD A,(IX+$00) ; {X delta between the two objects
 $9153 SUB (IY+$00)  ; }
 $9156 JR NC,$915A   ;
 $9158 NEG           ; make it positive
*$915A CP C          ; {X within threshold? else skip Y check
 $915B JR NC,$9168   ; }
 $915D LD A,(IX+$01) ; {Y delta between the two objects
 $9160 SUB (IY+$01)  ; }
 $9163 JR NC,$9167   ;
 $9165 NEG           ; make it positive
*$9167 CP C          ; within threshold? (result in carry)
*$9168 POP BC        ;
 $9169 RET           ;

