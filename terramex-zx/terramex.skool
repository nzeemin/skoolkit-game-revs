; Decode room number ($5C01) to row/col
;
; Used by the routines at #R$A640, #R$A671, #R$A69B and #R$A6AE.
;
; O:B row
; O:C col
;
; Divmod by 12: B=row (quotient), C=col (remainder). Rooms are numbered
; row*12+col, i.e. 12 rooms per horizontal row (matches the player-drawn map's
; row width).
c$AEEF LD A,($5C01)  ;
 $AEF2 LD B,$FF      ;
*$AEF4 INC B         ;
 $AEF5 SUB $0C       ;
 $AEF7 JR NC,$AEF4   ;
 $AEF9 ADD A,$0C     ;
 $AEFB LD C,A        ;
 $AEFC RET           ;

; Encode row/col to room number
;
; Used by the routines at #R$A640, #R$A671, #R$A69B and #R$A6AE.
;
; B row
; C col
;
; room = B*12 + C. Stores result to ($5C01).
