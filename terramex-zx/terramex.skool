; Fill C bytes with A (used for the menu box frame)
;
; Used by the routine at #R$93AF.
;
; A fill byte
; HL start address
; B row count
; C bytes per row
;
; A generic rectangle-fill helper: paints a solid block of one byte value, used
; to draw the menu's box frame.
c$9526 PUSH BC       ; {save BC/HL
 $9527 PUSH HL       ; }
*$9528 LD (HL),A     ; {write A, advance
 $9529 INC HL        ; }
 $952A DEC C         ; {loop C bytes
 $952B JR NZ,$9528   ; }
 $952D POP HL        ; restore the row start
 $952E LD BC,$0020   ; {advance a row ($20 bytes)
 $9531 ADD HL,BC     ; }
 $9532 POP BC        ; restore BC
 $9533 DJNZ $9526    ; loop B rows
 $9535 RET           ;

; Convert screen address to attribute address
;
; Used by the routines at #R$93AF and #R$94F9.
;
;   HL screen address
; O:HL attribute address
;
; Standard ZX idiom: H's top bits (Y7Y6, the screen third) rotated into place
; and ORed with $58 to get the attribute row; L is already the right column so
; it's left as-is.
c$9536 LD A,H        ;
 $9537 RRCA          ;
 $9538 RRCA          ;
 $9539 RRCA          ;
 $953A AND $03       ;
 $953C OR $58        ;
 $953E LD H,A        ;
 $953F RET           ;

