; Copies one 8-pixel-tall strip of the menu border graphic into place - part of
; the frame-drawing sequence run when the main menu screen is built.
c$92D6 PUSH DE       ; {save DE/HL
 $92D7 PUSH HL       ; }
 $92D8 LD A,H        ; {H AND $03
 $92D9 AND $03       ; }
 $92DB RLCA          ; <<3 (three RLCA)
 $92DC RLCA          ;
 $92DD RLCA          ;
 $92DE OR $40        ; {OR $40 (destination third)
 $92E0 LD D,A        ; }
 $92E1 OR $E0        ; {H = same value OR $E0 (source, $E0xx buffer)
 $92E3 LD H,A        ; }
 $92E4 LD E,L        ; {E=L, B=8 rows
 $92E5 LD B,$08      ; }
*$92E7 LD A,(HL)     ; {copy one byte
 $92E8 LD (DE),A     ; }
 $92E9 INC H         ; {both to the next pixel row
 $92EA INC D         ; }
 $92EB DJNZ $92E7    ; loop 8 rows
 $92ED POP HL        ; {restore DE/HL
 $92EE POP DE        ; }
