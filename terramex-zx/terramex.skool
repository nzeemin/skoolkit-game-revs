 $9C42 LD (DE),A     ;
 $9C43 INC H         ;
 $9C44 INC D         ;
 $9C45 LD A,H        ;
 $9C46 AND B         ;
 $9C47 CALL Z,$9DBF  ; DOWN HL, char-row fixup
 $9C4A LDD           ;
 $9C4C LDD           ;
 $9C4E LDD           ;
 $9C50 LD A,(HL)     ;
