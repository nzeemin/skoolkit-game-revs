; Countdown timer ($5BFD/$5BFC/$5BFB); expiry warps to room $28, triggers
; hazard
;
; Used by the routine at #R$8F47.
;
; .
;
; Ticks down the asteroid-collision countdown shown on the telescope screen;
; once it hits zero, forces the hero into room $28 and starts the game-over
; sequence.
c$935D LD HL,$5BFD   ; {HL=$5BFD, minutes--
 $9360 DEC (HL)      ; }
 $9361 BIT 7,(HL)    ; {underflowed?
 $9363 RET Z         ; }
 $9364 LD (HL),$3B   ; minutes=$3B
 $9366 DEC HL        ; {step to hours, hours--
 $9367 DEC (HL)      ; }
 $9368 BIT 7,(HL)    ; {underflowed?
 $936A RET Z         ; }
 $936B LD (HL),$17   ; hours=$17
 $936D DEC HL        ; {step to days, days--
 $936E DEC (HL)      ; }
 $936F BIT 7,(HL)    ; {underflowed?
 $9371 RET Z         ; }
; This entry point is used by the routine at #R$A9EE.
*$9372 LD A,$7F      ; {$5B06=$7F (game-over flag)
 $9374 LD ($5B06),A  ; }
 $9377 LD A,$28      ; A=$28 (end room)
 $9379 LD ($5C01),A  ; set Current room number
 $937C CALL $9855    ; Set up the current room
 $937F LD A,$28      ; {respawn room = $28
 $9381 LD ($5C2D),A  ; }
 $9384 XOR A         ; {clear $5C2C
 $9385 LD ($5C2C),A  ; }
 $9388 LD A,$1D      ; {respawn status = $1D
 $938A LD ($5C2B),A  ; }
 $938D JP $AE85      ; Set hero status ($5C06), clear hazard timer ($5C07)

; Pseudo-random byte: R register mixed with $93AD/$8F47 stride table
;
; Used by the routine at #R$BFA0.
;
; .
;
; Produces a pseudo-random byte by mixing the CPU refresh register with a
; rolling pointer, so creature timers and effects do not all fall into step.
c$9390 PUSH HL       ; {save HL/DE
 $9391 PUSH DE       ; }
 $9392 LD HL,($93AD) ; HL = rolling pointer ($93AD)
 $9395 LD D,L        ; {DE = low byte shifted up
 $9396 LD E,$00      ; }
 $9398 ADD HL,DE     ; mix them
 $9399 LD DE,$0029   ; {advance by $29
 $939C ADD HL,DE     ; }
 $939D LD ($93AD),HL ; store the new pointer
 $93A0 LD H,$00      ; keep only the low byte
 $93A2 LD DE,$8F47   ; {index into the stride table ($8F47)
 $93A5 ADD HL,DE     ; }
 $93A6 LD A,R        ; A = refresh register
 $93A8 XOR H         ; {fold in H and L
 $93A9 ADD A,L       ; }
 $93AA POP DE        ;
 $93AB POP HL        ;
 $93AC RET           ;

; Pseudo-random generator state (#R$9390)
b$93AD DEFB $39,$30

; Main menu: draw title screen, print input-device options, read selection
;
; Used by the routine at #R$8F47.
;
; .
;
; #HTML[<img src="images/scr/Menu.png" />]
; .
; Clears screen+attrs, blits the green border-frame graphic: top/bottom pieces
; from $E000/$E0E0 (#R$94B0), then left/right pieces (#R$94C2), draws a colored
; frame (per-cell attr $46 write), then prints the device options ("1 :
; KEYBOARD" via #R$94EF, "2 : KEMPSTON" via #R$94F9). Main loop draws a
; highlight bar over the option matching ($94AF) and polls keys 1/2/3 (port
; $F7FE) to change it.
c$93AF LD HL,$4000   ;
 $93B2 LD DE,$4001   ;
 $93B5 LD BC,$1AFF   ;
 $93B8 LD (HL),L     ;
 $93B9 LDIR          ;
 $93BB LD HL,$5800   ;
 $93BE LD DE,$5801   ;
 $93C1 LD BC,$02FF   ;
 $93C4 LD (HL),$44   ;
 $93C6 LDIR          ;
 $93C8 LD HL,$5937   ;
 $93CB LD B,$06      ;
 $93CD LD C,B        ;
 $93CE LD A,$45      ;
 $93D0 CALL $9526    ; Fill C bytes with A
 $93D3 LD HL,$5942   ;
 $93D6 LD B,$03      ;
 $93D8 LD C,B        ;
 $93D9 LD A,$47      ;
 $93DB CALL $9526    ; Fill C bytes with A
 $93DE LD HL,$E000   ; {HL=$E000, DE=$4000
 $93E1 LD DE,$4000   ; }
 $93E4 CALL $94B0    ; Blit 32x8 byte block (menu border-frame graphic)
 $93E7 LD HL,$E0E0   ; {HL=$E0E0, DE=$50E0 (bottom piece)
 $93EA LD DE,$50E0   ; }
 $93ED CALL $94B0    ; Blit 32x8 byte block (menu border-frame graphic)
 $93F0 LD DE,$4020   ;
 $93F3 LD B,$0B      ; blit border frame, left/right pieces x11
*$93F5 LD HL,$E020   ;
 $93F8 CALL $94C2    ; Draw left/right piece at HL/DE, then advance to next
                     ; screen third
 $93FB LD HL,$E040   ;
 $93FE CALL $94C2    ; Draw left/right piece at HL/DE, then advance to next
                     ; screen third
 $9401 DJNZ $93F5    ;
 $9403 LD HL,$4063   ;
 $9406 LD DE,$95FD   ;
 $9409 LD B,$03      ;
*$940B PUSH BC       ;
 $940C PUSH HL       ;
